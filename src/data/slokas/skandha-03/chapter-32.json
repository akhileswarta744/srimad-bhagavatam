[
  {
    "id": "skandha-03-chapter-32-sloka-001",
    "skandha": 3,
    "chapter": 32,
    "sloka": 1,
    "sanskrit": "अथ यो गृहमेधीयान्धर्मानेवावसन्गृहे काममर्थं च धर्मान्स्वान्दोग्धि भूयः पिपर्ति तान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "कपिल उवाच ।"
  },
  {
    "id": "skandha-03-chapter-32-sloka-002",
    "skandha": 3,
    "chapter": 32,
    "sloka": 2,
    "sanskrit": "स चापि भगवद्धर्मात्काममूढः पराङ्मुखः यजते क्रतुभिर्देवान्पितंश्च श्रद्धयान्वितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-003",
    "skandha": 3,
    "chapter": 32,
    "sloka": 3,
    "sanskrit": "तच्छ्रद्धयाक्रान्तमतिः पितृदेवव्रतः पुमान् गत्वा चान्द्रमसं लोकं सोमपाः पुनरेष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-004",
    "skandha": 3,
    "chapter": 32,
    "sloka": 4,
    "sanskrit": "यदा चाहीन्द्रशय्यायां शेतेऽनन्तासनो हरिः तदा लोका लयं यान्ति त एते गृहमेधिनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-005",
    "skandha": 3,
    "chapter": 32,
    "sloka": 5,
    "sanskrit": "ये स्वधर्मान्न दुह्यन्ति धीराः कामार्थहेतवे निःसङ्गा न्यस्तकर्माणः प्रशान्ताः शुद्धचेतसः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-006",
    "skandha": 3,
    "chapter": 32,
    "sloka": 6,
    "sanskrit": "निवृत्तिधर्मनिरता निर्ममा निरहङ्कृताः स्वधर्माप्तेन सत्त्वेन परिशुद्धेन चेतसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-007",
    "skandha": 3,
    "chapter": 32,
    "sloka": 7,
    "sanskrit": "सूर्यद्वारेण ते यान्ति पुरुषं विश्वतोमुखम् परावरेशं प्रकृतिमस्योत्पत्त्यन्तभावनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-008",
    "skandha": 3,
    "chapter": 32,
    "sloka": 8,
    "sanskrit": "द्विपरार्धावसाने यः प्रलयो ब्रह्मणस्तु ते तावदध्यासते लोकं परस्य परचिन्तकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-009",
    "skandha": 3,
    "chapter": 32,
    "sloka": 9,
    "sanskrit": "क्ष्माम्भोऽनलानिलवियन्मनैन्द्रियार्थ भूतादिभिः परिवृतं प्रतिसञ्जिहीर्षुः अव्याकृतं विशति यर्हि गुणत्रयात्माकालं पराख्यमनुभूय परः स्वयम्भूः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-010",
    "skandha": 3,
    "chapter": 32,
    "sloka": 10,
    "sanskrit": "एवं परेत्य भगवन्तमनुप्रविष्टाये योगिनो जितमरुन्मनसो विरागाः तेनैव साकममृतं पुरुषं पुराणं ब्रह्म प्रधानमुपयान्त्यगताभिमानाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-011",
    "skandha": 3,
    "chapter": 32,
    "sloka": 11,
    "sanskrit": "अथ तं सर्वभूतानां हृत्पद्मेषु कृतालयम् श्रुतानुभावं शरणं व्रज भावेन भामिनि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-012",
    "skandha": 3,
    "chapter": 32,
    "sloka": 12,
    "sanskrit": "आद्यः स्थिरचराणां यो वेदगर्भः सहर्षिभिः योगेश्वरैः कुमाराद्यैः सिद्धैर्योगप्रवर्तकैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-013",
    "skandha": 3,
    "chapter": 32,
    "sloka": 13,
    "sanskrit": "भेददृष्ट्याभिमानेन निःसङ्गेनापि कर्मणा कर्तृत्वात्सगुणं ब्रह्म पुरुषं पुरुषर्षभम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-014",
    "skandha": 3,
    "chapter": 32,
    "sloka": 14,
    "sanskrit": "स संसृत्य पुनः काले कालेनेश्वरमूर्तिना जाते गुणव्यतिकरे यथापूर्वं प्रजायते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-015",
    "skandha": 3,
    "chapter": 32,
    "sloka": 15,
    "sanskrit": "ऐश्वर्यं पारमेष्ठ्यं च तेऽपि धर्मविनिर्मितम् निषेव्य पुनरायान्ति गुणव्यतिकरे सति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-016",
    "skandha": 3,
    "chapter": 32,
    "sloka": 16,
    "sanskrit": "ये त्विहासक्तमनसः कर्मसु श्रद्धयान्विताः कुर्वन्त्यप्रतिषिद्धानि नित्यान्यपि च कृत्स्नशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-017",
    "skandha": 3,
    "chapter": 32,
    "sloka": 17,
    "sanskrit": "रजसा कुण्ठमनसः कामात्मानोऽजितेन्द्रियाः पित्न्यजन्त्यनुदिनं गृहेष्वभिरताशयाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-018",
    "skandha": 3,
    "chapter": 32,
    "sloka": 18,
    "sanskrit": "त्रैवर्गिकास्ते पुरुषा विमुखा हरिमेधसः कथायां कथनीयोरु विक्रमस्य मधुद्विषः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-019",
    "skandha": 3,
    "chapter": 32,
    "sloka": 19,
    "sanskrit": "नूनं दैवेन विहता ये चाच्युतकथासुधाम् हित्वा शृण्वन्त्यसद्गाथाः पुरीषमिव विड्भुजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-020",
    "skandha": 3,
    "chapter": 32,
    "sloka": 20,
    "sanskrit": "दक्षिणेन पथार्यम्णः पितृलोकं व्रजन्ति ते प्रजामनु प्रजायन्ते श्मशानान्तक्रियाकृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-021",
    "skandha": 3,
    "chapter": 32,
    "sloka": 21,
    "sanskrit": "ततस्ते क्षीणसुकृताः पुनर्लोकमिमं सति पतन्ति विवशा देवैः सद्यो विभ्रंशितोदयाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-022",
    "skandha": 3,
    "chapter": 32,
    "sloka": 22,
    "sanskrit": "तस्मात्त्वं सर्वभावेन भजस्व परमेष्ठिनम् तद्गुणाश्रयया भक्त्या भजनीयपदाम्बुजम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-023",
    "skandha": 3,
    "chapter": 32,
    "sloka": 23,
    "sanskrit": "वासुदेवे भगवति भक्तियोगः प्रयोजितः जनयत्याशु वैराग्यं ज्ञानं यद्ब्रह्मदर्शनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-024",
    "skandha": 3,
    "chapter": 32,
    "sloka": 24,
    "sanskrit": "यदास्य चित्तमर्थेषु समेष्विन्द्रियवृत्तिभिः न विगृह्णाति वैषम्यं प्रियमप्रियमित्युत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-025",
    "skandha": 3,
    "chapter": 32,
    "sloka": 25,
    "sanskrit": "स तदैवात्मनात्मानं निःसङ्गं समदर्शनम् हेयोपादेयरहितमारूढं पदमीक्षते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-026",
    "skandha": 3,
    "chapter": 32,
    "sloka": 26,
    "sanskrit": "ज्ञानमात्रं परं ब्रह्म परमात्मेश्वरः पुमान् दृश्यादिभिः पृथग्भावैर्भगवानेक ईयते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-027",
    "skandha": 3,
    "chapter": 32,
    "sloka": 27,
    "sanskrit": "एतावानेव योगेन समग्रेणेह योगिनः युज्यतेऽभिमतो ह्यर्थो यदसङ्गस्तु कृत्स्नशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-028",
    "skandha": 3,
    "chapter": 32,
    "sloka": 28,
    "sanskrit": "ज्ञानमेकं पराचीनैरिन्द्रियैर्ब्रह्म निर्गुणम् अवभात्यर्थरूपेण भ्रान्त्या शब्दादिधर्मिणा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-029",
    "skandha": 3,
    "chapter": 32,
    "sloka": 29,
    "sanskrit": "यथा महानहंरूपस्त्रिवृत्पञ्चविधः स्वराट् एकादशविधस्तस्य वपुरण्डं जगद्यतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-030",
    "skandha": 3,
    "chapter": 32,
    "sloka": 30,
    "sanskrit": "एतद्वै श्रद्धया भक्त्या योगाभ्यासेन नित्यशः समाहितात्मा निःसङ्गो विरक्त्या परिपश्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-031",
    "skandha": 3,
    "chapter": 32,
    "sloka": 31,
    "sanskrit": "इत्येतत्कथितं गुर्वि ज्ञानं तद्ब्रह्मदर्शनम् येनानुबुद्ध्यते तत्त्वं प्रकृतेः पुरुषस्य च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-032",
    "skandha": 3,
    "chapter": 32,
    "sloka": 32,
    "sanskrit": "ज्ञानयोगश्च मन्निष्ठो नैर्गुण्यो भक्तिलक्षणः द्वयोरप्येक एवार्थो भगवच्छब्दलक्षणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-033",
    "skandha": 3,
    "chapter": 32,
    "sloka": 33,
    "sanskrit": "यथेन्द्रियैः पृथग्द्वारैरर्थो बहुगुणाश्रयः एको नानेयते तद्वद्भगवान्शास्त्रवर्त्मभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-034",
    "skandha": 3,
    "chapter": 32,
    "sloka": 34,
    "sanskrit": "क्रियया क्रतुभिर्दानैस्तपःस्वाध्यायमर्शनैः आत्मेन्द्रियजयेनापि सन्न्यासेन च कर्मणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-035",
    "skandha": 3,
    "chapter": 32,
    "sloka": 35,
    "sanskrit": "योगेन विविधाङ्गेन भक्तियोगेन चैव हि धर्मेणोभयचिह्नेन यः प्रवृत्तिनिवृत्तिमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-036",
    "skandha": 3,
    "chapter": 32,
    "sloka": 36,
    "sanskrit": "आत्मतत्त्वावबोधेन वैराग्येण दृढेन च ईयते भगवानेभिः सगुणो निर्गुणः स्वदृक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-037",
    "skandha": 3,
    "chapter": 32,
    "sloka": 37,
    "sanskrit": "प्रावोचं भक्तियोगस्य स्वरूपं ते चतुर्विधम् कालस्य चाव्यक्तगतेर्योऽन्तर्धावति जन्तुषु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-038",
    "skandha": 3,
    "chapter": 32,
    "sloka": 38,
    "sanskrit": "जीवस्य संसृतीर्बह्वीरविद्याकर्मनिर्मिताः यास्वङ्ग प्रविशन्नात्मा न वेद गतिमात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-039",
    "skandha": 3,
    "chapter": 32,
    "sloka": 39,
    "sanskrit": "नैतत्खलायोपदिशेन्नाविनीताय कर्हिचित् न स्तब्धाय न भिन्नाय नैव धर्मध्वजाय च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-040",
    "skandha": 3,
    "chapter": 32,
    "sloka": 40,
    "sanskrit": "न लोलुपायोपदिशेन्न गृहारूढचेतसे नाभक्ताय च मे जातु न मद्भक्तद्विषामपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-041",
    "skandha": 3,
    "chapter": 32,
    "sloka": 41,
    "sanskrit": "श्रद्दधानाय भक्ताय विनीतायानसूयवे भूतेषु कृतमैत्राय शुश्रूषाभिरताय च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-042",
    "skandha": 3,
    "chapter": 32,
    "sloka": 42,
    "sanskrit": "बहिर्जातविरागाय शान्तचित्ताय दीयताम् निर्मत्सराय शुचये यस्याहं प्रेयसां प्रियः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-32-sloka-043",
    "skandha": 3,
    "chapter": 32,
    "sloka": 43,
    "sanskrit": "य इदं शृणुयादम्ब श्रद्धया पुरुषः सकृत् यो वाभिधत्ते मच्चित्तः स ह्येति पदवीं च मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]