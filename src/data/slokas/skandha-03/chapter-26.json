[
  {
    "id": "skandha-03-chapter-26-sloka-001",
    "skandha": 3,
    "chapter": 26,
    "sloka": 1,
    "sanskrit": "अथ ते सम्प्रवक्ष्यामि तत्त्वानां लक्षणं पृथक् यद्विदित्वा विमुच्येत पुरुषः प्राकृतैर्गुणैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-03-chapter-26-sloka-002",
    "skandha": 3,
    "chapter": 26,
    "sloka": 2,
    "sanskrit": "ज्ञानं निःश्रेयसार्थाय पुरुषस्यात्मदर्शनम् यदाहुर्वर्णये तत्ते हृदयग्रन्थिभेदनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-003",
    "skandha": 3,
    "chapter": 26,
    "sloka": 3,
    "sanskrit": "अनादिरात्मा पुरुषो निर्गुणः प्रकृतेः परः प्रत्यग्धामा स्वयंज्योतिर्विश्वं येन समन्वितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-004",
    "skandha": 3,
    "chapter": 26,
    "sloka": 4,
    "sanskrit": "स एष प्रकृतिं सूक्ष्मां दैवीं गुणमयीं विभुः यदृच्छयैवोपगतामभ्यपद्यत लीलया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-005",
    "skandha": 3,
    "chapter": 26,
    "sloka": 5,
    "sanskrit": "गुणैर्विचित्राः सृजतीं सरूपाः प्रकृतिं प्रजाः विलोक्य मुमुहे सद्यः स इह ज्ञानगूहया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-006",
    "skandha": 3,
    "chapter": 26,
    "sloka": 6,
    "sanskrit": "एवं पराभिध्यानेन कर्तृत्वं प्रकृतेः पुमान् कर्मसु क्रियमाणेषु गुणैरात्मनि मन्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-007",
    "skandha": 3,
    "chapter": 26,
    "sloka": 7,
    "sanskrit": "तदस्य संसृतिर्बन्धः पारतन्त्र्यं च तत्कृतम् भवत्यकर्तुरीशस्य साक्षिणो निर्वृतात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-008",
    "skandha": 3,
    "chapter": 26,
    "sloka": 8,
    "sanskrit": "कार्यकारणकर्तृत्वे कारणं प्रकृतिं विदुः भोक्तृत्वे सुखदुःखानां पुरुषं प्रकृतेः परम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-009",
    "skandha": 3,
    "chapter": 26,
    "sloka": 9,
    "sanskrit": "प्रकृतेः पुरुषस्यापि लक्षणं पुरुषोत्तम ब्रूहि कारणयोरस्य सदसच्च यदात्मकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "देवहूतिरुवाच ।"
  },
  {
    "id": "skandha-03-chapter-26-sloka-010",
    "skandha": 3,
    "chapter": 26,
    "sloka": 10,
    "sanskrit": "यत्तत्त्रिगुणमव्यक्तं नित्यं सदसदात्मकम् प्रधानं प्रकृतिं प्राहुरविशेषं विशेषवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-03-chapter-26-sloka-011",
    "skandha": 3,
    "chapter": 26,
    "sloka": 11,
    "sanskrit": "पञ्चभिः पञ्चभिर्ब्रह्म चतुर्भिर्दशभिस्तथा एतच्चतुर्विंशतिकं गणं प्राधानिकं विदुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-012",
    "skandha": 3,
    "chapter": 26,
    "sloka": 12,
    "sanskrit": "महाभूतानि पञ्चैव भूरापोऽग्निर्मरुन्नभः तन्मात्राणि च तावन्ति गन्धादीनि मतानि मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-013",
    "skandha": 3,
    "chapter": 26,
    "sloka": 13,
    "sanskrit": "इन्द्रियाणि दश श्रोत्रं त्वग्दृग्रसननासिकाः वाक्करौ चरणौ मेढ्रं पायुर्दशम उच्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-014",
    "skandha": 3,
    "chapter": 26,
    "sloka": 14,
    "sanskrit": "मनो बुद्धिरहङ्कारश्चित्तमित्यन्तरात्मकम् चतुर्धा लक्ष्यते भेदो वृत्त्या लक्षणरूपया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-015",
    "skandha": 3,
    "chapter": 26,
    "sloka": 15,
    "sanskrit": "एतावानेव सङ्ख्यातो ब्रह्मणः सगुणस्य ह सन्निवेशो मया प्रोक्तो यः कालः पञ्चविंशकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-016",
    "skandha": 3,
    "chapter": 26,
    "sloka": 16,
    "sanskrit": "प्रभावं पौरुषं प्राहुः कालमेके यतो भयम् अहङ्कारविमूढस्य कर्तुः प्रकृतिमीयुषः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-017",
    "skandha": 3,
    "chapter": 26,
    "sloka": 17,
    "sanskrit": "प्रकृतेर्गुणसाम्यस्य निर्विशेषस्य मानवि चेष्टा यतः स भगवान्काल इत्युपलक्षितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-018",
    "skandha": 3,
    "chapter": 26,
    "sloka": 18,
    "sanskrit": "अन्तः पुरुषरूपेण कालरूपेण यो बहिः समन्वेत्येष सत्त्वानां भगवानात्ममायया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-019",
    "skandha": 3,
    "chapter": 26,
    "sloka": 19,
    "sanskrit": "दैवात्क्षुभितधर्मिण्यां स्वस्यां योनौ परः पुमान् आधत्त वीर्यं सासूत महत्तत्त्वं हिरण्मयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-020",
    "skandha": 3,
    "chapter": 26,
    "sloka": 20,
    "sanskrit": "विश्वमात्मगतं व्यञ्जन्कूटस्थो जगदङ्कुरः स्वतेजसापिबत्तीव्रमात्मप्रस्वापनं तमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-021",
    "skandha": 3,
    "chapter": 26,
    "sloka": 21,
    "sanskrit": "यत्तत्सत्त्वगुणं स्वच्छं शान्तं भगवतः पदम् यदाहुर्वासुदेवाख्यं चित्तं तन्महदात्मकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-022",
    "skandha": 3,
    "chapter": 26,
    "sloka": 22,
    "sanskrit": "स्वच्छत्वमविकारित्वं शान्तत्वमिति चेतसः वृत्तिभिर्लक्षणं प्रोक्तं यथापां प्रकृतिः परा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-023",
    "skandha": 3,
    "chapter": 26,
    "sloka": 23,
    "sanskrit": "महत्तत्त्वाद्विकुर्वाणाद्भगवद्वीर्यसम्भवात् क्रियाशक्तिरहङ्कारस्त्रिविधः समपद्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-024",
    "skandha": 3,
    "chapter": 26,
    "sloka": 24,
    "sanskrit": "वैकारिकस्तैजसश्च तामसश्च यतो भवः मनसश्चेन्द्रियाणां च भूतानां महतामपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-025",
    "skandha": 3,
    "chapter": 26,
    "sloka": 25,
    "sanskrit": "सहस्रशिरसं साक्षाद्यमनन्तं प्रचक्षते सङ्कर्षणाख्यं पुरुषं भूतेन्द्रियमनोमयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-026",
    "skandha": 3,
    "chapter": 26,
    "sloka": 26,
    "sanskrit": "कर्तृत्वं करणत्वं च कार्यत्वं चेति लक्षणम् शान्तघोरविमूढत्वमिति वा स्यादहङ्कृतेः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-027",
    "skandha": 3,
    "chapter": 26,
    "sloka": 27,
    "sanskrit": "वैकारिकाद्विकुर्वाणान्मनस्तत्त्वमजायत यत्सङ्कल्पविकल्पाभ्यां वर्तते कामसम्भवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-028",
    "skandha": 3,
    "chapter": 26,
    "sloka": 28,
    "sanskrit": "यद्विदुर्ह्यनिरुद्धाख्यं हृषीकाणामधीश्वरम् शारदेन्दीवरश्यामं संराध्यं योगिभिः शनैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-029",
    "skandha": 3,
    "chapter": 26,
    "sloka": 29,
    "sanskrit": "तैजसात्तु विकुर्वाणाद्बुद्धितत्त्वमभूत्सति द्रव्यस्फुरणविज्ञानमिन्द्रियाणामनुग्रहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-030",
    "skandha": 3,
    "chapter": 26,
    "sloka": 30,
    "sanskrit": "संशयोऽथ विपर्यासो निश्चयः स्मृतिरेव च स्वाप इत्युच्यते बुद्धेर्लक्षणं वृत्तितः पृथक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-031",
    "skandha": 3,
    "chapter": 26,
    "sloka": 31,
    "sanskrit": "तैजसानीन्द्रियाण्येव क्रियाज्ञानविभागशः प्राणस्य हि क्रियाशक्तिर्बुद्धेर्विज्ञानशक्तिता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-032",
    "skandha": 3,
    "chapter": 26,
    "sloka": 32,
    "sanskrit": "तामसाच्च विकुर्वाणाद्भगवद्वीर्यचोदितात् शब्दमात्रमभूत्तस्मान्नभः श्रोत्रं तु शब्दगम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-033",
    "skandha": 3,
    "chapter": 26,
    "sloka": 33,
    "sanskrit": "अर्थाश्रयत्वं शब्दस्य द्रष्टुर्लिङ्गत्वमेव च तन्मात्रत्वं च नभसो लक्षणं कवयो विदुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-034",
    "skandha": 3,
    "chapter": 26,
    "sloka": 34,
    "sanskrit": "भूतानां छिद्रदातृत्वं बहिरन्तरमेव च प्राणेन्द्रियात्मधिष्ण्यत्वं नभसो वृत्तिलक्षणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-035",
    "skandha": 3,
    "chapter": 26,
    "sloka": 35,
    "sanskrit": "नभसः शब्दतन्मात्रात्कालगत्या विकुर्वतः स्पर्शोऽभवत्ततो वायुस्त्वक्स्पर्शस्य च सङ्ग्रहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-036",
    "skandha": 3,
    "chapter": 26,
    "sloka": 36,
    "sanskrit": "मृदुत्वं कठिनत्वं च शैत्यमुष्णत्वमेव च एतत्स्पर्शस्य स्पर्शत्वं तन्मात्रत्वं नभस्वतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-037",
    "skandha": 3,
    "chapter": 26,
    "sloka": 37,
    "sanskrit": "चालनं व्यूहनं प्राप्तिर्नेतृत्वं द्रव्यशब्दयोः सर्वेन्द्रियाणामात्मत्वं वायोः कर्माभिलक्षणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-038",
    "skandha": 3,
    "chapter": 26,
    "sloka": 38,
    "sanskrit": "वायोश्च स्पर्शतन्मात्राद्रूपं दैवेरितादभूत् समुत्थितं ततस्तेजश्चक्षू रूपोपलम्भनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-039",
    "skandha": 3,
    "chapter": 26,
    "sloka": 39,
    "sanskrit": "द्रव्याकृतित्वं गुणता व्यक्तिसंस्थात्वमेव च तेजस्त्वं तेजसः साध्वि रूपमात्रस्य वृत्तयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-040",
    "skandha": 3,
    "chapter": 26,
    "sloka": 40,
    "sanskrit": "द्योतनं पचनं पानमदनं हिममर्दनम् तेजसो वृत्तयस्त्वेताः शोषणं क्षुत्तृडेव च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-041",
    "skandha": 3,
    "chapter": 26,
    "sloka": 41,
    "sanskrit": "रूपमात्राद्विकुर्वाणात्तेजसो दैवचोदितात् रसमात्रमभूत्तस्मादम्भो जिह्वा रसग्रहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-042",
    "skandha": 3,
    "chapter": 26,
    "sloka": 42,
    "sanskrit": "कषायो मधुरस्तिक्तः कट्वम्ल इति नैकधा भौतिकानां विकारेण रस एको विभिद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-043",
    "skandha": 3,
    "chapter": 26,
    "sloka": 43,
    "sanskrit": "क्लेदनं पिण्डनं तृप्तिः प्राणनाप्यायनोन्दनम् तापापनोदो भूयस्त्वमम्भसो वृत्तयस्त्विमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-044",
    "skandha": 3,
    "chapter": 26,
    "sloka": 44,
    "sanskrit": "रसमात्राद्विकुर्वाणादम्भसो दैवचोदितात् गन्धमात्रमभूत्तस्मात्पृथ्वी घ्राणस्तु गन्धगः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-045",
    "skandha": 3,
    "chapter": 26,
    "sloka": 45,
    "sanskrit": "करम्भपूतिसौरभ्य शान्तोग्राम्लादिभिः पृथक् द्रव्यावयववैषम्याद्गन्ध एको विभिद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-046",
    "skandha": 3,
    "chapter": 26,
    "sloka": 46,
    "sanskrit": "भावनं ब्रह्मणः स्थानं धारणं सद्विशेषणम् सर्वसत्त्वगुणोद्भेदः पृथिवीवृत्तिलक्षणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-047",
    "skandha": 3,
    "chapter": 26,
    "sloka": 47,
    "sanskrit": "नभोगुणविशेषोऽर्थो यस्य तच्छ्रोत्रमुच्यते वायोर्गुणविशेषोऽर्थो यस्य तत्स्पर्शनं विदुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-048",
    "skandha": 3,
    "chapter": 26,
    "sloka": 48,
    "sanskrit": "तेजोगुणविशेषोऽर्थो यस्य तच्चक्षुरुच्यते अम्भोगुणविशेषोऽर्थो यस्य तद्रसनं विदुः भूमेर्गुणविशेषोऽर्थो यस्य स घ्राण उच्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-049",
    "skandha": 3,
    "chapter": 26,
    "sloka": 49,
    "sanskrit": "परस्य दृश्यते धर्मो ह्यपरस्मिन्समन्वयात् अतो विशेषो भावानां भूमावेवोपलक्ष्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-050",
    "skandha": 3,
    "chapter": 26,
    "sloka": 50,
    "sanskrit": "एतान्यसंहत्य यदा महदादीनि सप्त वै कालकर्मगुणोपेतो जगदादिरुपाविशत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-051",
    "skandha": 3,
    "chapter": 26,
    "sloka": 51,
    "sanskrit": "ततस्तेनानुविद्धेभ्यो युक्तेभ्योऽण्डमचेतनम् उत्थितं पुरुषो यस्मादुदतिष्ठदसौ विराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-052",
    "skandha": 3,
    "chapter": 26,
    "sloka": 52,
    "sanskrit": "एतदण्डं विशेषाख्यं क्रमवृद्धैर्दशोत्तरैः तोयादिभिः परिवृतं प्रधानेनावृतैर्बहिः यत्र लोकवितानोऽयं रूपं भगवतो हरेः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-053",
    "skandha": 3,
    "chapter": 26,
    "sloka": 53,
    "sanskrit": "हिरण्मयादण्डकोशादुत्थाय सलिले शयात् तमाविश्य महादेवो बहुधा निर्बिभेद खम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-054",
    "skandha": 3,
    "chapter": 26,
    "sloka": 54,
    "sanskrit": "निरभिद्यतास्य प्रथमं मुखं वाणी ततोऽभवत् वाण्या वह्निरथो नासे प्राणोतो घ्राण एतयोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-055",
    "skandha": 3,
    "chapter": 26,
    "sloka": 55,
    "sanskrit": "घ्राणाद्वायुरभिद्येतामक्षिणी चक्षुरेतयोः तस्मात्सूर्यो न्यभिद्येतां कर्णौ श्रोत्रं ततो दिशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-056",
    "skandha": 3,
    "chapter": 26,
    "sloka": 56,
    "sanskrit": "निर्बिभेद विराजस्त्वग् रोमश्मश्र्वादयस्ततः तत ओषधयश्चासन्शिश्नं निर्बिभिदे ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-057",
    "skandha": 3,
    "chapter": 26,
    "sloka": 57,
    "sanskrit": "रेतस्तस्मादाप आसन्निरभिद्यत वै गुदम् गुदादपानोऽपानाच्च मृत्युर्लोकभयङ्करः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-058",
    "skandha": 3,
    "chapter": 26,
    "sloka": 58,
    "sanskrit": "हस्तौ च निरभिद्येतां बलं ताभ्यां ततः स्वराट् पादौ च निरभिद्येतां गतिस्ताभ्यां ततो हरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-059",
    "skandha": 3,
    "chapter": 26,
    "sloka": 59,
    "sanskrit": "नाड्योऽस्य निरभिद्यन्त ताभ्यो लोहितमाभृतम् नद्यस्ततः समभवन्नुदरं निरभिद्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-060",
    "skandha": 3,
    "chapter": 26,
    "sloka": 60,
    "sanskrit": "क्षुत्पिपासे ततः स्यातां समुद्रस्त्वेतयोरभूत् अथास्य हृदयं भिन्नं हृदयान्मन उत्थितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-061",
    "skandha": 3,
    "chapter": 26,
    "sloka": 61,
    "sanskrit": "मनसश्चन्द्रमा जातो बुद्धिर्बुद्धेर्गिरां पतिः अहङ्कारस्ततो रुद्रश्चित्तं चैत्यस्ततोऽभवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-062",
    "skandha": 3,
    "chapter": 26,
    "sloka": 62,
    "sanskrit": "एते ह्यभ्युत्थिता देवा नैवास्योत्थापनेऽशकन् पुनराविविशुः खानि तमुत्थापयितुं क्रमात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-063",
    "skandha": 3,
    "chapter": 26,
    "sloka": 63,
    "sanskrit": "वह्निर्वाचा मुखं भेजे नोदतिष्ठत्तदा विराट् घ्राणेन नासिके वायुर्नोदतिष्ठत्तदा विराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-064",
    "skandha": 3,
    "chapter": 26,
    "sloka": 64,
    "sanskrit": "अक्षिणी चक्षुषादित्यो नोदतिष्ठत्तदा विराट् श्रोत्रेण कर्णौ च दिशो नोदतिष्ठत्तदा विराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-065",
    "skandha": 3,
    "chapter": 26,
    "sloka": 65,
    "sanskrit": "त्वचं रोमभिरोषध्यो नोदतिष्ठत्तदा विराट् रेतसा शिश्नमापस्तु नोदतिष्ठत्तदा विराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-066",
    "skandha": 3,
    "chapter": 26,
    "sloka": 66,
    "sanskrit": "गुदं मृत्युरपानेन नोदतिष्ठत्तदा विराट् हस्ताविन्द्रो बलेनैव नोदतिष्ठत्तदा विराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-067",
    "skandha": 3,
    "chapter": 26,
    "sloka": 67,
    "sanskrit": "विष्णुर्गत्यैव चरणौ नोदतिष्ठत्तदा विराट् नाडीर्नद्यो लोहितेन नोदतिष्ठत्तदा विराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-068",
    "skandha": 3,
    "chapter": 26,
    "sloka": 68,
    "sanskrit": "क्षुत्तृड्भ्यामुदरं सिन्धुर्नोदतिष्ठत्तदा विराट् हृदयं मनसा चन्द्रो नोदतिष्ठत्तदा विराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-069",
    "skandha": 3,
    "chapter": 26,
    "sloka": 69,
    "sanskrit": "बुद्ध्या ब्रह्मापि हृदयं नोदतिष्ठत्तदा विराट् रुद्रोऽभिमत्या हृदयं नोदतिष्ठत्तदा विराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-070",
    "skandha": 3,
    "chapter": 26,
    "sloka": 70,
    "sanskrit": "चित्तेन हृदयं चैत्यः क्षेत्रज्ञः प्राविशद्यदा विराट्तदैव पुरुषः सलिलादुदतिष्ठत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-071",
    "skandha": 3,
    "chapter": 26,
    "sloka": 71,
    "sanskrit": "यथा प्रसुप्तं पुरुषं प्राणेन्द्रियमनोधियः प्रभवन्ति विना येन नोत्थापयितुमोजसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-26-sloka-072",
    "skandha": 3,
    "chapter": 26,
    "sloka": 72,
    "sanskrit": "तमस्मिन्प्रत्यगात्मानं धिया योगप्रवृत्तया भक्त्या विरक्त्या ज्ञानेन विविच्यात्मनि चिन्तयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]