[
  {
    "id": "skandha-03-chapter-11-sloka-001",
    "skandha": 3,
    "chapter": 11,
    "sloka": 1,
    "sanskrit": "चरमः सद्विशेषाणामनेकोऽसंयुतः सदा परमाणुः स विज्ञेयो नृणामैक्यभ्रमो यतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-03-chapter-11-sloka-002",
    "skandha": 3,
    "chapter": 11,
    "sloka": 2,
    "sanskrit": "सत एव पदार्थस्य स्वरूपावस्थितस्य यत् कैवल्यं परममहानविशेषो निरन्तरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-003",
    "skandha": 3,
    "chapter": 11,
    "sloka": 3,
    "sanskrit": "एवं कालोऽप्यनुमितः सौक्ष्म्ये स्थौल्ये च सत्तम संस्थानभुक्त्या भगवानव्यक्तो व्यक्तभुग्विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-004",
    "skandha": 3,
    "chapter": 11,
    "sloka": 4,
    "sanskrit": "स कालः परमाणुर्वै यो भुङ्क्ते परमाणुताम् सतोऽविशेषभुग्यस्तु स कालः परमो महान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-005",
    "skandha": 3,
    "chapter": 11,
    "sloka": 5,
    "sanskrit": "अणुर्द्वौ परमाणू स्यात्त्रसरेणुस्त्रयः स्मृतः जालार्करश्म्यवगतः खमेवानुपतन्नगात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-006",
    "skandha": 3,
    "chapter": 11,
    "sloka": 6,
    "sanskrit": "त्रसरेणुत्रिकं भुङ्क्ते यः कालः स त्रुटिः स्मृतः शतभागस्तु वेधः स्यात्तैस्त्रिभिस्तु लवः स्मृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-007",
    "skandha": 3,
    "chapter": 11,
    "sloka": 7,
    "sanskrit": "निमेषस्त्रिलवो ज्ञेय आम्नातस्ते त्रयः क्षणः क्षणान्पञ्च विदुः काष्ठां लघु ता दश पञ्च च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-008",
    "skandha": 3,
    "chapter": 11,
    "sloka": 8,
    "sanskrit": "लघूनि वै समाम्नाता दश पञ्च च नाडिका ते द्वे मुहूर्तः प्रहरः षड्यामः सप्त वा नृणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-009",
    "skandha": 3,
    "chapter": 11,
    "sloka": 9,
    "sanskrit": "द्वादशार्धपलोन्मानं चतुर्भिश्चतुरङ्गुलैः स्वर्णमाषैः कृतच्छिद्रं यावत्प्रस्थजलप्लुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-010",
    "skandha": 3,
    "chapter": 11,
    "sloka": 10,
    "sanskrit": "यामाश्चत्वारश्चत्वारो मर्त्यानामहनी उभे पक्षः पञ्चदशाहानि शुक्लः कृष्णश्च मानद",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-011",
    "skandha": 3,
    "chapter": 11,
    "sloka": 11,
    "sanskrit": "तयोः समुच्चयो मासः पितॄणां तदहर्निशम् द्वौ तावृतुः षडयनं दक्षिणं चोत्तरं दिवि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-012",
    "skandha": 3,
    "chapter": 11,
    "sloka": 12,
    "sanskrit": "अयने चाहनी प्राहुर्वत्सरो द्वादश स्मृतः संवत्सरशतं न्णां परमायुर्निरूपितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-013",
    "skandha": 3,
    "chapter": 11,
    "sloka": 13,
    "sanskrit": "ग्रहर्क्षताराचक्रस्थः परमाण्वादिना जगत् संवत्सरावसानेन पर्येत्यनिमिषो विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-014",
    "skandha": 3,
    "chapter": 11,
    "sloka": 14,
    "sanskrit": "संवत्सरः परिवत्सर इडावत्सर एव च अनुवत्सरो वत्सरश्च विदुरैवं प्रभाष्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-015",
    "skandha": 3,
    "chapter": 11,
    "sloka": 15,
    "sanskrit": "यः सृज्यशक्तिमुरुधोच्छ्वसयन्स्वशक्त्या पुंसोऽभ्रमाय दिवि धावति भूतभेदः कालाख्यया गुणमयं क्रतुभिर्वितन्वंस् तस्मै बलिं हरत वत्सरपञ्चकाय",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-016",
    "skandha": 3,
    "chapter": 11,
    "sloka": 16,
    "sanskrit": "पितृदेवमनुष्याणामायुः परमिदं स्मृतम् परेषां गतिमाचक्ष्व ये स्युः कल्पाद्बहिर्विदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "विदुर उवाच ।"
  },
  {
    "id": "skandha-03-chapter-11-sloka-017",
    "skandha": 3,
    "chapter": 11,
    "sloka": 17,
    "sanskrit": "भगवान्वेद कालस्य गतिं भगवतो ननु विश्वं विचक्षते धीरा योगराद्धेन चक्षुषा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-018",
    "skandha": 3,
    "chapter": 11,
    "sloka": 18,
    "sanskrit": "कृतं त्रेता द्वापरं च कलिश्चेति चतुर्युगम् दिव्यैर्द्वादशभिर्वर्षैः सावधानं निरूपितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-03-chapter-11-sloka-019",
    "skandha": 3,
    "chapter": 11,
    "sloka": 19,
    "sanskrit": "चत्वारि त्रीणि द्वे चैकं कृतादिषु यथाक्रमम् सङ्ख्यातानि सहस्राणि द्विगुणानि शतानि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-020",
    "skandha": 3,
    "chapter": 11,
    "sloka": 20,
    "sanskrit": "सन्ध्यासन्ध्यांशयोरन्तर्यः कालः शतसङ्ख्ययोः तमेवाहुर्युगं तज्ज्ञा यत्र धर्मो विधीयते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-021",
    "skandha": 3,
    "chapter": 11,
    "sloka": 21,
    "sanskrit": "धर्मश्चतुष्पान्मनुजान्कृते समनुवर्तते स एवान्येष्वधर्मेण व्येति पादेन वर्धता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-022",
    "skandha": 3,
    "chapter": 11,
    "sloka": 22,
    "sanskrit": "त्रिलोक्या युगसाहस्रं बहिराब्रह्मणो दिनम् तावत्येव निशा तात यन्निमीलति विश्वसृक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-023",
    "skandha": 3,
    "chapter": 11,
    "sloka": 23,
    "sanskrit": "निशावसान आरब्धो लोककल्पोऽनुवर्तते यावद्दिनं भगवतो मनून्भुञ्जंश्चतुर्दश",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-024",
    "skandha": 3,
    "chapter": 11,
    "sloka": 24,
    "sanskrit": "स्वं स्वं कालं मनुर्भुङ्क्ते साधिकां ह्येकसप्ततिम् मन्वन्तरेषु मनवस्तद्वंश्या ऋषयः सुराः भवन्ति चैव युगपत्सुरेशाश्चानु ये च तान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-025",
    "skandha": 3,
    "chapter": 11,
    "sloka": 25,
    "sanskrit": "एष दैनन्दिनः सर्गो ब्राह्मस्त्रैलोक्यवर्तनः तिर्यङ्नृपितृदेवानां सम्भवो यत्र कर्मभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-026",
    "skandha": 3,
    "chapter": 11,
    "sloka": 26,
    "sanskrit": "मन्वन्तरेषु भगवान्बिभ्रत्सत्त्वं स्वमूर्तिभिः मन्वादिभिरिदं विश्वमवत्युदितपौरुषः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-027",
    "skandha": 3,
    "chapter": 11,
    "sloka": 27,
    "sanskrit": "तमोमात्रामुपादाय प्रतिसंरुद्धविक्रमः कालेनानुगताशेष आस्ते तूष्णीं दिनात्यये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-028",
    "skandha": 3,
    "chapter": 11,
    "sloka": 28,
    "sanskrit": "तमेवान्वपि धीयन्ते लोका भूरादयस्त्रयः निशायामनुवृत्तायां निर्मुक्तशशिभास्करम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-029",
    "skandha": 3,
    "chapter": 11,
    "sloka": 29,
    "sanskrit": "त्रिलोक्यां दह्यमानायां शक्त्या सङ्कर्षणाग्निना यान्त्यूष्मणा महर्लोकाज्जनं भृग्वादयोऽर्दिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-030",
    "skandha": 3,
    "chapter": 11,
    "sloka": 30,
    "sanskrit": "तावत्त्रिभुवनं सद्यः कल्पान्तैधितसिन्धवः प्लावयन्त्युत्कटाटोप चण्डवातेरितोर्मयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-031",
    "skandha": 3,
    "chapter": 11,
    "sloka": 31,
    "sanskrit": "अन्तः स तस्मिन्सलिल आस्तेऽनन्तासनो हरिः योगनिद्रानिमीलाक्षः स्तूयमानो जनालयैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-032",
    "skandha": 3,
    "chapter": 11,
    "sloka": 32,
    "sanskrit": "एवंविधैरहोरात्रैः कालगत्योपलक्षितैः अपक्षितमिवास्यापि परमायुर्वयःशतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-033",
    "skandha": 3,
    "chapter": 11,
    "sloka": 33,
    "sanskrit": "यदर्धमायुषस्तस्य परार्धमभिधीयते पूर्वः परार्धोऽपक्रान्तो ह्यपरोऽद्य प्रवर्तते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-034",
    "skandha": 3,
    "chapter": 11,
    "sloka": 34,
    "sanskrit": "पूर्वस्यादौ परार्धस्य ब्राह्मो नाम महानभूत् कल्पो यत्राभवद्ब्रह्मा शब्दब्रह्मेति यं विदुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-035",
    "skandha": 3,
    "chapter": 11,
    "sloka": 35,
    "sanskrit": "तस्यैव चान्ते कल्पोऽभूद्यं पाद्ममभिचक्षते यद्धरेर्नाभिसरस आसील्लोकसरोरुहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-036",
    "skandha": 3,
    "chapter": 11,
    "sloka": 36,
    "sanskrit": "अयं तु कथितः कल्पो द्वितीयस्यापि भारत वाराह इति विख्यातो यत्रासीच्छूकरो हरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-037",
    "skandha": 3,
    "chapter": 11,
    "sloka": 37,
    "sanskrit": "कालोऽयं द्विपरार्धाख्यो निमेष उपचर्यते अव्याकृतस्यानन्तस्य ह्यनादेर्जगदात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-038",
    "skandha": 3,
    "chapter": 11,
    "sloka": 38,
    "sanskrit": "कालोऽयं परमाण्वादिर्द्विपरार्धान्त ईश्वरः नैवेशितुं प्रभुर्भूम्न ईश्वरो धाममानिनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-039",
    "skandha": 3,
    "chapter": 11,
    "sloka": 39,
    "sanskrit": "विकारैः सहितो युक्तैर्विशेषादिभिरावृतः आण्डकोशो बहिरयं पञ्चाशत्कोटिविस्तृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-040",
    "skandha": 3,
    "chapter": 11,
    "sloka": 40,
    "sanskrit": "दशोत्तराधिकैर्यत्र प्रविष्टः परमाणुवत् लक्ष्यतेऽन्तर्गताश्चान्ये कोटिशो ह्यण्डराशयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-11-sloka-041",
    "skandha": 3,
    "chapter": 11,
    "sloka": 41,
    "sanskrit": "तदाहुरक्षरं ब्रह्म सर्वकारणकारणम् विष्णोर्धाम परं साक्षात्पुरुषस्य महात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]