[
  {
    "id": "skandha-03-chapter-27-sloka-001",
    "skandha": 3,
    "chapter": 27,
    "sloka": 1,
    "sanskrit": "प्रकृतिस्थोऽपि पुरुषो नाज्यते प्राकृतैर्गुणैः अविकारादकर्तृत्वान्निर्गुणत्वाज्जलार्कवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-03-chapter-27-sloka-002",
    "skandha": 3,
    "chapter": 27,
    "sloka": 2,
    "sanskrit": "स एष यर्हि प्रकृतेर्गुणेष्वभिविषज्जते अहङ्क्रियाविमूढात्मा कर्तास्मीत्यभिमन्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-003",
    "skandha": 3,
    "chapter": 27,
    "sloka": 3,
    "sanskrit": "तेन संसारपदवीमवशोऽभ्येत्यनिर्वृतः प्रासङ्गिकैः कर्मदोषैः सदसन्मिश्रयोनिषु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-004",
    "skandha": 3,
    "chapter": 27,
    "sloka": 4,
    "sanskrit": "अर्थे ह्यविद्यमानेऽपि संसृतिर्न निवर्तते ध्यायतो विषयानस्य स्वप्नेऽनर्थागमो यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-005",
    "skandha": 3,
    "chapter": 27,
    "sloka": 5,
    "sanskrit": "अत एव शनैश्चित्तं प्रसक्तमसतां पथि भक्तियोगेन तीव्रेण विरक्त्या च नयेद्वशम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-006",
    "skandha": 3,
    "chapter": 27,
    "sloka": 6,
    "sanskrit": "यमादिभिर्योगपथैरभ्यसञ्श्रद्धयान्वितः मयि भावेन सत्येन मत्कथाश्रवणेन च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-007",
    "skandha": 3,
    "chapter": 27,
    "sloka": 7,
    "sanskrit": "सर्वभूतसमत्वेन निर्वैरेणाप्रसङ्गतः ब्रह्मचर्येण मौनेन स्वधर्मेण बलीयसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-008",
    "skandha": 3,
    "chapter": 27,
    "sloka": 8,
    "sanskrit": "यदृच्छयोपलब्धेन सन्तुष्टो मितभुङ्मुनिः विविक्तशरणः शान्तो मैत्रः करुण आत्मवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-009",
    "skandha": 3,
    "chapter": 27,
    "sloka": 9,
    "sanskrit": "सानुबन्धे च देहेऽस्मिन्नकुर्वन्नसदाग्रहम् ज्ञानेन दृष्टतत्त्वेन प्रकृतेः पुरुषस्य च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-010",
    "skandha": 3,
    "chapter": 27,
    "sloka": 10,
    "sanskrit": "निवृत्तबुद्ध्यवस्थानो दूरीभूतान्यदर्शनः उपलभ्यात्मनात्मानं चक्षुषेवार्कमात्मदृक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-011",
    "skandha": 3,
    "chapter": 27,
    "sloka": 11,
    "sanskrit": "मुक्तलिङ्गं सदाभासमसति प्रतिपद्यते सतो बन्धुमसच्चक्षुः सर्वानुस्यूतमद्वयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-012",
    "skandha": 3,
    "chapter": 27,
    "sloka": 12,
    "sanskrit": "यथा जलस्थ आभासः स्थलस्थेनावदृश्यते स्वाभासेन तथा सूर्यो जलस्थेन दिवि स्थितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-013",
    "skandha": 3,
    "chapter": 27,
    "sloka": 13,
    "sanskrit": "एवं त्रिवृदहङ्कारो भूतेन्द्रियमनोमयैः स्वाभासैर्लक्षितोऽनेन सदाभासेन सत्यदृक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-014",
    "skandha": 3,
    "chapter": 27,
    "sloka": 14,
    "sanskrit": "भूतसूक्ष्मेन्द्रियमनो बुद्ध्यादिष्विह निद्रया लीनेष्वसति यस्तत्र विनिद्रो निरहङ्क्रियः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-015",
    "skandha": 3,
    "chapter": 27,
    "sloka": 15,
    "sanskrit": "मन्यमानस्तदात्मानमनष्टो नष्टवन्मृषा नष्टेऽहङ्करणे द्रष्टा नष्टवित्त इवातुरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-016",
    "skandha": 3,
    "chapter": 27,
    "sloka": 16,
    "sanskrit": "एवं प्रत्यवमृश्यासावात्मानं प्रतिपद्यते साहङ्कारस्य द्रव्यस्य योऽवस्थानमनुग्रहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-017",
    "skandha": 3,
    "chapter": 27,
    "sloka": 17,
    "sanskrit": "पुरुषं प्रकृतिर्ब्रह्मन्न विमुञ्चति कर्हिचित् अन्योन्यापाश्रयत्वाच्च नित्यत्वादनयोः प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "देवहूतिरुवाच ।"
  },
  {
    "id": "skandha-03-chapter-27-sloka-018",
    "skandha": 3,
    "chapter": 27,
    "sloka": 18,
    "sanskrit": "यथा गन्धस्य भूमेश्च न भावो व्यतिरेकतः अपां रसस्य च यथा तथा बुद्धेः परस्य च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-019",
    "skandha": 3,
    "chapter": 27,
    "sloka": 19,
    "sanskrit": "अकर्तुः कर्मबन्धोऽयं पुरुषस्य यदाश्रयः गुणेषु सत्सु प्रकृतेः कैवल्यं तेष्वतः कथम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-020",
    "skandha": 3,
    "chapter": 27,
    "sloka": 20,
    "sanskrit": "क्वचित्तत्त्वावमर्शेन निवृत्तं भयमुल्बणम् अनिवृत्तनिमित्तत्वात्पुनः प्रत्यवतिष्ठते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-021",
    "skandha": 3,
    "chapter": 27,
    "sloka": 21,
    "sanskrit": "अनिमित्तनिमित्तेन स्वधर्मेणामलात्मना तीव्रया मयि भक्त्या च श्रुतसम्भृतया चिरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-03-chapter-27-sloka-022",
    "skandha": 3,
    "chapter": 27,
    "sloka": 22,
    "sanskrit": "ज्ञानेन दृष्टतत्त्वेन वैराग्येण बलीयसा तपोयुक्तेन योगेन तीव्रेणात्मसमाधिना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-023",
    "skandha": 3,
    "chapter": 27,
    "sloka": 23,
    "sanskrit": "प्रकृतिः पुरुषस्येह दह्यमाना त्वहर्निशम् तिरोभवित्री शनकैरग्नेर्योनिरिवारणिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-024",
    "skandha": 3,
    "chapter": 27,
    "sloka": 24,
    "sanskrit": "भुक्तभोगा परित्यक्ता दृष्टदोषा च नित्यशः नेश्वरस्याशुभं धत्ते स्वे महिम्नि स्थितस्य च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-025",
    "skandha": 3,
    "chapter": 27,
    "sloka": 25,
    "sanskrit": "यथा ह्यप्रतिबुद्धस्य प्रस्वापो बह्वनर्थभृत् स एव प्रतिबुद्धस्य न वै मोहाय कल्पते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-026",
    "skandha": 3,
    "chapter": 27,
    "sloka": 26,
    "sanskrit": "एवं विदिततत्त्वस्य प्रकृतिर्मयि मानसम् युञ्जतो नापकुरुत आत्मारामस्य कर्हिचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-027",
    "skandha": 3,
    "chapter": 27,
    "sloka": 27,
    "sanskrit": "यदैवमध्यात्मरतः कालेन बहुजन्मना सर्वत्र जातवैराग्य आब्रह्मभुवनान्मुनिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-028",
    "skandha": 3,
    "chapter": 27,
    "sloka": 28,
    "sanskrit": "मद्भक्तः प्रतिबुद्धार्थो मत्प्रसादेन भूयसा निःश्रेयसं स्वसंस्थानं कैवल्याख्यं मदाश्रयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-029",
    "skandha": 3,
    "chapter": 27,
    "sloka": 29,
    "sanskrit": "प्राप्नोतीहाञ्जसा धीरः स्वदृशा च्छिन्नसंशयः यद्गत्वा न निवर्तेत योगी लिङ्गाद्विनिर्गमे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-27-sloka-030",
    "skandha": 3,
    "chapter": 27,
    "sloka": 30,
    "sanskrit": "यदा न योगोपचितासु चेतो मायासु सिद्धस्य विषज्जतेऽङ्ग अनन्यहेतुष्वथ मे गतिः स्यादात्यन्तिकी यत्र न मृत्युहासः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]