[
  {
    "id": "skandha-03-chapter-12-sloka-001",
    "skandha": 3,
    "chapter": 12,
    "sloka": 1,
    "sanskrit": "इति ते वर्णितः क्षत्तः कालाख्यः परमात्मनः महिमा वेदगर्भोऽथ यथास्राक्षीन्निबोध मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-03-chapter-12-sloka-002",
    "skandha": 3,
    "chapter": 12,
    "sloka": 2,
    "sanskrit": "ससर्जाग्रेऽन्धतामिस्रमथ तामिस्रमादिकृत् महामोहं च मोहं च तमश्चाज्ञानवृत्तयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-003",
    "skandha": 3,
    "chapter": 12,
    "sloka": 3,
    "sanskrit": "दृष्ट्वा पापीयसीं सृष्टिं नात्मानं बह्वमन्यत भगवद्ध्यानपूतेन मनसान्यां ततोऽसृजत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-004",
    "skandha": 3,
    "chapter": 12,
    "sloka": 4,
    "sanskrit": "सनकं च सनन्दं च सनातनमथात्मभूः सनत्कुमारं च मुनीन्निष्क्रियानूर्ध्वरेतसः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-005",
    "skandha": 3,
    "chapter": 12,
    "sloka": 5,
    "sanskrit": "तान्बभाषे स्वभूः पुत्रान्प्रजाः सृजत पुत्रकाः तन्नैच्छन्मोक्षधर्माणो वासुदेवपरायणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-006",
    "skandha": 3,
    "chapter": 12,
    "sloka": 6,
    "sanskrit": "सोऽवध्यातः सुतैरेवं प्रत्याख्यातानुशासनैः क्रोधं दुर्विषहं जातं नियन्तुमुपचक्रमे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-007",
    "skandha": 3,
    "chapter": 12,
    "sloka": 7,
    "sanskrit": "धिया निगृह्यमाणोऽपि भ्रुवोर्मध्यात्प्रजापतेः सद्योऽजायत तन्मन्युः कुमारो नीललोहितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-008",
    "skandha": 3,
    "chapter": 12,
    "sloka": 8,
    "sanskrit": "स वै रुरोद देवानां पूर्वजो भगवान्भवः नामानि कुरु मे धातः स्थानानि च जगद्गुरो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-009",
    "skandha": 3,
    "chapter": 12,
    "sloka": 9,
    "sanskrit": "इति तस्य वचः पाद्मो भगवान्परिपालयन् अभ्यधाद्भद्रया वाचा मा रोदीस्तत्करोमि ते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-010",
    "skandha": 3,
    "chapter": 12,
    "sloka": 10,
    "sanskrit": "यदरोदीः सुरश्रेष्ठ सोद्वेग इव बालकः ततस्त्वामभिधास्यन्ति नाम्ना रुद्र इति प्रजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-011",
    "skandha": 3,
    "chapter": 12,
    "sloka": 11,
    "sanskrit": "हृदिन्द्रियाण्यसुर्व्योम वायुरग्निर्जलं मही सूर्यश्चन्द्रस्तपश्चैव स्थानान्यग्रे कृतानि ते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-012",
    "skandha": 3,
    "chapter": 12,
    "sloka": 12,
    "sanskrit": "मन्युर्मनुर्महिनसो महाञ्छिव ऋतध्वजः उग्ररेता भवः कालो वामदेवो धृतव्रतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-013",
    "skandha": 3,
    "chapter": 12,
    "sloka": 13,
    "sanskrit": "धीर्धृतिरसलोमा च नियुत्सर्पिरिलाम्बिका इरावती स्वधा दीक्षा रुद्राण्यो रुद्र ते स्त्रियः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-014",
    "skandha": 3,
    "chapter": 12,
    "sloka": 14,
    "sanskrit": "गृहाणैतानि नामानि स्थानानि च सयोषणः एभिः सृज प्रजा बह्वीः प्रजानामसि यत्पतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-015",
    "skandha": 3,
    "chapter": 12,
    "sloka": 15,
    "sanskrit": "इत्यादिष्टः स्वगुरुणा भगवान्नीललोहितः सत्त्वाकृतिस्वभावेन ससर्जात्मसमाः प्रजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-016",
    "skandha": 3,
    "chapter": 12,
    "sloka": 16,
    "sanskrit": "रुद्राणां रुद्रसृष्टानां समन्ताद्ग्रसतां जगत् निशाम्यासङ्ख्यशो यूथान्प्रजापतिरशङ्कत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-017",
    "skandha": 3,
    "chapter": 12,
    "sloka": 17,
    "sanskrit": "अलं प्रजाभिः सृष्टाभिरीदृशीभिः सुरोत्तम मया सह दहन्तीभिर्दिशश्चक्षुर्भिरुल्बणैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-018",
    "skandha": 3,
    "chapter": 12,
    "sloka": 18,
    "sanskrit": "तप आतिष्ठ भद्रं ते सर्वभूतसुखावहम् तपसैव यथा पूर्वं स्रष्टा विश्वमिदं भवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-019",
    "skandha": 3,
    "chapter": 12,
    "sloka": 19,
    "sanskrit": "तपसैव परं ज्योतिर्भगवन्तमधोक्षजम् सर्वभूतगुहावासमञ्जसा विन्दते पुमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-020",
    "skandha": 3,
    "chapter": 12,
    "sloka": 20,
    "sanskrit": "एवमात्मभुवादिष्टः परिक्रम्य गिरां पतिम् बाढमित्यमुमामन्त्र्य विवेश तपसे वनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-03-chapter-12-sloka-021",
    "skandha": 3,
    "chapter": 12,
    "sloka": 21,
    "sanskrit": "अथाभिध्यायतः सर्गं दश पुत्राः प्रजज्ञिरे भगवच्छक्तियुक्तस्य लोकसन्तानहेतवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-022",
    "skandha": 3,
    "chapter": 12,
    "sloka": 22,
    "sanskrit": "मरीचिरत्र्यङ्गिरसौ पुलस्त्यः पुलहः क्रतुः भृगुर्वसिष्ठो दक्षश्च दशमस्तत्र नारदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-023",
    "skandha": 3,
    "chapter": 12,
    "sloka": 23,
    "sanskrit": "उत्सङ्गान्नारदो जज्ञे दक्षोऽङ्गुष्ठात्स्वयम्भुवः प्राणाद्वसिष्ठः सञ्जातो भृगुस्त्वचि करात्क्रतुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-024",
    "skandha": 3,
    "chapter": 12,
    "sloka": 24,
    "sanskrit": "पुलहो नाभितो जज्ञे पुलस्त्यः कर्णयोरृषिः अङ्गिरा मुखतोऽक्ष्णोऽत्रिर्मरीचिर्मनसोऽभवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-025",
    "skandha": 3,
    "chapter": 12,
    "sloka": 25,
    "sanskrit": "धर्मः स्तनाद्दक्षिणतो यत्र नारायणः स्वयम् अधर्मः पृष्ठतो यस्मान्मृत्युर्लोकभयङ्करः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-026",
    "skandha": 3,
    "chapter": 12,
    "sloka": 26,
    "sanskrit": "हृदि कामो भ्रुवः क्रोधो लोभश्चाधरदच्छदात् आस्याद्वाक्सिन्धवो मेढ्रान्निरृतिः पायोरघाश्रयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-027",
    "skandha": 3,
    "chapter": 12,
    "sloka": 27,
    "sanskrit": "छायायाः कर्दमो जज्ञे देवहूत्याः पतिः प्रभुः मनसो देहतश्चेदं जज्ञे विश्वकृतो जगत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-028",
    "skandha": 3,
    "chapter": 12,
    "sloka": 28,
    "sanskrit": "वाचं दुहितरं तन्वीं स्वयम्भूर्हरतीं मनः अकामां चकमे क्षत्तः सकाम इति नः श्रुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-029",
    "skandha": 3,
    "chapter": 12,
    "sloka": 29,
    "sanskrit": "तमधर्मे कृतमतिं विलोक्य पितरं सुताः मरीचिमुख्या मुनयो विश्रम्भात्प्रत्यबोधयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-030",
    "skandha": 3,
    "chapter": 12,
    "sloka": 30,
    "sanskrit": "नैतत्पूर्वैः कृतं त्वद्ये न करिष्यन्ति चापरे यस्त्वं दुहितरं गच्छेरनिगृह्याङ्गजं प्रभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-031",
    "skandha": 3,
    "chapter": 12,
    "sloka": 31,
    "sanskrit": "तेजीयसामपि ह्येतन्न सुश्लोक्यं जगद्गुरो यद्वृत्तमनुतिष्ठन्वै लोकः क्षेमाय कल्पते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-032",
    "skandha": 3,
    "chapter": 12,
    "sloka": 32,
    "sanskrit": "तस्मै नमो भगवते य इदं स्वेन रोचिषा आत्मस्थं व्यञ्जयामास स धर्मं पातुमर्हति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-033",
    "skandha": 3,
    "chapter": 12,
    "sloka": 33,
    "sanskrit": "स इत्थं गृणतः पुत्रान्पुरो दृष्ट्वा प्रजापतीन् प्रजापतिपतिस्तन्वं तत्याज व्रीडितस्तदा तां दिशो जगृहुर्घोरां नीहारं यद्विदुस्तमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-034",
    "skandha": 3,
    "chapter": 12,
    "sloka": 34,
    "sanskrit": "कदाचिद्ध्यायतः स्रष्टुर्वेदा आसंश्चतुर्मुखात् कथं स्रक्ष्याम्यहं लोकान्समवेतान्यथा पुरा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-035",
    "skandha": 3,
    "chapter": 12,
    "sloka": 35,
    "sanskrit": "चातुर्होत्रं कर्मतन्त्रमुपवेदनयैः सह धर्मस्य पादाश्चत्वारस्तथैवाश्रमवृत्तयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-036",
    "skandha": 3,
    "chapter": 12,
    "sloka": 36,
    "sanskrit": "स वै विश्वसृजामीशो वेदादीन्मुखतोऽसृजत् यद्यद्येनासृजद्देवस्तन्मे ब्रूहि तपोधन",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "विदुर उवाच ।"
  },
  {
    "id": "skandha-03-chapter-12-sloka-037",
    "skandha": 3,
    "chapter": 12,
    "sloka": 37,
    "sanskrit": "ऋग्यजुःसामाथर्वाख्यान्वेदान्पूर्वादिभिर्मुखैः शास्त्रमिज्यां स्तुतिस्तोमं प्रायश्चित्तं व्यधात्क्रमात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-03-chapter-12-sloka-038",
    "skandha": 3,
    "chapter": 12,
    "sloka": 38,
    "sanskrit": "आयुर्वेदं धनुर्वेदं गान्धर्वं वेदमात्मनः स्थापत्यं चासृजद्वेदं क्रमात्पूर्वादिभिर्मुखैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-039",
    "skandha": 3,
    "chapter": 12,
    "sloka": 39,
    "sanskrit": "इतिहासपुराणानि पञ्चमं वेदमीश्वरः सर्वेभ्य एव वक्त्रेभ्यः ससृजे सर्वदर्शनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-040",
    "skandha": 3,
    "chapter": 12,
    "sloka": 40,
    "sanskrit": "षोडश्युक्थौ पूर्ववक्त्रात्पुरीष्यग्निष्टुतावथ आप्तोर्यामातिरात्रौ च वाजपेयं सगोसवम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-041",
    "skandha": 3,
    "chapter": 12,
    "sloka": 41,
    "sanskrit": "विद्या दानं तपः सत्यं धर्मस्येति पदानि च आश्रमांश्च यथासङ्ख्यमसृजत्सह वृत्तिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-042",
    "skandha": 3,
    "chapter": 12,
    "sloka": 42,
    "sanskrit": "सावित्रं प्राजापत्यं च ब्राह्मं चाथ बृहत्तथा वार्ता सञ्चयशालीन शिलोञ्छ इति वै गृहे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-043",
    "skandha": 3,
    "chapter": 12,
    "sloka": 43,
    "sanskrit": "वैखानसा वालखिल्यौ दुम्बराः फेनपा वने न्यासे कुटीचकः पूर्वं बह्वोदो हंसनिष्क्रियौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-12-sloka-044",
    "skandha": 3,
    "chapter": 12,
    "sloka": 44,
    "sanskrit": "आन्वीक्षिकी त्रयी वार्ता दण्डनीतिस्तथैव च एवं व्याहृतयश्चासन्प्रणवो ह्यस्य दह्रतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
