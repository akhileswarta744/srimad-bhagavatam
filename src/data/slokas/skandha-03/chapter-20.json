[
  {
    "id": "skandha-03-chapter-20-sloka-001",
    "skandha": 3,
    "chapter": 20,
    "sloka": 1,
    "sanskrit": "महीं प्रतिष्ठामध्यस्य सौते स्वायम्भुवो मनुः कान्यन्वतिष्ठद्द्वाराणि मार्गायावरजन्मनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "शौनक उवाच ।"
  },
  {
    "id": "skandha-03-chapter-20-sloka-002",
    "skandha": 3,
    "chapter": 20,
    "sloka": 2,
    "sanskrit": "क्षत्ता महाभागवतः कृष्णस्यैकान्तिकः सुहृत् यस्तत्याजाग्रजं कृष्णे सापत्यमघवानिति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-003",
    "skandha": 3,
    "chapter": 20,
    "sloka": 3,
    "sanskrit": "द्वैपायनादनवरो महित्वे तस्य देहजः सर्वात्मना श्रितः कृष्णं तत्परांश्चाप्यनुव्रतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-004",
    "skandha": 3,
    "chapter": 20,
    "sloka": 4,
    "sanskrit": "किमन्वपृच्छन्मैत्रेयं विरजास्तीर्थसेवया उपगम्य कुशावर्त आसीनं तत्त्ववित्तमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-005",
    "skandha": 3,
    "chapter": 20,
    "sloka": 5,
    "sanskrit": "तयोः संवदतोः सूत प्रवृत्ता ह्यमलाः कथाः आपो गाङ्गा इवाघघ्नीर्हरेः पादाम्बुजाश्रयाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-006",
    "skandha": 3,
    "chapter": 20,
    "sloka": 6,
    "sanskrit": "ता नः कीर्तय भद्रं ते कीर्तन्योदारकर्मणः रसज्ञः को नु तृप्येत हरिलीलामृतं पिबन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-007",
    "skandha": 3,
    "chapter": 20,
    "sloka": 7,
    "sanskrit": "एवमुग्रश्रवाः पृष्ट ऋषिभिर्नैमिषायनैः भगवत्यर्पिताध्यात्मस्तानाह श्रूयतामिति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-008",
    "skandha": 3,
    "chapter": 20,
    "sloka": 8,
    "sanskrit": "हरेर्धृतक्रोडतनोः स्वमायया निशम्य गोरुद्धरणं रसातलात् लीलां हिरण्याक्षमवज्ञया हतं सञ्जातहर्षो मुनिमाह भारतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "सूत उवाच ।"
  },
  {
    "id": "skandha-03-chapter-20-sloka-009",
    "skandha": 3,
    "chapter": 20,
    "sloka": 9,
    "sanskrit": "प्रजापतिपतिः सृष्ट्वा प्रजासर्गे प्रजापतीन् किमारभत मे ब्रह्मन्प्रब्रूह्यव्यक्तमार्गवित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "विदुर उवाच ।"
  },
  {
    "id": "skandha-03-chapter-20-sloka-010",
    "skandha": 3,
    "chapter": 20,
    "sloka": 10,
    "sanskrit": "ये मरीच्यादयो विप्रा यस्तु स्वायम्भुवो मनुः ते वै ब्रह्मण आदेशात्कथमेतदभावयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-011",
    "skandha": 3,
    "chapter": 20,
    "sloka": 11,
    "sanskrit": "सद्वितीयाः किमसृजन्स्वतन्त्रा उत कर्मसु आहो स्वित्संहताः सर्व इदं स्म समकल्पयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-012",
    "skandha": 3,
    "chapter": 20,
    "sloka": 12,
    "sanskrit": "दैवेन दुर्वितर्क्येण परेणानिमिषेण च जातक्षोभाद्भगवतो महानासीद्गुणत्रयात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-03-chapter-20-sloka-013",
    "skandha": 3,
    "chapter": 20,
    "sloka": 13,
    "sanskrit": "रजःप्रधानान्महतस्त्रिलिङ्गो दैवचोदितात् जातः ससर्ज भूतादिर्वियदादीनि पञ्चशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-014",
    "skandha": 3,
    "chapter": 20,
    "sloka": 14,
    "sanskrit": "तानि चैकैकशः स्रष्टुमसमर्थानि भौतिकम् संहत्य दैवयोगेन हैममण्डमवासृजन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-015",
    "skandha": 3,
    "chapter": 20,
    "sloka": 15,
    "sanskrit": "सोऽशयिष्टाब्धिसलिले आण्डकोशो निरात्मकः साग्रं वै वर्षसाहस्रमन्ववात्सीत्तमीश्वरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-016",
    "skandha": 3,
    "chapter": 20,
    "sloka": 16,
    "sanskrit": "तस्य नाभेरभूत्पद्मं सहस्रार्कोरुदीधिति सर्वजीवनिकायौको यत्र स्वयमभूत्स्वराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-017",
    "skandha": 3,
    "chapter": 20,
    "sloka": 17,
    "sanskrit": "सोऽनुविष्टो भगवता यः शेते सलिलाशये लोकसंस्थां यथा पूर्वं निर्ममे संस्थया स्वया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-018",
    "skandha": 3,
    "chapter": 20,
    "sloka": 18,
    "sanskrit": "ससर्ज च्छाययाविद्यां पञ्चपर्वाणमग्रतः तामिस्रमन्धतामिस्रं तमो मोहो महातमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-019",
    "skandha": 3,
    "chapter": 20,
    "sloka": 19,
    "sanskrit": "विससर्जात्मनः कायं नाभिनन्दंस्तमोमयम् जगृहुर्यक्षरक्षांसि रात्रिं क्षुत्तृट्समुद्भवाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-020",
    "skandha": 3,
    "chapter": 20,
    "sloka": 20,
    "sanskrit": "क्षुत्तृड्भ्यामुपसृष्टास्ते तं जग्धुमभिदुद्रुवुः मा रक्षतैनं जक्षध्वमित्यूचुः क्षुत्तृडर्दिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-021",
    "skandha": 3,
    "chapter": 20,
    "sloka": 21,
    "sanskrit": "देवस्तानाह संविग्नो मा मां जक्षत रक्षत अहो मे यक्षरक्षांसि प्रजा यूयं बभूविथ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-022",
    "skandha": 3,
    "chapter": 20,
    "sloka": 22,
    "sanskrit": "देवताः प्रभया या या दीव्यन्प्रमुखतोऽसृजत् ते अहार्षुर्देवयन्तो विसृष्टां तां प्रभामहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-023",
    "skandha": 3,
    "chapter": 20,
    "sloka": 23,
    "sanskrit": "देवोऽदेवाञ्जघनतः सृजति स्मातिलोलुपान् त एनं लोलुपतया मैथुनायाभिपेदिरे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-024",
    "skandha": 3,
    "chapter": 20,
    "sloka": 24,
    "sanskrit": "ततो हसन्स भगवानसुरैर्निरपत्रपैः अन्वीयमानस्तरसा क्रुद्धो भीतः परापतत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-025",
    "skandha": 3,
    "chapter": 20,
    "sloka": 25,
    "sanskrit": "स उपव्रज्य वरदं प्रपन्नार्तिहरं हरिम् अनुग्रहाय भक्तानामनुरूपात्मदर्शनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-026",
    "skandha": 3,
    "chapter": 20,
    "sloka": 26,
    "sanskrit": "पाहि मां परमात्मंस्ते प्रेषणेनासृजं प्रजाः ता इमा यभितुं पापा उपाक्रामन्ति मां प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-027",
    "skandha": 3,
    "chapter": 20,
    "sloka": 27,
    "sanskrit": "त्वमेकः किल लोकानां क्लिष्टानां क्लेशनाशनः त्वमेकः क्लेशदस्तेषामनासन्नपदां तव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-028",
    "skandha": 3,
    "chapter": 20,
    "sloka": 28,
    "sanskrit": "सोऽवधार्यास्य कार्पण्यं विविक्ताध्यात्मदर्शनः विमुञ्चात्मतनुं घोरामित्युक्तो विमुमोच ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-029",
    "skandha": 3,
    "chapter": 20,
    "sloka": 29,
    "sanskrit": "तां क्वणच्चरणाम्भोजां मदविह्वललोचनाम् काञ्चीकलापविलसद् दुकूलच्छन्नरोधसम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-030",
    "skandha": 3,
    "chapter": 20,
    "sloka": 30,
    "sanskrit": "अन्योन्यश्लेषयोत्तुङ्ग निरन्तरपयोधराम् सुनासां सुद्विजां स्निग्ध हासलीलावलोकनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-031",
    "skandha": 3,
    "chapter": 20,
    "sloka": 31,
    "sanskrit": "गूहन्तीं व्रीडयात्मानं नीलालकवरूथिनीम् उपलभ्यासुरा धर्म सर्वे सम्मुमुहुः स्त्रियम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-032",
    "skandha": 3,
    "chapter": 20,
    "sloka": 32,
    "sanskrit": "अहो रूपमहो धैर्यमहो अस्या नवं वयः मध्ये कामयमानानामकामेव विसर्पति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-033",
    "skandha": 3,
    "chapter": 20,
    "sloka": 33,
    "sanskrit": "वितर्कयन्तो बहुधा तां सन्ध्यां प्रमदाकृतिम् अभिसम्भाव्य विश्रम्भात्पर्यपृच्छन्कुमेधसः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-034",
    "skandha": 3,
    "chapter": 20,
    "sloka": 34,
    "sanskrit": "कासि कस्यासि रम्भोरु को वार्थस्तेऽत्र भामिनि रूपद्रविणपण्येन दुर्भगान्नो विबाधसे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-035",
    "skandha": 3,
    "chapter": 20,
    "sloka": 35,
    "sanskrit": "या वा काचित्त्वमबले दिष्ट्या सन्दर्शनं तव उत्सुनोषीक्षमाणानां कन्दुकक्रीडया मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-036",
    "skandha": 3,
    "chapter": 20,
    "sloka": 36,
    "sanskrit": "नैकत्र ते जयति शालिनि पादपद्मं घ्नन्त्या मुहुः करतलेन पतत्पतङ्गम् मध्यं विषीदति बृहत्स्तनभारभीतं शान्तेव दृष्टिरमला सुशिखासमूहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-037",
    "skandha": 3,
    "chapter": 20,
    "sloka": 37,
    "sanskrit": "इति सायन्तनीं सन्ध्यामसुराः प्रमदायतीम् प्रलोभयन्तीं जगृहुर्मत्वा मूढधियः स्त्रियम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-038",
    "skandha": 3,
    "chapter": 20,
    "sloka": 38,
    "sanskrit": "प्रहस्य भावगम्भीरं जिघ्रन्त्यात्मानमात्मना कान्त्या ससर्ज भगवान्गन्धर्वाप्सरसां गणान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-039",
    "skandha": 3,
    "chapter": 20,
    "sloka": 39,
    "sanskrit": "विससर्ज तनुं तां वै ज्योत्स्नां कान्तिमतीं प्रियाम् त एव चाददुः प्रीत्या विश्वावसुपुरोगमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-040",
    "skandha": 3,
    "chapter": 20,
    "sloka": 40,
    "sanskrit": "सृष्ट्वा भूतपिशाचांश्च भगवानात्मतन्द्रिणा दिग्वाससो मुक्तकेशान्वीक्ष्य चामीलयद्दृशौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-041",
    "skandha": 3,
    "chapter": 20,
    "sloka": 41,
    "sanskrit": "जगृहुस्तद्विसृष्टां तां जृम्भणाख्यां तनुं प्रभोः निद्रामिन्द्रियविक्लेदो यया भूतेषु दृश्यते येनोच्छिष्टान्धर्षयन्ति तमुन्मादं प्रचक्षते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-042",
    "skandha": 3,
    "chapter": 20,
    "sloka": 42,
    "sanskrit": "ऊर्जस्वन्तं मन्यमान आत्मानं भगवानजः साध्यान्गणान्पितृगणान्परोक्षेणासृजत्प्रभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-043",
    "skandha": 3,
    "chapter": 20,
    "sloka": 43,
    "sanskrit": "त आत्मसर्गं तं कायं पितरः प्रतिपेदिरे साध्येभ्यश्च पितृभ्यश्च कवयो यद्वितन्वते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-044",
    "skandha": 3,
    "chapter": 20,
    "sloka": 44,
    "sanskrit": "सिद्धान्विद्याधरांश्चैव तिरोधानेन सोऽसृजत् तेभ्योऽददात्तमात्मानमन्तर्धानाख्यमद्भुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-20-sloka-045",
    "skandha": 3,
    "chapter": 20,
