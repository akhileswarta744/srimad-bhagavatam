[
  {
    "id": "skandha-03-chapter-24-sloka-001",
    "skandha": 3,
    "chapter": 24,
    "sloka": 1,
    "sanskrit": "निर्वेदवादिनीमेवं मनोर्दुहितरं मुनिः दयालुः शालिनीमाह शुक्लाभिव्याहृतं स्मरन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-03-chapter-24-sloka-002",
    "skandha": 3,
    "chapter": 24,
    "sloka": 2,
    "sanskrit": "मा खिदो राजपुत्रीत्थमात्मानं प्रत्यनिन्दिते भगवांस्तेऽक्षरो गर्भमदूरात्सम्प्रपत्स्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "ऋषिरुवाच ।"
  },
  {
    "id": "skandha-03-chapter-24-sloka-003",
    "skandha": 3,
    "chapter": 24,
    "sloka": 3,
    "sanskrit": "धृतव्रतासि भद्रं ते दमेन नियमेन च तपोद्रविणदानैश्च श्रद्धया चेश्वरं भज",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-004",
    "skandha": 3,
    "chapter": 24,
    "sloka": 4,
    "sanskrit": "स त्वयाराधितः शुक्लो वितन्वन्मामकं यशः छेत्ता ते हृदयग्रन्थिमौदर्यो ब्रह्मभावनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-005",
    "skandha": 3,
    "chapter": 24,
    "sloka": 5,
    "sanskrit": "देवहूत्यपि सन्देशं गौरवेण प्रजापतेः सम्यक्ष्रद्धाय पुरुषं कूटस्थमभजद्गुरुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-03-chapter-24-sloka-006",
    "skandha": 3,
    "chapter": 24,
    "sloka": 6,
    "sanskrit": "तस्यां बहुतिथे काले भगवान्मधुसूदनः कार्दमं वीर्यमापन्नो जज्ञेऽग्निरिव दारुणि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-007",
    "skandha": 3,
    "chapter": 24,
    "sloka": 7,
    "sanskrit": "अवादयंस्तदा व्योम्नि वादित्राणि घनाघनाः गायन्ति तं स्म गन्धर्वा नृत्यन्त्यप्सरसो मुदा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-008",
    "skandha": 3,
    "chapter": 24,
    "sloka": 8,
    "sanskrit": "पेतुः सुमनसो दिव्याः खेचरैरपवर्जिताः प्रसेदुश्च दिशः सर्वा अम्भांसि च मनांसि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-009",
    "skandha": 3,
    "chapter": 24,
    "sloka": 9,
    "sanskrit": "तत्कर्दमाश्रमपदं सरस्वत्या परिश्रितम् स्वयम्भूः साकमृषिभिर्मरीच्यादिभिरभ्ययात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-010",
    "skandha": 3,
    "chapter": 24,
    "sloka": 10,
    "sanskrit": "भगवन्तं परं ब्रह्म सत्त्वेनांशेन शत्रुहन् तत्त्वसङ्ख्यानविज्ञप्त्यै जातं विद्वानजः स्वराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-011",
    "skandha": 3,
    "chapter": 24,
    "sloka": 11,
    "sanskrit": "सभाजयन्विशुद्धेन चेतसा तच्चिकीर्षितम् प्रहृष्यमाणैरसुभिः कर्दमं चेदमभ्यधात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-012",
    "skandha": 3,
    "chapter": 24,
    "sloka": 12,
    "sanskrit": "त्वया मेऽपचितिस्तात कल्पिता निर्व्यलीकतः यन्मे सञ्जगृहे वाक्यं भवान्मानद मानयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "ब्रह्मोवाच ।"
  },
  {
    "id": "skandha-03-chapter-24-sloka-013",
    "skandha": 3,
    "chapter": 24,
    "sloka": 13,
    "sanskrit": "एतावत्येव शुश्रूषा कार्या पितरि पुत्रकैः बाढमित्यनुमन्येत गौरवेण गुरोर्वचः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-014",
    "skandha": 3,
    "chapter": 24,
    "sloka": 14,
    "sanskrit": "इमा दुहितरः सत्यस्तव वत्स सुमध्यमाः सर्गमेतं प्रभावैः स्वैर्बृंहयिष्यन्त्यनेकधा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-015",
    "skandha": 3,
    "chapter": 24,
    "sloka": 15,
    "sanskrit": "अतस्त्वमृषिमुख्येभ्यो यथाशीलं यथारुचि आत्मजाः परिदेह्यद्य विस्तृणीहि यशो भुवि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-016",
    "skandha": 3,
    "chapter": 24,
    "sloka": 16,
    "sanskrit": "वेदाहमाद्यं पुरुषमवतीर्णं स्वमायया भूतानां शेवधिं देहं बिभ्राणं कपिलं मुने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-017",
    "skandha": 3,
    "chapter": 24,
    "sloka": 17,
    "sanskrit": "ज्ञानविज्ञानयोगेन कर्मणामुद्धरञ्जटाः हिरण्यकेशः पद्माक्षः पद्ममुद्रापदाम्बुजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-018",
    "skandha": 3,
    "chapter": 24,
    "sloka": 18,
    "sanskrit": "एष मानवि ते गर्भं प्रविष्टः कैटभार्दनः अविद्यासंशयग्रन्थिं छित्त्वा गां विचरिष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-019",
    "skandha": 3,
    "chapter": 24,
    "sloka": 19,
    "sanskrit": "अयं सिद्धगणाधीशः साङ्ख्याचार्यैः सुसम्मतः लोके कपिल इत्याख्यां गन्ता ते कीर्तिवर्धनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-020",
    "skandha": 3,
    "chapter": 24,
    "sloka": 20,
    "sanskrit": "तावाश्वास्य जगत्स्रष्टा कुमारैः सहनारदः हंसो हंसेन यानेन त्रिधामपरमं ययौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-03-chapter-24-sloka-021",
    "skandha": 3,
    "chapter": 24,
    "sloka": 21,
    "sanskrit": "गते शतधृतौ क्षत्तः कर्दमस्तेन चोदितः यथोदितं स्वदुहित्ः प्रादाद्विश्वसृजां ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-022",
    "skandha": 3,
    "chapter": 24,
    "sloka": 22,
    "sanskrit": "मरीचये कलां प्रादादनसूयामथात्रये श्रद्धामङ्गिरसेऽयच्छत्पुलस्त्याय हविर्भुवम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-023",
    "skandha": 3,
    "chapter": 24,
    "sloka": 23,
    "sanskrit": "पुलहाय गतिं युक्तां क्रतवे च क्रियां सतीम् ख्यातिं च भृगवेऽयच्छद्वसिष्ठायाप्यरुन्धतीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-024",
    "skandha": 3,
    "chapter": 24,
    "sloka": 24,
    "sanskrit": "अथर्वणेऽददाच्छान्तिं यया यज्ञो वितन्यते विप्रर्षभान्कृतोद्वाहान्सदारान्समलालयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-025",
    "skandha": 3,
    "chapter": 24,
    "sloka": 25,
    "sanskrit": "ततस्त ऋषयः क्षत्तः कृतदारा निमन्त्र्य तम् प्रातिष्ठन्नन्दिमापन्नाः स्वं स्वमाश्रममण्डलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-026",
    "skandha": 3,
    "chapter": 24,
    "sloka": 26,
    "sanskrit": "स चावतीर्णं त्रियुगमाज्ञाय विबुधर्षभम् विविक्त उपसङ्गम्य प्रणम्य समभाषत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-027",
    "skandha": 3,
    "chapter": 24,
    "sloka": 27,
    "sanskrit": "अहो पापच्यमानानां निरये स्वैरमङ्गलैः कालेन भूयसा नूनं प्रसीदन्तीह देवताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-028",
    "skandha": 3,
    "chapter": 24,
    "sloka": 28,
    "sanskrit": "बहुजन्मविपक्वेन सम्यग्योगसमाधिना द्रष्टुं यतन्ते यतयः शून्यागारेषु यत्पदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-029",
    "skandha": 3,
    "chapter": 24,
    "sloka": 29,
    "sanskrit": "स एव भगवानद्य हेलनं न गणय्य नः गृहेषु जातो ग्राम्याणां यः स्वानां पक्षपोषणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-030",
    "skandha": 3,
    "chapter": 24,
    "sloka": 30,
    "sanskrit": "स्वीयं वाक्यमृतं कर्तुमवतीर्णोऽसि मे गृहे चिकीर्षुर्भगवान्ज्ञानं भक्तानां मानवर्धनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-031",
    "skandha": 3,
    "chapter": 24,
    "sloka": 31,
    "sanskrit": "तान्येव तेऽभिरूपाणि रूपाणि भगवंस्तव यानि यानि च रोचन्ते स्वजनानामरूपिणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-032",
    "skandha": 3,
    "chapter": 24,
    "sloka": 32,
    "sanskrit": "त्वां सूरिभिस्तत्त्वबुभुत्सयाद्धा सदाभिवादार्हणपादपीठम् ऐश्वर्यवैराग्ययशोऽवबोध वीर्यश्रिया पूर्तमहं प्रपद्ये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-033",
    "skandha": 3,
    "chapter": 24,
    "sloka": 33,
    "sanskrit": "परं प्रधानं पुरुषं महान्तं कालं कविं त्रिवृतं लोकपालम् आत्मानुभूत्यानुगतप्रपञ्चं स्वच्छन्दशक्तिं कपिलं प्रपद्ये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-034",
    "skandha": 3,
    "chapter": 24,
    "sloka": 34,
    "sanskrit": "अ स्माभिपृच्छेऽद्य पतिं प्रजानां त्वयावतीर्णर्ण उताप्तकामः परिव्रजत्पदवीमास्थितोऽहं चरिष्ये त्वां हृदि युञ्जन्विशोकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-035",
    "skandha": 3,
    "chapter": 24,
    "sloka": 35,
    "sanskrit": "मया प्रोक्तं हि लोकस्य प्रमाणं सत्यलौकिके अथाजनि मया तुभ्यं यदवोचमृतं मुने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-03-chapter-24-sloka-036",
    "skandha": 3,
    "chapter": 24,
    "sloka": 36,
    "sanskrit": "एतन्मे जन्म लोकेऽस्मिन्मुमुक्षूणां दुराशयात् प्रसङ्ख्यानाय तत्त्वानां सम्मतायात्मदर्शने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-037",
    "skandha": 3,
    "chapter": 24,
    "sloka": 37,
    "sanskrit": "एष आत्मपथोऽव्यक्तो नष्टः कालेन भूयसा तं प्रवर्तयितुं देहमिमं विद्धि मया भृतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-038",
    "skandha": 3,
    "chapter": 24,
    "sloka": 38,
    "sanskrit": "गच्छ कामं मयापृष्टो मयि सन्न्यस्तकर्मणा जित्वा सुदुर्जयं मृत्युममृतत्वाय मां भज",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-039",
    "skandha": 3,
    "chapter": 24,
    "sloka": 39,
    "sanskrit": "मामात्मानं स्वयंज्योतिः सर्वभूतगुहाशयम् आत्मन्येवात्मना वीक्ष्य विशोकोऽभयमृच्छसि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-040",
    "skandha": 3,
    "chapter": 24,
    "sloka": 40,
    "sanskrit": "मात्र आध्यात्मिकीं विद्यां शमनीं सर्वकर्मणाम् वितरिष्ये यया चासौ भयं चातितरिष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-041",
    "skandha": 3,
    "chapter": 24,
    "sloka": 41,
    "sanskrit": "एवं समुदितस्तेन कपिलेन प्रजापतिः दक्षिणीकृत्य तं प्रीतो वनमेव जगाम ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-03-chapter-24-sloka-042",
    "skandha": 3,
    "chapter": 24,
    "sloka": 42,
    "sanskrit": "व्रतं स आस्थितो मौनमात्मैकशरणो मुनिः निःसङ्गो व्यचरत्क्षोणीमनग्निरनिकेतनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-043",
    "skandha": 3,
    "chapter": 24,
    "sloka": 43,
    "sanskrit": "मनो ब्रह्मणि युञ्जानो यत्तत्सदसतः परम् गुणावभासे विगुण एकभक्त्यानुभाविते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-044",
    "skandha": 3,
    "chapter": 24,
    "sloka": 44,
    "sanskrit": "निरहङ्कृतिर्निर्ममश्च निर्द्वन्द्वः समदृक्स्वदृक् प्रत्यक्प्रशान्तधीर्धीरः प्रशान्तोर्मिरिवोदधिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-24-sloka-045",
