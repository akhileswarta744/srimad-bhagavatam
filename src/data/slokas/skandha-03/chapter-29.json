[
  {
    "id": "skandha-03-chapter-29-sloka-001",
    "skandha": 3,
    "chapter": 29,
    "sloka": 1,
    "sanskrit": "लक्षणं महदादीनां प्रकृतेः पुरुषस्य च स्वरूपं लक्ष्यतेऽमीषां येन तत्पारमार्थिकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "देवहूतिरुवाच ।"
  },
  {
    "id": "skandha-03-chapter-29-sloka-002",
    "skandha": 3,
    "chapter": 29,
    "sloka": 2,
    "sanskrit": "यथा साङ्ख्येषु कथितं यन्मूलं तत्प्रचक्षते भक्तियोगस्य मे मार्गं ब्रूहि विस्तरशः प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-003",
    "skandha": 3,
    "chapter": 29,
    "sloka": 3,
    "sanskrit": "विरागो येन पुरुषो भगवन्सर्वतो भवेत् आचक्ष्व जीवलोकस्य विविधा मम संसृतीः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-004",
    "skandha": 3,
    "chapter": 29,
    "sloka": 4,
    "sanskrit": "कालस्येश्वररूपस्य परेषां च परस्य ते स्वरूपं बत कुर्वन्ति यद्धेतोः कुशलं जनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-005",
    "skandha": 3,
    "chapter": 29,
    "sloka": 5,
    "sanskrit": "लोकस्य मिथ्याभिमतेरचक्षुषश्चिरं प्रसुप्तस्य तमस्यनाश्रये श्रान्तस्य कर्मस्वनुविद्धया धिया त्वमाविरासीः किल योगभास्करः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-006",
    "skandha": 3,
    "chapter": 29,
    "sloka": 6,
    "sanskrit": "इति मातुर्वचः श्लक्ष्णं प्रतिनन्द्य महामुनिः आबभाषे कुरुश्रेष्ठ प्रीतस्तां करुणार्दितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-03-chapter-29-sloka-007",
    "skandha": 3,
    "chapter": 29,
    "sloka": 7,
    "sanskrit": "भक्तियोगो बहुविधो मार्गैर्भामिनि भाव्यते स्वभावगुणमार्गेण पुंसां भावो विभिद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-03-chapter-29-sloka-008",
    "skandha": 3,
    "chapter": 29,
    "sloka": 8,
    "sanskrit": "अभिसन्धाय यो हिंसां दम्भं मात्सर्यमेव वा संरम्भी भिन्नदृग्भावं मयि कुर्यात्स तामसः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-009",
    "skandha": 3,
    "chapter": 29,
    "sloka": 9,
    "sanskrit": "विषयानभिसन्धाय यश ऐश्वर्यमेव वा अर्चादावर्चयेद्यो मां पृथग्भावः स राजसः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-010",
    "skandha": 3,
    "chapter": 29,
    "sloka": 10,
    "sanskrit": "कर्मनिर्हारमुद्दिश्य परस्मिन्वा तदर्पणम् यजेद्यष्टव्यमिति वा पृथग्भावः स सात्त्विकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-011",
    "skandha": 3,
    "chapter": 29,
    "sloka": 11,
    "sanskrit": "मद्गुणश्रुतिमात्रेण मयि सर्वगुहाशये मनोगतिरविच्छिन्ना यथा गङ्गाम्भसोऽम्बुधौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-012",
    "skandha": 3,
    "chapter": 29,
    "sloka": 12,
    "sanskrit": "लक्षणं भक्तियोगस्य निर्गुणस्य ह्युदाहृतम् अहैतुक्यव्यवहिता या भक्तिः पुरुषोत्तमे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-013",
    "skandha": 3,
    "chapter": 29,
    "sloka": 13,
    "sanskrit": "सालोक्यसार्ष्टिसामीप्य सारूप्यैकत्वमप्युत दीयमानं न गृह्णन्ति विना मत्सेवनं जनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-014",
    "skandha": 3,
    "chapter": 29,
    "sloka": 14,
    "sanskrit": "स एव भक्तियोगाख्य आत्यन्तिक उदाहृतः येनातिव्रज्य त्रिगुणं मद्भावायोपपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-015",
    "skandha": 3,
    "chapter": 29,
    "sloka": 15,
    "sanskrit": "निषेवितेनानिमित्तेन स्वधर्मेण महीयसा क्रियायोगेन शस्तेन नातिहिंस्रेण नित्यशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-016",
    "skandha": 3,
    "chapter": 29,
    "sloka": 16,
    "sanskrit": "मद्धिष्ण्यदर्शनस्पर्श पूजास्तुत्यभिवन्दनैः भूतेषु मद्भावनया सत्त्वेनासङ्गमेन च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-017",
    "skandha": 3,
    "chapter": 29,
    "sloka": 17,
    "sanskrit": "महतां बहुमानेन दीनानामनुकम्पया मैत्र्या चैवात्मतुल्येषु यमेन नियमेन च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-018",
    "skandha": 3,
    "chapter": 29,
    "sloka": 18,
    "sanskrit": "आध्यात्मिकानुश्रवणान्नामसङ्कीर्तनाच्च मे आर्जवेनार्यसङ्गेन निरहङ्क्रियया तथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-019",
    "skandha": 3,
    "chapter": 29,
    "sloka": 19,
    "sanskrit": "मद्धर्मणो गुणैरेतैः परिसंशुद्ध आशयः पुरुषस्याञ्जसाभ्येति श्रुतमात्रगुणं हि माम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-020",
    "skandha": 3,
    "chapter": 29,
    "sloka": 20,
    "sanskrit": "यथा वातरथो घ्राणमावृङ्क्ते गन्ध आशयात् एवं योगरतं चेत आत्मानमविकारि यत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-021",
    "skandha": 3,
    "chapter": 29,
    "sloka": 21,
    "sanskrit": "अहं सर्वेषु भूतेषु भूतात्मावस्थितः सदा तमवज्ञाय मां मर्त्यः कुरुतेऽर्चाविडम्बनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-022",
    "skandha": 3,
    "chapter": 29,
    "sloka": 22,
    "sanskrit": "यो मां सर्वेषु भूतेषु सन्तमात्मानमीश्वरम् हित्वार्चां भजते मौढ्याद्भस्मन्येव जुहोति सः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-023",
    "skandha": 3,
    "chapter": 29,
    "sloka": 23,
    "sanskrit": "द्विषतः परकाये मां मानिनो भिन्नदर्शिनः भूतेषु बद्धवैरस्य न मनः शान्तिमृच्छति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-024",
    "skandha": 3,
    "chapter": 29,
    "sloka": 24,
    "sanskrit": "अहमुच्चावचैर्द्रव्यैः क्रिययोत्पन्नयानघे नैव तुष्येऽर्चितोऽर्चायां भूतग्रामावमानिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-025",
    "skandha": 3,
    "chapter": 29,
    "sloka": 25,
    "sanskrit": "अर्चादावर्चयेत्तावदीश्वरं मां स्वकर्मकृत् यावन्न वेद स्वहृदि सर्वभूतेष्ववस्थितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-026",
    "skandha": 3,
    "chapter": 29,
    "sloka": 26,
    "sanskrit": "आत्मनश्च परस्यापि यः करोत्यन्तरोदरम् तस्य भिन्नदृशो मृत्युर्विदधे भयमुल्बणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-027",
    "skandha": 3,
    "chapter": 29,
    "sloka": 27,
    "sanskrit": "अथ मां सर्वभूतेषु भूतात्मानं कृतालयम् अर्हयेद्दानमानाभ्यां मैत्र्याभिन्नेन चक्षुषा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-028",
    "skandha": 3,
    "chapter": 29,
    "sloka": 28,
    "sanskrit": "जीवाः श्रेष्ठा ह्यजीवानां ततः प्राणभृतः शुभे ततः सचित्ताः प्रवरास्ततश्चेन्द्रियवृत्तयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-029",
    "skandha": 3,
    "chapter": 29,
    "sloka": 29,
    "sanskrit": "तत्रापि स्पर्शवेदिभ्यः प्रवरा रसवेदिनः तेभ्यो गन्धविदः श्रेष्ठास्ततः शब्दविदो वराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-030",
    "skandha": 3,
    "chapter": 29,
    "sloka": 30,
    "sanskrit": "रूपभेदविदस्तत्र ततश्चोभयतोदतः तेषां बहुपदाः श्रेष्ठाश्चतुष्पादस्ततो द्विपात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-031",
    "skandha": 3,
    "chapter": 29,
    "sloka": 31,
    "sanskrit": "ततो वर्णाश्च चत्वारस्तेषां ब्राह्मण उत्तमः ब्राह्मणेष्वपि वेदज्ञो ह्यर्थज्ञोऽभ्यधिकस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-032",
    "skandha": 3,
    "chapter": 29,
    "sloka": 32,
    "sanskrit": "अर्थज्ञात्संशयच्छेत्ता ततः श्रेयान्स्वकर्मकृत् मुक्तसङ्गस्ततो भूयानदोग्धा धर्ममात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-033",
    "skandha": 3,
    "chapter": 29,
    "sloka": 33,
    "sanskrit": "तस्मान्मय्यर्पिताशेष क्रियार्थात्मा निरन्तरः मय्यर्पितात्मनः पुंसो मयि सन्न्यस्तकर्मणः न पश्यामि परं भूतमकर्तुः समदर्शनात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-034",
    "skandha": 3,
    "chapter": 29,
    "sloka": 34,
    "sanskrit": "मनसैतानि भूतानि प्रणमेद्बहुमानयन् ईश्वरो जीवकलया प्रविष्टो भगवानिति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-035",
    "skandha": 3,
    "chapter": 29,
    "sloka": 35,
    "sanskrit": "भक्तियोगश्च योगश्च मया मानव्युदीरितः ययोरेकतरेणैव पुरुषः पुरुषं व्रजेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-036",
    "skandha": 3,
    "chapter": 29,
    "sloka": 36,
    "sanskrit": "एतद्भगवतो रूपं ब्रह्मणः परमात्मनः परं प्रधानं पुरुषं दैवं कर्मविचेष्टितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-037",
    "skandha": 3,
    "chapter": 29,
    "sloka": 37,
    "sanskrit": "रूपभेदास्पदं दिव्यं काल इत्यभिधीयते भूतानां महदादीनां यतो भिन्नदृशां भयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-038",
    "skandha": 3,
    "chapter": 29,
    "sloka": 38,
    "sanskrit": "योऽन्तः प्रविश्य भूतानि भूतैरत्त्यखिलाश्रयः स विष्ण्वाख्योऽधियज्ञोऽसौ कालः कलयतां प्रभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-039",
    "skandha": 3,
    "chapter": 29,
    "sloka": 39,
    "sanskrit": "न चास्य कश्चिद्दयितो न द्वेष्यो न च बान्धवः आविशत्यप्रमत्तोऽसौ प्रमत्तं जनमन्तकृत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-040",
    "skandha": 3,
    "chapter": 29,
    "sloka": 40,
    "sanskrit": "यद्भयाद्वाति वातोऽयं सूर्यस्तपति यद्भयात् यद्भयाद्वर्षते देवो भगणो भाति यद्भयात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-041",
    "skandha": 3,
    "chapter": 29,
    "sloka": 41,
    "sanskrit": "यद्वनस्पतयो भीता लताश्चौषधिभिः सह स्वे स्वे कालेऽभिगृह्णन्ति पुष्पाणि च फलानि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-042",
    "skandha": 3,
    "chapter": 29,
    "sloka": 42,
    "sanskrit": "स्रवन्ति सरितो भीता नोत्सर्पत्युदधिर्यतः अग्निरिन्धे सगिरिभिर्भूर्न मज्जति यद्भयात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-043",
    "skandha": 3,
    "chapter": 29,
    "sloka": 43,
    "sanskrit": "नभो ददाति श्वसतां पदं यन्नियमाददः लोकं स्वदेहं तनुते महान्सप्तभिरावृतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-044",
    "skandha": 3,
    "chapter": 29,
    "sloka": 44,
    "sanskrit": "गुणाभिमानिनो देवाः सर्गादिष्वस्य यद्भयात् वर्तन्तेऽनुयुगं येषां वश एतच्चराचरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-29-sloka-045",
    "skandha": 3,
    "chapter": 29,
