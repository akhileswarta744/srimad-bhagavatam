[
  {
    "id": "skandha-03-chapter-13-sloka-001",
    "skandha": 3,
    "chapter": 13,
    "sloka": 1,
    "malayalamMeaning": "ശുകദേവൻ പറഞ്ഞു: 'വിദുരന്റെ ചോദ്യം കേട്ട് സന്തുഷ്ടനായ മൈത്രേയ മഹർഷി വരാഹമൂർത്തിയുടെ പുണ്യകഥ വിവരിച്ചുതുടങ്ങി.'",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "ശ്രീശുകൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-03-chapter-13-sloka-002",
    "skandha": 3,
    "chapter": 13,
    "sloka": 2,
    "malayalamMeaning": "ബ്രഹ്മാവ് സൃഷ്ടികർമ്മം ആരംഭിച്ചപ്പോൾ പ്രളയജലത്തിൽ മുങ്ങിപ്പോയ ഭൂമിയെ എങ്ങനെ ഉദ്ധരിക്കണമെന്ന് ആലോചിച്ച് ഭഗവാനെ ധ്യാനിച്ചു.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "വിദുരർ പറഞ്ഞു"
  },
  {
    "id": "skandha-03-chapter-13-sloka-003",
    "skandha": 3,
    "chapter": 13,
    "sloka": 3,
    "malayalamMeaning": "ബ്രഹ്മാവിന്റെ നാസികാരന്ധ്രത്തിൽ നിന്ന് വിരലോളം മാത്രം വലിപ്പമുള്ള ഒരു ചെറിയ വരാഹശിശു പുറത്തുവരികയും, നിമിഷനേരം കൊണ്ട് അത് പർവ്വതസമാനമായ മഹാശരീരമായി വളരുകയും ചെയ്തു.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-13-sloka-004",
    "skandha": 3,
    "chapter": 13,
    "sloka": 4,
    "malayalamMeaning": "യജ്ഞവരാഹമൂർത്തിയായ ആ ഭഗവാൻ അത്യുഗ്രമായി ഘോരഗർജ്ജനം ചെയ്ത് പ്രളയജലത്തിലേക്ക് എടുത്തുചാടി, രസാതലത്തിൽ താണുപോയ ഭൂമീദേവിയെ തന്റെ കൂർത്ത ദംഷ്ട്രാഗ്രത്തിൽ കോരിയെടുത്ത് ഉയർത്തിക്കൊണ്ടുവന്നു.",
    "source": "Sanskrit Documents / Gitapress"
  },
