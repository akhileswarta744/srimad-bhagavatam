[
  {
    "id": "skandha-03-chapter-06-sloka-001",
    "skandha": 3,
    "chapter": 6,
    "sloka": 1,
    "sanskrit": "इति तासां स्वशक्तीनां सतीनामसमेत्य सः प्रसुप्तलोकतन्त्राणां निशाम्य गतिमीश्वरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "ऋषिरुवाच ।"
  },
  {
    "id": "skandha-03-chapter-06-sloka-002",
    "skandha": 3,
    "chapter": 6,
    "sloka": 2,
    "sanskrit": "कालसञ्ज्ञां तदा देवीं बिभ्रच्छक्तिमुरुक्रमः त्रयोविंशति तत्त्वानां गणं युगपदाविशत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-003",
    "skandha": 3,
    "chapter": 6,
    "sloka": 3,
    "sanskrit": "सोऽनुप्रविष्टो भगवांश्चेष्टारूपेण तं गणम् भिन्नं संयोजयामास सुप्तं कर्म प्रबोधयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-004",
    "skandha": 3,
    "chapter": 6,
    "sloka": 4,
    "sanskrit": "प्रबुद्धकर्म दैवेन त्रयोविंशतिको गणः प्रेरितोऽजनयत्स्वाभिर्मात्राभिरधिपूरुषम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-005",
    "skandha": 3,
    "chapter": 6,
    "sloka": 5,
    "sanskrit": "परेण विशता स्वस्मिन्मात्रया विश्वसृग्गणः चुक्षोभान्योन्यमासाद्य यस्मिन्लोकाश्चराचराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-006",
    "skandha": 3,
    "chapter": 6,
    "sloka": 6,
    "sanskrit": "हिरण्मयः स पुरुषः सहस्रपरिवत्सरान् आण्डकोश उवासाप्सु सर्वसत्त्वोपबृंहितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-007",
    "skandha": 3,
    "chapter": 6,
    "sloka": 7,
    "sanskrit": "स वै विश्वसृजां गर्भो देवकर्मात्मशक्तिमान् विबभाजात्मनात्मानमेकधा दशधा त्रिधा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-008",
    "skandha": 3,
    "chapter": 6,
    "sloka": 8,
    "sanskrit": "एष ह्यशेषसत्त्वानामात्मांशः परमात्मनः आद्योऽवतारो यत्रासौ भूतग्रामो विभाव्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-009",
    "skandha": 3,
    "chapter": 6,
    "sloka": 9,
    "sanskrit": "साध्यात्मः साधिदैवश्च साधिभूत इति त्रिधा विराट्प्राणो दशविध एकधा हृदयेन च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-010",
    "skandha": 3,
    "chapter": 6,
    "sloka": 10,
    "sanskrit": "स्मरन्विश्वसृजामीशो विज्ञापितमधोक्षजः विराजमतपत्स्वेन तेजसैषां विवृत्तये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-011",
    "skandha": 3,
    "chapter": 6,
    "sloka": 11,
    "sanskrit": "अथ तस्याभितप्तस्य कतिधायतनानि ह निरभिद्यन्त देवानां तानि मे गदतः शृणु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-012",
    "skandha": 3,
    "chapter": 6,
    "sloka": 12,
    "sanskrit": "तस्याग्निरास्यं निर्भिन्नं लोकपालोऽविशत्पदम् वाचा स्वांशेन वक्तव्यं ययासौ प्रतिपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-013",
    "skandha": 3,
    "chapter": 6,
    "sloka": 13,
    "sanskrit": "निर्भिन्नं तालु वरुणो लोकपालोऽविशद्धरेः जिह्वयांशेन च रसं ययासौ प्रतिपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-014",
    "skandha": 3,
    "chapter": 6,
    "sloka": 14,
    "sanskrit": "निर्भिन्ने अश्विनौ नासे विष्णोराविशतां पदम् घ्राणेनांशेन गन्धस्य प्रतिपत्तिर्यतो भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-015",
    "skandha": 3,
    "chapter": 6,
    "sloka": 15,
    "sanskrit": "निर्भिन्ने अक्षिणी त्वष्टा लोकपालोऽविशद्विभोः चक्षुषांशेन रूपाणां प्रतिपत्तिर्यतो भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-016",
    "skandha": 3,
    "chapter": 6,
    "sloka": 16,
    "sanskrit": "निर्भिन्नान्यस्य चर्माणि लोकपालोऽनिलोऽविशत् प्राणेनांशेन संस्पर्शं येनासौ प्रतिपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-017",
    "skandha": 3,
    "chapter": 6,
    "sloka": 17,
    "sanskrit": "कर्णावस्य विनिर्भिन्नौ धिष्ण्यं स्वं विविशुर्दिशः श्रोत्रेणांशेन शब्दस्य सिद्धिं येन प्रपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-018",
    "skandha": 3,
    "chapter": 6,
    "sloka": 18,
    "sanskrit": "त्वचमस्य विनिर्भिन्नां विविशुर्धिष्ण्यमोषधीः अंशेन रोमभिः कण्डूं यैरसौ प्रतिपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-019",
    "skandha": 3,
    "chapter": 6,
    "sloka": 19,
    "sanskrit": "मेढ्रं तस्य विनिर्भिन्नं स्वधिष्ण्यं क उपाविशत् रेतसांशेन येनासावानन्दं प्रतिपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-020",
    "skandha": 3,
    "chapter": 6,
    "sloka": 20,
    "sanskrit": "गुदं पुंसो विनिर्भिन्नं मित्रो लोकेश आविशत् पायुनांशेन येनासौ विसर्गं प्रतिपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-021",
    "skandha": 3,
    "chapter": 6,
    "sloka": 21,
    "sanskrit": "हस्तावस्य विनिर्भिन्नाविन्द्रः स्वर्पतिराविशत् वार्तयांशेन पुरुषो यया वृत्तिं प्रपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-022",
    "skandha": 3,
    "chapter": 6,
    "sloka": 22,
    "sanskrit": "पादावस्य विनिर्भिन्नौ लोकेशो विष्णुराविशत् गत्या स्वांशेन पुरुषो यया प्राप्यं प्रपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-023",
    "skandha": 3,
    "chapter": 6,
    "sloka": 23,
    "sanskrit": "बुद्धिं चास्य विनिर्भिन्नां वागीशो धिष्ण्यमाविशत् बोधेनांशेन बोद्धव्यम्प्रतिपत्तिर्यतो भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-024",
    "skandha": 3,
    "chapter": 6,
    "sloka": 24,
    "sanskrit": "हृदयं चास्य निर्भिन्नं चन्द्रमा धिष्ण्यमाविशत् मनसांशेन येनासौ विक्रियां प्रतिपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-025",
    "skandha": 3,
    "chapter": 6,
    "sloka": 25,
    "sanskrit": "आत्मानं चास्य निर्भिन्नमभिमानोऽविशत्पदम् कर्मणांशेन येनासौ कर्तव्यं प्रतिपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-026",
    "skandha": 3,
    "chapter": 6,
    "sloka": 26,
    "sanskrit": "सत्त्वं चास्य विनिर्भिन्नं महान्धिष्ण्यमुपाविशत् चित्तेनांशेन येनासौ विज्ञानं प्रतिपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-027",
    "skandha": 3,
    "chapter": 6,
    "sloka": 27,
    "sanskrit": "शीर्ष्णोऽस्य द्यौर्धरा पद्भ्यां खं नाभेरुदपद्यत गुणानां वृत्तयो येषु प्रतीयन्ते सुरादयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-028",
    "skandha": 3,
    "chapter": 6,
    "sloka": 28,
    "sanskrit": "आत्यन्तिकेन सत्त्वेन दिवं देवाः प्रपेदिरे धरां रजःस्वभावेन पणयो ये च ताननु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-029",
    "skandha": 3,
    "chapter": 6,
    "sloka": 29,
    "sanskrit": "तार्तीयेन स्वभावेन भगवन्नाभिमाश्रिताः उभयोरन्तरं व्योम ये रुद्रपार्षदां गणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-030",
    "skandha": 3,
    "chapter": 6,
    "sloka": 30,
    "sanskrit": "मुखतोऽवर्तत ब्रह्म पुरुषस्य कुरूद्वह यस्तून्मुखत्वाद्वर्णानां मुख्योऽभूद्ब्राह्मणो गुरुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-031",
    "skandha": 3,
    "chapter": 6,
    "sloka": 31,
    "sanskrit": "बाहुभ्योऽवर्तत क्षत्रं क्षत्रियस्तदनुव्रतः यो जातस्त्रायते वर्णान्पौरुषः कण्टकक्षतात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-032",
    "skandha": 3,
    "chapter": 6,
    "sloka": 32,
    "sanskrit": "विशोऽवर्तन्त तस्योर्वोर्लोकवृत्तिकरीर्विभोः वैश्यस्तदुद्भवो वार्तां नृणां यः समवर्तयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-033",
    "skandha": 3,
    "chapter": 6,
    "sloka": 33,
    "sanskrit": "पद्भ्यां भगवतो जज्ञे शुश्रूषा धर्मसिद्धये तस्यां जातः पुरा शूद्रो यद्वृत्त्या तुष्यते हरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-034",
    "skandha": 3,
    "chapter": 6,
    "sloka": 34,
    "sanskrit": "एते वर्णाः स्वधर्मेण यजन्ति स्वगुरुं हरिम् श्रद्धयात्मविशुद्ध्यर्थं यज्जाताः सह वृत्तिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-035",
    "skandha": 3,
    "chapter": 6,
    "sloka": 35,
    "sanskrit": "एतत्क्षत्तर्भगवतो दैवकर्मात्मरूपिणः कः श्रद्दध्यादुपाकर्तुं योगमायाबलोदयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-036",
    "skandha": 3,
    "chapter": 6,
    "sloka": 36,
    "sanskrit": "तथापि कीर्तयाम्यङ्ग यथामति यथाश्रुतम् कीर्तिं हरेः स्वां सत्कर्तुं गिरमन्याभिधासतीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-037",
    "skandha": 3,
    "chapter": 6,
    "sloka": 37,
    "sanskrit": "एकान्तलाभं वचसो नु पुंसां सुश्लोकमौलेर्गुणवादमाहुः श्रुतेश्च विद्वद्भिरुपाकृतायां कथासुधायामुपसम्प्रयोगम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-038",
    "skandha": 3,
    "chapter": 6,
    "sloka": 38,
    "sanskrit": "आत्मनोऽवसितो वत्स महिमा कविनादिना संवत्सरसहस्रान्ते धिया योगविपक्कया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-039",
    "skandha": 3,
    "chapter": 6,
    "sloka": 39,
    "sanskrit": "अतो भगवतो माया मायिनामपि मोहिनी यत्स्वयं चात्मवर्त्मात्मा न वेद किमुतापरे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-03-chapter-06-sloka-040",
    "skandha": 3,
    "chapter": 6,
    "sloka": 40,
    "sanskrit": "यतोऽप्राप्य न्यवर्तन्त वाचश्च मनसा सह अहं चान्य इमे देवास्तस्मै भगवते नमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]