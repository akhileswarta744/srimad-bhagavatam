[
  {
    "id": "skandha-09-chapter-13-sloka-001",
    "skandha": 9,
    "chapter": 13,
    "sloka": 1,
    "sanskrit": "निमिरिक्ष्वाकुतनयो वसिष्ठमवृतर्त्विजम् आरभ्य सत्रं सोऽप्याह शक्रेण प्राग्वृतोऽस्मि भोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-13-sloka-002",
    "skandha": 9,
    "chapter": 13,
    "sloka": 2,
    "sanskrit": "तं निर्वर्त्यागमिष्यामि तावन्मां प्रतिपालय तूष्णीमासीद्गृहपतिः सोऽपीन्द्रस्याकरोन्मखम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-003",
    "skandha": 9,
    "chapter": 13,
    "sloka": 3,
    "sanskrit": "निमित्तश्चलमिदं विद्वान्सत्रमारभतामात्मवान् ऋत्विग्भिरपरैस्तावन्नागमद्यावता गुरुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-004",
    "skandha": 9,
    "chapter": 13,
    "sloka": 4,
    "sanskrit": "शिष्यव्यतिक्रमं वीक्ष्य तं निर्वर्त्यागतो गुरुः अशपत्पतताद्देहो निमेः पण्डितमानिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-005",
    "skandha": 9,
    "chapter": 13,
    "sloka": 5,
    "sanskrit": "निमिः प्रतिददौ शापं गुरवेऽधर्मवर्तिने तवापि पतताद्देहो लोभाद्धर्ममजानतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-006",
    "skandha": 9,
    "chapter": 13,
    "sloka": 6,
    "sanskrit": "इत्युत्ससर्ज स्वं देहं निमिरध्यात्मकोविदः मित्रावरुणयोर्जज्ञे उर्वश्यां प्रपितामहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-007",
    "skandha": 9,
    "chapter": 13,
    "sloka": 7,
    "sanskrit": "गन्धवस्तुषु तद्देहं निधाय मुनिसत्तमाः समाप्ते सत्रयागे च देवानूचुः समागतान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-008",
    "skandha": 9,
    "chapter": 13,
    "sloka": 8,
    "sanskrit": "राज्ञो जीवतु देहोऽयं प्रसन्नाः प्रभवो यदि तथेत्युक्ते निमिः प्राह मा भून्मे देहबन्धनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-009",
    "skandha": 9,
    "chapter": 13,
    "sloka": 9,
    "sanskrit": "यस्य योगं न वाञ्छन्ति वियोगभयकातराः भजन्ति चरणाम्भोजं मुनयो हरिमेधसः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-010",
    "skandha": 9,
    "chapter": 13,
    "sloka": 10,
    "sanskrit": "देहं नावरुरुत्सेऽहं दुःखशोकभयावहम् सर्वत्रास्य यतो मृत्युर्मत्स्यानामुदके यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-011",
    "skandha": 9,
    "chapter": 13,
    "sloka": 11,
    "sanskrit": "विदेह उष्यतां कामं लोचनेषु शरीरिणाम् उन्मेषणनिमेषाभ्यां लक्षितोऽध्यात्मसंस्थितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "देवा ऊचुः ।"
  },
  {
    "id": "skandha-09-chapter-13-sloka-012",
    "skandha": 9,
    "chapter": 13,
    "sloka": 12,
    "sanskrit": "अराजकभयं न्णां मन्यमाना महर्षयः देहं ममन्थुः स्म निमेः कुमारः समजायत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-013",
    "skandha": 9,
    "chapter": 13,
    "sloka": 13,
    "sanskrit": "जन्मना जनकः सोऽभूद्वैदेहस्तु विदेहजः मिथिलो मथनाज्जातो मिथिला येन निर्मिता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-014",
    "skandha": 9,
    "chapter": 13,
    "sloka": 14,
    "sanskrit": "तस्मादुदावसुस्तस्य पुत्रोऽभून्नन्दिवर्धनः ततः सुकेतुस्तस्यापि देवरातो महीपते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-015",
    "skandha": 9,
    "chapter": 13,
    "sloka": 15,
    "sanskrit": "तस्माद्बृहद्रथस्तस्य महावीर्यः सुधृत्पिता सुधृतेर्धृष्टकेतुर्वै हर्यश्वोऽथ मरुस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-016",
    "skandha": 9,
    "chapter": 13,
    "sloka": 16,
    "sanskrit": "मरोः प्रतीपकस्तस्माज्जातः कृतरथो यतः देवमीढस्तस्य पुत्रो विश्रुतोऽथ महाधृतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-017",
    "skandha": 9,
    "chapter": 13,
    "sloka": 17,
    "sanskrit": "कृतिरातस्ततस्तस्मान्महारोमा च तत्सुतः स्वर्णरोमा सुतस्तस्य ह्रस्वरोमा व्यजायत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-018",
    "skandha": 9,
    "chapter": 13,
    "sloka": 18,
    "sanskrit": "ततः शीरध्वजो जज्ञे यज्ञार्थं कर्षतो महीम् सीता शीराग्रतो जाता तस्मात्शीरध्वजः स्मृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-019",
    "skandha": 9,
    "chapter": 13,
    "sloka": 19,
    "sanskrit": "कुशध्वजस्तस्य पुत्रस्ततो धर्मध्वजो नृपः धर्मध्वजस्य द्वौ पुत्रौ कृतध्वजमितध्वजौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-020",
    "skandha": 9,
    "chapter": 13,
    "sloka": 20,
    "sanskrit": "कृतध्वजात्केशिध्वजः खाण्डिक्यस्तु मितध्वजात् कृतध्वजसुतो राजन्नात्मविद्याविशारदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-021",
    "skandha": 9,
    "chapter": 13,
    "sloka": 21,
    "sanskrit": "खाण्डिक्यः कर्मतत्त्वज्ञो भीतः केशिध्वजाद्द्रुतः भानुमांस्तस्य पुत्रोऽभूच्छतद्युम्नस्तु तत्सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-022",
    "skandha": 9,
    "chapter": 13,
    "sloka": 22,
    "sanskrit": "शुचिस्तु तनयस्तस्मात्सनद्वाजः सुतोऽभवत् ऊर्जकेतुः सनद्वाजादजोऽथ पुरुजित्सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-023",
    "skandha": 9,
    "chapter": 13,
    "sloka": 23,
    "sanskrit": "अरिष्टनेमिस्तस्यापि श्रुतायुस्तत्सुपार्श्वकः ततश्चित्ररथो यस्य क्षेमाधिर्मिथिलाधिपः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-024",
    "skandha": 9,
    "chapter": 13,
    "sloka": 24,
    "sanskrit": "तस्मात्समरथस्तस्य सुतः सत्यरथस्ततः आसीदुपगुरुस्तस्मादुपगुप्तोऽग्निसम्भवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-025",
    "skandha": 9,
    "chapter": 13,
    "sloka": 25,
    "sanskrit": "वस्वनन्तोऽथ तत्पुत्रो युयुधो यत्सुभाषणः श्रुतस्ततो जयस्तस्माद्विजयोऽस्मादृतः सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-026",
    "skandha": 9,
    "chapter": 13,
    "sloka": 26,
    "sanskrit": "शुनकस्तत्सुतो जज्ञे वीतहव्यो धृतिस्ततः बहुलाश्वो धृतेस्तस्य कृतिरस्य महावशी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-13-sloka-027",
    "skandha": 9,
    "chapter": 13,
    "sloka": 27,
    "sanskrit": "एते वै मैथिला राजन्नात्मविद्याविशारदाः योगेश्वरप्रसादेन द्वन्द्वैर्मुक्ता गृहेष्वपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]