[
  {
    "id": "skandha-09-chapter-20-sloka-001",
    "skandha": 9,
    "chapter": 20,
    "sloka": 1,
    "sanskrit": "पूरोर्वंशं प्रवक्ष्यामि यत्र जातोऽसि भारत यत्र राजर्षयो वंश्या ब्रह्मवंश्याश्च जज्ञिरे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीबादरायणिरुवाच ।"
  },
  {
    "id": "skandha-09-chapter-20-sloka-002",
    "skandha": 9,
    "chapter": 20,
    "sloka": 2,
    "sanskrit": "जनमेजयो ह्यभूत्पूरोः प्रचिन्वांस्तत्सुतस्ततः प्रवीरोऽथ मनुस्युर्वै तस्माच्चारुपदोऽभवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-003",
    "skandha": 9,
    "chapter": 20,
    "sloka": 3,
    "sanskrit": "तस्य सुद्युरभूत्पुत्रस्तस्माद्बहुगवस्ततः संयातिस्तस्याहंयाती रौद्राश्वस्तत्सुतः स्मृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-004",
    "skandha": 9,
    "chapter": 20,
    "sloka": 4,
    "sanskrit": "ऋतेयुस्तस्य कक्षेयुः स्थण्डिलेयुः कृतेयुकः जलेयुः सन्नतेयुश्च धर्मसत्यव्रतेयवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-005",
    "skandha": 9,
    "chapter": 20,
    "sloka": 5,
    "sanskrit": "दशैतेऽप्सरसः पुत्रा वनेयुश्चावमः स्मृतः घृताच्यामिन्द्रियाणीव मुख्यस्य जगदात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-006",
    "skandha": 9,
    "chapter": 20,
    "sloka": 6,
    "sanskrit": "ऋतेयो रन्तिनावोऽभूत्त्रयस्तस्यात्मजा नृप सुमतिर्ध्रुवोऽप्रतिरथः कण्वोऽप्रतिरथात्मजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-007",
    "skandha": 9,
    "chapter": 20,
    "sloka": 7,
    "sanskrit": "तस्य मेधातिथिस्तस्मात्प्रस्कन्नाद्या द्विजातयः पुत्रोऽभूत्सुमते रेभिर्दुष्मन्तस्तत्सुतो मतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-008",
    "skandha": 9,
    "chapter": 20,
    "sloka": 8,
    "sanskrit": "दुष्मन्तो मृगयां यातः कण्वाश्रमपदं गतः तत्रासीनां स्वप्रभया मण्डयन्तीं रमामिव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-009",
    "skandha": 9,
    "chapter": 20,
    "sloka": 9,
    "sanskrit": "विलोक्य सद्यो मुमुहे देवमायामिव स्त्रियम् बभाषे तां वरारोहां भटैः कतिपयैर्वृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-010",
    "skandha": 9,
    "chapter": 20,
    "sloka": 10,
    "sanskrit": "तद्दर्शनप्रमुदितः सन्निवृत्तपरिश्रमः पप्रच्छ कामसन्तप्तः प्रहसञ्श्लक्ष्णया गिरा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-011",
    "skandha": 9,
    "chapter": 20,
    "sloka": 11,
    "sanskrit": "का त्वं कमलपत्राक्षि कस्यासि हृदयङ्गमे किं स्विच्चिकीर्षितं तत्र भवत्या निर्जने वने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-012",
    "skandha": 9,
    "chapter": 20,
    "sloka": 12,
    "sanskrit": "व्यक्तं राजन्यतनयां वेद्म्यहं त्वां सुमध्यमे न हि चेतः पौरवाणामधर्मे रमते क्वचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-013",
    "skandha": 9,
    "chapter": 20,
    "sloka": 13,
    "sanskrit": "विश्वामित्रात्मजैवाहं त्यक्ता मेनकया वने वेदैतद्भगवान्कण्वो वीर किं करवाम ते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशकुन्तलोवाच ।"
  },
  {
    "id": "skandha-09-chapter-20-sloka-014",
    "skandha": 9,
    "chapter": 20,
    "sloka": 14,
    "sanskrit": "आस्यतां ह्यरविन्दाक्ष गृह्यतामर्हणं च नः भुज्यतां सन्ति नीवारा उष्यतां यदि रोचते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-015",
    "skandha": 9,
    "chapter": 20,
    "sloka": 15,
    "sanskrit": "उपपन्नमिदं सुभ्रु जातायाः कुशिकान्वये स्वयं हि वृणुते राज्ञां कन्यकाः सदृशं वरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीदुष्मन्त उवाच ।"
  },
  {
    "id": "skandha-09-chapter-20-sloka-016",
    "skandha": 9,
    "chapter": 20,
    "sloka": 16,
    "sanskrit": "ओमित्युक्ते यथाधर्ममुपयेमे शकुन्तलाम् गान्धर्वविधिना राजा देशकालविधानवित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-017",
    "skandha": 9,
    "chapter": 20,
    "sloka": 17,
    "sanskrit": "अमोघवीर्यो राजर्षिर्महिष्यां वीर्यमादधे श्वोभूते स्वपुरं यातः कालेनासूत सा सुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-018",
    "skandha": 9,
    "chapter": 20,
    "sloka": 18,
    "sanskrit": "कण्वः कुमारस्य वने चक्रे समुचिताः क्रियाः बद्ध्वा मृगेन्द्रं तरसा क्रीडति स्म स बालकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-019",
    "skandha": 9,
    "chapter": 20,
    "sloka": 19,
    "sanskrit": "तं दुरत्ययविक्रान्तमादाय प्रमदोत्तमा हरेरंशांशसम्भूतं भर्तुरन्तिकमागमत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-020",
    "skandha": 9,
    "chapter": 20,
    "sloka": 20,
    "sanskrit": "यदा न जगृहे राजा भार्यापुत्रावनिन्दितौ शृण्वतां सर्वभूतानां खे वागाहाशरीरिणी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-021",
    "skandha": 9,
    "chapter": 20,
    "sloka": 21,
    "sanskrit": "माता भस्त्रा पितुः पुत्रो येन जातः स एव सः भरस्व पुत्रं दुष्मन्त मावमंस्थाः शकुन्तलाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-022",
    "skandha": 9,
    "chapter": 20,
    "sloka": 22,
    "sanskrit": "रेतोधाः पुत्रो नयति नरदेव यमक्षयात् त्वं चास्य धाता गर्भस्य सत्यमाह शकुन्तला",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-023",
    "skandha": 9,
    "chapter": 20,
    "sloka": 23,
    "sanskrit": "पितर्युपरते सोऽपि चक्रवर्ती महायशाः महिमा गीयते तस्य हरेरंशभुवो भुवि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-024",
    "skandha": 9,
    "chapter": 20,
    "sloka": 24,
    "sanskrit": "चक्रं दक्षिणहस्तेऽस्य पद्मकोशोऽस्य पादयोः ईजे महाभिषेकेण सोऽभिषिक्तोऽधिराड्विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-025",
    "skandha": 9,
    "chapter": 20,
    "sloka": 25,
    "sanskrit": "पञ्चपञ्चाशता मेध्यैर्गङ्गायामनु वाजिभिः मामतेयं पुरोधाय यमुनामनु च प्रभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-026",
    "skandha": 9,
    "chapter": 20,
    "sloka": 26,
    "sanskrit": "अष्टसप्ततिमेध्याश्वान्बबन्ध प्रददद्वसु भरतस्य हि दौष्मन्तेरग्निः साचीगुणे चितः सहस्रं बद्वशो यस्मिन्ब्राह्मणा गा विभेजिरे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-027",
    "skandha": 9,
    "chapter": 20,
    "sloka": 27,
    "sanskrit": "त्रयस्त्रिंशच्छतं ह्यश्वान्बद्ध्वा विस्मापयन्नृपान् दौष्मन्तिरत्यगान्मायां देवानां गुरुमाययौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-028",
    "skandha": 9,
    "chapter": 20,
    "sloka": 28,
    "sanskrit": "मृगाञ्छुक्लदतः कृष्णान्हिरण्येन परीवृतान् अदात्कर्मणि मष्णारे नियुतानि चतुर्दश",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-029",
    "skandha": 9,
    "chapter": 20,
    "sloka": 29,
    "sanskrit": "भरतस्य महत्कर्म न पूर्वे नापरे नृपाः नैवापुर्नैव प्राप्स्यन्ति बाहुभ्यां त्रिदिवं यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-030",
    "skandha": 9,
    "chapter": 20,
    "sloka": 30,
    "sanskrit": "किरातहूणान्यवनान्पौण्ड्रान्कङ्कान्खशाञ्छकान् अब्रह्मण्यनृपांश्चाहन्म्लेच्छान्दिग्विजयेऽखिलान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-031",
    "skandha": 9,
    "chapter": 20,
    "sloka": 31,
    "sanskrit": "जित्वा पुरासुरा देवान्ये रसौकांसि भेजिरे देवस्त्रियो रसां नीताः प्राणिभिः पुनराहरत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-032",
    "skandha": 9,
    "chapter": 20,
    "sloka": 32,
    "sanskrit": "सर्वान्कामान्दुदुहतुः प्रजानां तस्य रोदसी समास्त्रिणवसाहस्रीर्दिक्षु चक्रमवर्तयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-033",
    "skandha": 9,
    "chapter": 20,
    "sloka": 33,
    "sanskrit": "स संराड्लोकपालाख्यमैश्वर्यमधिराट्श्रियम् चक्रं चास्खलितं प्राणान्मृषेत्युपरराम ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-034",
    "skandha": 9,
    "chapter": 20,
    "sloka": 34,
    "sanskrit": "तस्यासन्नृप वैदर्भ्यः पत्न्यस्तिस्रः सुसम्मताः जघ्नुस्त्यागभयात्पुत्रान्नानुरूपा इतीरिते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-035",
    "skandha": 9,
    "chapter": 20,
    "sloka": 35,
    "sanskrit": "तस्यैवं वितथे वंशे तदर्थं यजतः सुतम् मरुत्स्तोमेन मरुतो भरद्वाजमुपाददुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-036",
    "skandha": 9,
    "chapter": 20,
    "sloka": 36,
    "sanskrit": "अन्तर्वत्न्यां भ्रातृपत्न्यां मैथुनाय बृहस्पतिः प्रवृत्तो वारितो गर्भं शप्त्वा वीर्यमुपासृजत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-037",
    "skandha": 9,
    "chapter": 20,
    "sloka": 37,
    "sanskrit": "तं त्यक्तुकामां ममतां भर्तुस्त्यागविशङ्किताम् नामनिर्वाचनं तस्य श्लोकमेनं सुरा जगुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-038",
    "skandha": 9,
    "chapter": 20,
    "sloka": 38,
    "sanskrit": "मूढे भर द्वाजमिमं भर द्वाजं बृहस्पते यातौ यदुक्त्वा पितरौ भरद्वाजस्ततस्त्वयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-20-sloka-039",
    "skandha": 9,
    "chapter": 20,
    "sloka": 39,
    "sanskrit": "चोद्यमाना सुरैरेवं मत्वा वितथमात्मजम् व्यसृजन्मरुतोऽबिभ्रन्दत्तोऽयं वितथेऽन्वये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]