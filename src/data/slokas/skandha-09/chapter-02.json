[
  {
    "id": "skandha-09-chapter-02-sloka-001",
    "skandha": 9,
    "chapter": 2,
    "sloka": 1,
    "sanskrit": "एवं गतेऽथ सुद्युम्ने मनुर्वैवस्वतः सुते पुत्रकामस्तपस्तेपे यमुनायां शतं समाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-02-sloka-002",
    "skandha": 9,
    "chapter": 2,
    "sloka": 2,
    "sanskrit": "ततोऽयजन्मनुर्देवमपत्यार्थं हरिं प्रभुम् इक्ष्वाकुपूर्वजान्पुत्रान्लेभे स्वसदृशान्दश",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-003",
    "skandha": 9,
    "chapter": 2,
    "sloka": 3,
    "sanskrit": "पृषध्रस्तु मनोः पुत्रो गोपालो गुरुणा कृतः पालयामास गा यत्तो रात्र्यां वीरासनव्रतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-004",
    "skandha": 9,
    "chapter": 2,
    "sloka": 4,
    "sanskrit": "एकदा प्राविशद्गोष्ठं शार्दूलो निशि वर्षति शयाना गाव उत्थाय भीतास्ता बभ्रमुर्व्रजे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-005",
    "skandha": 9,
    "chapter": 2,
    "sloka": 5,
    "sanskrit": "एकां जग्राह बलवान्सा चुक्रोश भयातुरा तस्यास्तु क्रन्दितं श्रुत्वा पृषध्रोऽनुससार ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-006",
    "skandha": 9,
    "chapter": 2,
    "sloka": 6,
    "sanskrit": "खड्गमादाय तरसा प्रलीनोडुगणे निशि अजानन्नच्छिनोद्बभ्रोः शिरः शार्दूलशङ्कया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-007",
    "skandha": 9,
    "chapter": 2,
    "sloka": 7,
    "sanskrit": "व्याघ्रोऽपि वृक्णश्रवणो निस्त्रिंशाग्राहतस्ततः निश्चक्राम भृशं भीतो रक्तं पथि समुत्सृजन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-008",
    "skandha": 9,
    "chapter": 2,
    "sloka": 8,
    "sanskrit": "मन्यमानो हतं व्याघ्रं पृषध्रः परवीरहा अद्राक्षीत्स्वहतां बभ्रुं व्युष्टायां निशि दुःखितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-009",
    "skandha": 9,
    "chapter": 2,
    "sloka": 9,
    "sanskrit": "तं शशाप कुलाचार्यः कृतागसमकामतः न क्षत्रबन्धुः शूद्रस्त्वं कर्मणा भवितामुना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-010",
    "skandha": 9,
    "chapter": 2,
    "sloka": 10,
    "sanskrit": "एवं शप्तस्तु गुरुणा प्रत्यगृह्णात्कृताञ्जलिः अधारयद्व्रतं वीर ऊर्ध्वरेता मुनिप्रियम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-011",
    "skandha": 9,
    "chapter": 2,
    "sloka": 11,
    "sanskrit": "वासुदेवे भगवति सर्वात्मनि परेऽमले एकान्तित्वं गतो भक्त्या सर्वभूतसुहृत्समः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-012",
    "skandha": 9,
    "chapter": 2,
    "sloka": 12,
    "sanskrit": "विमुक्तसङ्गः शान्तात्मा संयताक्षोऽपरिग्रहः यदृच्छयोपपन्नेन कल्पयन्वृत्तिमात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-013",
    "skandha": 9,
    "chapter": 2,
    "sloka": 13,
    "sanskrit": "आत्मन्यात्मानमाधाय ज्ञानतृप्तः समाहितः विचचार महीमेतां जडान्धबधिराकृतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-014",
    "skandha": 9,
    "chapter": 2,
    "sloka": 14,
    "sanskrit": "एवं वृत्तो वनं गत्वा दृष्ट्वा दावाग्निमुत्थितम् तेनोपयुक्तकरणो ब्रह्म प्राप परं मुनिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-015",
    "skandha": 9,
    "chapter": 2,
    "sloka": 15,
    "sanskrit": "कविः कनीयान्विषयेषु निःस्पृहो विसृज्य राज्यं सह बन्धुभिर्वनम् निवेश्य चित्ते पुरुषं स्वरोचिषं विवेश कैशोरवयाः परं गतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-016",
    "skandha": 9,
    "chapter": 2,
    "sloka": 16,
    "sanskrit": "करूषान्मानवादासन्कारूषाः क्षत्रजातयः उत्तरापथगोप्तारो ब्रह्मण्या धर्मवत्सलाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-017",
    "skandha": 9,
    "chapter": 2,
    "sloka": 17,
    "sanskrit": "धृष्टाद्धार्ष्टमभूत्क्षत्रं ब्रह्मभूयं गतं क्षितौ नृगस्य वंशः सुमतिर्भूतज्योतिस्ततो वसुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-018",
    "skandha": 9,
    "chapter": 2,
    "sloka": 18,
    "sanskrit": "वसोः प्रतीकस्तत्पुत्र ओघवानोघवत्पिता कन्या चौघवती नाम सुदर्शन उवाह ताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-019",
    "skandha": 9,
    "chapter": 2,
    "sloka": 19,
    "sanskrit": "चित्रसेनो नरिष्यन्तादृक्षस्तस्य सुतोऽभवत् तस्य मीढ्वांस्ततः पूर्ण इन्द्रसेनस्तु तत्सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-020",
    "skandha": 9,
    "chapter": 2,
    "sloka": 20,
    "sanskrit": "वीतिहोत्रस्त्विन्द्रसेनात्तस्य सत्यश्रवा अभूत् उरुश्रवाः सुतस्तस्य देवदत्तस्ततोऽभवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-021",
    "skandha": 9,
    "chapter": 2,
    "sloka": 21,
    "sanskrit": "ततोऽग्निवेश्यो भगवानग्निः स्वयमभूत्सुतः कानीन इति विख्यातो जातूकर्ण्यो महानृषिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-022",
    "skandha": 9,
    "chapter": 2,
    "sloka": 22,
    "sanskrit": "ततो ब्रह्मकुलं जातमाग्निवेश्यायनं नृप नरिष्यन्तान्वयः प्रोक्तो दिष्टवंशमतः शृणु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-023",
    "skandha": 9,
    "chapter": 2,
    "sloka": 23,
    "sanskrit": "नाभागो दिष्टपुत्रोऽन्यः कर्मणा वैश्यतां गतः भलन्दनः सुतस्तस्य वत्सप्रीतिर्भलन्दनात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-024",
    "skandha": 9,
    "chapter": 2,
    "sloka": 24,
    "sanskrit": "वत्सप्रीतेः सुतः प्रांशुस्तत्सुतं प्रमतिं विदुः खनित्रः प्रमतेस्तस्माच्चाक्षुषोऽथ विविंशतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-025",
    "skandha": 9,
    "chapter": 2,
    "sloka": 25,
    "sanskrit": "विविंशतेः सुतो रम्भः खनीनेत्रोऽस्य धार्मिकः करन्धमो महाराज तस्यासीदात्मजो नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-026",
    "skandha": 9,
    "chapter": 2,
    "sloka": 26,
    "sanskrit": "तस्यावीक्षित्सुतो यस्य मरुत्तश्चक्रवर्त्यभूत् संवर्तोऽयाजयद्यं वै महायोग्यङ्गिरःसुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-027",
    "skandha": 9,
    "chapter": 2,
    "sloka": 27,
    "sanskrit": "मरुत्तस्य यथा यज्ञो न तथान्योऽस्ति कश्चन सर्वं हिरण्मयं त्वासीद्यत्किञ्चिच्चास्य शोभनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-028",
    "skandha": 9,
    "chapter": 2,
    "sloka": 28,
    "sanskrit": "अमाद्यदिन्द्रः सोमेन दक्षिणाभिर्द्विजातयः मरुतः परिवेष्टारो विश्वेदेवाः सभासदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-029",
    "skandha": 9,
    "chapter": 2,
    "sloka": 29,
    "sanskrit": "मरुत्तस्य दमः पुत्रस्तस्यासीद्राज्यवर्धनः सुधृतिस्तत्सुतो जज्ञे सौधृतेयो नरः सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-030",
    "skandha": 9,
    "chapter": 2,
    "sloka": 30,
    "sanskrit": "तत्सुतः केवलस्तस्माद्धुन्धुमान्वेगवांस्ततः बुधस्तस्याभवद्यस्य तृणबिन्दुर्महीपतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-031",
    "skandha": 9,
    "chapter": 2,
    "sloka": 31,
    "sanskrit": "तं भेजेऽलम्बुषा देवी भजनीयगुणालयम् वराप्सरा यतः पुत्राः कन्या चेलविलाभवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-032",
    "skandha": 9,
    "chapter": 2,
    "sloka": 32,
    "sanskrit": "यस्यामुत्पादयामास विश्रवा धनदं सुतम् प्रादाय विद्यां परमामृषिर्योगेश्वरः पितुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-033",
    "skandha": 9,
    "chapter": 2,
    "sloka": 33,
    "sanskrit": "विशालः शून्यबन्धुश्च धूम्रकेतुश्च तत्सुताः विशालो वंशकृद्राजा वैशालीं निर्ममे पुरीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-034",
    "skandha": 9,
    "chapter": 2,
    "sloka": 34,
    "sanskrit": "हेमचन्द्रः सुतस्तस्य धूम्राक्षस्तस्य चात्मजः तत्पुत्रात्संयमादासीत्कृशाश्वः सहदेवजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-035",
    "skandha": 9,
    "chapter": 2,
    "sloka": 35,
    "sanskrit": "कृशाश्वात्सोमदत्तोऽभूद्योऽश्वमेधैरिडस्पतिम् इष्ट्वा पुरुषमापाग्र्यां गतिं योगेश्वराश्रिताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-02-sloka-036",
    "skandha": 9,
    "chapter": 2,
    "sloka": 36,
    "sanskrit": "सौमदत्तिस्तु सुमतिस्तत्पुत्रो जनमेजयः एते वैशालभूपालास्तृणबिन्दोर्यशोधराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]