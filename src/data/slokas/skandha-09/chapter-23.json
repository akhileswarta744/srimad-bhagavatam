[
  {
    "id": "skandha-09-chapter-23-sloka-001",
    "skandha": 9,
    "chapter": 23,
    "sloka": 1,
    "sanskrit": "अनोः सभानरश्चक्षुः परेष्णुश्च त्रयः सुताः सभानरात्कालनरः सृञ्जयस्तत्सुतस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-23-sloka-002",
    "skandha": 9,
    "chapter": 23,
    "sloka": 2,
    "sanskrit": "जनमेजयस्तस्य पुत्रो महाशालो महामनाः उशीनरस्तितिक्षुश्च महामनस आत्मजौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-003",
    "skandha": 9,
    "chapter": 23,
    "sloka": 3,
    "sanskrit": "शिबिर्वरः कृमिर्दक्षश्चत्वारोशीनरात्मजाः वृषादर्भः सुधीरश्च मद्रः केकय आत्मवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-004",
    "skandha": 9,
    "chapter": 23,
    "sloka": 4,
    "sanskrit": "शिबेश्चत्वार एवासंस्तितिक्षोश्च रुषद्रथः ततो होमोऽथ सुतपा बलिः सुतपसोऽभवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-005",
    "skandha": 9,
    "chapter": 23,
    "sloka": 5,
    "sanskrit": "अङ्गवङ्गकलिङ्गाद्याः सुह्मपुण्ड्रौड्रसंज्ञिताः जज्ञिरे दीर्घतमसो बलेः क्षेत्रे महीक्षितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-006",
    "skandha": 9,
    "chapter": 23,
    "sloka": 6,
    "sanskrit": "चक्रुः स्वनाम्ना विषयान्षडिमान्प्राच्यकांश्च ते खलपानोऽङ्गतो जज्ञे तस्माद्दिविरथस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-007",
    "skandha": 9,
    "chapter": 23,
    "sloka": 7,
    "sanskrit": "सुतो धर्मरथो यस्य जज्ञे चित्ररथोऽप्रजाः रोमपाद इति ख्यातस्तस्मै दशरथः सखा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-008",
    "skandha": 9,
    "chapter": 23,
    "sloka": 8,
    "sanskrit": "शान्तां स्वकन्यां प्रायच्छदृष्यशृङ्ग उवाह याम् देवेऽवर्षति यं रामा आनिन्युर्हरिणीसुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-009",
    "skandha": 9,
    "chapter": 23,
    "sloka": 9,
    "sanskrit": "नाट्यसङ्गीतवादित्रैर्विभ्रमालिङ्गनार्हणैः स तु राज्ञोऽनपत्यस्य निरूप्येष्टिं मरुत्वते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-010",
    "skandha": 9,
    "chapter": 23,
    "sloka": 10,
    "sanskrit": "प्रजामदाद्दशरथो येन लेभेऽप्रजाः प्रजाः चतुरङ्गो रोमपादात्पृथुलाक्षस्तु तत्सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-011",
    "skandha": 9,
    "chapter": 23,
    "sloka": 11,
    "sanskrit": "बृहद्रथो बृहत्कर्मा बृहद्भानुश्च तत्सुताः आद्याद्बृहन्मनास्तस्माज्जयद्रथ उदाहृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-012",
    "skandha": 9,
    "chapter": 23,
    "sloka": 12,
    "sanskrit": "विजयस्तस्य सम्भूत्यां ततो धृतिरजायत ततो धृतव्रतस्तस्य सत्कर्माधिरथस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-013",
    "skandha": 9,
    "chapter": 23,
    "sloka": 13,
    "sanskrit": "योऽसौ गङ्गातटे क्रीडन्मञ्जूषान्तर्गतं शिशुम् कुन्त्यापविद्धं कानीनमनपत्योऽकरोत्सुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-014",
    "skandha": 9,
    "chapter": 23,
    "sloka": 14,
    "sanskrit": "वृषसेनः सुतस्तस्य कर्णस्य जगतीपते द्रुह्योश्च तनयो बभ्रुः सेतुस्तस्यात्मजस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-015",
    "skandha": 9,
    "chapter": 23,
    "sloka": 15,
    "sanskrit": "आरब्धस्तस्य गान्धारस्तस्य धर्मस्ततो धृतः धृतस्य दुर्मदस्तस्मात्प्रचेताः प्राचेतसः शतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-016",
    "skandha": 9,
    "chapter": 23,
    "sloka": 16,
    "sanskrit": "म्लेच्छाधिपतयोऽभूवन्नुदीचीं दिशमाश्रिताः तुर्वसोश्च सुतो वह्निर्वह्नेर्भर्गोऽथ भानुमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-017",
    "skandha": 9,
    "chapter": 23,
    "sloka": 17,
    "sanskrit": "त्रिभानुस्तत्सुतोऽस्यापि करन्धम उदारधीः मरुतस्तत्सुतोऽपुत्रः पुत्रं पौरवमन्वभूत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-018",
    "skandha": 9,
    "chapter": 23,
    "sloka": 18,
    "sanskrit": "दुष्मन्तः स पुनर्भेजे स्ववंशं राज्यकामुकः ययातेर्ज्येष्ठपुत्रस्य यदोर्वंशं नरर्षभ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-019",
    "skandha": 9,
    "chapter": 23,
    "sloka": 19,
    "sanskrit": "वर्णयामि महापुण्यं सर्वपापहरं नृणाम् यदोर्वंशं नरः श्रुत्वा सर्वपापैः प्रमुच्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-020",
    "skandha": 9,
    "chapter": 23,
    "sloka": 20,
    "sanskrit": "यत्रावतीर्णो भगवान्परमात्मा नराकृतिः यदोः सहस्रजित्क्रोष्टा नलो रिपुरिति श्रुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-021",
    "skandha": 9,
    "chapter": 23,
    "sloka": 21,
    "sanskrit": "चत्वारः सूनवस्तत्र शतजित्प्रथमात्मजः महाहयो रेणुहयो हैहयश्चेति तत्सुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-022",
    "skandha": 9,
    "chapter": 23,
    "sloka": 22,
    "sanskrit": "धर्मस्तु हैहयसुतो नेत्रः कुन्तेः पिता ततः सोहञ्जिरभवत्कुन्तेर्महिष्मान्भद्रसेनकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-023",
    "skandha": 9,
    "chapter": 23,
    "sloka": 23,
    "sanskrit": "दुर्मदो भद्रसेनस्य धनकः कृतवीर्यसूः कृताग्निः कृतवर्मा च कृतौजा धनकात्मजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-024",
    "skandha": 9,
    "chapter": 23,
    "sloka": 24,
    "sanskrit": "अर्जुनः कृतवीर्यस्य सप्तद्वीपेश्वरोऽभवत् दत्तात्रेयाद्धरेरंशात्प्राप्तयोगमहागुणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-025",
    "skandha": 9,
    "chapter": 23,
    "sloka": 25,
    "sanskrit": "न नूनं कार्तवीर्यस्य गतिं यास्यन्ति पार्थिवाः यज्ञदानतपोयोगैः श्रुतवीर्यदयादिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-026",
    "skandha": 9,
    "chapter": 23,
    "sloka": 26,
    "sanskrit": "पञ्चाशीति सहस्राणि ह्यव्याहतबलः समाः अनष्टवित्तस्मरणो बुभुजेऽक्षय्यषड्वसु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-027",
    "skandha": 9,
    "chapter": 23,
    "sloka": 27,
    "sanskrit": "तस्य पुत्रसहस्रेषु पञ्चैवोर्वरिता मृधे जयध्वजः शूरसेनो वृषभो मधुरूर्जितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-028",
    "skandha": 9,
    "chapter": 23,
    "sloka": 28,
    "sanskrit": "जयध्वजात्तालजङ्घस्तस्य पुत्रशतं त्वभूत् क्षत्रं यत्तालजङ्घाख्यमौर्वतेजोपसंहृतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-029",
    "skandha": 9,
    "chapter": 23,
    "sloka": 29,
    "sanskrit": "तेषां ज्येष्ठो वीतिहोत्रो वृष्णिः पुत्रो मधोः स्मृतः तस्य पुत्रशतं त्वासीद्वृष्णिज्येष्ठं यतः कुलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-030",
    "skandha": 9,
    "chapter": 23,
    "sloka": 30,
    "sanskrit": "माधवा वृष्णयो राजन्यादवाश्चेति संज्ञिताः यदुपुत्रस्य च क्रोष्टोः पुत्रो वृजिनवांस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-031",
    "skandha": 9,
    "chapter": 23,
    "sloka": 31,
    "sanskrit": "स्वाहितोऽतो विषद्गुर्वै तस्य चित्ररथस्ततः शशबिन्दुर्महायोगी महाभागो महानभूत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-032",
    "skandha": 9,
    "chapter": 23,
    "sloka": 32,
    "sanskrit": "चतुर्दशमहारत्नश्चक्रवर्त्यपराजितः तस्य पत्नीसहस्राणां दशानां सुमहायशाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-033",
    "skandha": 9,
    "chapter": 23,
    "sloka": 33,
    "sanskrit": "दशलक्षसहस्राणि पुत्राणां तास्वजीजनत् तेषां तु षट्प्रधानानां पृथुश्रवस आत्मजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-034",
    "skandha": 9,
    "chapter": 23,
    "sloka": 34,
    "sanskrit": "धर्मो नामोशना तस्य हयमेधशतस्य याट् तत्सुतो रुचकस्तस्य पञ्चासन्नात्मजाः शृणु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-035",
    "skandha": 9,
    "chapter": 23,
    "sloka": 35,
    "sanskrit": "पुरुजिद्रुक्मरुक्मेषु पृथुज्यामघसंज्ञिताः ज्यामघस्त्वप्रजोऽप्यन्यां भार्यां शैब्यापतिर्भयात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-036",
    "skandha": 9,
    "chapter": 23,
    "sloka": 36,
    "sanskrit": "नाविन्दच्छत्रुभवनाद्भोज्यां कन्यामहारषीत् रथस्थां तां निरीक्ष्याह शैब्या पतिममर्षिता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-037",
    "skandha": 9,
    "chapter": 23,
    "sloka": 37,
    "sanskrit": "केयं कुहक मत्स्थानं रथमारोपितेति वै स्नुषा तवेत्यभिहिते स्मयन्ती पतिमब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-038",
    "skandha": 9,
    "chapter": 23,
    "sloka": 38,
    "sanskrit": "अहं बन्ध्यासपत्नी च स्नुषा मे युज्यते कथम् जनयिष्यसि यं राज्ञि तस्येयमुपयुज्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-23-sloka-039",
    "skandha": 9,
    "chapter": 23,
    "sloka": 39,
    "sanskrit": "अन्वमोदन्त तद्विश्वे देवाः पितर एव च शैब्या गर्भमधात्काले कुमारं सुषुवे शुभम् स विदर्भ इति प्रोक्त उपयेमे स्नुषां सतीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]