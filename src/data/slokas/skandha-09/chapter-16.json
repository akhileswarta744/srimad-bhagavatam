[
  {
    "id": "skandha-09-chapter-16-sloka-001",
    "skandha": 9,
    "chapter": 16,
    "sloka": 1,
    "sanskrit": "पित्रोपशिक्षितो रामस्तथेति कुरुनन्दन संवत्सरं तीर्थयात्रां चरित्वाश्रममाव्रजत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-16-sloka-002",
    "skandha": 9,
    "chapter": 16,
    "sloka": 2,
    "sanskrit": "कदाचिद्रेणुका याता गङ्गायां पद्ममालिनम् गन्धर्वराजं क्रीडन्तमप्सरोभिरपश्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-003",
    "skandha": 9,
    "chapter": 16,
    "sloka": 3,
    "sanskrit": "विलोकयन्ती क्रीडन्तमुदकार्थं नदीं गता होमवेलां न सस्मार किञ्चिच्चित्ररथस्पृहा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-004",
    "skandha": 9,
    "chapter": 16,
    "sloka": 4,
    "sanskrit": "कालात्ययं तं विलोक्य मुनेः शापविशङ्किता आगत्य कलशं तस्थौ पुरोधाय कृताञ्जलिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-005",
    "skandha": 9,
    "chapter": 16,
    "sloka": 5,
    "sanskrit": "व्यभिचारं मुनिर्ज्ञात्वा पत्न्याः प्रकुपितोऽब्रवीत् घ्नतैनां पुत्रकाः पापामित्युक्तास्ते न चक्रिरे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-006",
    "skandha": 9,
    "chapter": 16,
    "sloka": 6,
    "sanskrit": "रामः सञ्चोदितः पित्रा भ्रात्न्मात्रा सहावधीत् प्रभावज्ञो मुनेः सम्यक्समाधेस्तपसश्च सः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-007",
    "skandha": 9,
    "chapter": 16,
    "sloka": 7,
    "sanskrit": "वरेण च्छन्दयामास प्रीतः सत्यवतीसुतः वव्रे हतानां रामोऽपि जीवितं चास्मृतिं वधे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-008",
    "skandha": 9,
    "chapter": 16,
    "sloka": 8,
    "sanskrit": "उत्तस्थुस्ते कुशलिनो निद्रापाय इवाञ्जसा पितुर्विद्वांस्तपोवीर्यं रामश्चक्रे सुहृद्वधम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-009",
    "skandha": 9,
    "chapter": 16,
    "sloka": 9,
    "sanskrit": "येऽर्जुनस्य सुता राजन्स्मरन्तः स्वपितुर्वधम् रामवीर्यपराभूता लेभिरे शर्म न क्वचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-010",
    "skandha": 9,
    "chapter": 16,
    "sloka": 10,
    "sanskrit": "एकदाश्रमतो रामे सभ्रातरि वनं गते वैरं सिषाधयिषवो लब्धच्छिद्रा उपागमन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-011",
    "skandha": 9,
    "chapter": 16,
    "sloka": 11,
    "sanskrit": "दृष्ट्वाग्न्यागार आसीनमावेशितधियं मुनिम् भगवत्युत्तमश्लोके जघ्नुस्ते पापनिश्चयाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-012",
    "skandha": 9,
    "chapter": 16,
    "sloka": 12,
    "sanskrit": "याच्यमानाः कृपणया राममात्रातिदारुणाः प्रसह्य शिर उत्कृत्य निन्युस्ते क्षत्रबन्धवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-013",
    "skandha": 9,
    "chapter": 16,
    "sloka": 13,
    "sanskrit": "रेणुका दुःखशोकार्ता निघ्नन्त्यात्मानमात्मना रामरामेति तातेति विचुक्रोशोच्चकैः सती",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-014",
    "skandha": 9,
    "chapter": 16,
    "sloka": 14,
    "sanskrit": "तदुपश्रुत्य दूरस्था हा रामेत्यार्तवत्स्वनम् त्वरयाश्रममासाद्य ददृशुः पितरं हतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-015",
    "skandha": 9,
    "chapter": 16,
    "sloka": 15,
    "sanskrit": "ते दुःखरोषामर्षार्ति शोकवेगविमोहिताः हा तात साधो धर्मिष्ठ त्यक्त्वास्मान्स्वर्गतो भवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-016",
    "skandha": 9,
    "chapter": 16,
    "sloka": 16,
    "sanskrit": "विलप्यैवं पितुर्देहं निधाय भ्रातृषु स्वयम् प्रगृह्य परशुं रामः क्षत्रान्ताय मनो दधे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-017",
    "skandha": 9,
    "chapter": 16,
    "sloka": 17,
    "sanskrit": "गत्वा माहिष्मतीं रामो ब्रह्मघ्नविहतश्रियम् तेषां स शीर्षभी राजन्मध्ये चक्रे महागिरिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-018",
    "skandha": 9,
    "chapter": 16,
    "sloka": 18,
    "sanskrit": "तद्रक्तेन नदीं घोरामब्रह्मण्यभयावहाम् हेतुं कृत्वा पितृवधं क्षत्रेऽमङ्गलकारिणि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-019",
    "skandha": 9,
    "chapter": 16,
    "sloka": 19,
    "sanskrit": "त्रिःसप्तकृत्वः पृथिवीं कृत्वा निःक्षत्रियां प्रभुः समन्तपञ्चके चक्रे शोणितोदान्ह्रदान्नव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-020",
    "skandha": 9,
    "chapter": 16,
    "sloka": 20,
    "sanskrit": "पितुः कायेन सन्धाय शिर आदाय बर्हिषि सर्वदेवमयं देवमात्मानमयजन्मखैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-021",
    "skandha": 9,
    "chapter": 16,
    "sloka": 21,
    "sanskrit": "ददौ प्राचीं दिशं होत्रे ब्रह्मणे दक्षिणां दिशम् अध्वर्यवे प्रतीचीं वै उद्गात्रे उत्तरां दिशम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-022",
    "skandha": 9,
    "chapter": 16,
    "sloka": 22,
    "sanskrit": "अन्येभ्योऽवान्तरदिशः कश्यपाय च मध्यतः आर्यावर्तमुपद्रष्ट्रे सदस्येभ्यस्ततः परम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-023",
    "skandha": 9,
    "chapter": 16,
    "sloka": 23,
    "sanskrit": "ततश्चावभृथस्नान विधूताशेषकिल्बिषः सरस्वत्यां महानद्यां रेजे व्यब्भ्र इवांशुमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-024",
    "skandha": 9,
    "chapter": 16,
    "sloka": 24,
    "sanskrit": "स्वदेहं जमदग्निस्तु लब्ध्वा संज्ञानलक्षणम् ऋषीणां मण्डले सोऽभूत्सप्तमो रामपूजितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-025",
    "skandha": 9,
    "chapter": 16,
    "sloka": 25,
    "sanskrit": "जामदग्न्योऽपि भगवान्रामः कमललोचनः आगामिन्यन्तरे राजन्वर्तयिष्यति वै बृहत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-026",
    "skandha": 9,
    "chapter": 16,
    "sloka": 26,
    "sanskrit": "आस्तेऽद्यापि महेन्द्राद्रौ न्यस्तदण्डः प्रशान्तधीः उपगीयमानचरितः सिद्धगन्धर्वचारणैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-027",
    "skandha": 9,
    "chapter": 16,
    "sloka": 27,
    "sanskrit": "एवं भृगुषु विश्वात्मा भगवान्हरिरीश्वरः अवतीर्य परं भारं भुवोऽहन्बहुशो नृपान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-028",
    "skandha": 9,
    "chapter": 16,
    "sloka": 28,
    "sanskrit": "गाधेरभून्महातेजाः समिद्ध इव पावकः तपसा क्षात्रमुत्सृज्य यो लेभे ब्रह्मवर्चसम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-029",
    "skandha": 9,
    "chapter": 16,
    "sloka": 29,
    "sanskrit": "विश्वामित्रस्य चैवासन्पुत्रा एकशतं नृप मध्यमस्तु मधुच्छन्दा मधुच्छन्दस एव ते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-030",
    "skandha": 9,
    "chapter": 16,
    "sloka": 30,
    "sanskrit": "पुत्रं कृत्वा शुनःशेफं देवरातं च भार्गवम् आजीगर्तं सुतानाह ज्येष्ठ एष प्रकल्प्यताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-031",
    "skandha": 9,
    "chapter": 16,
    "sloka": 31,
    "sanskrit": "यो वै हरिश्चन्द्रमखे विक्रीतः पुरुषः पशुः स्तुत्वा देवान्प्रजेशादीन्मुमुचे पाशबन्धनात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-032",
    "skandha": 9,
    "chapter": 16,
    "sloka": 32,
    "sanskrit": "यो रातो देवयजने देवैर्गाधिषु तापसः देवरात इति ख्यातः शुनःशेफस्तु भार्गवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-033",
    "skandha": 9,
    "chapter": 16,
    "sloka": 33,
    "sanskrit": "ये मधुच्छन्दसो ज्येष्ठाः कुशलं मेनिरे न तत् अशपत्तान्मुनिः क्रुद्धो म्लेच्छा भवत दुर्जनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-034",
    "skandha": 9,
    "chapter": 16,
    "sloka": 34,
    "sanskrit": "स होवाच मधुच्छन्दाः सार्धं पञ्चाशता ततः यन्नो भवान्सञ्जानीते तस्मिंस्तिष्ठामहे वयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-035",
    "skandha": 9,
    "chapter": 16,
    "sloka": 35,
    "sanskrit": "ज्येष्ठं मन्त्रदृशं चक्रुस्त्वामन्वञ्चो वयं स्म हि विश्वामित्रः सुतानाह वीरवन्तो भविष्यथ ये मानं मेऽनुगृह्णन्तो वीरवन्तमकर्त माम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-036",
    "skandha": 9,
    "chapter": 16,
    "sloka": 36,
    "sanskrit": "एष वः कुशिका वीरो देवरातस्तमन्वित अन्ये चाष्टकहारीत जयक्रतुमदादयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-16-sloka-037",
    "skandha": 9,
    "chapter": 16,
    "sloka": 37,
    "sanskrit": "एवं कौशिकगोत्रं तु विश्वामित्रैः पृथग्विधम् प्रवरान्तरमापन्नं तद्धि चैवं प्रकल्पितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]