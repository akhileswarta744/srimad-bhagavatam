[
  {
    "id": "skandha-09-chapter-07-sloka-001",
    "skandha": 9,
    "chapter": 7,
    "sloka": 1,
    "sanskrit": "मान्धातुः पुत्रप्रवरो योऽम्बरीषः प्रकीर्तितः पितामहेन प्रवृतो यौवनाश्वस्तु तत्सुतः हारीतस्तस्य पुत्रोऽभून्मान्धातृप्रवरा इमे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-07-sloka-002",
    "skandha": 9,
    "chapter": 7,
    "sloka": 2,
    "sanskrit": "नर्मदा भ्रातृभिर्दत्ता पुरुकुत्साय योरगैः तया रसातलं नीतो भुजगेन्द्रप्रयुक्तया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-003",
    "skandha": 9,
    "chapter": 7,
    "sloka": 3,
    "sanskrit": "गन्धर्वानवधीत्तत्र वध्यान्वै विष्णुशक्तिधृक् नागाल्लब्धवरः सर्पादभयं स्मरतामिदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-004",
    "skandha": 9,
    "chapter": 7,
    "sloka": 4,
    "sanskrit": "त्रसद्दस्युः पौरुकुत्सो योऽनरण्यस्य देहकृत् हर्यश्वस्तत्सुतस्तस्मात्प्रारुणोऽथ त्रिबन्धनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-005",
    "skandha": 9,
    "chapter": 7,
    "sloka": 5,
    "sanskrit": "तस्य सत्यव्रतः पुत्रस्त्रिशङ्कुरिति विश्रुतः प्राप्तश्चाण्डालतां शापाद्गुरोः कौशिकतेजसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-006",
    "skandha": 9,
    "chapter": 7,
    "sloka": 6,
    "sanskrit": "सशरीरो गतः स्वर्गमद्यापि दिवि दृश्यते पातितोऽवाक्षिरा देवैस्तेनैव स्तम्भितो बलात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-007",
    "skandha": 9,
    "chapter": 7,
    "sloka": 7,
    "sanskrit": "त्रैशङ्कवो हरिश्चन्द्रो विश्वामित्रवसिष्ठयोः यन्निमित्तमभूद्युद्धं पक्षिणोर्बहुवार्षिकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-008",
    "skandha": 9,
    "chapter": 7,
    "sloka": 8,
    "sanskrit": "सोऽनपत्यो विषण्णात्मा नारदस्योपदेशतः वरुणं शरणं यातः पुत्रो मे जायतां प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-009",
    "skandha": 9,
    "chapter": 7,
    "sloka": 9,
    "sanskrit": "यदि वीरो महाराज तेनैव त्वां यजे इति तथेति वरुणेनास्य पुत्रो जातस्तु रोहितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-010",
    "skandha": 9,
    "chapter": 7,
    "sloka": 10,
    "sanskrit": "जातः सुतो ह्यनेनाङ्ग मां यजस्वेति सोऽब्रवीत् यदा पशुर्निर्दशः स्यादथ मेध्यो भवेदिति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-011",
    "skandha": 9,
    "chapter": 7,
    "sloka": 11,
    "sanskrit": "निर्दशे च स आगत्य यजस्वेत्याह सोऽब्रवीत् दन्ताः पशोर्यज्जायेरन्नथ मेध्यो भवेदिति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-012",
    "skandha": 9,
    "chapter": 7,
    "sloka": 12,
    "sanskrit": "दन्ता जाता यजस्वेति स प्रत्याहाथ सोऽब्रवीत् यदा पतन्त्यस्य दन्ता अथ मेध्यो भवेदिति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-013",
    "skandha": 9,
    "chapter": 7,
    "sloka": 13,
    "sanskrit": "पशोर्निपतिता दन्ता यजस्वेत्याह सोऽब्रवीत् यदा पशोः पुनर्दन्ता जायन्तेऽथ पशुः शुचिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-014",
    "skandha": 9,
    "chapter": 7,
    "sloka": 14,
    "sanskrit": "पुनर्जाता यजस्वेति स प्रत्याहाथ सोऽब्रवीत् सान्नाहिको यदा राजन्राजन्योऽथ पशुः शुचिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-015",
    "skandha": 9,
    "chapter": 7,
    "sloka": 15,
    "sanskrit": "इति पुत्रानुरागेण स्नेहयन्त्रितचेतसा कालं वञ्चयता तं तमुक्तो देवस्तमैक्षत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-016",
    "skandha": 9,
    "chapter": 7,
    "sloka": 16,
    "sanskrit": "रोहितस्तदभिज्ञाय पितुः कर्म चिकीर्षितम् प्राणप्रेप्सुर्धनुष्पाणिररण्यं प्रत्यपद्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-017",
    "skandha": 9,
    "chapter": 7,
    "sloka": 17,
    "sanskrit": "पितरं वरुणग्रस्तं श्रुत्वा जातमहोदरम् रोहितो ग्राममेयाय तमिन्द्रः प्रत्यषेधत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-018",
    "skandha": 9,
    "chapter": 7,
    "sloka": 18,
    "sanskrit": "भूमेः पर्यटनं पुण्यं तीर्थक्षेत्रनिषेवणैः रोहितायादिशच्छक्रः सोऽप्यरण्येऽवसत्समाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-019",
    "skandha": 9,
    "chapter": 7,
    "sloka": 19,
    "sanskrit": "एवं द्वितीये तृतीये चतुर्थे पञ्चमे तथा अभ्येत्याभ्येत्य स्थविरो विप्रो भूत्वाह वृत्रहा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-020",
    "skandha": 9,
    "chapter": 7,
    "sloka": 20,
    "sanskrit": "षष्ठं संवत्सरं तत्र चरित्वा रोहितः पुरीम् उपव्रजन्नजीगर्तादक्रीणान्मध्यमं सुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-021",
    "skandha": 9,
    "chapter": 7,
    "sloka": 21,
    "sanskrit": "शुनःशेफं पशुं पित्रे प्रदाय समवन्दत ततः पुरुषमेधेन हरिश्चन्द्रो महायशाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-022",
    "skandha": 9,
    "chapter": 7,
    "sloka": 22,
    "sanskrit": "मुक्तोदरोऽयजद्देवान्वरुणादीन्महत्कथः विश्वामित्रोऽभवत्तस्मिन्होता चाध्वर्युरात्मवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-023",
    "skandha": 9,
    "chapter": 7,
    "sloka": 23,
    "sanskrit": "जमदग्निरभूद्ब्रह्मा वसिष्ठोऽयास्यः सामगः तस्मै तुष्टो ददाविन्द्रः शातकौम्भमयं रथम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-024",
    "skandha": 9,
    "chapter": 7,
    "sloka": 24,
    "sanskrit": "शुनःशेफस्य माहात्म्यमुपरिष्टात्प्रचक्ष्यते सत्यं सारं धृतिं दृष्ट्वा सभार्यस्य च भूपतेः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-025",
    "skandha": 9,
    "chapter": 7,
    "sloka": 25,
    "sanskrit": "विश्वामित्रो भृशं प्रीतो ददावविहतां गतिम् मनः पृथिव्यां तामद्भिस्तेजसापोऽनिलेन तत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-026",
    "skandha": 9,
    "chapter": 7,
    "sloka": 26,
    "sanskrit": "खे वायुं धारयंस्तच्च भूतादौ तं महात्मनि तस्मिन्ज्ञानकलां ध्यात्वा तयाज्ञानं विनिर्दहन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-07-sloka-027",
    "skandha": 9,
    "chapter": 7,
    "sloka": 27,
    "sanskrit": "हित्वा तां स्वेन भावेन निर्वाणसुखसंविदा अनिर्देश्याप्रतर्क्येण तस्थौ विध्वस्तबन्धनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]