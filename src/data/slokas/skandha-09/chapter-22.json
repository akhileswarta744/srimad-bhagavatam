[
  {
    "id": "skandha-09-chapter-22-sloka-001",
    "skandha": 9,
    "chapter": 22,
    "sloka": 1,
    "sanskrit": "मित्रायुश्च दिवोदासाच्च्यवनस्तत्सुतो नृप सुदासः सहदेवोऽथ सोमको जन्तुजन्मकृत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-22-sloka-002",
    "skandha": 9,
    "chapter": 22,
    "sloka": 2,
    "sanskrit": "तस्य पुत्रशतं तेषां यवीयान्पृषतः सुतः स तस्माद्द्रुपदो जज्ञे सर्वसम्पत्समन्वितः द्रुपदाद्द्रौपदी तस्य धृष्टद्युम्नादयः सुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-003",
    "skandha": 9,
    "chapter": 22,
    "sloka": 3,
    "sanskrit": "धृष्टद्युम्नाद्धृष्टकेतुर्भार्म्याः पाञ्चालका इमे योऽजमीढसुतो ह्यन्य ऋक्षः संवरणस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-004",
    "skandha": 9,
    "chapter": 22,
    "sloka": 4,
    "sanskrit": "तपत्यां सूर्यकन्यायां कुरुक्षेत्रपतिः कुरुः परीक्षिः सुधनुर्जह्नुर्निषधश्च कुरोः सुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-005",
    "skandha": 9,
    "chapter": 22,
    "sloka": 5,
    "sanskrit": "सुहोत्रोऽभूत्सुधनुषश्च्यवनोऽथ ततः कृती वसुस्तस्योपरिचरो बृहद्रथमुखास्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-006",
    "skandha": 9,
    "chapter": 22,
    "sloka": 6,
    "sanskrit": "कुशाम्बमत्स्यप्रत्यग्र चेदिपाद्याश्च चेदिपाः बृहद्रथात्कुशाग्रोऽभूदृषभस्तस्य तत्सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-007",
    "skandha": 9,
    "chapter": 22,
    "sloka": 7,
    "sanskrit": "जज्ञे सत्यहितोऽपत्यं पुष्पवांस्तत्सुतो जहुः अन्यस्यामपि भार्यायां शकले द्वे बृहद्रथात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-008",
    "skandha": 9,
    "chapter": 22,
    "sloka": 8,
    "sanskrit": "ये मात्रा बहिरुत्सृष्टे जरया चाभिसन्धिते जीव जीवेति क्रीडन्त्या जरासन्धोऽभवत्सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-009",
    "skandha": 9,
    "chapter": 22,
    "sloka": 9,
    "sanskrit": "ततश्च सहदेवोऽभूत्सोमापिर्यच्छ्रुतश्रवाः परीक्षिरनपत्योऽभूत्सुरथो नाम जाह्नवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-010",
    "skandha": 9,
    "chapter": 22,
    "sloka": 10,
    "sanskrit": "ततो विदूरथस्तस्मात्सार्वभौमस्ततोऽभवत् जयसेनस्तत्तनयो राधिकोऽतोऽयुताय्वभूत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-011",
    "skandha": 9,
    "chapter": 22,
    "sloka": 11,
    "sanskrit": "ततश्चाक्रोधनस्तस्माद्देवातिथिरमुष्य च ऋक्षस्तस्य दिलीपोऽभूत्प्रतीपस्तस्य चात्मजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-012",
    "skandha": 9,
    "chapter": 22,
    "sloka": 12,
    "sanskrit": "देवापिः शान्तनुस्तस्य बाह्लीक इति चात्मजाः पितृराज्यं परित्यज्य देवापिस्तु वनं गतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-013",
    "skandha": 9,
    "chapter": 22,
    "sloka": 13,
    "sanskrit": "अभवच्छान्तनू राजा प्राङ्महाभिषसंज्ञितः यं यं कराभ्यां स्पृशति जीर्णं यौवनमेति सः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-014",
    "skandha": 9,
    "chapter": 22,
    "sloka": 14,
    "sanskrit": "शान्तिमाप्नोति चैवाग्र्यां कर्मणा तेन शान्तनुः समा द्वादश तद्राज्ये न ववर्ष यदा विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-015",
    "skandha": 9,
    "chapter": 22,
    "sloka": 15,
    "sanskrit": "शान्तनुर्ब्राह्मणैरुक्तः परिवेत्तायमग्रभुक् राज्यं देह्यग्रजायाशु पुरराष्ट्रविवृद्धये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-016",
    "skandha": 9,
    "chapter": 22,
    "sloka": 16,
    "sanskrit": "एवमुक्तो द्विजैर्ज्येष्ठं छन्दयामास सोऽब्रवीत् तन्मन्त्रिप्रहितैर्विप्रैर्वेदाद्विभ्रंशितो गिरा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-017",
    "skandha": 9,
    "chapter": 22,
    "sloka": 17,
    "sanskrit": "वेदवादातिवादान्वै तदा देवो ववर्ष ह देवापिर्योगमास्थाय कलापग्राममाश्रितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-018",
    "skandha": 9,
    "chapter": 22,
    "sloka": 18,
    "sanskrit": "सोमवंशे कलौ नष्टे कृतादौ स्थापयिष्यति बाह्लीकात्सोमदत्तोऽभूद्भूरिर्भूरिश्रवास्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-019",
    "skandha": 9,
    "chapter": 22,
    "sloka": 19,
    "sanskrit": "शलश्च शान्तनोरासीद्गङ्गायां भीष्म आत्मवान् सर्वधर्मविदां श्रेष्ठो महाभागवतः कविः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-020",
    "skandha": 9,
    "chapter": 22,
    "sloka": 20,
    "sanskrit": "वीरयूथाग्रणीर्येन रामोऽपि युधि तोषितः शान्तनोर्दासकन्यायां जज्ञे चित्राङ्गदः सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-021",
    "skandha": 9,
    "chapter": 22,
    "sloka": 21,
    "sanskrit": "विचित्रवीर्यश्चावरजो नाम्ना चित्राङ्गदो हतः यस्यां पराशरात्साक्षादवतीर्णो हरेः कला",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-022",
    "skandha": 9,
    "chapter": 22,
    "sloka": 22,
    "sanskrit": "वेदगुप्तो मुनिः कृष्णो यतोऽहमिदमध्यगाम् हित्वा स्वशिष्यान्पैलादीन्भगवान्बादरायणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-023",
    "skandha": 9,
    "chapter": 22,
    "sloka": 23,
    "sanskrit": "मह्यं पुत्राय शान्ताय परं गुह्यमिदं जगौ विचित्रवीर्योऽथोवाह काशीराजसुते बलात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-024",
    "skandha": 9,
    "chapter": 22,
    "sloka": 24,
    "sanskrit": "स्वयंवरादुपानीते अम्बिकाम्बालिके उभे तयोरासक्तहृदयो गृहीतो यक्ष्मणा मृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-025",
    "skandha": 9,
    "chapter": 22,
    "sloka": 25,
    "sanskrit": "क्षेत्रेऽप्रजस्य वै भ्रातुर्मात्रोक्तो बादरायणः धृतराष्ट्रं च पाण्डुं च विदुरं चाप्यजीजनत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-026",
    "skandha": 9,
    "chapter": 22,
    "sloka": 26,
    "sanskrit": "गान्धार्यां धृतराष्ट्रस्य जज्ञे पुत्रशतं नृप तत्र दुर्योधनो ज्येष्ठो दुःशला चापि कन्यका",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-027",
    "skandha": 9,
    "chapter": 22,
    "sloka": 27,
    "sanskrit": "शापान्मैथुनरुद्धस्य पाण्डोः कुन्त्यां महारथाः जाता धर्मानिलेन्द्रेभ्यो युधिष्ठिरमुखास्त्रयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-028",
    "skandha": 9,
    "chapter": 22,
    "sloka": 28,
    "sanskrit": "नकुलः सहदेवश्च माद्र्यां नासत्यदस्रयोः द्रौपद्यां पञ्च पञ्चभ्यः पुत्रास्ते पितरोऽभवन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-029",
    "skandha": 9,
    "chapter": 22,
    "sloka": 29,
    "sanskrit": "युधिष्ठिरात्प्रतिविन्ध्यः श्रुतसेनो वृकोदरात् अर्जुनाच्छ्रुतकीर्तिस्तु शतानीकस्तु नाकुलिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-030",
    "skandha": 9,
    "chapter": 22,
    "sloka": 30,
    "sanskrit": "सहदेवसुतो राजन्छ्रुतकर्मा तथापरे युधिष्ठिरात्तु पौरव्यां देवकोऽथ घटोत्कचः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-031",
    "skandha": 9,
    "chapter": 22,
    "sloka": 31,
    "sanskrit": "भीमसेनाद्धिडिम्बायां काल्यां सर्वगतस्ततः सहदेवात्सुहोत्रं तु विजयासूत पार्वती",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-032",
    "skandha": 9,
    "chapter": 22,
    "sloka": 32,
    "sanskrit": "करेणुमत्यां नकुलो नरमित्रं तथार्जुनः इरावन्तमुलुप्यां वै सुतायां बभ्रुवाहनम् मणिपुरपतेः सोऽपि तत्पुत्रः पुत्रिकासुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-033",
    "skandha": 9,
    "chapter": 22,
    "sloka": 33,
    "sanskrit": "तव तातः सुभद्रायामभिमन्युरजायत सर्वातिरथजिद्वीर उत्तरायां ततो भवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-034",
    "skandha": 9,
    "chapter": 22,
    "sloka": 34,
    "sanskrit": "परिक्षीणेषु कुरुषु द्रौणेर्ब्रह्मास्त्रतेजसा त्वं च कृष्णानुभावेन सजीवो मोचितोऽन्तकात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-035",
    "skandha": 9,
    "chapter": 22,
    "sloka": 35,
    "sanskrit": "तवेमे तनयास्तात जनमेजयपूर्वकाः श्रुतसेनो भीमसेन उग्रसेनश्च वीर्यवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-036",
    "skandha": 9,
    "chapter": 22,
    "sloka": 36,
    "sanskrit": "जनमेजयस्त्वां विदित्वा तक्षकान्निधनं गतम् सर्पान्वै सर्पयागाग्नौ स होष्यति रुषान्वितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-037",
    "skandha": 9,
    "chapter": 22,
    "sloka": 37,
    "sanskrit": "कालषेयं पुरोधाय तुरं तुरगमेधषाट् समन्तात्पृथिवीं सर्वां जित्वा यक्ष्यति चाध्वरैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-038",
    "skandha": 9,
    "chapter": 22,
    "sloka": 38,
    "sanskrit": "तस्य पुत्रः शतानीको याज्ञवल्क्यात्त्रयीं पठन् अस्त्रज्ञानं क्रियाज्ञानं शौनकात्परमेष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-039",
    "skandha": 9,
    "chapter": 22,
    "sloka": 39,
    "sanskrit": "सहस्रानीकस्तत्पुत्रस्ततश्चैवाश्वमेधजः असीमकृष्णस्तस्यापि नेमिचक्रस्तु तत्सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-040",
    "skandha": 9,
    "chapter": 22,
    "sloka": 40,
    "sanskrit": "गजाह्वये हृते नद्या कौशाम्ब्यां साधु वत्स्यति उक्तस्ततश्चित्ररथस्तस्माच्छुचिरथः सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-041",
    "skandha": 9,
    "chapter": 22,
    "sloka": 41,
    "sanskrit": "तस्माच्च वृष्टिमांस्तस्य सुषेणोऽथ महीपतिः सुनीथस्तस्य भविता नृचक्षुर्यत्सुखीनलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-042",
    "skandha": 9,
    "chapter": 22,
    "sloka": 42,
    "sanskrit": "परिप्लवः सुतस्तस्मान्मेधावी सुनयात्मजः नृपञ्जयस्ततो दूर्वस्तिमिस्तस्माज्जनिष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-043",
    "skandha": 9,
    "chapter": 22,
    "sloka": 43,
    "sanskrit": "तिमेर्बृहद्रथस्तस्माच्छतानीकः सुदासजः शतानीकाद्दुर्दमनस्तस्यापत्यं महीनरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-22-sloka-044",
    "skandha": 9,
    "chapter": 22,
    "sloka": 44,
    "sanskrit": "दण्डपाणिर्निमिस्तस्य क्षेमको भविता यतः ब्रह्मक्षत्रस्य वै योनिर्वंशो देवर्षिसत्कृतः",
    "malayalamMeaning": "",
