[
  {
    "id": "skandha-09-chapter-24-sloka-001",
    "skandha": 9,
    "chapter": 24,
    "sloka": 1,
    "sanskrit": "तस्यां विदर्भोऽजनयत्पुत्रौ नाम्ना कुशक्रथौ तृतीयं रोमपादं च विदर्भकुलनन्दनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-24-sloka-002",
    "skandha": 9,
    "chapter": 24,
    "sloka": 2,
    "sanskrit": "रोमपादसुतो बभ्रुर्बभ्रोः कृतिरजायत उशिकस्तत्सुतस्तस्माच्चेदिश्चैद्यादयो नृपाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-003",
    "skandha": 9,
    "chapter": 24,
    "sloka": 3,
    "sanskrit": "क्रथस्य कुन्तिः पुत्रोऽभूद्वृष्णिस्तस्याथ निर्वृतिः ततो दशार्हो नाम्नाभूत्तस्य व्योमः सुतस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-004",
    "skandha": 9,
    "chapter": 24,
    "sloka": 4,
    "sanskrit": "जीमूतो विकृतिस्तस्य यस्य भीमरथः सुतः ततो नवरथः पुत्रो जातो दशरथस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-005",
    "skandha": 9,
    "chapter": 24,
    "sloka": 5,
    "sanskrit": "करम्भिः शकुनेः पुत्रो देवरातस्तदात्मजः देवक्षत्रस्ततस्तस्य मधुः कुरुवशादनुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-006",
    "skandha": 9,
    "chapter": 24,
    "sloka": 6,
    "sanskrit": "पुरुहोत्रस्त्वनोः पुत्रस्तस्यायुः सात्वतस्ततः भजमानो भजिर्दिव्यो वृष्णिर्देवावृधोऽन्धकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-007",
    "skandha": 9,
    "chapter": 24,
    "sloka": 7,
    "sanskrit": "सात्वतस्य सुताः सप्त महाभोजश्च मारिष भजमानस्य निम्लोचिः किङ्कणो धृष्टिरेव च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-008",
    "skandha": 9,
    "chapter": 24,
    "sloka": 8,
    "sanskrit": "एकस्यामात्मजाः पत्न्यामन्यस्यां च त्रयः सुताः शताजिच्च सहस्राजिदयुताजिदिति प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-009",
    "skandha": 9,
    "chapter": 24,
    "sloka": 9,
    "sanskrit": "बभ्रुर्देवावृधसुतस्तयोः श्लोकौ पठन्त्यमू यथैव शृणुमो दूरात्सम्पश्यामस्तथान्तिकात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-010",
    "skandha": 9,
    "chapter": 24,
    "sloka": 10,
    "sanskrit": "बभ्रुः श्रेष्ठो मनुष्याणां देवैर्देवावृधः समः पुरुषाः पञ्चषष्टिश्च षट्सहस्राणि चाष्ट च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-011",
    "skandha": 9,
    "chapter": 24,
    "sloka": 11,
    "sanskrit": "येऽमृतत्वमनुप्राप्ता बभ्रोर्देवावृधादपि महाभोजोऽतिधर्मात्मा भोजा आसंस्तदन्वये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-012",
    "skandha": 9,
    "chapter": 24,
    "sloka": 12,
    "sanskrit": "वृष्णेः सुमित्रः पुत्रोऽभूद्युधाजिच्च परन्तप शिनिस्तस्यानमित्रश्च निघ्नोऽभूदनमित्रतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-013",
    "skandha": 9,
    "chapter": 24,
    "sloka": 13,
    "sanskrit": "सत्राजितः प्रसेनश्च निघ्नस्याथासतुः सुतौ अनमित्रसुतो योऽन्यः शिनिस्तस्य च सत्यकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-014",
    "skandha": 9,
    "chapter": 24,
    "sloka": 14,
    "sanskrit": "युयुधानः सात्यकिर्वै जयस्तस्य कुणिस्ततः युगन्धरोऽनमित्रस्य वृष्णिः पुत्रोऽपरस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-015",
    "skandha": 9,
    "chapter": 24,
    "sloka": 15,
    "sanskrit": "श्वफल्कश्चित्ररथश्च गान्दिन्यां च श्वफल्कतः अक्रूरप्रमुखा आसन्पुत्रा द्वादश विश्रुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-016",
    "skandha": 9,
    "chapter": 24,
    "sloka": 16,
    "sanskrit": "आसङ्गः सारमेयश्च मृदुरो मृदुविद्गिरिः धर्मवृद्धः सुकर्मा च क्षेत्रोपेक्षोऽरिमर्दनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-017",
    "skandha": 9,
    "chapter": 24,
    "sloka": 17,
    "sanskrit": "शत्रुघ्नो गन्धमादश्च प्रतिबाहुश्च द्वादश तेषां स्वसा सुचाराख्या द्वावक्रूरसुतावपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-018",
    "skandha": 9,
    "chapter": 24,
    "sloka": 18,
    "sanskrit": "देववानुपदेवश्च तथा चित्ररथात्मजाः पृथुर्विदूरथाद्याश्च बहवो वृष्णिनन्दनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-019",
    "skandha": 9,
    "chapter": 24,
    "sloka": 19,
    "sanskrit": "कुकुरो भजमानश्च शुचिः कम्बलबर्हिषः कुकुरस्य सुतो वह्निर्विलोमा तनयस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-020",
    "skandha": 9,
    "chapter": 24,
    "sloka": 20,
    "sanskrit": "कपोतरोमा तस्यानुः सखा यस्य च तुम्बुरुः अन्धकाद्दुन्दुभिस्तस्मादविद्योतः पुनर्वसुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-021",
    "skandha": 9,
    "chapter": 24,
    "sloka": 21,
    "sanskrit": "तस्याहुकश्चाहुकी च कन्या चैवाहुकात्मजौ देवकश्चोग्रसेनश्च चत्वारो देवकात्मजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-022",
    "skandha": 9,
    "chapter": 24,
    "sloka": 22,
    "sanskrit": "देववानुपदेवश्च सुदेवो देववर्धनः तेषां स्वसारः सप्तासन्धृतदेवादयो नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-023",
    "skandha": 9,
    "chapter": 24,
    "sloka": 23,
    "sanskrit": "शान्तिदेवोपदेवा च श्रीदेवा देवरक्षिता सहदेवा देवकी च वसुदेव उवाह ताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-024",
    "skandha": 9,
    "chapter": 24,
    "sloka": 24,
    "sanskrit": "कंसः सुनामा न्यग्रोधः कङ्कः शङ्कुः सुहूस्तथा राष्ट्रपालोऽथ धृष्टिश्च तुष्टिमानौग्रसेनयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-025",
    "skandha": 9,
    "chapter": 24,
    "sloka": 25,
    "sanskrit": "कंसा कंसवती कङ्का शूरभू राष्ट्रपालिका उग्रसेनदुहितरो वसुदेवानुजस्त्रियः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-026",
    "skandha": 9,
    "chapter": 24,
    "sloka": 26,
    "sanskrit": "शूरो विदूरथादासीद्भजमानस्तु तत्सुतः शिनिस्तस्मात्स्वयं भोजो हृदिकस्तत्सुतो मतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-027",
    "skandha": 9,
    "chapter": 24,
    "sloka": 27,
    "sanskrit": "देवमीढः शतधनुः कृतवर्मेति तत्सुताः देवमीढस्य शूरस्य मारिषा नाम पत्न्यभूत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-028",
    "skandha": 9,
    "chapter": 24,
    "sloka": 28,
    "sanskrit": "तस्यां स जनयामास दश पुत्रानकल्मषान् वसुदेवं देवभागं देवश्रवसमानकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-029",
    "skandha": 9,
    "chapter": 24,
    "sloka": 29,
    "sanskrit": "सृञ्जयं श्यामकं कङ्कं शमीकं वत्सकं वृकम् देवदुन्दुभयो नेदुरानका यस्य जन्मनि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-030",
    "skandha": 9,
    "chapter": 24,
    "sloka": 30,
    "sanskrit": "वसुदेवं हरेः स्थानं वदन्त्यानकदुन्दुभिम् पृथा च श्रुतदेवा च श्रुतकीर्तिः श्रुतश्रवाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-031",
    "skandha": 9,
    "chapter": 24,
    "sloka": 31,
    "sanskrit": "राजाधिदेवी चैतेषां भगिन्यः पञ्च कन्यकाः कुन्तेः सख्युः पिता शूरो ह्यपुत्रस्य पृथामदात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-032",
    "skandha": 9,
    "chapter": 24,
    "sloka": 32,
    "sanskrit": "साप दुर्वाससो विद्यां देवहूतीं प्रतोषितात् तस्या वीर्यपरीक्षार्थमाजुहाव रविं शुचिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-033",
    "skandha": 9,
    "chapter": 24,
    "sloka": 33,
    "sanskrit": "तदैवोपागतं देवं वीक्ष्य विस्मितमानसा प्रत्ययार्थं प्रयुक्ता मे याहि देव क्षमस्व मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-034",
    "skandha": 9,
    "chapter": 24,
    "sloka": 34,
    "sanskrit": "अमोघं देवसन्दर्शमादधे त्वयि चात्मजम् योनिर्यथा न दुष्येत कर्ताहं ते सुमध्यमे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-035",
    "skandha": 9,
    "chapter": 24,
    "sloka": 35,
    "sanskrit": "इति तस्यां स आधाय गर्भं सूर्यो दिवं गतः सद्यः कुमारः सञ्जज्ञे द्वितीय इव भास्करः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-036",
    "skandha": 9,
    "chapter": 24,
    "sloka": 36,
    "sanskrit": "तं सात्यजन्नदीतोये कृच्छ्राल्लोकस्य बिभ्यती प्रपितामहस्तामुवाह पाण्डुर्वै सत्यविक्रमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-037",
    "skandha": 9,
    "chapter": 24,
    "sloka": 37,
    "sanskrit": "श्रुतदेवां तु कारूषो वृद्धशर्मा समग्रहीत् यस्यामभूद्दन्तवक्र ऋषिशप्तो दितेः सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-038",
    "skandha": 9,
    "chapter": 24,
    "sloka": 38,
    "sanskrit": "कैकेयो धृष्टकेतुश्च श्रुतकीर्तिमविन्दत सन्तर्दनादयस्तस्यां पञ्चासन्कैकयाः सुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-039",
    "skandha": 9,
    "chapter": 24,
    "sloka": 39,
    "sanskrit": "राजाधिदेव्यामावन्त्यौ जयसेनोऽजनिष्ट ह दमघोषश्चेदिराजः श्रुतश्रवसमग्रहीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-040",
    "skandha": 9,
    "chapter": 24,
    "sloka": 40,
    "sanskrit": "शिशुपालः सुतस्तस्याः कथितस्तस्य सम्भवः देवभागस्य कंसायां चित्रकेतुबृहद्बलौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-041",
    "skandha": 9,
    "chapter": 24,
    "sloka": 41,
    "sanskrit": "कंसवत्यां देवश्रवसः सुवीर इषुमांस्तथा बकः कङ्कात्तु कङ्कायां सत्यजित्पुरुजित्तथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-042",
    "skandha": 9,
    "chapter": 24,
    "sloka": 42,
    "sanskrit": "सृञ्जयो राष्ट्रपाल्यां च वृषदुर्मर्षणादिकान् हरिकेशहिरण्याक्षौ शूरभूम्यां च श्यामकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-043",
    "skandha": 9,
    "chapter": 24,
    "sloka": 43,
    "sanskrit": "मिश्रकेश्यामप्सरसि वृकादीन्वत्सकस्तथा तक्षपुष्करशालादीन्दुर्वाक्ष्यां वृक आदधे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-044",
    "skandha": 9,
    "chapter": 24,
    "sloka": 44,
    "sanskrit": "सुमित्रार्जुनपालादीन्समीकात्तु सुदामनी आनकः कर्णिकायां वै ऋतधामाजयावपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-24-sloka-045",
    "skandha": 9,
    "chapter": 24,
    "sloka": 45,
    "sanskrit": "पौरवी रोहिणी भद्रा मदिरा रोचना इला देवकीप्रमुखाश्चासन्पत्न्य आनकदुन्दुभेः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
