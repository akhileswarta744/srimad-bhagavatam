[
  {
    "id": "skandha-09-chapter-19-sloka-001",
    "skandha": 9,
    "chapter": 19,
    "sloka": 1,
    "sanskrit": "स इत्थमाचरन्कामान्स्त्रैणोऽपह्नवमात्मनः बुद्ध्वा प्रियायै निर्विण्णो गाथामेतामगायत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-19-sloka-002",
    "skandha": 9,
    "chapter": 19,
    "sloka": 2,
    "sanskrit": "शृणु भार्गव्यमूं गाथां मद्विधाचरितां भुवि धीरा यस्यानुशोचन्ति वने ग्रामनिवासिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-003",
    "skandha": 9,
    "chapter": 19,
    "sloka": 3,
    "sanskrit": "बस्त एको वने कश्चिद्विचिन्वन्प्रियमात्मनः ददर्श कूपे पतितां स्वकर्मवशगामजाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-004",
    "skandha": 9,
    "chapter": 19,
    "sloka": 4,
    "sanskrit": "तस्या उद्धरणोपायं बस्तः कामी विचिन्तयन् व्यधत्त तीर्थमुद्धृत्य विषाणाग्रेण रोधसी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-005",
    "skandha": 9,
    "chapter": 19,
    "sloka": 5,
    "sanskrit": "सोत्तीर्य कूपात्सुश्रोणी तमेव चकमे किल तया वृतं समुद्वीक्ष्य बह्व्योऽजाः कान्तकामिनीः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-006",
    "skandha": 9,
    "chapter": 19,
    "sloka": 6,
    "sanskrit": "पीवानं श्मश्रुलं प्रेष्ठं मीढ्वांसं याभकोविदम् स एकोऽजवृषस्तासां बह्वीनां रतिवर्धनः रेमे कामग्रहग्रस्त आत्मानं नावबुध्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-007",
    "skandha": 9,
    "chapter": 19,
    "sloka": 7,
    "sanskrit": "तमेव प्रेष्ठतमया रममाणमजान्यया विलोक्य कूपसंविग्ना नामृष्यद्बस्तकर्म तत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-008",
    "skandha": 9,
    "chapter": 19,
    "sloka": 8,
    "sanskrit": "तं दुर्हृदं सुहृद्रूपं कामिनं क्षणसौहृदम् इन्द्रियाराममुत्सृज्य स्वामिनं दुःखिता ययौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-009",
    "skandha": 9,
    "chapter": 19,
    "sloka": 9,
    "sanskrit": "सोऽपि चानुगतः स्त्रैणः कृपणस्तां प्रसादितुम् कुर्वन्निडविडाकारं नाशक्नोत्पथि सन्धितुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-010",
    "skandha": 9,
    "chapter": 19,
    "sloka": 10,
    "sanskrit": "तस्य तत्र द्विजः कश्चिदजास्वाम्यच्छिनद्रुषा लम्बन्तं वृषणं भूयः सन्दधेऽर्थाय योगवित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-011",
    "skandha": 9,
    "chapter": 19,
    "sloka": 11,
    "sanskrit": "सम्बद्धवृषणः सोऽपि ह्यजया कूपलब्धया कालं बहुतिथं भद्रे कामैर्नाद्यापि तुष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-012",
    "skandha": 9,
    "chapter": 19,
    "sloka": 12,
    "sanskrit": "तथाहं कृपणः सुभ्रु भवत्याः प्रेमयन्त्रितः आत्मानं नाभिजानामि मोहितस्तव मायया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-013",
    "skandha": 9,
    "chapter": 19,
    "sloka": 13,
    "sanskrit": "यत्पृथिव्यां व्रीहियवं हिरण्यं पशवः स्त्रियः न दुह्यन्ति मनःप्रीतिं पुंसः कामहतस्य ते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-014",
    "skandha": 9,
    "chapter": 19,
    "sloka": 14,
    "sanskrit": "न जातु कामः कामानामुपभोगेन शांयति हविषा कृष्णवर्त्मेव भूय एवाभिवर्धते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-015",
    "skandha": 9,
    "chapter": 19,
    "sloka": 15,
    "sanskrit": "यदा न कुरुते भावं सर्वभूतेष्वमङ्गलम् समदृष्टेस्तदा पुंसः सर्वाः सुखमया दिशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-016",
    "skandha": 9,
    "chapter": 19,
    "sloka": 16,
    "sanskrit": "या दुस्त्यजा दुर्मतिभिर्जीर्यतो या न जीर्यते तां तृष्णां दुःखनिवहां शर्मकामो द्रुतं त्यजेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-017",
    "skandha": 9,
    "chapter": 19,
    "sloka": 17,
    "sanskrit": "मात्रा स्वस्रा दुहित्रा वा नाविविक्तासनो भवेत् बलवानिन्द्रियग्रामो विद्वांसमपि कर्षति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-018",
    "skandha": 9,
    "chapter": 19,
    "sloka": 18,
    "sanskrit": "पूर्णं वर्षसहस्रं मे विषयान्सेवतोऽसकृत् तथापि चानुसवनं तृष्णा तेषूपजायते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-019",
    "skandha": 9,
    "chapter": 19,
    "sloka": 19,
    "sanskrit": "तस्मादेतामहं त्यक्त्वा ब्रह्मण्यध्याय मानसम् निर्द्वन्द्वो निरहङ्कारश्चरिष्यामि मृगैः सह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-020",
    "skandha": 9,
    "chapter": 19,
    "sloka": 20,
    "sanskrit": "दृष्टं श्रुतमसद्बुद्ध्वा नानुध्यायेन्न सन्दिशेत् संसृतिं चात्मनाशं च तत्र विद्वान्स आत्मदृक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-021",
    "skandha": 9,
    "chapter": 19,
    "sloka": 21,
    "sanskrit": "इत्युक्त्वा नाहुषो जायां तदीयं पूरवे वयः दत्त्वा स्वजरसं तस्मादाददे विगतस्पृहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-022",
    "skandha": 9,
    "chapter": 19,
    "sloka": 22,
    "sanskrit": "दिशि दक्षिणपूर्वस्यां द्रुह्युं दक्षिणतो यदुम् प्रतीच्यां तुर्वसुं चक्र उदीच्यामनुमीश्वरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-023",
    "skandha": 9,
    "chapter": 19,
    "sloka": 23,
    "sanskrit": "भूमण्डलस्य सर्वस्य पूरुमर्हत्तमं विशाम् अभिषिच्याग्रजांस्तस्य वशे स्थाप्य वनं ययौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-024",
    "skandha": 9,
    "chapter": 19,
    "sloka": 24,
    "sanskrit": "आसेवितं वर्षपूगान्षड्वर्गं विषयेषु सः क्षणेन मुमुचे नीडं जातपक्ष इव द्विजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-025",
    "skandha": 9,
    "chapter": 19,
    "sloka": 25,
    "sanskrit": "स तत्र निर्मुक्तसमस्तसङ्ग आत्मानुभूत्या विधुतत्रिलिङ्गः परेऽमले ब्रह्मणि वासुदेवे लेभे गतिं भागवतीं प्रतीतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-026",
    "skandha": 9,
    "chapter": 19,
    "sloka": 26,
    "sanskrit": "श्रुत्वा गाथां देवयानी मेने प्रस्तोभमात्मनः स्त्रीपुंसोः स्नेहवैक्लव्यात्परिहासमिवेरितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-027",
    "skandha": 9,
    "chapter": 19,
    "sloka": 27,
    "sanskrit": "सा सन्निवासं सुहृदां प्रपायामिव गच्छताम् विज्ञायेश्वरतन्त्राणां मायाविरचितं प्रभोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-028",
    "skandha": 9,
    "chapter": 19,
    "sloka": 28,
    "sanskrit": "सर्वत्र सङ्गमुत्सृज्य स्वप्नौपम्येन भार्गवी कृष्णे मनः समावेश्य व्यधुनोल्लिङ्गमात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-19-sloka-029",
    "skandha": 9,
    "chapter": 19,
    "sloka": 29,
    "sanskrit": "नमस्तुभ्यं भगवते वासुदेवाय वेधसे सर्वभूताधिवासाय शान्ताय बृहते नमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]