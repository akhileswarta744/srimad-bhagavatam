[
  {
    "id": "skandha-09-chapter-03-sloka-001",
    "skandha": 9,
    "chapter": 3,
    "sloka": 1,
    "sanskrit": "शर्यातिर्मानवो राजा ब्रह्मिष्ठः सम्बभूव ह यो वा अङ्गिरसां सत्रे द्वितीयमहरूचिवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-03-sloka-002",
    "skandha": 9,
    "chapter": 3,
    "sloka": 2,
    "sanskrit": "सुकन्या नाम तस्यासीत्कन्या कमललोचना तया सार्धं वनगतो ह्यगमच्च्यवनाश्रमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-003",
    "skandha": 9,
    "chapter": 3,
    "sloka": 3,
    "sanskrit": "सा सखीभिः परिवृता विचिन्वन्त्यङ्घ्रिपान्वने वल्मीकरन्ध्रे ददृशे खद्योते इव ज्योतिषी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-004",
    "skandha": 9,
    "chapter": 3,
    "sloka": 4,
    "sanskrit": "ते दैवचोदिता बाला ज्योतिषी कण्टकेन वै अविध्यन्मुग्धभावेन सुस्रावासृक्ततो बहिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-005",
    "skandha": 9,
    "chapter": 3,
    "sloka": 5,
    "sanskrit": "शकृन्मूत्रनिरोधोऽभूत्सैनिकानां च तत्क्षणात् राजर्षिस्तमुपालक्ष्य पुरुषान्विस्मितोऽब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-006",
    "skandha": 9,
    "chapter": 3,
    "sloka": 6,
    "sanskrit": "अप्यभद्रं न युष्माभिर्भार्गवस्य विचेष्टितम् व्यक्तं केनापि नस्तस्य कृतमाश्रमदूषणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-007",
    "skandha": 9,
    "chapter": 3,
    "sloka": 7,
    "sanskrit": "सुकन्या प्राह पितरं भीता किञ्चित्कृतं मया द्वे ज्योतिषी अजानन्त्या निर्भिन्ने कण्टकेन वै",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-008",
    "skandha": 9,
    "chapter": 3,
    "sloka": 8,
    "sanskrit": "दुहितुस्तद्वचः श्रुत्वा शर्यातिर्जातसाध्वसः मुनिं प्रसादयामास वल्मीकान्तर्हितं शनैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-009",
    "skandha": 9,
    "chapter": 3,
    "sloka": 9,
    "sanskrit": "तदभिप्रायमाज्ञाय प्रादाद्दुहितरं मुनेः कृच्छ्रान्मुक्तस्तमामन्त्र्य पुरं प्रायात्समाहितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-010",
    "skandha": 9,
    "chapter": 3,
    "sloka": 10,
    "sanskrit": "सुकन्या च्यवनं प्राप्य पतिं परमकोपनम् प्रीणयामास चित्तज्ञा अप्रमत्तानुवृत्तिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-011",
    "skandha": 9,
    "chapter": 3,
    "sloka": 11,
    "sanskrit": "कस्यचित्त्वथ कालस्य नासत्यावाश्रमागतौ तौ पूजयित्वा प्रोवाच वयो मे दत्तमीश्वरौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-012",
    "skandha": 9,
    "chapter": 3,
    "sloka": 12,
    "sanskrit": "ग्रहं ग्रहीष्ये सोमस्य यज्ञे वामप्यसोमपोः क्रियतां मे वयोरूपं प्रमदानां यदीप्सितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-013",
    "skandha": 9,
    "chapter": 3,
    "sloka": 13,
    "sanskrit": "बाढमित्यूचतुर्विप्रमभिनन्द्य भिषक्तमौ निमज्जतां भवानस्मिन्ह्रदे सिद्धविनिर्मिते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-014",
    "skandha": 9,
    "chapter": 3,
    "sloka": 14,
    "sanskrit": "इत्युक्तो जरया ग्रस्त देहो धमनिसन्ततः ह्रदं प्रवेशितोऽश्विभ्यां वलीपलितविग्रहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-015",
    "skandha": 9,
    "chapter": 3,
    "sloka": 15,
    "sanskrit": "पुरुषास्त्रय उत्तस्थुरपीव्या वनिताप्रियाः पद्मस्रजः कुण्डलिनस्तुल्यरूपाः सुवाससः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-016",
    "skandha": 9,
    "chapter": 3,
    "sloka": 16,
    "sanskrit": "तान्निरीक्ष्य वरारोहा सरूपान्सूर्यवर्चसः अजानती पतिं साध्वी अश्विनौ शरणं ययौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-017",
    "skandha": 9,
    "chapter": 3,
    "sloka": 17,
    "sanskrit": "दर्शयित्वा पतिं तस्यै पातिव्रत्येन तोषितौ ऋषिमामन्त्र्य ययतुर्विमानेन त्रिविष्टपम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-018",
    "skandha": 9,
    "chapter": 3,
    "sloka": 18,
    "sanskrit": "यक्ष्यमाणोऽथ शर्यातिश्च्यवनस्याश्रमं गतः ददर्श दुहितुः पार्श्वे पुरुषं सूर्यवर्चसम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-019",
    "skandha": 9,
    "chapter": 3,
    "sloka": 19,
    "sanskrit": "राजा दुहितरं प्राह कृतपादाभिवन्दनाम् आशिषश्चाप्रयुञ्जानो नातिप्रीतिमना इव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-020",
    "skandha": 9,
    "chapter": 3,
    "sloka": 20,
    "sanskrit": "चिकीर्षितं ते किमिदं पतिस्त्वया प्रलम्भितो लोकनमस्कृतो मुनिः यत्त्वं जराग्रस्तमसत्यसम्मतं विहाय जारं भजसेऽमुमध्वगम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-021",
    "skandha": 9,
    "chapter": 3,
    "sloka": 21,
    "sanskrit": "कथं मतिस्तेऽवगतान्यथा सतां कुलप्रसूते कुलदूषणं त्विदम् बिभर्षि जारं यदपत्रपा कुलं पितुश्च भर्तुश्च नयस्यधस्तमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-022",
    "skandha": 9,
    "chapter": 3,
    "sloka": 22,
    "sanskrit": "एवं ब्रुवाणं पितरं स्मयमाना शुचिस्मिता उवाच तात जामाता तवैष भृगुनन्दनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-023",
    "skandha": 9,
    "chapter": 3,
    "sloka": 23,
    "sanskrit": "शशंस पित्रे तत्सर्वं वयोरूपाभिलम्भनम् विस्मितः परमप्रीतस्तनयां परिषस्वजे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-024",
    "skandha": 9,
    "chapter": 3,
    "sloka": 24,
    "sanskrit": "सोमेन याजयन्वीरं ग्रहं सोमस्य चाग्रहीत् असोमपोरप्यश्विनोश्च्यवनः स्वेन तेजसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-025",
    "skandha": 9,
    "chapter": 3,
    "sloka": 25,
    "sanskrit": "हन्तुं तमाददे वज्रं सद्यो मन्युरमर्षितः सवज्रं स्तम्भयामास भुजमिन्द्रस्य भार्गवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-026",
    "skandha": 9,
    "chapter": 3,
    "sloka": 26,
    "sanskrit": "अन्वजानंस्ततः सर्वे ग्रहं सोमस्य चाश्विनोः भिषजाविति यत्पूर्वं सोमाहुत्या बहिष्कृतौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-027",
    "skandha": 9,
    "chapter": 3,
    "sloka": 27,
    "sanskrit": "उत्तानबर्हिरानर्तो भूरिषेण इति त्रयः शर्यातेरभवन्पुत्रा आनर्ताद्रेवतोऽभवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-028",
    "skandha": 9,
    "chapter": 3,
    "sloka": 28,
    "sanskrit": "सोऽन्तःसमुद्रे नगरीं विनिर्माय कुशस्थलीम् आस्थितोऽभुङ्क्त विषयानानर्तादीनरिन्दम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-029",
    "skandha": 9,
    "chapter": 3,
    "sloka": 29,
    "sanskrit": "तस्य पुत्रशतं जज्ञे ककुद्मिज्येष्ठमुत्तमम् ककुद्मी रेवतीं कन्यां स्वामादाय विभुं गतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-030",
    "skandha": 9,
    "chapter": 3,
    "sloka": 30,
    "sanskrit": "पुत्र्या वरं परिप्रष्टुं ब्रह्मलोकमपावृतम् आवर्तमाने गान्धर्वे स्थितोऽलब्धक्षणः क्षणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-031",
    "skandha": 9,
    "chapter": 3,
    "sloka": 31,
    "sanskrit": "तदन्त आद्यमानम्य स्वाभिप्रायं न्यवेदयत् तच्छ्रुत्वा भगवान्ब्रह्मा प्रहस्य तमुवाच ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-032",
    "skandha": 9,
    "chapter": 3,
    "sloka": 32,
    "sanskrit": "अहो राजन्निरुद्धास्ते कालेन हृदि ये कृताः तत्पुत्रपौत्रनप्त्णां गोत्राणि च न शृण्महे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-033",
    "skandha": 9,
    "chapter": 3,
    "sloka": 33,
    "sanskrit": "कालोऽभियातस्त्रिणव चतुर्युगविकल्पितः तद्गच्छ देवदेवांशो बलदेवो महाबलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-034",
    "skandha": 9,
    "chapter": 3,
    "sloka": 34,
    "sanskrit": "कन्यारत्नमिदं राजन्नररत्नाय देहि भोः भुवो भारावताराय भगवान्भूतभावनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-035",
    "skandha": 9,
    "chapter": 3,
    "sloka": 35,
    "sanskrit": "अवतीर्णो निजांशेन पुण्यश्रवणकीर्तनः इत्यादिष्टोऽभिवन्द्याजं नृपः स्वपुरमागतः त्यक्तं पुण्यजनत्रासाद्भ्रातृभिर्दिक्ष्ववस्थितैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-03-sloka-036",
    "skandha": 9,
    "chapter": 3,
    "sloka": 36,
    "sanskrit": "सुतां दत्त्वानवद्याङ्गीं बलाय बलशालिने बदर्याख्यं गतो राजा तप्तुं नारायणाश्रमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]