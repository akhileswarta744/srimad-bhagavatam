[
  {
    "id": "skandha-09-chapter-14-sloka-001",
    "skandha": 9,
    "chapter": 14,
    "sloka": 1,
    "sanskrit": "अथातः श्रूयतां राजन्वंशः सोमस्य पावनः यस्मिन्नैलादयो भूपाः कीर्त्यन्ते पुण्यकीर्तयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-14-sloka-002",
    "skandha": 9,
    "chapter": 14,
    "sloka": 2,
    "sanskrit": "सहस्रशिरसः पुंसो नाभिह्रदसरोरुहात् जातस्यासीत्सुतो धातुरत्रिः पितृसमो गुणैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-003",
    "skandha": 9,
    "chapter": 14,
    "sloka": 3,
    "sanskrit": "तस्य दृग्भ्योऽभवत्पुत्रः सोमोऽमृतमयः किल विप्रौषध्युडुगणानां ब्रह्मणा कल्पितः पतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-004",
    "skandha": 9,
    "chapter": 14,
    "sloka": 4,
    "sanskrit": "सोऽयजद्राजसूयेन विजित्य भुवनत्रयम् पत्नीं बृहस्पतेर्दर्पात्तारां नामाहरद्बलात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-005",
    "skandha": 9,
    "chapter": 14,
    "sloka": 5,
    "sanskrit": "यदा स देवगुरुणा याचितोऽभीक्ष्णशो मदात् नात्यजत्तत्कृते जज्ञे सुरदानवविग्रहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-006",
    "skandha": 9,
    "chapter": 14,
    "sloka": 6,
    "sanskrit": "शुक्रो बृहस्पतेर्द्वेषादग्रहीत्सासुरोडुपम् हरो गुरुसुतं स्नेहात्सर्वभूतगणावृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-007",
    "skandha": 9,
    "chapter": 14,
    "sloka": 7,
    "sanskrit": "सर्वदेवगणोपेतो महेन्द्रो गुरुमन्वयात् सुरासुरविनाशोऽभूत्समरस्तारकामयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-008",
    "skandha": 9,
    "chapter": 14,
    "sloka": 8,
    "sanskrit": "निवेदितोऽथाङ्गिरसा सोमं निर्भर्त्स्य विश्वकृत् तारां स्वभर्त्रे प्रायच्छदन्तर्वत्नीमवैत्पतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-009",
    "skandha": 9,
    "chapter": 14,
    "sloka": 9,
    "sanskrit": "त्यज त्यजाशु दुष्प्रज्ञे मत्क्षेत्रादाहितं परैः नाहं त्वां भस्मसात्कुर्यां स्त्रियं सान्तानिकेऽसति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-010",
    "skandha": 9,
    "chapter": 14,
    "sloka": 10,
    "sanskrit": "तत्याज व्रीडिता तारा कुमारं कनकप्रभम् स्पृहामाङ्गिरसश्चक्रे कुमारे सोम एव च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-011",
    "skandha": 9,
    "chapter": 14,
    "sloka": 11,
    "sanskrit": "ममायं न तवेत्युच्चैस्तस्मिन्विवदमानयोः पप्रच्छुरृषयो देवा नैवोचे व्रीडिता तु सा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-012",
    "skandha": 9,
    "chapter": 14,
    "sloka": 12,
    "sanskrit": "कुमारो मातरं प्राह कुपितोऽलीकलज्जया किं न वचस्यसद्वृत्ते आत्मावद्यं वदाशु मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-013",
    "skandha": 9,
    "chapter": 14,
    "sloka": 13,
    "sanskrit": "ब्रह्मा तां रह आहूय समप्राक्षीच्च सान्त्वयन् सोमस्येत्याह शनकैः सोमस्तं तावदग्रहीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-014",
    "skandha": 9,
    "chapter": 14,
    "sloka": 14,
    "sanskrit": "तस्यात्मयोनिरकृत बुध इत्यभिधां नृप बुद्ध्या गम्भीरया येन पुत्रेणापोडुराण्मुदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-015",
    "skandha": 9,
    "chapter": 14,
    "sloka": 15,
    "sanskrit": "ततः पुरूरवा जज्ञे इलायां य उदाहृतः तस्य रूपगुणौदार्य शीलद्रविणविक्रमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-016",
    "skandha": 9,
    "chapter": 14,
    "sloka": 16,
    "sanskrit": "श्रुत्वोर्वशीन्द्रभवने गीयमानान्सुरर्षिणा तदन्तिकमुपेयाय देवी स्मरशरार्दिता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-017",
    "skandha": 9,
    "chapter": 14,
    "sloka": 17,
    "sanskrit": "मित्रावरुणयोः शापादापन्ना नरलोकताम् निशम्य पुरुषश्रेष्ठं कन्दर्पमिव रूपिणम् धृतिं विष्टभ्य ललना उपतस्थे तदन्तिके",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-018",
    "skandha": 9,
    "chapter": 14,
    "sloka": 18,
    "sanskrit": "स तां विलोक्य नृपतिर्हर्षेणोत्फुल्ललोचनः उवाच श्लक्ष्णया वाचा देवीं हृष्टतनूरुहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-019",
    "skandha": 9,
    "chapter": 14,
    "sloka": 19,
    "sanskrit": "स्वागतं ते वरारोहे आस्यतां करवाम किम् संरमस्व मया साकं रतिर्नौ शाश्वतीः समाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीराजोवाच ।"
  },
  {
    "id": "skandha-09-chapter-14-sloka-020",
    "skandha": 9,
    "chapter": 14,
    "sloka": 20,
    "sanskrit": "कस्यास्त्वयि न सज्जेत मनो दृष्टिश्च सुन्दर यदङ्गान्तरमासाद्य च्यवते ह रिरंसया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "उर्वश्युवाच ।"
  },
  {
    "id": "skandha-09-chapter-14-sloka-021",
    "skandha": 9,
    "chapter": 14,
    "sloka": 21,
    "sanskrit": "एतावुरणकौ राजन्न्यासौ रक्षस्व मानद संरंस्ये भवता साकं श्लाघ्यः स्त्रीणां वरः स्मृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-022",
    "skandha": 9,
    "chapter": 14,
    "sloka": 22,
    "sanskrit": "घृतं मे वीर भक्ष्यं स्यान्नेक्षे त्वान्यत्र मैथुनात् विवाससं तत्तथेति प्रतिपेदे महामनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-023",
    "skandha": 9,
    "chapter": 14,
    "sloka": 23,
    "sanskrit": "अहो रूपमहो भावो नरलोकविमोहनम् को न सेवेत मनुजो देवीं त्वां स्वयमागताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-024",
    "skandha": 9,
    "chapter": 14,
    "sloka": 24,
    "sanskrit": "तया स पुरुषश्रेष्ठो रमयन्त्या यथार्हतः रेमे सुरविहारेषु कामं चैत्ररथादिषु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-025",
    "skandha": 9,
    "chapter": 14,
    "sloka": 25,
    "sanskrit": "रममाणस्तया देव्या पद्मकिञ्जल्कगन्धया तन्मुखामोदमुषितो मुमुदेऽहर्गणान्बहून्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-026",
    "skandha": 9,
    "chapter": 14,
    "sloka": 26,
    "sanskrit": "अपश्यन्नुर्वशीमिन्द्रो गन्धर्वान्समचोदयत् उर्वशीरहितं मह्यमास्थानं नातिशोभते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-027",
    "skandha": 9,
    "chapter": 14,
    "sloka": 27,
    "sanskrit": "ते उपेत्य महारात्रे तमसि प्रत्युपस्थिते उर्वश्या उरणौ जह्रुर्न्यस्तौ राजनि जायया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-028",
    "skandha": 9,
    "chapter": 14,
    "sloka": 28,
    "sanskrit": "निशम्याक्रन्दितं देवी पुत्रयोर्नीयमानयोः हतास्म्यहं कुनाथेन नपुंसा वीरमानिना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-029",
    "skandha": 9,
    "chapter": 14,
    "sloka": 29,
    "sanskrit": "यद्विश्रम्भादहं नष्टा हृतापत्या च दस्युभिः यः शेते निशि सन्त्रस्तो यथा नारी दिवा पुमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-030",
    "skandha": 9,
    "chapter": 14,
    "sloka": 30,
    "sanskrit": "इति वाक्सायकैर्बिद्धः प्रतोत्त्रैरिव कुञ्जरः निशि निस्त्रिंशमादाय विवस्त्रोऽभ्यद्रवद्रुषा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-031",
    "skandha": 9,
    "chapter": 14,
    "sloka": 31,
    "sanskrit": "ते विसृज्योरणौ तत्र व्यद्योतन्त स्म विद्युतः आदाय मेषावायान्तं नग्नमैक्षत सा पतिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-032",
    "skandha": 9,
    "chapter": 14,
    "sloka": 32,
    "sanskrit": "ऐलोऽपि शयने जायामपश्यन्विमना इव तच्चित्तो विह्वलः शोचन्बभ्रामोन्मत्तवन्महीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-033",
    "skandha": 9,
    "chapter": 14,
    "sloka": 33,
    "sanskrit": "स तां वीक्ष्य कुरुक्षेत्रे सरस्वत्यां च तत्सखीः पञ्च प्रहृष्टवदनः प्राह सूक्तं पुरूरवाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-034",
    "skandha": 9,
    "chapter": 14,
    "sloka": 34,
    "sanskrit": "अहो जाये तिष्ठ तिष्ठ घोरे न त्यक्तुमर्हसि मां त्वमद्याप्यनिर्वृत्य वचांसि कृणवावहै",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-035",
    "skandha": 9,
    "chapter": 14,
    "sloka": 35,
    "sanskrit": "सुदेहोऽयं पतत्यत्र देवि दूरं हृतस्त्वया खादन्त्येनं वृका गृध्रास्त्वत्प्रसादस्य नास्पदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-036",
    "skandha": 9,
    "chapter": 14,
    "sloka": 36,
    "sanskrit": "मा मृथाः पुरुषोऽसि त्वं मा स्म त्वाद्युर्वृका इमे क्वापि सख्यं न वै स्त्रीणां वृकाणां हृदयं यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "उर्वश्युवाच ।"
  },
  {
    "id": "skandha-09-chapter-14-sloka-037",
    "skandha": 9,
    "chapter": 14,
    "sloka": 37,
    "sanskrit": "स्त्रियो ह्यकरुणाः क्रूरा दुर्मर्षाः प्रियसाहसाः घ्नन्त्यल्पार्थेऽपि विश्रब्धं पतिं भ्रातरमप्युत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-038",
    "skandha": 9,
    "chapter": 14,
    "sloka": 38,
    "sanskrit": "विधायालीकविश्रम्भमज्ञेषु त्यक्तसौहृदाः नवं नवमभीप्सन्त्यः पुंश्चल्यः स्वैरवृत्तयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-039",
    "skandha": 9,
    "chapter": 14,
    "sloka": 39,
    "sanskrit": "संवत्सरान्ते हि भवानेकरात्रं मयेश्वरः रंस्यत्यपत्यानि च ते भविष्यन्त्यपराणि भोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-040",
    "skandha": 9,
    "chapter": 14,
    "sloka": 40,
    "sanskrit": "अन्तर्वत्नीमुपालक्ष्य देवीं स प्रययौ पुरीम् पुनस्तत्र गतोऽब्दान्ते उर्वशीं वीरमातरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-041",
    "skandha": 9,
    "chapter": 14,
    "sloka": 41,
    "sanskrit": "उपलभ्य मुदा युक्तः समुवास तया निशाम् अथैनमुर्वशी प्राह कृपणं विरहातुरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-042",
    "skandha": 9,
    "chapter": 14,
    "sloka": 42,
    "sanskrit": "गन्धर्वानुपधावेमांस्तुभ्यं दास्यन्ति मामिति तस्य संस्तुवतस्तुष्टा अग्निस्थालीं ददुर्नृप उर्वशीं मन्यमानस्तां सोऽबुध्यत चरन्वने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-043",
    "skandha": 9,
    "chapter": 14,
    "sloka": 43,
    "sanskrit": "स्थालीं न्यस्य वने गत्वा गृहानाध्यायतो निशि त्रेतायां सम्प्रवृत्तायां मनसि त्रय्यवर्तत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-044",
    "skandha": 9,
    "chapter": 14,
    "sloka": 44,
    "sanskrit": "स्थालीस्थानं गतोऽश्वत्थं शमीगर्भं विलक्ष्य सः तेन द्वे अरणी कृत्वा उर्वशीलोककाम्यया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-14-sloka-045",
    "skandha": 9,
    "chapter": 14,
    "sloka": 45,
