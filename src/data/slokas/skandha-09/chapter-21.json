[
  {
    "id": "skandha-09-chapter-21-sloka-001",
    "skandha": 9,
    "chapter": 21,
    "sloka": 1,
    "sanskrit": "वितथस्य सुतान्मन्योर्बृहत्क्षत्रो जयस्ततः महावीर्यो नरो गर्गः सङ्कृतिस्तु नरात्मजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-21-sloka-002",
    "skandha": 9,
    "chapter": 21,
    "sloka": 2,
    "sanskrit": "गुरुश्च रन्तिदेवश्च सङ्कृतेः पाण्डुनन्दन रन्तिदेवस्य महिमा इहामुत्र च गीयते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-003",
    "skandha": 9,
    "chapter": 21,
    "sloka": 3,
    "sanskrit": "वियद्वित्तस्य ददतो लब्धं लब्धं बुभुक्षतः निष्किञ्चनस्य धीरस्य सकुटुम्बस्य सीदतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-004",
    "skandha": 9,
    "chapter": 21,
    "sloka": 4,
    "sanskrit": "व्यतीयुरष्टचत्वारिंशदहान्यपिबतः किल घृतपायससंयावं तोयं प्रातरुपस्थितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-005",
    "skandha": 9,
    "chapter": 21,
    "sloka": 5,
    "sanskrit": "कृच्छ्रप्राप्तकुटुम्बस्य क्षुत्तृड्भ्यां जातवेपथोः अतिथिर्ब्राह्मणः काले भोक्तुकामस्य चागमत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-006",
    "skandha": 9,
    "chapter": 21,
    "sloka": 6,
    "sanskrit": "तस्मै संव्यभजत्सोऽन्नमादृत्य श्रद्धयान्वितः हरिं सर्वत्र सम्पश्यन्स भुक्त्वा प्रययौ द्विजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-007",
    "skandha": 9,
    "chapter": 21,
    "sloka": 7,
    "sanskrit": "अथान्यो भोक्ष्यमाणस्य विभक्तस्य महीपतेः विभक्तं व्यभजत्तस्मै वृषलाय हरिं स्मरन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-008",
    "skandha": 9,
    "chapter": 21,
    "sloka": 8,
    "sanskrit": "याते शूद्रे तमन्योऽगादतिथिः श्वभिरावृतः राजन्मे दीयतामन्नं सगणाय बुभुक्षते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-009",
    "skandha": 9,
    "chapter": 21,
    "sloka": 9,
    "sanskrit": "स आदृत्यावशिष्टं यद्बहुमानपुरस्कृतम् तच्च दत्त्वा नमश्चक्रे श्वभ्यः श्वपतये विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-010",
    "skandha": 9,
    "chapter": 21,
    "sloka": 10,
    "sanskrit": "पानीयमात्रमुच्छेषं तच्चैकपरितर्पणम् पास्यतः पुल्कसोऽभ्यागादपो देह्यशुभाय मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-011",
    "skandha": 9,
    "chapter": 21,
    "sloka": 11,
    "sanskrit": "तस्य तां करुणां वाचं निशम्य विपुलश्रमाम् कृपया भृशसन्तप्त इदमाहामृतं वचः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-012",
    "skandha": 9,
    "chapter": 21,
    "sloka": 12,
    "sanskrit": "न कामयेऽहं गतिमीश्वरात्परामष्टर्द्धियुक्तामपुनर्भवं वा आर्तिं प्रपद्येऽखिलदेहभाजामन्तःस्थितो येन भवन्त्यदुःखाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-013",
    "skandha": 9,
    "chapter": 21,
    "sloka": 13,
    "sanskrit": "क्षुत्तृट्श्रमो गात्रपरिभ्रमश्च दैन्यं क्लमः शोकविषादमोहाः सर्वे निवृत्ताः कृपणस्य जन्तोर्जिजीविषोर्जीवजलार्पणान्मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-014",
    "skandha": 9,
    "chapter": 21,
    "sloka": 14,
    "sanskrit": "इति प्रभाष्य पानीयं म्रियमाणः पिपासया पुल्कसायाददाद्धीरो निसर्गकरुणो नृपः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-015",
    "skandha": 9,
    "chapter": 21,
    "sloka": 15,
    "sanskrit": "तस्य त्रिभुवनाधीशाः फलदाः फलमिच्छताम् आत्मानं दर्शयां चक्रुर्माया विष्णुविनिर्मिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-016",
    "skandha": 9,
    "chapter": 21,
    "sloka": 16,
    "sanskrit": "स वै तेभ्यो नमस्कृत्य निःसङ्गो विगतस्पृहः वासुदेवे भगवति भक्त्या चक्रे मनः परम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-017",
    "skandha": 9,
    "chapter": 21,
    "sloka": 17,
    "sanskrit": "ईश्वरालम्बनं चित्तं कुर्वतोऽनन्यराधसः माया गुणमयी राजन्स्वप्नवत्प्रत्यलीयत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-018",
    "skandha": 9,
    "chapter": 21,
    "sloka": 18,
    "sanskrit": "तत्प्रसङ्गानुभावेन रन्तिदेवानुवर्तिनः अभवन्योगिनः सर्वे नारायणपरायणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-019",
    "skandha": 9,
    "chapter": 21,
    "sloka": 19,
    "sanskrit": "गर्गाच्छिनिस्ततो गार्ग्यः क्षत्राद्ब्रह्म ह्यवर्तत दुरितक्षयो महावीर्यात्तस्य त्रय्यारुणिः कविः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-020",
    "skandha": 9,
    "chapter": 21,
    "sloka": 20,
    "sanskrit": "पुष्करारुणिरित्यत्र ये ब्राह्मणगतिं गताः बृहत्क्षत्रस्य पुत्रोऽभूद्धस्ती यद्धस्तिनापुरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-021",
    "skandha": 9,
    "chapter": 21,
    "sloka": 21,
    "sanskrit": "अजमीढो द्विमीढश्च पुरुमीढश्च हस्तिनः अजमीढस्य वंश्याः स्युः प्रियमेधादयो द्विजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-022",
    "skandha": 9,
    "chapter": 21,
    "sloka": 22,
    "sanskrit": "अजमीढाद्बृहदिषुस्तस्य पुत्रो बृहद्धनुः बृहत्कायस्ततस्तस्य पुत्र आसीज्जयद्रथः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-023",
    "skandha": 9,
    "chapter": 21,
    "sloka": 23,
    "sanskrit": "तत्सुतो विशदस्तस्य स्येनजित्समजायत रुचिराश्वो दृढहनुः काश्यो वत्सश्च तत्सुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-024",
    "skandha": 9,
    "chapter": 21,
    "sloka": 24,
    "sanskrit": "रुचिराश्वसुतः पारः पृथुसेनस्तदात्मजः पारस्य तनयो नीपस्तस्य पुत्रशतं त्वभूत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-025",
    "skandha": 9,
    "chapter": 21,
    "sloka": 25,
    "sanskrit": "स कृत्व्यां शुककन्यायां ब्रह्मदत्तमजीजनत् योगी स गवि भार्यायां विष्वक्सेनमधात्सुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-026",
    "skandha": 9,
    "chapter": 21,
    "sloka": 26,
    "sanskrit": "जैगीषव्योपदेशेन योगतन्त्रं चकार ह उदक्सेनस्ततस्तस्माद्भल्लाटो बार्हदीषवाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-027",
    "skandha": 9,
    "chapter": 21,
    "sloka": 27,
    "sanskrit": "यवीनरो द्विमीढस्य कृतिमांस्तत्सुतः स्मृतः नाम्ना सत्यधृतिस्तस्य दृढनेमिः सुपार्श्वकृत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-028",
    "skandha": 9,
    "chapter": 21,
    "sloka": 28,
    "sanskrit": "सुपार्श्वात्सुमतिस्तस्य पुत्रः सन्नतिमांस्ततः कृती हिरण्यनाभाद्यो योगं प्राप्य जगौ स्म षट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-029",
    "skandha": 9,
    "chapter": 21,
    "sloka": 29,
    "sanskrit": "संहिताः प्राच्यसाम्नां वै नीपो ह्युद्ग्रायुधस्ततः तस्य क्षेम्यः सुवीरोऽथ सुवीरस्य रिपुञ्जयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-030",
    "skandha": 9,
    "chapter": 21,
    "sloka": 30,
    "sanskrit": "ततो बहुरथो नाम पुरुमीढोऽप्रजोऽभवत् नलिन्यामजमीढस्य नीलः शान्तिस्तु तत्सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-031",
    "skandha": 9,
    "chapter": 21,
    "sloka": 31,
    "sanskrit": "शान्तेः सुशान्तिस्तत्पुत्रः पुरुजोऽर्कस्ततोऽभवत् भर्म्याश्वस्तनयस्तस्य पञ्चासन्मुद्गलादयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-032",
    "skandha": 9,
    "chapter": 21,
    "sloka": 32,
    "sanskrit": "यवीनरो बृहद्विश्वः काम्पिल्लः सञ्जयः सुताः भर्म्याश्वः प्राह पुत्रा मे पञ्चानां रक्षणाय हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-033",
    "skandha": 9,
    "chapter": 21,
    "sloka": 33,
    "sanskrit": "विषयाणामलमिमे इति पञ्चालसंज्ञिताः मुद्गलाद्ब्रह्मनिर्वृत्तं गोत्रं मौद्गल्यसंज्ञितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-034",
    "skandha": 9,
    "chapter": 21,
    "sloka": 34,
    "sanskrit": "मिथुनं मुद्गलाद्भार्म्याद्दिवोदासः पुमानभूत् अहल्या कन्यका यस्यां शतानन्दस्तु गौतमात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-035",
    "skandha": 9,
    "chapter": 21,
    "sloka": 35,
    "sanskrit": "तस्य सत्यधृतिः पुत्रो धनुर्वेदविशारदः शरद्वांस्तत्सुतो यस्मादुर्वशीदर्शनात्किल",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-21-sloka-036",
    "skandha": 9,
    "chapter": 21,
    "sloka": 36,
    "sanskrit": "शरस्तम्बेऽपतद्रेतो मिथुनं तदभूच्छुभम् तद्दृष्ट्वा कृपयागृह्णाच्छान्तनुर्मृगयां चरन् कृपः कुमारः कन्या च द्रोणपत्न्यभवत्कृपी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]