[
  {
    "id": "skandha-09-chapter-01-sloka-001",
    "skandha": 9,
    "chapter": 1,
    "sloka": 1,
    "sanskrit": "मन्वन्तराणि सर्वाणि त्वयोक्तानि श्रुतानि मे वीर्याण्यनन्तवीर्यस्य हरेस्तत्र कृतानि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीराजोवाच ।"
  },
  {
    "id": "skandha-09-chapter-01-sloka-002",
    "skandha": 9,
    "chapter": 1,
    "sloka": 2,
    "sanskrit": "योऽसौ सत्यव्रतो नाम राजर्षिर्द्रविडेश्वरः ज्ञानं योऽतीतकल्पान्ते लेभे पुरुषसेवया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-003",
    "skandha": 9,
    "chapter": 1,
    "sloka": 3,
    "sanskrit": "स वै विवस्वतः पुत्रो मनुरासीदिति श्रुतम् त्वत्तस्तस्य सुताः प्रोक्ता इक्ष्वाकुप्रमुखा नृपाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-004",
    "skandha": 9,
    "chapter": 1,
    "sloka": 4,
    "sanskrit": "तेषां वंशं पृथग्ब्रह्मन्वंशानुचरितानि च कीर्तयस्व महाभाग नित्यं शुश्रूषतां हि नः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-005",
    "skandha": 9,
    "chapter": 1,
    "sloka": 5,
    "sanskrit": "ये भूता ये भविष्याश्च भवन्त्यद्यतनाश्च ये तेषां नः पुण्यकीर्तीनां सर्वेषां वद विक्रमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-006",
    "skandha": 9,
    "chapter": 1,
    "sloka": 6,
    "sanskrit": "एवं परीक्षिता राज्ञा सदसि ब्रह्मवादिनाम् पृष्टः प्रोवाच भगवाञ्छुकः परमधर्मवित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीसूत उवाच ।"
  },
  {
    "id": "skandha-09-chapter-01-sloka-007",
    "skandha": 9,
    "chapter": 1,
    "sloka": 7,
    "sanskrit": "श्रूयतां मानवो वंशः प्राचुर्येण परन्तप न शक्यते विस्तरतो वक्तुं वर्षशतैरपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-01-sloka-008",
    "skandha": 9,
    "chapter": 1,
    "sloka": 8,
    "sanskrit": "परावरेषां भूतानामात्मा यः पुरुषः परः स एवासीदिदं विश्वं कल्पान्तेऽन्यन्न किञ्चन",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-009",
    "skandha": 9,
    "chapter": 1,
    "sloka": 9,
    "sanskrit": "तस्य नाभेः समभवत्पद्मकोषो हिरण्मयः तस्मिन्जज्ञे महाराज स्वयम्भूश्चतुराननः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-010",
    "skandha": 9,
    "chapter": 1,
    "sloka": 10,
    "sanskrit": "मरीचिर्मनसस्तस्य जज्ञे तस्यापि कश्यपः दाक्षायण्यां ततोऽदित्यां विवस्वानभवत्सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-011",
    "skandha": 9,
    "chapter": 1,
    "sloka": 11,
    "sanskrit": "ततो मनुः श्राद्धदेवः संज्ञायामास भारत श्रद्धायां जनयामास दश पुत्रान्स आत्मवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-012",
    "skandha": 9,
    "chapter": 1,
    "sloka": 12,
    "sanskrit": "इक्ष्वाकुनृगशर्याति दिष्टधृष्टकरूषकान् नरिष्यन्तं पृषध्रं च नभगं च कविं विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-013",
    "skandha": 9,
    "chapter": 1,
    "sloka": 13,
    "sanskrit": "अप्रजस्य मनोः पूर्वं वसिष्ठो भगवान्किल मित्रावरुणयोरिष्टिं प्रजार्थमकरोद्विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-014",
    "skandha": 9,
    "chapter": 1,
    "sloka": 14,
    "sanskrit": "तत्र श्रद्धा मनोः पत्नी होतारं समयाचत दुहित्रर्थमुपागम्य प्रणिपत्य पयोव्रता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-015",
    "skandha": 9,
    "chapter": 1,
    "sloka": 15,
    "sanskrit": "प्रेषितोऽध्वर्युणा होता व्यचरत्तत्समाहितः गृहीते हविषि वाचा वषट्कारं गृणन्द्विजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-016",
    "skandha": 9,
    "chapter": 1,
    "sloka": 16,
    "sanskrit": "होतुस्तद्व्यभिचारेण कन्येला नाम साभवत् तां विलोक्य मनुः प्राह नातितुष्टमना गुरुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-017",
    "skandha": 9,
    "chapter": 1,
    "sloka": 17,
    "sanskrit": "भगवन्किमिदं जातं कर्म वो ब्रह्मवादिनाम् विपर्ययमहो कष्टं मैवं स्याद्ब्रह्मविक्रिया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-018",
    "skandha": 9,
    "chapter": 1,
    "sloka": 18,
    "sanskrit": "यूयं ब्रह्मविदो युक्तास्तपसा दग्धकिल्बिषाः कुतः सङ्कल्पवैषम्यमनृतं विबुधेष्विव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-019",
    "skandha": 9,
    "chapter": 1,
    "sloka": 19,
    "sanskrit": "निशम्य तद्वचस्तस्य भगवान्प्रपितामहः होतुर्व्यतिक्रमं ज्ञात्वा बभाषे रविनन्दनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-020",
    "skandha": 9,
    "chapter": 1,
    "sloka": 20,
    "sanskrit": "एतत्सङ्कल्पवैषम्यं होतुस्ते व्यभिचारतः तथापि साधयिष्ये ते सुप्रजास्त्वं स्वतेजसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-021",
    "skandha": 9,
    "chapter": 1,
    "sloka": 21,
    "sanskrit": "एवं व्यवसितो राजन्भगवान्स महायशाः अस्तौषीदादिपुरुषमिलायाः पुंस्त्वकाम्यया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-022",
    "skandha": 9,
    "chapter": 1,
    "sloka": 22,
    "sanskrit": "तस्मै कामवरं तुष्टो भगवान्हरिरीश्वरः ददाविलाभवत्तेन सुद्युम्नः पुरुषर्षभः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-023",
    "skandha": 9,
    "chapter": 1,
    "sloka": 23,
    "sanskrit": "स एकदा महाराज विचरन्मृगयां वने वृतः कतिपयामात्यैरश्वमारुह्य सैन्धवम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-024",
    "skandha": 9,
    "chapter": 1,
    "sloka": 24,
    "sanskrit": "प्रगृह्य रुचिरं चापं शरांश्च परमाद्भुतान् दंशितोऽनुमृगं वीरो जगाम दिशमुत्तराम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-025",
    "skandha": 9,
    "chapter": 1,
    "sloka": 25,
    "sanskrit": "सुकुमारवनं मेरोरधस्तात्प्रविवेश ह यत्रास्ते भगवाञ्छर्वो रममाणः सहोमया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-026",
    "skandha": 9,
    "chapter": 1,
    "sloka": 26,
    "sanskrit": "तस्मिन्प्रविष्ट एवासौ सुद्युम्नः परवीरहा अपश्यत्स्त्रियमात्मानमश्वं च वडवां नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-027",
    "skandha": 9,
    "chapter": 1,
    "sloka": 27,
    "sanskrit": "तथा तदनुगाः सर्वे आत्मलिङ्गविपर्ययम् दृष्ट्वा विमनसोऽभूवन्वीक्षमाणाः परस्परम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-028",
    "skandha": 9,
    "chapter": 1,
    "sloka": 28,
    "sanskrit": "कथमेवं गुणो देशः केन वा भगवन्कृतः प्रश्नमेनं समाचक्ष्व परं कौतूहलं हि नः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीराजोवाच ।"
  },
  {
    "id": "skandha-09-chapter-01-sloka-029",
    "skandha": 9,
    "chapter": 1,
    "sloka": 29,
    "sanskrit": "एकदा गिरिशं द्रष्टुमृषयस्तत्र सुव्रताः दिशो वितिमिराभासाः कुर्वन्तः समुपागमन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-09-chapter-01-sloka-030",
    "skandha": 9,
    "chapter": 1,
    "sloka": 30,
    "sanskrit": "तान्विलोक्याम्बिका देवी विवासा व्रीडिता भृशम् भर्तुरङ्कात्समुत्थाय नीवीमाश्वथ पर्यधात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-031",
    "skandha": 9,
    "chapter": 1,
    "sloka": 31,
    "sanskrit": "ऋषयोऽपि तयोर्वीक्ष्य प्रसङ्गं रममाणयोः निवृत्ताः प्रययुस्तस्मान्नरनारायणाश्रमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-032",
    "skandha": 9,
    "chapter": 1,
    "sloka": 32,
    "sanskrit": "तदिदं भगवानाह प्रियायाः प्रियकाम्यया स्थानं यः प्रविशेदेतत्स वै योषिद्भवेदिति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-033",
    "skandha": 9,
    "chapter": 1,
    "sloka": 33,
    "sanskrit": "तत ऊर्ध्वं वनं तद्वै पुरुषा वर्जयन्ति हि सा चानुचरसंयुक्ता विचचार वनाद्वनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-034",
    "skandha": 9,
    "chapter": 1,
    "sloka": 34,
    "sanskrit": "अथ तामाश्रमाभ्याशे चरन्तीं प्रमदोत्तमाम् स्त्रीभिः परिवृतां वीक्ष्य चकमे भगवान्बुधः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-035",
    "skandha": 9,
    "chapter": 1,
    "sloka": 35,
    "sanskrit": "सापि तं चकमे सुभ्रूः सोमराजसुतं पतिम् स तस्यां जनयामास पुरूरवसमात्मजम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-036",
    "skandha": 9,
    "chapter": 1,
    "sloka": 36,
    "sanskrit": "एवं स्त्रीत्वमनुप्राप्तः सुद्युम्नो मानवो नृपः सस्मार स कुलाचार्यं वसिष्ठमिति शुश्रुम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-037",
    "skandha": 9,
    "chapter": 1,
    "sloka": 37,
    "sanskrit": "स तस्य तां दशां दृष्ट्वा कृपया भृशपीडितः सुद्युम्नस्याशयन्पुंस्त्वमुपाधावत शङ्करम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-038",
    "skandha": 9,
    "chapter": 1,
    "sloka": 38,
    "sanskrit": "तुष्टस्तस्मै स भगवानृषये प्रियमावहन् स्वां च वाचमृतां कुर्वन्निदमाह विशाम्पते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-039",
    "skandha": 9,
    "chapter": 1,
    "sloka": 39,
    "sanskrit": "मासं पुमान्स भविता मासं स्त्री तव गोत्रजः इत्थं व्यवस्थया कामं सुद्युम्नोऽवतु मेदिनीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-040",
    "skandha": 9,
    "chapter": 1,
    "sloka": 40,
    "sanskrit": "आचार्यानुग्रहात्कामं लब्ध्वा पुंस्त्वं व्यवस्थया पालयामास जगतीं नाभ्यनन्दन्स्म तं प्रजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-041",
    "skandha": 9,
    "chapter": 1,
    "sloka": 41,
    "sanskrit": "तस्योत्कलो गयो राजन्विमलश्च त्रयः सुताः दक्षिणापथराजानो बभूवुर्धर्मवत्सलाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-09-chapter-01-sloka-042",
    "skandha": 9,
    "chapter": 1,
    "sloka": 42,
    "sanskrit": "ततः परिणते काले प्रतिष्ठानपतिः प्रभुः पुरूरवस उत्सृज्य गां पुत्राय गतो वनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]