[
  {
    "id": "skandha-12-chapter-01-sloka-001",
    "skandha": 12,
    "chapter": 1,
    "sloka": 1,
    "sanskrit": "योऽन्त्यः पुरञ्जयो नाम भविष्यो बारहद्रथः तस्यामात्यस्तु शुनको हत्वा स्वामिनमात्मजम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-12-chapter-01-sloka-002",
    "skandha": 12,
    "chapter": 1,
    "sloka": 2,
    "sanskrit": "प्रद्योतसंज्ञं राजानं कर्ता यत्पालकः सुतः विशाखयूपस्तत्पुत्रो भविता राजकस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-003",
    "skandha": 12,
    "chapter": 1,
    "sloka": 3,
    "sanskrit": "नन्दिवर्धनस्तत्पुत्रः पञ्च प्रद्योतना इमे अष्टत्रिंशोत्तरशतं भोक्ष्यन्ति पृथिवीं नृपाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-004",
    "skandha": 12,
    "chapter": 1,
    "sloka": 4,
    "sanskrit": "शिशुनागस्ततो भाव्यः काकवर्णस्तु तत्सुतः क्षेमधर्मा तस्य सुतः क्षेत्रज्ञः क्षेमधर्मजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-005",
    "skandha": 12,
    "chapter": 1,
    "sloka": 5,
    "sanskrit": "विधिसारः सुतस्तस्या जातशत्रुर्भविष्यति दर्भकस्तत्सुतो भावी दर्भकस्याजयः स्मृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-006",
    "skandha": 12,
    "chapter": 1,
    "sloka": 6,
    "sanskrit": "नन्दिवर्धन आजेयो महानन्दिः सुतस्ततः शिशुनागा दशैवैते सष्ट्युत्तरशतत्रयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-007",
    "skandha": 12,
    "chapter": 1,
    "sloka": 7,
    "sanskrit": "समा भोक्ष्यन्ति पृथिवीं कुरुश्रेष्ठ कलौ नृपाः महानन्दिसुतो राजन्शूद्रागर्भोद्भवो बली",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-008",
    "skandha": 12,
    "chapter": 1,
    "sloka": 8,
    "sanskrit": "महापद्मपतिः कश्चिन्नन्दः क्षत्रविनाशकृत् ततो नृपा भविष्यन्ति शूद्रप्रायास्त्वधार्मिकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-009",
    "skandha": 12,
    "chapter": 1,
    "sloka": 9,
    "sanskrit": "स एकच्छत्रां पृथिवीमनुल्लङ्घितशासनः शासिष्यति महापद्मो द्वितीय इव भार्गवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-010",
    "skandha": 12,
    "chapter": 1,
    "sloka": 10,
    "sanskrit": "तस्य चाष्टौ भविष्यन्ति सुमाल्यप्रमुखाः सुताः य इमां भोक्ष्यन्ति महीं राजानश्च शतं समाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-011",
    "skandha": 12,
    "chapter": 1,
    "sloka": 11,
    "sanskrit": "नव नन्दान्द्विजः कश्चित्प्रपन्नानुद्धरिष्यति तेषां अभावे जगतीं मौर्या भोक्ष्यन्ति वै कलौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-012",
    "skandha": 12,
    "chapter": 1,
    "sloka": 12,
    "sanskrit": "स एव चन्द्रगुप्तं वै द्विजो राज्येऽभिषेक्ष्यति तत्सुतो वारिसारस्तु ततश्चाशोकवर्धनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-013",
    "skandha": 12,
    "chapter": 1,
    "sloka": 13,
    "sanskrit": "सुयशा भविता तस्य सङ्गतः सुयशःसुतः शालिशूकस्ततस्तस्य सोमशर्मा भविष्यति शतधन्वा ततस्तस्य भविता तद्बृहद्रथः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-014",
    "skandha": 12,
    "chapter": 1,
    "sloka": 14,
    "sanskrit": "मौर्या ह्येते दश नृपाः सप्तत्रिंशच्छतोत्तरम् समा भोक्ष्यन्ति पृथिवीं कलौ कुरुकुलोद्वह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-015",
    "skandha": 12,
    "chapter": 1,
    "sloka": 15,
    "sanskrit": "अग्निमित्रस्ततस्तस्मात्सुज्येष्ठो भविता ततः वसुमित्रो भद्रकश्च पुलिन्दो भविता सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-016",
    "skandha": 12,
    "chapter": 1,
    "sloka": 16,
    "sanskrit": "ततो घोषः सुतस्तस्माद्वज्रमित्रो भविष्यति ततो भागवतस्तस्माद्देवभूतिः कुरूद्वह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-017",
    "skandha": 12,
    "chapter": 1,
    "sloka": 17,
    "sanskrit": "शुङ्गा दशैते भोक्ष्यन्ति भूमिं वर्षशताधिकम् ततः काण्वानियं भूमिर्यास्यत्यल्पगुणान्नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-018",
    "skandha": 12,
    "chapter": 1,
    "sloka": 18,
    "sanskrit": "शुङ्गं हत्वा देवभूतिं काण्वोऽमात्यस्तु कामिनम् स्वयं करिष्यते राज्यं वसुदेवो महामतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-019",
    "skandha": 12,
    "chapter": 1,
    "sloka": 19,
    "sanskrit": "तस्य पुत्रस्तु भूमित्रस्तस्य नारायणः सुतः काण्वायना इमे भूमिं चत्वारिंशच्च पञ्च च शतानि त्रीणि भोक्ष्यन्ति वर्षाणां च कलौ युगे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-020",
    "skandha": 12,
    "chapter": 1,
    "sloka": 20,
    "sanskrit": "हत्वा काण्वं सुशर्माणं तद्भृत्यो वृषलो बली गां भोक्ष्यत्यन्ध्रजातीयः कञ्चित्कालमसत्तमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-021",
    "skandha": 12,
    "chapter": 1,
    "sloka": 21,
    "sanskrit": "कृष्णनामाथ तद्भ्राता भविता पृथिवीपतिः श्रीशान्तकर्णस्तत्पुत्रः पौर्णमासस्तु तत्सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-022",
    "skandha": 12,
    "chapter": 1,
    "sloka": 22,
    "sanskrit": "लम्बोदरस्तु तत्पुत्रस्तस्माच्चिबिलको नृपः मेघस्वातिश्चिबिलकादटमानस्तु तस्य च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-023",
    "skandha": 12,
    "chapter": 1,
    "sloka": 23,
    "sanskrit": "अनिष्टकर्मा हालेयस्तलकस्तस्य चात्मजः पुरीषभीरुस्तत्पुत्रस्ततो राजा सुनन्दनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-024",
    "skandha": 12,
    "chapter": 1,
    "sloka": 24,
    "sanskrit": "चकोरो बहवो यत्र शिवस्वातिररिन्दमः तस्यापि गोमती पुत्रः पुरीमान्भविता ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-025",
    "skandha": 12,
    "chapter": 1,
    "sloka": 25,
    "sanskrit": "मेदशिराः शिवस्कन्दो यज्ञश्रीस्तत्सुतस्ततः विजयस्तत्सुतो भाव्यश्चन्द्रविज्ञः सलोमधिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-026",
    "skandha": 12,
    "chapter": 1,
    "sloka": 26,
    "sanskrit": "एते त्रिंशन्नृपतयश्चत्वार्यब्दशतानि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-027",
    "skandha": 12,
    "chapter": 1,
    "sloka": 27,
    "sanskrit": "सप्ताभीरा आवभृत्या दश गर्दभिनो नृपाः षट्पञ्चाशच्च पृथिवीं भोक्ष्यन्ति कुरुनन्दन कङ्काः षोडश भूपाला भविष्यन्त्यतिलोलुपाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-028",
    "skandha": 12,
    "chapter": 1,
    "sloka": 28,
    "sanskrit": "ततोऽष्टौ यवना भाव्याश्चतुर्दश तुरुष्ककाः भूयो दश गुरुण्डाश्च मौला एकादशैव तु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-029",
    "skandha": 12,
    "chapter": 1,
    "sloka": 29,
    "sanskrit": "एते भोक्ष्यन्ति पृथिवीं दश वर्षशतानि च नवाधिकां च नवतिं मौला एकादश क्षितिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-030",
    "skandha": 12,
    "chapter": 1,
    "sloka": 30,
    "sanskrit": "भोक्ष्यन्त्यब्दशतान्यङ्ग त्रीणि तैः संस्थिते ततः किलकिलायां नृपतयो भूतनन्दोऽथ वङ्गिरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-031",
    "skandha": 12,
    "chapter": 1,
    "sloka": 31,
    "sanskrit": "शिशुनन्दिश्च तद्भ्राता यशोनन्दिः प्रवीरकः इत्येते वै वर्षशतं भविष्यन्त्यधिकानि षट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-032",
    "skandha": 12,
    "chapter": 1,
    "sloka": 32,
    "sanskrit": "तेषां त्रयोदश सुता भवितारश्च बाह्लिकाः पुष्पमित्रोऽथ राजन्यो दुर्मित्रोऽस्य तथैव च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-033",
    "skandha": 12,
    "chapter": 1,
    "sloka": 33,
    "sanskrit": "एककाला इमे भूपाः सप्तान्ध्राः सप्त कौशलाः विदूरपतयो भाव्या निषधास्तत एव हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-034",
    "skandha": 12,
    "chapter": 1,
    "sloka": 34,
    "sanskrit": "मागधानां तु भविता विश्वस्फूर्जिः पुरञ्जयः करिष्यत्यपरो वर्णान्पुलिन्दयदुमद्रकान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-035",
    "skandha": 12,
    "chapter": 1,
    "sloka": 35,
    "sanskrit": "प्रजाश्चाब्रह्मभूयिष्ठाः स्थापयिष्यति दुर्मतिः वीर्यवान्क्षत्रमुत्साद्य पद्मवत्यां स वै पुरि अनुगङ्गमाप्रयागं गुप्तां भोक्ष्यति मेदिनीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-036",
    "skandha": 12,
    "chapter": 1,
    "sloka": 36,
    "sanskrit": "सौराष्ट्रावन्त्याभीराश्च शूरा अर्बुदमालवाः व्रात्या द्विजा भविष्यन्ति शूद्रप्राया जनाधिपाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-037",
    "skandha": 12,
    "chapter": 1,
    "sloka": 37,
    "sanskrit": "सिन्धोस्तटं चन्द्रभागां कौन्तीं काश्मीरमण्डलम् भोक्ष्यन्ति शूद्रा व्रात्याद्या म्लेच्छाश्चाब्रह्मवर्चसः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-038",
    "skandha": 12,
    "chapter": 1,
    "sloka": 38,
    "sanskrit": "तुल्यकाला इमे राजन्म्लेच्छप्रायाश्च भूभृतः एतेऽधर्मानृतपराः फल्गुदास्तीव्रमन्यवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-039",
    "skandha": 12,
    "chapter": 1,
    "sloka": 39,
    "sanskrit": "स्त्रीबालगोद्विजघ्नाश्च परदारधनादृताः उदितास्तमितप्राया अल्पसत्त्वाल्पकायुषः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-040",
    "skandha": 12,
    "chapter": 1,
    "sloka": 40,
    "sanskrit": "असंस्कृताः क्रियाहीना रजसा तमसावृताः प्रजास्ते भक्षयिष्यन्ति म्लेच्छा राजन्यरूपिणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-01-sloka-041",
    "skandha": 12,
    "chapter": 1,
    "sloka": 41,
    "sanskrit": "तन्नाथास्ते जनपदास्तच्छीलाचारवादिनः अन्योन्यतो राजभिश्च क्षयं यास्यन्ति पीडिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]