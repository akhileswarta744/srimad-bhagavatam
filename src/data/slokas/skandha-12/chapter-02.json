[
  {
    "id": "skandha-12-chapter-02-sloka-001",
    "skandha": 12,
    "chapter": 2,
    "sloka": 1,
    "sanskrit": "ततश्चानुदिनं धर्मः सत्यं शौचं क्षमा दया कालेन बलिना राजन्नङ्क्ष्यत्यायुर्बलं स्मृतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-12-chapter-02-sloka-002",
    "skandha": 12,
    "chapter": 2,
    "sloka": 2,
    "sanskrit": "वित्तमेव कलौ नॄणां जन्माचारगुणोदयः धर्मन्यायव्यवस्थायां कारणं बलमेव हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-003",
    "skandha": 12,
    "chapter": 2,
    "sloka": 3,
    "sanskrit": "दाम्पत्येऽभिरुचिर्हेतुर्मायैव व्यावहारिके स्त्रीत्वे पुंस्त्वे च हि रतिर्विप्रत्वे सूत्रमेव हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-004",
    "skandha": 12,
    "chapter": 2,
    "sloka": 4,
    "sanskrit": "लिङ्गं एवाश्रमख्यातावन्योन्यापत्तिकारणम् अवृत्त्या न्यायदौर्बल्यं पाण्डित्ये चापलं वचः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-005",
    "skandha": 12,
    "chapter": 2,
    "sloka": 5,
    "sanskrit": "अनाढ्यतैवासाधुत्वे साधुत्वे दम्भ एव तु स्वीकार एव चोद्वाहे स्नानमेव प्रसाधनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-006",
    "skandha": 12,
    "chapter": 2,
    "sloka": 6,
    "sanskrit": "दूरे वार्ययनं तीर्थं लावण्यं केशधारणम् उदरंभरता स्वार्थः सत्यत्वे धार्ष्ट्यमेव हि दाक्ष्यं कुटुम्बभरणं यशोऽर्थे धर्मसेवनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-007",
    "skandha": 12,
    "chapter": 2,
    "sloka": 7,
    "sanskrit": "एवं प्रजाभिर्दुष्टाभिराकीर्णे क्षितिमण्डले ब्रह्मविट्क्षत्रशूद्राणां यो बली भविता नृपः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-008",
    "skandha": 12,
    "chapter": 2,
    "sloka": 8,
    "sanskrit": "प्रजा हि लुब्धै राजन्यैर्निर्घृणैर्दस्युधर्मभिः आच्छिन्नदारद्रविणा यास्यन्ति गिरिकाननम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-009",
    "skandha": 12,
    "chapter": 2,
    "sloka": 9,
    "sanskrit": "शाकमूलामिषक्षौद्र फलपुष्पाष्टिभोजनाः अनावृष्ट्या विनङ्क्ष्यन्ति दुर्भिक्षकरपीडिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-010",
    "skandha": 12,
    "chapter": 2,
    "sloka": 10,
    "sanskrit": "शीतवातातपप्रावृड् हिमैरन्योन्यतः प्रजाः क्षुत्तृड्भ्यां व्याधिभिश्चैव सन्तप्स्यन्ते च चिन्तया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-011",
    "skandha": 12,
    "chapter": 2,
    "sloka": 11,
    "sanskrit": "त्रिंशद्विंशति वर्षाणि परमायुः कलौ नृणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-012",
    "skandha": 12,
    "chapter": 2,
    "sloka": 12,
    "sanskrit": "क्षीयमाणेषु देहेषु देहिनां कलिदोषतः वर्णाश्रमवतां धर्मे नष्टे वेदपथे नृणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-013",
    "skandha": 12,
    "chapter": 2,
    "sloka": 13,
    "sanskrit": "पाषण्डप्रचुरे धर्मे दस्युप्रायेषु राजसु चौर्यानृतवृथाहिंसा नानावृत्तिषु वै नृषु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-014",
    "skandha": 12,
    "chapter": 2,
    "sloka": 14,
    "sanskrit": "शूद्रप्रायेषु वर्णेषु च्छागप्रायासु धेनुषु गृहप्रायेष्वाश्रमेषु यौनप्रायेषु बन्धुषु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-015",
    "skandha": 12,
    "chapter": 2,
    "sloka": 15,
    "sanskrit": "अणुप्रायास्वोषधीषु शमीप्रायेषु स्थास्नुषु विद्युत्प्रायेषु मेघेषु शून्यप्रायेषु सद्मसु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-016",
    "skandha": 12,
    "chapter": 2,
    "sloka": 16,
    "sanskrit": "इत्थं कलौ गतप्राये जनेषु खरधर्मिषु धर्मत्राणाय सत्त्वेन भगवानवतरिष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-017",
    "skandha": 12,
    "chapter": 2,
    "sloka": 17,
    "sanskrit": "चराचरगुरोर्विष्णोरीश्वरस्याखिलात्मनः धर्मत्राणाय साधूनां जन्म कर्मापनुत्तये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-018",
    "skandha": 12,
    "chapter": 2,
    "sloka": 18,
    "sanskrit": "शम्भलग्राममुख्यस्य ब्राह्मणस्य महात्मनः भवने विष्णुयशसः कल्किः प्रादुर्भविष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-019",
    "skandha": 12,
    "chapter": 2,
    "sloka": 19,
    "sanskrit": "अश्वमाशुगमारुह्य देवदत्तं जगत्पतिः असिनासाधुदमनमष्टैश्वर्यगुणान्वितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-020",
    "skandha": 12,
    "chapter": 2,
    "sloka": 20,
    "sanskrit": "विचरन्नाशुना क्षौण्यां हयेनाप्रतिमद्युतिः नृपलिङ्गच्छदो दस्यून्कोटिशो निहनिष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-021",
    "skandha": 12,
    "chapter": 2,
    "sloka": 21,
    "sanskrit": "अथ तेषां भविष्यन्ति मनांसि विशदानि वै वासुदेवाङ्गरागाति पुण्यगन्धानिलस्पृशाम् पौरजानपदानां वै हतेष्वखिलदस्युषु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-022",
    "skandha": 12,
    "chapter": 2,
    "sloka": 22,
    "sanskrit": "तेषां प्रजाविसर्गश्च स्थविष्ठः सम्भविष्यति वासुदेवे भगवति सत्त्वमूर्तौ हृदि स्थिते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-023",
    "skandha": 12,
    "chapter": 2,
    "sloka": 23,
    "sanskrit": "यदावतीर्णो भगवान्कल्किर्धर्मपतिर्हरिः कृतं भविष्यति तदा प्रजासूतिश्च सात्त्विकी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-024",
    "skandha": 12,
    "chapter": 2,
    "sloka": 24,
    "sanskrit": "यदा चन्द्रश्च सूर्यश्च तथा तिष्यबृहस्पती एकराशौ समेष्यन्ति भविष्यति तदा कृतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-025",
    "skandha": 12,
    "chapter": 2,
    "sloka": 25,
    "sanskrit": "येऽतीता वर्तमाना ये भविष्यन्ति च पार्थिवाः ते त उद्देशतः प्रोक्ता वंशीयाः सोमसूर्ययोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-026",
    "skandha": 12,
    "chapter": 2,
    "sloka": 26,
    "sanskrit": "आरभ्य भवतो जन्म यावन्नन्दाभिषेचनम् एतद्वर्षसहस्रं तु शतं पञ्चदशोत्तरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-027",
    "skandha": 12,
    "chapter": 2,
    "sloka": 27,
    "sanskrit": "सप्तर्षीणां तु यौ पूर्वौ दृश्येते उदितौ दिवि तयोस्तु मध्ये नक्षत्रं दृश्यते यत्समं निशि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-028",
    "skandha": 12,
    "chapter": 2,
    "sloka": 28,
    "sanskrit": "तेनैव ऋषयो युक्तास्तिष्ठन्त्यब्दशतं नृणाम् ते त्वदीये द्विजाः काल अधुना चाश्रिता मघाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-029",
    "skandha": 12,
    "chapter": 2,
    "sloka": 29,
    "sanskrit": "विष्णोर्भगवतो भानुः कृष्णाख्योऽसौ दिवं गतः तदाविशत्कलिर्लोकं पापे यद्रमते जनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-030",
    "skandha": 12,
    "chapter": 2,
    "sloka": 30,
    "sanskrit": "यावत्स पादपद्माभ्यां स्पृशनास्ते रमापतिः तावत्कलिर्वै पृथिवीं पराक्रन्तुं न चाशकत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-031",
    "skandha": 12,
    "chapter": 2,
    "sloka": 31,
    "sanskrit": "यदा देवर्षयः सप्त मघासु विचरन्ति हि तदा प्रवृत्तस्तु कलिर्द्वादशाब्दशतात्मकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-032",
    "skandha": 12,
    "chapter": 2,
    "sloka": 32,
    "sanskrit": "यदा मघाभ्यो यास्यन्ति पूर्वाषाढां महर्षयः तदा नन्दात्प्रभृत्येष कलिर्वृद्धिं गमिष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-033",
    "skandha": 12,
    "chapter": 2,
    "sloka": 33,
    "sanskrit": "यस्मिन्कृष्णो दिवं यातस्तस्मिन्नेव तदाहनि प्रतिपन्नं कलियुगमिति प्राहुः पुराविदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-034",
    "skandha": 12,
    "chapter": 2,
    "sloka": 34,
    "sanskrit": "दिव्याब्दानां सहस्रान्ते चतुर्थे तु पुनः कृतम् भविष्यति तदा नॄणां मन आत्मप्रकाशकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-035",
    "skandha": 12,
    "chapter": 2,
    "sloka": 35,
    "sanskrit": "इत्येष मानवो वंशो यथा सङ्ख्यायते भुवि तथा विट्शूद्रविप्राणां तास्ता ज्ञेया युगे युगे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-036",
    "skandha": 12,
    "chapter": 2,
    "sloka": 36,
    "sanskrit": "एतेषां नामलिङ्गानां पुरुषाणां महात्मनाम् कथामात्रावशिष्टानां कीर्तिरेव स्थिता भुवि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-037",
    "skandha": 12,
    "chapter": 2,
    "sloka": 37,
    "sanskrit": "देवापिः शान्तनोर्भ्राता मरुश्चेक्ष्वाकुवंशजः कलापग्राम आसाते महायोगबलान्वितौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-038",
    "skandha": 12,
    "chapter": 2,
    "sloka": 38,
    "sanskrit": "ताविहैत्य कलेरन्ते वासुदेवानुशिक्षितौ वर्णाश्रमयुतं धर्मं पूर्ववत्प्रथयिष्यतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-039",
    "skandha": 12,
    "chapter": 2,
    "sloka": 39,
    "sanskrit": "कृतं त्रेता द्वापरं च कलिश्चेति चतुर्युगम् अनेन क्रमयोगेन भुवि प्राणिषु वर्तते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-040",
    "skandha": 12,
    "chapter": 2,
    "sloka": 40,
    "sanskrit": "राजन्नेते मया प्रोक्ता नरदेवास्तथापरे भूमौ ममत्वं कृत्वान्ते हित्वेमां निधनं गताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-041",
    "skandha": 12,
    "chapter": 2,
    "sloka": 41,
    "sanskrit": "कृमिविड्भस्मसंज्ञान्ते राजनाम्नोऽपि यस्य च भूतध्रुक्तत्कृते स्वार्थं किं वेद निरयो यतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-042",
    "skandha": 12,
    "chapter": 2,
    "sloka": 42,
    "sanskrit": "कथं सेयमखण्डा भूः पूर्वैर्मे पुरुषैर्धृता मत्पुत्रस्य च पौत्रस्य मत्पूर्वा वंशजस्य वा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-043",
    "skandha": 12,
    "chapter": 2,
    "sloka": 43,
    "sanskrit": "तेजोऽबन्नमयं कायं गृहीत्वात्मतयाबुधाः महीं ममतया चोभौ हित्वान्तेऽदर्शनं गताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-12-chapter-02-sloka-044",
    "skandha": 12,
    "chapter": 2,
    "sloka": 44,
    "sanskrit": "ये ये भूपतयो राजन्भुञ्जते भुवमोजसा कालेन ते कृताः सर्वे कथामात्राः कथासु च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]