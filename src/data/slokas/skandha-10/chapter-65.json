[
  {
    "id": "skandha-10-chapter-65-sloka-001",
    "skandha": 10,
    "chapter": 65,
    "sloka": 1,
    "sanskrit": "बलभद्रः कुरुश्रेष्ठ भगवान्रथमास्थितः सुहृद्दिदृक्षुरुत्कण्ठः प्रययौ नन्दगोकुलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-65-sloka-002",
    "skandha": 10,
    "chapter": 65,
    "sloka": 2,
    "sanskrit": "परिष्वक्तश्चिरोत्कण्ठैर्गोपैर्गोपीभिरेव च रामोऽभिवाद्य पितरावाशीर्भिरभिनन्दितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-003",
    "skandha": 10,
    "chapter": 65,
    "sloka": 3,
    "sanskrit": "चिरं नः पाहि दाशार्ह सानुजो जगदीश्वरः इत्यारोप्याङ्कमालिङ्ग्य नेत्रैः सिषिचतुर्जलैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-004",
    "skandha": 10,
    "chapter": 65,
    "sloka": 4,
    "sanskrit": "गोपवृद्धांश्च विधिवद्यविष्ठैरभिवन्दितः यथावयो यथासख्यं यथासम्बन्धमात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-005",
    "skandha": 10,
    "chapter": 65,
    "sloka": 5,
    "sanskrit": "समुपेत्याथ गोपालान्हास्यहस्तग्रहादिभिः विश्रान्तम्सुखमासीनं पप्रच्छुः पर्युपागताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-006",
    "skandha": 10,
    "chapter": 65,
    "sloka": 6,
    "sanskrit": "पृष्टाश्चानामयं स्वेषु प्रेमगद्गदया गिरा कृष्णे कमलपत्राक्षे सन्न्यस्ताखिलराधसः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-007",
    "skandha": 10,
    "chapter": 65,
    "sloka": 7,
    "sanskrit": "कच्चिन्नो बान्धवा राम सर्वे कुशलमासते कच्चित्स्मरथ नो राम यूयं दारसुतान्विताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-008",
    "skandha": 10,
    "chapter": 65,
    "sloka": 8,
    "sanskrit": "दिष्ट्या कंसो हतः पापो दिष्ट्या मुक्ताः सुहृज्जनाः निहत्य निर्जित्य रिपून्दिष्ट्या दुर्गं समाश्रीताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-009",
    "skandha": 10,
    "chapter": 65,
    "sloka": 9,
    "sanskrit": "गोप्यो हसन्त्यः पप्रच्छू रामसन्दर्शनादृताः कच्चिदास्ते सुखं कृष्णः पुरस्त्रीजनवल्लभः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-010",
    "skandha": 10,
    "chapter": 65,
    "sloka": 10,
    "sanskrit": "कच्चित्स्मरति वा बन्धून्पितरं मातरं च सः अप्यसौ मातरं द्रष्टुं सकृदप्यागमिष्यति अपि वा स्मरतेऽस्माकमनुसेवां महाभुजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-011",
    "skandha": 10,
    "chapter": 65,
    "sloka": 11,
    "sanskrit": "मातरं पितरं भ्रातॄन्पतीन्पुत्रान्स्वसॄनपि यदर्थे जहिम दाशार्ह दुस्त्यजान्स्वजनान्प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-012",
    "skandha": 10,
    "chapter": 65,
    "sloka": 12,
    "sanskrit": "ता नः सद्यः परित्यज्य गतः सञ्छिन्नसौहृदः कथं नु तादृशं स्त्रीभिर्न श्रद्धीयेत भाषितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-013",
    "skandha": 10,
    "chapter": 65,
    "sloka": 13,
    "sanskrit": "कथं नु गृह्णन्त्यनवस्थितात्मनो वचः कृतघ्नस्य बुधाः पुरस्त्रियः गृह्णन्ति वै चित्रकथस्य सुन्दर स्मितावलोकोच्छ्वसितस्मरातुराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-014",
    "skandha": 10,
    "chapter": 65,
    "sloka": 14,
    "sanskrit": "किं नस्तत्कथया गोप्यः कथाः कथयतापराः यात्यस्माभिर्विना कालो यदि तस्य तथैव नः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-015",
    "skandha": 10,
    "chapter": 65,
    "sloka": 15,
    "sanskrit": "इति प्रहसितं शौरेर्जल्पितं चारुवीक्षितम् गतिं प्रेमपरिष्वङ्गं स्मरन्त्यो रुरुदुः स्त्रियः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-016",
    "skandha": 10,
    "chapter": 65,
    "sloka": 16,
    "sanskrit": "सङ्कर्षणस्ताः कृष्णस्य सन्देशैर्हृदयंगमैः सान्त्वयामास भगवान्नानानुनयकोविदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-017",
    "skandha": 10,
    "chapter": 65,
    "sloka": 17,
    "sanskrit": "द्वौ मासौ तत्र चावात्सीन्मधुं माधवं एव च रामः क्षपासु भगवान्गोपीनां रतिमावहन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-018",
    "skandha": 10,
    "chapter": 65,
    "sloka": 18,
    "sanskrit": "पूर्णचन्द्रकलामृष्टे कौमुदीगन्धवायुना यमुनोपवने रेमे सेविते स्त्रीगणैर्वृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-019",
    "skandha": 10,
    "chapter": 65,
    "sloka": 19,
    "sanskrit": "वरुणप्रेषिता देवी वारुणी वृक्षकोटरात् पतन्ती तद्वनं सर्वं स्वगन्धेनाध्यवासयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-020",
    "skandha": 10,
    "chapter": 65,
    "sloka": 20,
    "sanskrit": "तं गन्धं मधुधाराया वायुनोपहृतं बलः आघ्रायोपगतस्तत्र ललनाभिः समं पपौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-021",
    "skandha": 10,
    "chapter": 65,
    "sloka": 21,
    "sanskrit": "उपगीयमानो गन्धर्वैर्वनिताशोभिमण्डले रेमे करेणुयूथेशो माहेन्द्र इव वारणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-022",
    "skandha": 10,
    "chapter": 65,
    "sloka": 22,
    "sanskrit": "नेदुर्दुन्दुभयो व्योम्नि ववृषुः कुसुमैर्मुदा गन्धर्वा मुनयो रामं तद्वीर्यैरीडिरे तदा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-023",
    "skandha": 10,
    "chapter": 65,
    "sloka": 23,
    "sanskrit": "उपगीयमानचरितो वनिताभिर्हलायुध वनेषु व्यचरत्क्षीवो मदविह्वललोचनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-024",
    "skandha": 10,
    "chapter": 65,
    "sloka": 24,
    "sanskrit": "स्रग्व्येककुण्डलो मत्तो वैजयन्त्या च मालया बिभ्रत्स्मितमुखाम्भोजं स्वेदप्रालेयभूषितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-025",
    "skandha": 10,
    "chapter": 65,
    "sloka": 25,
    "sanskrit": "स आजुहाव यमुनां जलक्रीडार्थमीश्वरः अनागतां हलाग्रेण कुपितो विचकर्ष ह निजं वाक्यमनादृत्य मत्त इत्यापगां बलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-026",
    "skandha": 10,
    "chapter": 65,
    "sloka": 26,
    "sanskrit": "पापे त्वं मामवज्ञाय यन्नायासि मयाहुता नेष्ये त्वां लाङ्गलाग्रेण शतधा कामचारिणीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-027",
    "skandha": 10,
    "chapter": 65,
    "sloka": 27,
    "sanskrit": "एवं निर्भर्त्सिता भीता यमुना यदुनन्दनम् उवाच चकिता वाचं पतिता पादयोर्नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-028",
    "skandha": 10,
    "chapter": 65,
    "sloka": 28,
    "sanskrit": "राम राम महाबाहो न जाने तव विक्रमम् यस्यैकांशेन विधृता जगती जगतः पते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-029",
    "skandha": 10,
    "chapter": 65,
    "sloka": 29,
    "sanskrit": "परं भावं भगवतो भगवन्मामजानतीम् मोक्तुमर्हसि विश्वात्मन्प्रपन्नां भक्तवत्सल",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-030",
    "skandha": 10,
    "chapter": 65,
    "sloka": 30,
    "sanskrit": "ततो व्यमुञ्चद्यमुनां याचितो भगवान्बलः विजगाह जलं स्त्रीभिः करेणुभिरिवेभराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-031",
    "skandha": 10,
    "chapter": 65,
    "sloka": 31,
    "sanskrit": "कामं विहृत्य सलिलादुत्तीर्णायासीताम्बरे भूषणानि महार्हाणि ददौ कान्तिः शुभां स्रजम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-032",
    "skandha": 10,
    "chapter": 65,
    "sloka": 32,
    "sanskrit": "वसित्वा वाससी नीले मालां आमुच्य काञ्चनीम् रेये स्वलङ्कृतो लिप्तो माहेन्द्र इव वारणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-033",
    "skandha": 10,
    "chapter": 65,
    "sloka": 33,
    "sanskrit": "अद्यापि दृश्यते राजन्यमुनाकृष्टवर्त्मना बलस्यानन्तवीर्यस्य वीर्यं सूचयतीव हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-65-sloka-034",
    "skandha": 10,
    "chapter": 65,
    "sloka": 34,
    "sanskrit": "एवं सर्वा निशा याता एकेव रमतो व्रजे रामस्याक्षिप्तचित्तस्य माधुर्यैर्व्रजयोषिताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]