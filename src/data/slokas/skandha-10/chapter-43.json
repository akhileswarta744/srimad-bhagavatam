[
  {
    "id": "skandha-10-chapter-43-sloka-001",
    "skandha": 10,
    "chapter": 43,
    "sloka": 1,
    "sanskrit": "अथ कृष्णश्च रामश्च कृतशौचौ परन्तप मल्लदुन्दुभिनिर्घोषं श्रुत्वा द्रष्टुमुपेयतुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-43-sloka-002",
    "skandha": 10,
    "chapter": 43,
    "sloka": 2,
    "sanskrit": "रङ्गद्वारं समासाद्य तस्मिन्नागमवस्थितम् अपश्यत्कुवलयापीडं कृष्णोऽम्बष्ठप्रचोदितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-003",
    "skandha": 10,
    "chapter": 43,
    "sloka": 3,
    "sanskrit": "बद्ध्वा परिकरं शौरिः समुह्य कुटिलालकान् उवाच हस्तिपं वाचा मेघनादगभीरया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-004",
    "skandha": 10,
    "chapter": 43,
    "sloka": 4,
    "sanskrit": "अम्बष्ठाम्बष्ठ मार्गं नौ देह्यपक्रम मा चिरम् नो चेत्सकुञ्जरं त्वाद्य नयामि यमसादनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-005",
    "skandha": 10,
    "chapter": 43,
    "sloka": 5,
    "sanskrit": "एवं निर्भर्त्सितोऽम्बष्ठः कुपितः कोपितं गजम् चोदयामास कृष्णाय कालान्तकयमोपमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-006",
    "skandha": 10,
    "chapter": 43,
    "sloka": 6,
    "sanskrit": "करीन्द्रस्तमभिद्रुत्य करेण तरसाग्रहीत् कराद्विगलितः सोऽमुं निहत्याङ्घ्रिष्वलीयत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-007",
    "skandha": 10,
    "chapter": 43,
    "sloka": 7,
    "sanskrit": "सङ्क्रुद्धस्तमचक्षाणो घ्राणदृष्टिः स केशवम् परामृशत्पुष्करेण स प्रसह्य विनिर्गतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-008",
    "skandha": 10,
    "chapter": 43,
    "sloka": 8,
    "sanskrit": "पुच्छे प्रगृह्यातिबलं धनुषः पञ्चविंशतिम् विचकर्ष यथा नागं सुपर्ण इव लीलया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-009",
    "skandha": 10,
    "chapter": 43,
    "sloka": 9,
    "sanskrit": "स पर्यावर्तमानेन सव्यदक्षिणतोऽच्युतः बभ्राम भ्राम्यमाणेन गोवत्सेनेव बालकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-010",
    "skandha": 10,
    "chapter": 43,
    "sloka": 10,
    "sanskrit": "ततोऽभिमखमभ्येत्य पाणिनाहत्य वारणम् प्राद्रवन्पातयामास स्पृश्यमानः पदे पदे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-011",
    "skandha": 10,
    "chapter": 43,
    "sloka": 11,
    "sanskrit": "स धावन्क्रीदया भूमौ पतित्वा सहसोत्थितः तम्मत्वा पतितं क्रुद्धो दन्ताभ्यां सोऽहनत्क्षितिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-012",
    "skandha": 10,
    "chapter": 43,
    "sloka": 12,
    "sanskrit": "स्वविक्रमे प्रतिहते कुञ्जरेन्द्रोऽत्यमर्षितः चोद्यमानो महामात्रैः कृष्णमभ्यद्रवद्रुषा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-013",
    "skandha": 10,
    "chapter": 43,
    "sloka": 13,
    "sanskrit": "तमापतन्तमासाद्य भगवान्मधुसूदनः निगृह्य पाणिना हस्तं पातयामास भूतले",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-014",
    "skandha": 10,
    "chapter": 43,
    "sloka": 14,
    "sanskrit": "पतितस्य पदाक्रम्य मृगेन्द्र इव लीलया दन्तमुत्पाट्य तेनेभं हस्तिपांश्चाहनद्धरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-015",
    "skandha": 10,
    "chapter": 43,
    "sloka": 15,
    "sanskrit": "मृतकं द्विपमुत्सृज्य दन्तपाणिः समाविशत् अंसन्यस्तविषाणोऽसृङ् मदबिन्दुभिरङ्कितः विरूढस्वेदकणिका वदनाम्बुरुहो बभौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-016",
    "skandha": 10,
    "chapter": 43,
    "sloka": 16,
    "sanskrit": "वृतौ गोपैः कतिपयैर्बलदेवजनार्दनौ रङ्गं विविशतू राजन्गजदन्तवरायुधौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-017",
    "skandha": 10,
    "chapter": 43,
    "sloka": 17,
    "sanskrit": "मल्लानामशनिर्नृणां नरवरः स्त्रीणां स्मरो मूर्तिमान् गोपानां स्वजनोऽसतां क्षितिभुजां शास्ता स्वपित्रोः शिशुः मृत्युर्भोजपतेर्विराडविदुषां तत्त्वं परं योगिनां वृष्णीनां परदेवतेति विदितो रङ्गं गतः साग्रजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-018",
    "skandha": 10,
    "chapter": 43,
    "sloka": 18,
    "sanskrit": "हतं कुवलयापीडं दृष्ट्वा तावपि दुर्जयौ कंसो मनस्यपि तदा भृशमुद्विविजे नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-019",
    "skandha": 10,
    "chapter": 43,
    "sloka": 19,
    "sanskrit": "तौ रेजतू रङ्गगतौ महाभुजौ विचित्रवेषाभरणस्रगम्बरौ यथा नटावुत्तमवेषधारिणौ मनः क्षिपन्तौ प्रभया निरीक्षताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-020",
    "skandha": 10,
    "chapter": 43,
    "sloka": 20,
    "sanskrit": "निरीक्ष्य तावुत्तमपूरुषौ जना मञ्चस्थिता नागरराष्ट्रका नृप प्रहर्षवेगोत्कलितेक्षणाननाः पपुर्न तृप्ता नयनैस्तदाननम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-021",
    "skandha": 10,
    "chapter": 43,
    "sloka": 21,
    "sanskrit": "पिबन्त इव चक्षुर्भ्यां लिहन्त इव जिह्वया जिघ्रन्त इव नासाभ्यां श्लिष्यन्त इव बाहुभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-022",
    "skandha": 10,
    "chapter": 43,
    "sloka": 22,
    "sanskrit": "ऊचुः परस्परं ते वै यथादृष्टं यथाश्रुतम् तद्रूपगुणमाधुर्य प्रागल्भ्यस्मारिता इव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-023",
    "skandha": 10,
    "chapter": 43,
    "sloka": 23,
    "sanskrit": "एतौ भगवतः साक्षाद्धरेर्नारायणस्य हि अवतीर्णाविहांशेन वसुदेवस्य वेश्मनि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-024",
    "skandha": 10,
    "chapter": 43,
    "sloka": 24,
    "sanskrit": "एष वै किल देवक्यां जातो नीतश्च गोकुलम् कालमेतं वसन्गूढो ववृधे नन्दवेश्मनि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-025",
    "skandha": 10,
    "chapter": 43,
    "sloka": 25,
    "sanskrit": "पूतनानेन नीतान्तं चक्रवातश्च दानवः अर्जुनौ गुह्यकः केशी धेनुकोऽन्ये च तद्विधाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-026",
    "skandha": 10,
    "chapter": 43,
    "sloka": 26,
    "sanskrit": "गावः सपाला एतेन दावाग्नेः परिमोचिताः कालियो दमितः सर्प इन्द्रश्च विमदः कृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-027",
    "skandha": 10,
    "chapter": 43,
    "sloka": 27,
    "sanskrit": "सप्ताहमेकहस्तेन धृतोऽद्रिप्रवरोऽमुना वर्षवाताशनिभ्यश्च परित्रातं च गोकुलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-028",
    "skandha": 10,
    "chapter": 43,
    "sloka": 28,
    "sanskrit": "गोप्योऽस्य नित्यमुदित हसितप्रेक्षणं मुखम् पश्यन्त्यो विविधांस्तापांस्तरन्ति स्माश्रमं मुदा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-029",
    "skandha": 10,
    "chapter": 43,
    "sloka": 29,
    "sanskrit": "वदन्त्यनेन वंशोऽयं यदोः सुबहुविश्रुतः श्रियं यशो महत्वं च लप्स्यते परिरक्षितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-030",
    "skandha": 10,
    "chapter": 43,
    "sloka": 30,
    "sanskrit": "अयं चास्याग्रजः श्रीमान्रामः कमललोचनः प्रलम्बो निहतो येन वत्सको ये बकादयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-031",
    "skandha": 10,
    "chapter": 43,
    "sloka": 31,
    "sanskrit": "जनेष्वेवं ब्रुवाणेषु तूर्येषु निनदत्सु च कृष्णरामौ समाभाष्य चाणूरो वाक्यमब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-032",
    "skandha": 10,
    "chapter": 43,
    "sloka": 32,
    "sanskrit": "हे नन्दसूनो हे राम भवन्तौ वीरसम्मतौ नियुद्धकुशलौ श्रुत्वा राज्ञाहूतौ दिदृक्षुणा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-033",
    "skandha": 10,
    "chapter": 43,
    "sloka": 33,
    "sanskrit": "प्रियं राज्ञः प्रकुर्वत्यः श्रेयो विन्दन्ति वै प्रजाः मनसा कर्मणा वाचा विपरीतमतोऽन्यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-034",
    "skandha": 10,
    "chapter": 43,
    "sloka": 34,
    "sanskrit": "नित्यं प्रमुदिता गोपा वत्सपाला यथास्फुटम् वनेषु मल्लयुद्धेन क्रीडन्तश्चारयन्ति गाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-035",
    "skandha": 10,
    "chapter": 43,
    "sloka": 35,
    "sanskrit": "तस्माद्राज्ञः प्रियं यूयं वयं च करवाम हे भूतानि नः प्रसीदन्ति सर्वभूतमयो नृपः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-036",
    "skandha": 10,
    "chapter": 43,
    "sloka": 36,
    "sanskrit": "तन्निशम्याब्रवीत्कृष्णो देशकालोचितं वचः नियुद्धमात्मनोऽभीष्टं मन्यमानोऽभिनन्द्य च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-037",
    "skandha": 10,
    "chapter": 43,
    "sloka": 37,
    "sanskrit": "प्रजा भोजपतेरस्य वयं चापि वनेचराः करवाम प्रियं नित्यं तन्नः परमनुग्रहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-038",
    "skandha": 10,
    "chapter": 43,
    "sloka": 38,
    "sanskrit": "बाला वयं तुल्यबलैः क्रीडिष्यामो यथोचितम् भवेन्नियुद्धं माधर्मः स्पृशेन्मल्लसभासदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-43-sloka-039",
    "skandha": 10,
    "chapter": 43,
    "sloka": 39,
    "sanskrit": "न बालो न किशोरस्त्वं बलश्च बलिनां वरः लीलयेभो हतो येन सहस्रद्विपसत्त्वभृत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "चाणूर उवाच ।"
  },
  {
    "id": "skandha-10-chapter-43-sloka-040",
    "skandha": 10,
    "chapter": 43,
    "sloka": 40,
    "sanskrit": "तस्माद्भवद्भ्यां बलिभिर्योद्धव्यं नानयोऽत्र वै मयि विक्रम वार्ष्णेय बलेन सह मुष्टिकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]