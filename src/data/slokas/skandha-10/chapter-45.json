[
  {
    "id": "skandha-10-chapter-45-sloka-001",
    "skandha": 10,
    "chapter": 45,
    "sloka": 1,
    "sanskrit": "पितरावुपलब्धार्थौ विदित्वा पुरुषोत्तमः मा भूदिति निजां मायां ततान जनमोहिनीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-45-sloka-002",
    "skandha": 10,
    "chapter": 45,
    "sloka": 2,
    "sanskrit": "उवाच पितरावेत्य साग्रजः सात्वनर्षभः प्रश्रयावनतः प्रीणन्नम्ब तातेति सादरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-003",
    "skandha": 10,
    "chapter": 45,
    "sloka": 3,
    "sanskrit": "नास्मत्तो युवयोस्तात नित्योत्कण्ठितयोरपि बाल्यपौगण्डकैशोराः पुत्राभ्यामभवन्क्वचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-004",
    "skandha": 10,
    "chapter": 45,
    "sloka": 4,
    "sanskrit": "न लब्धो दैवहतयोर्वासो नौ भवदन्तिके यां बालाः पितृगेहस्था विन्दन्ते लालिता मुदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-005",
    "skandha": 10,
    "chapter": 45,
    "sloka": 5,
    "sanskrit": "सर्वार्थसम्भवो देहो जनितः पोषितो यतः न तयोर्याति निर्वेशं पित्रोर्मर्त्यः शतायुषा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-006",
    "skandha": 10,
    "chapter": 45,
    "sloka": 6,
    "sanskrit": "यस्तयोरात्मजः कल्प आत्मना च धनेन च वृत्तिं न दद्यात्तं प्रेत्य स्वमांसं खादयन्ति हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-007",
    "skandha": 10,
    "chapter": 45,
    "sloka": 7,
    "sanskrit": "मातरं पितरं वृद्धं भार्यां साध्वीं सुतम्शिशुम् गुरुं विप्रं प्रपन्नं च कल्पोऽबिभ्रच्छ्वसन्मृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-008",
    "skandha": 10,
    "chapter": 45,
    "sloka": 8,
    "sanskrit": "तन्नावकल्पयोः कंसान्नित्यमुद्विग्नचेतसोः मोघमेते व्यतिक्रान्ता दिवसा वामनर्चतोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-009",
    "skandha": 10,
    "chapter": 45,
    "sloka": 9,
    "sanskrit": "तत्क्षन्तुमर्हथस्तात मातर्नौ परतन्त्रयोः अकुर्वतोर्वां शुश्रूषां क्लिष्टयोर्दुर्हृदा भृशम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-010",
    "skandha": 10,
    "chapter": 45,
    "sloka": 10,
    "sanskrit": "इति मायामनुष्यस्य हरेर्विश्वात्मनो गिरा मोहितावङ्कमारोप्य परिष्वज्यापतुर्मुदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-45-sloka-011",
    "skandha": 10,
    "chapter": 45,
    "sloka": 11,
    "sanskrit": "सिञ्चन्तावश्रुधाराभिः स्नेहपाशेन चावृतौ न किञ्चिदूचतू राजन्बाष्पकण्ठौ विमोहितौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-012",
    "skandha": 10,
    "chapter": 45,
    "sloka": 12,
    "sanskrit": "एवमाश्वास्य पितरौ भगवान्देवकीसुतः मातामहं तूग्रसेनं यदूनामकरोन्णृपम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-013",
    "skandha": 10,
    "chapter": 45,
    "sloka": 13,
    "sanskrit": "आह चास्मान्महाराज प्रजाश्चाज्ञप्तुमर्हसि ययातिशापाद्यदुभिर्नासितव्यं नृपासने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-014",
    "skandha": 10,
    "chapter": 45,
    "sloka": 14,
    "sanskrit": "मयि भृत्य उपासीने भवतो विबुधादयः बलिं हरन्त्यवनताः किमुतान्ये नराधिपाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-015",
    "skandha": 10,
    "chapter": 45,
    "sloka": 15,
    "sanskrit": "सर्वान्स्वान्ज्ञतिसम्बन्धान्दिग्भ्यः कंसभयाकुलान् यदुवृष्ण्यन्धकमधु दाशार्हकुकुरादिकान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-016",
    "skandha": 10,
    "chapter": 45,
    "sloka": 16,
    "sanskrit": "सभाजितान्समाश्वास्य विदेशावासकर्शितान् न्यवासयत्स्वगेहेषु वित्तैः सन्तर्प्य विश्वकृत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-017",
    "skandha": 10,
    "chapter": 45,
    "sloka": 17,
    "sanskrit": "कृष्णसङ्कर्षणभुजैर्गुप्ता लब्धमनोरथाः गृहेषु रेमिरे सिद्धाः कृष्णरामगतज्वराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-018",
    "skandha": 10,
    "chapter": 45,
    "sloka": 18,
    "sanskrit": "वीक्षन्तोऽहरहः प्रीता मुकुन्दवदनाम्बुजम् नित्यं प्रमुदितं श्रीमत्सदयस्मितवीक्षणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-019",
    "skandha": 10,
    "chapter": 45,
    "sloka": 19,
    "sanskrit": "तत्र प्रवयसोऽप्यासन्युवानोऽतिबलौजसः पिबन्तोऽक्षैर्मुकुन्दस्य मुखाम्बुजसुधां मुहुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-020",
    "skandha": 10,
    "chapter": 45,
    "sloka": 20,
    "sanskrit": "अथ नन्दं समसाद्य भगवान्देवकीसुतः सङ्कर्षणश्च राजेन्द्र परिष्वज्येदमूचतुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-021",
    "skandha": 10,
    "chapter": 45,
    "sloka": 21,
    "sanskrit": "पितर्युवाभ्यां स्निग्धाभ्यां पोषितौ लालितौ भृशम् पित्रोरभ्यधिका प्रीतिरात्मजेष्वात्मनोऽपि हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-022",
    "skandha": 10,
    "chapter": 45,
    "sloka": 22,
    "sanskrit": "स पिता सा च जननी यौ पुष्णीतां स्वपुत्रवत् शिशून्बन्धुभिरुत्सृष्टानकल्पैः पोषरक्षणे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-023",
    "skandha": 10,
    "chapter": 45,
    "sloka": 23,
    "sanskrit": "यात यूयं व्रजंन्तात वयं च स्नेहदुःखितान् ज्ञातीन्वो द्रष्टुमेष्यामो विधाय सुहृदां सुखम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-024",
    "skandha": 10,
    "chapter": 45,
    "sloka": 24,
    "sanskrit": "एवं सान्त्वय्य भगवान्नन्दं सव्रजमच्युतः वासोऽलङ्कारकुप्याद्यैरर्हयामास सादरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-025",
    "skandha": 10,
    "chapter": 45,
    "sloka": 25,
    "sanskrit": "इत्युक्तस्तौ परिष्वज्य नन्दः प्रणयविह्वलः पूरयन्नश्रुभिर्नेत्रे सह गोपैर्व्रजं ययौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-026",
    "skandha": 10,
    "chapter": 45,
    "sloka": 26,
    "sanskrit": "अथ शूरसुतो राजन्पुत्रयोः समकारयत् पुरोधसा ब्राह्मणैश्च यथावद्द्विजसंस्कृतिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-027",
    "skandha": 10,
    "chapter": 45,
    "sloka": 27,
    "sanskrit": "तेभ्योऽदाद्दक्षिणा गावो रुक्ममालाः स्वलङ्कृताः स्वलङ्कृतेभ्यः सम्पूज्य सवत्साः क्षौममालिनीः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-028",
    "skandha": 10,
    "chapter": 45,
    "sloka": 28,
    "sanskrit": "याः कृष्णरामजन्मर्क्षे मनोदत्ता महामतिः ताश्चाददादनुस्मृत्य कंसेनाधर्मतो हृताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-029",
    "skandha": 10,
    "chapter": 45,
    "sloka": 29,
    "sanskrit": "ततश्च लब्धसंस्कारौ द्विजत्वं प्राप्य सुव्रतौ गर्गाद्यदुकुलाचार्याद्गायत्रं व्रतमास्थितौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-030",
    "skandha": 10,
    "chapter": 45,
    "sloka": 30,
    "sanskrit": "प्रभवौ सर्वविद्यानां सर्वज्ञौ जगदीश्वरौ नान्यसिद्धामलं ज्ञानं गूहमानौ नरेहितैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-031",
    "skandha": 10,
    "chapter": 45,
    "sloka": 31,
    "sanskrit": "अथो गुरुकुले वासमिच्छन्तावुपजग्मतुः काश्यं सान्दीपनिं नाम ह्यवन्तिपुरवासिनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-032",
    "skandha": 10,
    "chapter": 45,
    "sloka": 32,
    "sanskrit": "यथोपसाद्य तौ दान्तौ गुरौ वृत्तिमनिन्दिताम् ग्राहयन्तावुपेतौ स्म भक्त्या देवमिवादृतौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-033",
    "skandha": 10,
    "chapter": 45,
    "sloka": 33,
    "sanskrit": "तयोर्द्विजवरस्तुष्टः शुद्धभावानुवृत्तिभिः प्रोवाच वेदानखिलान्सङ्गोपनिषदो गुरुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-034",
    "skandha": 10,
    "chapter": 45,
    "sloka": 34,
    "sanskrit": "सरहस्यं धनुर्वेदं धर्मान्न्यायपथांस्तथा तथा चान्वीक्षिकीं विद्यां राजनीतिं च षड्विधाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-035",
    "skandha": 10,
    "chapter": 45,
    "sloka": 35,
    "sanskrit": "सर्वं नरवरश्रेष्ठौ सर्वविद्याप्रवर्तकौ सकृन्निगदमात्रेण तौ सञ्जगृहतुर्नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-036",
    "skandha": 10,
    "chapter": 45,
    "sloka": 36,
    "sanskrit": "अहोरात्रैश्चतुःषष्ट्या संयत्तौ तावतीः कलाः गुरुदक्षिणयाचार्यं छन्दयामासतुर्नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-037",
    "skandha": 10,
    "chapter": 45,
    "sloka": 37,
    "sanskrit": "द्विजस्तयोस्तं महिमानमद्भुतं संलोक्ष्य राजन्नतिमानुसीं मतिम् सम्मन्त्र्य पत्न्या स महार्णवे मृतं बालं प्रभासे वरयां बभूव ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-038",
    "skandha": 10,
    "chapter": 45,
    "sloka": 38,
    "sanskrit": "तेथेत्यथारुह्य महारथौ रथं प्रभासमासाद्य दुरन्तविक्रमौ वेलामुपव्रज्य निषीदतुः क्षनं सिन्धुर्विदित्वार्हनमाहरत्तयोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-039",
    "skandha": 10,
    "chapter": 45,
    "sloka": 39,
    "sanskrit": "तमाह भगवानाशु गुरुपुत्रः प्रदीयताम् योऽसाविह त्वया ग्रस्तो बालको महतोर्मिणा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-040",
    "skandha": 10,
    "chapter": 45,
    "sloka": 40,
    "sanskrit": "न चाहार्षमहं देव दैत्यः पञ्चजनो महान् अन्तर्जलचरः कृष्ण शङ्खरूपधरोऽसुरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीसमुद्र उवाच ।"
  },
  {
    "id": "skandha-10-chapter-45-sloka-041",
    "skandha": 10,
    "chapter": 45,
    "sloka": 41,
    "sanskrit": "आस्ते तेनाहृतो नूनं तच्छ्रुत्वा सत्त्वरं प्रभुः जलमाविश्य तं हत्वा नापश्यदुदरेऽर्भकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-042",
    "skandha": 10,
    "chapter": 45,
    "sloka": 42,
    "sanskrit": "तदङ्गप्रभवं शङ्खमादाय रथमागमत् ततः संयमनीं नाम यमस्य दयितां पुरीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-043",
    "skandha": 10,
    "chapter": 45,
    "sloka": 43,
    "sanskrit": "गत्वा जनार्दनः शङ्खं प्रदध्मौ सहलायुधः शङ्खनिर्ह्रादमाकर्ण्य प्रजासंयमनो यमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-45-sloka-044",
    "skandha": 10,
    "chapter": 45,
    "sloka": 44,
    "sanskrit": "तयोः सपर्यां महतीं चक्रे भक्त्युपबृंहिताम् उवाचावनतः कृष्णं सर्वभूताशयालयम् लीलामनुष्ययोर्विष्णो युवयोः करवाम किम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
