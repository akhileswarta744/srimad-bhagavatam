[
  {
    "id": "skandha-10-chapter-79-sloka-001",
    "skandha": 10,
    "chapter": 79,
    "sloka": 1,
    "sanskrit": "ततः पर्वण्युपावृत्ते प्रचण्डः पांशुवर्षणः भीमो वायुरभूद्राजन्पूयगन्धस्तु सर्वशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-79-sloka-002",
    "skandha": 10,
    "chapter": 79,
    "sloka": 2,
    "sanskrit": "ततोऽमेध्यमयं वर्षं बल्वलेन विनिर्मितम् अभवद्यज्ञशालायां सोऽन्वदृश्यत शूलधृक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-003",
    "skandha": 10,
    "chapter": 79,
    "sloka": 3,
    "sanskrit": "तं विलोक्य बृहत्कायं भिन्नाञ्जनचयोपमम् तप्तताम्रशिखाश्मश्रुं दंष्ट्रोग्रभ्रुकुटीमुखम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-004",
    "skandha": 10,
    "chapter": 79,
    "sloka": 4,
    "sanskrit": "सस्मार मूषलं रामः परसैन्यविदारणम् हलं च दैत्यदमनं ते तूर्णमुपतस्थतुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-005",
    "skandha": 10,
    "chapter": 79,
    "sloka": 5,
    "sanskrit": "तमाकृष्य हलाग्रेण बल्वलं गगनेचरम् मूषलेनाहनत्क्रुद्धो मूर्ध्नि ब्रह्मद्रुहं बलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-006",
    "skandha": 10,
    "chapter": 79,
    "sloka": 6,
    "sanskrit": "सोऽपतद्भुवि निर्भिन्न ललाटोऽसृक्समुत्सृजन् मुञ्चन्नार्तस्वरं शैलो यथा वज्रहतोऽरुणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-007",
    "skandha": 10,
    "chapter": 79,
    "sloka": 7,
    "sanskrit": "संस्तुत्य मुनयो रामं प्रयुज्यावितथाशिषः अभ्यषिञ्चन्महाभागा वृत्रघ्नं विबुधा यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-008",
    "skandha": 10,
    "chapter": 79,
    "sloka": 8,
    "sanskrit": "वैजयन्तीं ददुर्मालां श्रीधामाम्लानपङ्कजां रामाय वाससी दिव्ये दिव्यान्याभरणानि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-009",
    "skandha": 10,
    "chapter": 79,
    "sloka": 9,
    "sanskrit": "अथ तैरभ्यनुज्ञातः कौशिकीमेत्य ब्राह्मणैः स्नात्वा सरोवरमगाद्यतः सरयूरास्रवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-010",
    "skandha": 10,
    "chapter": 79,
    "sloka": 10,
    "sanskrit": "अनुस्रोतेन सरयूं प्रयागमुपगम्य सः स्नात्वा सन्तर्प्य देवादीन्जगाम पुलहाश्रमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-011",
    "skandha": 10,
    "chapter": 79,
    "sloka": 11,
    "sanskrit": "गोमतीं गण्डकीं स्नात्वा विपाशां शोण आप्लुतः गयां गत्वा पितॄनिष्ट्वा गङ्गासागरसङ्गमे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-012",
    "skandha": 10,
    "chapter": 79,
    "sloka": 12,
    "sanskrit": "उपस्पृश्य महेन्द्राद्रौ रामं दृष्ट्वाभिवाद्य च सप्तगोदावरीं वेणां पम्पां भीमरथीं ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-013",
    "skandha": 10,
    "chapter": 79,
    "sloka": 13,
    "sanskrit": "स्कन्दं दृष्ट्वा ययौ रामः श्रीशैलं गिरिशालयम् द्रविडेषु महापुण्यं दृष्ट्वाद्रिं वेङ्कटं प्रभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-014",
    "skandha": 10,
    "chapter": 79,
    "sloka": 14,
    "sanskrit": "कामकोष्णीं पुरीं काञ्चीं कावेरीं च सरिद्वराम् श्रीरन्गाख्यं महापुण्यं यत्र सन्निहितो हरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-015",
    "skandha": 10,
    "chapter": 79,
    "sloka": 15,
    "sanskrit": "ऋषभाद्रिं हरेः क्षेत्रं दक्षिणां मथुरां तथा सामुद्रं सेतुमगमत्महापातकनाशनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-016",
    "skandha": 10,
    "chapter": 79,
    "sloka": 16,
    "sanskrit": "तत्रायुतमदाद्धेनूर्ब्राह्मणेभ्यो हलायुधः कृतमालां ताम्रपर्णीं मलयं च कुलाचलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-017",
    "skandha": 10,
    "chapter": 79,
    "sloka": 17,
    "sanskrit": "तत्रागस्त्यं समासीनं नमस्कृत्याभिवाद्य च योजितस्तेन चाशीर्भिरनुज्ञातो गतोऽर्णवम् दक्षिणं तत्र कन्याख्यां दुर्गां देवीं ददर्श सः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-018",
    "skandha": 10,
    "chapter": 79,
    "sloka": 18,
    "sanskrit": "ततः फाल्गुनमासाद्य पञ्चाप्सरसमुत्तमम् विष्णुः सन्निहितो यत्र स्नात्वास्पर्शद्गवायुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-019",
    "skandha": 10,
    "chapter": 79,
    "sloka": 19,
    "sanskrit": "ततोऽभिव्रज्य भगवान्केरलांस्तु त्रिगर्तकान् गोकर्णाख्यं शिवक्षेत्रं सान्निध्यं यत्र धूर्जटेः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-020",
    "skandha": 10,
    "chapter": 79,
    "sloka": 20,
    "sanskrit": "आर्यां द्वैपायनीं दृष्ट्वा शूर्पारकमगाद्बलः तापीं पयोष्णीं निर्विन्ध्यामुपस्पृश्याथ दण्डकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-021",
    "skandha": 10,
    "chapter": 79,
    "sloka": 21,
    "sanskrit": "प्रविश्य रेवामगमद्यत्र माहिष्मती पुरी मनुतीर्थमुपस्पृश्य प्रभासं पुनरागमत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-022",
    "skandha": 10,
    "chapter": 79,
    "sloka": 22,
    "sanskrit": "श्रुत्वा द्विजैः कथ्यमानं कुरुपाण्डवसंयुगे सर्वराजन्यनिधनं भारं मेने हृतं भुवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-023",
    "skandha": 10,
    "chapter": 79,
    "sloka": 23,
    "sanskrit": "स भीमदुर्योधनयोर्गदाभ्यां युध्यतोर्मृधे वारयिष्यन्विनशनं जगाम यदुनन्दनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-024",
    "skandha": 10,
    "chapter": 79,
    "sloka": 24,
    "sanskrit": "युधिष्ठिरस्तु तं दृष्ट्वा यमौ कृष्णार्जुनावपि अभिवाद्याभवंस्तुष्णीं किं विवक्षुरिहागतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-025",
    "skandha": 10,
    "chapter": 79,
    "sloka": 25,
    "sanskrit": "गदापाणी उभौ दृष्ट्वा संरब्धौ विजयैषिणौ मण्डलानि विचित्राणि चरन्ताविदमब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-026",
    "skandha": 10,
    "chapter": 79,
    "sloka": 26,
    "sanskrit": "युवां तुल्यबलौ वीरौ हे राजन्हे वृकोदर एकं प्राणाधिकं मन्ये उतैकं शिक्षयाधिकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-027",
    "skandha": 10,
    "chapter": 79,
    "sloka": 27,
    "sanskrit": "तस्मादेकतरस्येह युवयोः समवीर्ययोः न लक्ष्यते जयोऽन्यो वा विरमत्वफलो रणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-028",
    "skandha": 10,
    "chapter": 79,
    "sloka": 28,
    "sanskrit": "न तद्वाक्यं जगृहतुर्बद्धवैरौ नृपार्थवत् अनुस्मरन्तावन्योन्यं दुरुक्तं दुष्कृतानि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-029",
    "skandha": 10,
    "chapter": 79,
    "sloka": 29,
    "sanskrit": "दिष्टं तदनुमन्वानो रामो द्वारवतीं ययौ उग्रसेनादिभिः प्रीतैर्ज्ञातिभिः समुपागतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-030",
    "skandha": 10,
    "chapter": 79,
    "sloka": 30,
    "sanskrit": "तं पुनर्नैमिषं प्राप्तमृषयोऽयाजयन्मुदा क्रत्वङ्गं क्रतुभिः सर्वैर्निवृत्ताखिलविग्रहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-031",
    "skandha": 10,
    "chapter": 79,
    "sloka": 31,
    "sanskrit": "तेभ्यो विशुद्धं विज्ञानं भगवान्व्यतरद्विभुः येनैवात्मन्यदो विश्वमात्मानं विश्वगं विदुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-032",
    "skandha": 10,
    "chapter": 79,
    "sloka": 32,
    "sanskrit": "स्वपत्यावभृथस्नातो ज्ञातिबन्धुसुहृद्वृतः रेजे स्वज्योत्स्नयेवेन्दुः सुवासाः सुष्ठ्वलङ्कृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-033",
    "skandha": 10,
    "chapter": 79,
    "sloka": 33,
    "sanskrit": "ईदृग्विधान्यसङ्ख्यानि बलस्य बलशालिनः अनन्तस्याप्रमेयस्य मायामर्त्यस्य सन्ति हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-79-sloka-034",
    "skandha": 10,
    "chapter": 79,
    "sloka": 34,
    "sanskrit": "योऽनुस्मरेत रामस्य कर्माण्यद्भुतकर्मणः सायं प्रातरनन्तस्य विष्णोः स दयितो भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
