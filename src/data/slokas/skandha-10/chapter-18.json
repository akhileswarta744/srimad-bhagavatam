[
  {
    "id": "skandha-10-chapter-18-sloka-001",
    "skandha": 10,
    "chapter": 18,
    "sloka": 1,
    "sanskrit": "अथ कृष्णः परिवृतो ज्ञातिभिर्मुदितात्मभिः अनुगीयमानो न्यविशद्व्रजं गोकुलमण्डितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-18-sloka-002",
    "skandha": 10,
    "chapter": 18,
    "sloka": 2,
    "sanskrit": "व्रजे विक्रीडतोरेवं गोपालच्छद्ममायया ग्रीष्मो नामर्तुरभवन्नातिप्रेयाञ्छरीरिणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-003",
    "skandha": 10,
    "chapter": 18,
    "sloka": 3,
    "sanskrit": "स च वृन्दावनगुणैर्वसन्त इव लक्षितः यत्रास्ते भगवान्साक्षाद्रामेण सह केशवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-004",
    "skandha": 10,
    "chapter": 18,
    "sloka": 4,
    "sanskrit": "यत्र निर्झरनिर्ह्राद निवृत्तस्वनझिल्लिकम् शश्वत्तच्छीकरर्जीष द्रुममण्डलमण्डितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-005",
    "skandha": 10,
    "chapter": 18,
    "sloka": 5,
    "sanskrit": "सरित्सरःप्रस्रवणोर्मिवायुना कह्लारकञ्जोत्पलरेणुहारिणा न विद्यते यत्र वनौकसां दवो निदाघवह्न्यर्कभवोऽतिशाद्वले",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-006",
    "skandha": 10,
    "chapter": 18,
    "sloka": 6,
    "sanskrit": "अगाधतोयह्रदिनीतटोर्मिभिर्द्रवत्पुरीष्याः पुलिनैः समन्ततः न यत्र चण्डांशुकरा विषोल्बणा भुवो रसं शाद्वलितं च गृह्णते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-007",
    "skandha": 10,
    "chapter": 18,
    "sloka": 7,
    "sanskrit": "वनं कुसुमितं श्रीमन्नदच्चित्रमृगद्विजम् गायन्मयूरभ्रमरं कूजत्कोकिलसारसम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-008",
    "skandha": 10,
    "chapter": 18,
    "sloka": 8,
    "sanskrit": "क्रीडिष्यमाणस्तत्क्र्ष्णो भगवान्बलसंयुतः वेणुं विरणयन्गोपैर्गोधनैः संवृतोऽविशत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-009",
    "skandha": 10,
    "chapter": 18,
    "sloka": 9,
    "sanskrit": "प्रवालबर्हस्तबक स्रग्धातुकृतभूषणाः रामकृष्णादयो गोपा ननृतुर्युयुधुर्जगुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-010",
    "skandha": 10,
    "chapter": 18,
    "sloka": 10,
    "sanskrit": "कृष्णस्य नृत्यतः केचिज्जगुः केचिदवादयन् वेणुपाणितलैः शृङ्गैः प्रशशंसुरथापरे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-011",
    "skandha": 10,
    "chapter": 18,
    "sloka": 11,
    "sanskrit": "गोपजातिप्रतिच्छन्ना देवा गोपालरूपिणौ ईडिरे कृष्णरामौ च नटा इव नटं नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-012",
    "skandha": 10,
    "chapter": 18,
    "sloka": 12,
    "sanskrit": "भ्रमणैर्लङ्घनैः क्षेपैरास्फोटनविकर्षणैः चिक्रीडतुर्नियुद्धेन काकपक्षधरौ क्वचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-013",
    "skandha": 10,
    "chapter": 18,
    "sloka": 13,
    "sanskrit": "क्वचिन्नृत्यत्सु चान्येषु गायकौ वादकौ स्वयम् शशंसतुर्महाराज साधु साध्विति वादिनौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-014",
    "skandha": 10,
    "chapter": 18,
    "sloka": 14,
    "sanskrit": "क्वचिद्बिल्वैः क्वचित्कुम्भैः क्वचामलकमुष्टिभिः अस्पृश्यनेत्रबन्धाद्यैः क्वचिन्मृगखगेहया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-015",
    "skandha": 10,
    "chapter": 18,
    "sloka": 15,
    "sanskrit": "क्वचिच्च दर्दुरप्लावैर्विविधैरुपहासकैः कदाचित्स्यन्दोलिकया कर्हिचिन्नृपचेष्टया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-016",
    "skandha": 10,
    "chapter": 18,
    "sloka": 16,
    "sanskrit": "एवं तौ लोकसिद्धाभिः क्रीडाभिश्चेरतुर्वने नद्यद्रिद्रोणिकुञ्जेषु काननेषु सरःसु च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-017",
    "skandha": 10,
    "chapter": 18,
    "sloka": 17,
    "sanskrit": "पशूंश्चारयतोर्गोपैस्तद्वने रामकृष्णयोः गोपरूपी प्रलम्बोऽगादसुरस्तज्जिहीर्षया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-018",
    "skandha": 10,
    "chapter": 18,
    "sloka": 18,
    "sanskrit": "तं विद्वानपि दाशार्हो भगवान्सर्वदर्शनः अन्वमोदत तत्सख्यं वधं तस्य विचिन्तयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-019",
    "skandha": 10,
    "chapter": 18,
    "sloka": 19,
    "sanskrit": "तत्रोपाहूय गोपालान्कृष्णः प्राह विहारवित् हे गोपा विहरिष्यामो द्वन्द्वीभूय यथायथम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-020",
    "skandha": 10,
    "chapter": 18,
    "sloka": 20,
    "sanskrit": "तत्र चक्रुः परिवृढौ गोपा रामजनार्दनौ कृष्णसङ्घट्टिनः केचिदासन्रामस्य चापरे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-021",
    "skandha": 10,
    "chapter": 18,
    "sloka": 21,
    "sanskrit": "आचेरुर्विविधाः क्रीडा वाह्यवाहकलक्षणाः यत्रारोहन्ति जेतारो वहन्ति च पराजिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-022",
    "skandha": 10,
    "chapter": 18,
    "sloka": 22,
    "sanskrit": "वहन्तो वाह्यमानाश्च चारयन्तश्च गोधनम् भाण्डीरकं नाम वटं जग्मुः कृष्णपुरोगमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-023",
    "skandha": 10,
    "chapter": 18,
    "sloka": 23,
    "sanskrit": "रामसङ्घट्टिनो यर्हि श्रीदामवृषभादयः क्रीडायां जयिनस्तांस्तानूहुः कृष्णादयो नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-024",
    "skandha": 10,
    "chapter": 18,
    "sloka": 24,
    "sanskrit": "उवाह कृष्णो भगवान्श्रीदामानं पराजितः वृषभं भद्रसेनस्तु प्रलम्बो रोहिणीसुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-025",
    "skandha": 10,
    "chapter": 18,
    "sloka": 25,
    "sanskrit": "अविषह्यं मन्यमानः कृष्णं दानवपुङ्गवः वहन्द्रुततरं प्रागादवरोहणतः परम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-026",
    "skandha": 10,
    "chapter": 18,
    "sloka": 26,
    "sanskrit": "तमुद्वहन्धरणिधरेन्द्रगौरवं महासुरो विगतरयो निजं वपुः स आस्थितः पुरटपरिच्छदो बभौ तडिद्द्युमानुडुपतिवाडिवाम्बुदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-027",
    "skandha": 10,
    "chapter": 18,
    "sloka": 27,
    "sanskrit": "निरीक्ष्य तद्वपुरलमम्बरे चरत् प्रदीप्तदृग्भ्रुकुटितटोग्रदंष्ट्रकम् ज्वलच्छिखं कटककिरीटकुण्डल त्विषाद्भुतं हलधर ईषदत्रसत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-028",
    "skandha": 10,
    "chapter": 18,
    "sloka": 28,
    "sanskrit": "अथागतस्मृतिरभयो रिपुं बलो विहाय सार्थमिव हरन्तमात्मनः रुषाहनच्छिरसि दृढेन मुष्टिना सुराधिपो गिरिमिव वज्ररंहसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-029",
    "skandha": 10,
    "chapter": 18,
    "sloka": 29,
    "sanskrit": "स आहतः सपदि विशीर्णमस्तको मुखाद्वमन्रुधिरमपस्मृतोऽसुरः महारवं व्यसुरपतत्समीरयन्गिरिर्यथा मघवत आयुधाहतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-030",
    "skandha": 10,
    "chapter": 18,
    "sloka": 30,
    "sanskrit": "दृष्ट्वा प्रलम्बं निहतं बलेन बलशालिना गोपाः सुविस्मिता आसन्साधु साध्विति वादिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-031",
    "skandha": 10,
    "chapter": 18,
    "sloka": 31,
    "sanskrit": "आशिषोऽभिगृणन्तस्तं प्रशशंसुस्तदर्हणम् प्रेत्यागतमिवालिङ्ग्य प्रेमविह्वलचेतसः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-18-sloka-032",
    "skandha": 10,
    "chapter": 18,
    "sloka": 32,
    "sanskrit": "पापे प्रलम्बे निहते देवाः परमनिर्वृताः अभ्यवर्षन्बलं माल्यैः शशंसुः साधु साध्विति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]