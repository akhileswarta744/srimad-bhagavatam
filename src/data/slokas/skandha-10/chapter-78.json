[
  {
    "id": "skandha-10-chapter-78-sloka-001",
    "skandha": 10,
    "chapter": 78,
    "sloka": 1,
    "sanskrit": "शिशुपालस्य शाल्वस्य पौण्ड्रकस्यापि दुर्मतिः परलोकगतानां च कुर्वन्पारोक्ष्यसौहृदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-78-sloka-002",
    "skandha": 10,
    "chapter": 78,
    "sloka": 2,
    "sanskrit": "एकः पदातिः सङ्क्रुद्धो गदापाणिः प्रकम्पयन् पद्भ्यामिमां महाराज महासत्त्वो व्यदृश्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-003",
    "skandha": 10,
    "chapter": 78,
    "sloka": 3,
    "sanskrit": "तं तथायान्तमालोक्य गदामादाय सत्त्वरः अवप्लुत्य रथात्कृष्णः सिन्धुं वेलेव प्रत्यधात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-004",
    "skandha": 10,
    "chapter": 78,
    "sloka": 4,
    "sanskrit": "गदामुद्यम्य कारूषो मुकुन्दं प्राह दुर्मदः दिष्ट्या दिष्ट्या भवानद्य मम दृष्टिपथं गतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-005",
    "skandha": 10,
    "chapter": 78,
    "sloka": 5,
    "sanskrit": "त्वं मातुलेयो नः कृष्ण मित्रध्रुङ्मां जिघांससि अतस्त्वां गदया मन्द हनिष्ये वज्रकल्पया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-006",
    "skandha": 10,
    "chapter": 78,
    "sloka": 6,
    "sanskrit": "तर्ह्यानृण्यमुपैम्यज्ञ मित्राणां मित्रवत्सलः बन्धुरूपमरिं हत्वा व्याधिं देहचरं यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-007",
    "skandha": 10,
    "chapter": 78,
    "sloka": 7,
    "sanskrit": "एवं रूक्षैस्तुदन्वाक्यैः कृष्णं तोत्रैरिव द्विपम् गदयाताडयन्मूर्ध्नि सिंहवद्व्यनदच्च सः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-008",
    "skandha": 10,
    "chapter": 78,
    "sloka": 8,
    "sanskrit": "गदयाभिहतोऽप्याजौ न चचाल यदूद्वहः कृष्णोऽपि तमहन्गुर्व्या कौमोदक्या स्तनान्तरे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-009",
    "skandha": 10,
    "chapter": 78,
    "sloka": 9,
    "sanskrit": "गदानिर्भिन्नहृदय उद्वमन्रुधिरं मुखात् प्रसार्य केशबाह्वङ्घ्रीन्धरण्यां न्यपतद्व्यसुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-010",
    "skandha": 10,
    "chapter": 78,
    "sloka": 10,
    "sanskrit": "ततः सूक्ष्मतरं ज्योतिः कृष्णमाविशदद्भुतम् पश्यतां सर्वभूतानां यथा चैद्यवधे नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-011",
    "skandha": 10,
    "chapter": 78,
    "sloka": 11,
    "sanskrit": "विदूरथस्तु तद्भ्राता भ्रातृशोकपरिप्लुतः आगच्छदसिचर्माभ्यामुच्छ्वसंस्तज्जिघांसया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-012",
    "skandha": 10,
    "chapter": 78,
    "sloka": 12,
    "sanskrit": "तस्य चापततः कृष्णश्चक्रेण क्षुरनेमिना शिरो जहार राजेन्द्र सकिरीटं सकुण्डलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-013",
    "skandha": 10,
    "chapter": 78,
    "sloka": 13,
    "sanskrit": "एवं सौभं च शाल्वं च दन्तवक्रं सहानुजम् हत्वा दुर्विषहानन्यैरीडितः सुरमानवैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-014",
    "skandha": 10,
    "chapter": 78,
    "sloka": 14,
    "sanskrit": "मुनिभिः सिद्धगन्धर्वैर्विद्याधरमहोरगैः अप्सरोभिः पितृगणैर्यक्षैः किन्नरचारणैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-015",
    "skandha": 10,
    "chapter": 78,
    "sloka": 15,
    "sanskrit": "उपगीयमानविजयः कुसुमैरभिवर्षितः वृतश्च वृष्णिप्रवरैर्विवेशालङ्कृतां पुरीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-016",
    "skandha": 10,
    "chapter": 78,
    "sloka": 16,
    "sanskrit": "एवं योगेश्वरः कृष्णो भगवान्जगदीश्वरः ईयते पशुदृष्टीनां निर्जितो जयतीति सः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-017",
    "skandha": 10,
    "chapter": 78,
    "sloka": 17,
    "sanskrit": "श्रुत्वा युद्धोद्यमं रामः कुरूणां सह पाण्डवैः तीर्थाभिषेकव्याजेन मध्यस्थः प्रययौ किल",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-018",
    "skandha": 10,
    "chapter": 78,
    "sloka": 18,
    "sanskrit": "स्नात्वा प्रभासे सन्तर्प्य देवर्षिपितृमानवान् सरस्वतीं प्रतिस्रोतं ययौ ब्राह्मणसंवृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-019",
    "skandha": 10,
    "chapter": 78,
    "sloka": 19,
    "sanskrit": "पृथूदकं बिन्दुसरस्त्रितकूपं सुदर्शनम् विशालं ब्रह्मतीर्थं च चक्रं प्राचीं सरस्वतीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-020",
    "skandha": 10,
    "chapter": 78,
    "sloka": 20,
    "sanskrit": "यमुनामनु यान्येव गङ्गामनु च भारत जगाम नैमिषं यत्र ऋषयः सत्रमासते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-021",
    "skandha": 10,
    "chapter": 78,
    "sloka": 21,
    "sanskrit": "तमागतमभिप्रेत्य मुनयो दीर्घसत्रिणः अभिनन्द्य यथान्यायं प्रणम्योत्थाय चार्चयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-022",
    "skandha": 10,
    "chapter": 78,
    "sloka": 22,
    "sanskrit": "सोऽर्चितः सपरीवारः कृतासनपरिग्रहः रोमहर्षणमासीनं महर्षेः शिष्यमैक्षत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-023",
    "skandha": 10,
    "chapter": 78,
    "sloka": 23,
    "sanskrit": "अप्रत्युत्थायिनं सूतमकृतप्रह्वणाञ्जलिम् अध्यासीनं च तान्विप्रांश्चुकोपोद्वीक्ष्य माधवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-024",
    "skandha": 10,
    "chapter": 78,
    "sloka": 24,
    "sanskrit": "यस्मादसाविमान्विप्रानध्यास्ते प्रतिलोमजः धर्मपालांस्तथैवास्मान्वधमर्हति दुर्मतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-025",
    "skandha": 10,
    "chapter": 78,
    "sloka": 25,
    "sanskrit": "ऋषेर्भगवतो भूत्वा शिष्योऽधीत्य बहूनि च सेतिहासपुराणानि धर्मशास्त्राणि सर्वशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-026",
    "skandha": 10,
    "chapter": 78,
    "sloka": 26,
    "sanskrit": "अदान्तस्याविनीतस्य वृथा पण्डितमानिनः न गुणाय भवन्ति स्म नटस्येवाजितात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-027",
    "skandha": 10,
    "chapter": 78,
    "sloka": 27,
    "sanskrit": "एतदर्थो हि लोकेऽस्मिन्नवतारो मया कृतः वध्या मे धर्मध्वजिनस्ते हि पातकिनोऽधिकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-028",
    "skandha": 10,
    "chapter": 78,
    "sloka": 28,
    "sanskrit": "एतावदुक्त्वा भगवान्निवृत्तोऽसद्वधादपि भावित्वात्तं कुशाग्रेण करस्थेनाहनत्प्रभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-029",
    "skandha": 10,
    "chapter": 78,
    "sloka": 29,
    "sanskrit": "हाहेतिवादिनः सर्वे मुनयः खिन्नमानसाः ऊचुः सङ्कर्षणं देवमधर्मस्ते कृतः प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-030",
    "skandha": 10,
    "chapter": 78,
    "sloka": 30,
    "sanskrit": "अस्य ब्रह्मासनं दत्तमस्माभिर्यदुनन्दन आयुश्चात्माक्लमं तावद्यावत्सत्रं समाप्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-031",
    "skandha": 10,
    "chapter": 78,
    "sloka": 31,
    "sanskrit": "अजानतैवाचरितस्त्वया ब्रह्मवधो यथा योगेश्वरस्य भवतो नाम्नायोऽपि नियामकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-032",
    "skandha": 10,
    "chapter": 78,
    "sloka": 32,
    "sanskrit": "यद्येतद्ब्रह्महत्यायाः पावनं लोकपावन चरिष्यति भवांल्लोक सङ्ग्रहोऽनन्यचोदितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-033",
    "skandha": 10,
    "chapter": 78,
    "sloka": 33,
    "sanskrit": "चरिष्ये वधनिर्वेशं लोकानुग्रहकाम्यया नियमः प्रथमे कल्पे यावान्स तु विधीयताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-10-chapter-78-sloka-034",
    "skandha": 10,
    "chapter": 78,
    "sloka": 34,
    "sanskrit": "दीर्घमायुर्बतैतस्य सत्त्वमिन्द्रियमेव च आशासितं यत्तद्ब्रूते साधये योगमायया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-035",
    "skandha": 10,
    "chapter": 78,
    "sloka": 35,
    "sanskrit": "अस्त्रस्य तव वीर्यस्य मृत्योरस्माकमेव च यथा भवेद्वचः सत्यं तथा राम विधीयताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "ऋषय ऊचुः ।"
  },
  {
    "id": "skandha-10-chapter-78-sloka-036",
    "skandha": 10,
    "chapter": 78,
    "sloka": 36,
    "sanskrit": "आत्मा वै पुत्र उत्पन्न इति वेदानुशासनम् तस्मादस्य भवेद्वक्ता आयुरिन्द्रियसत्त्ववान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-10-chapter-78-sloka-037",
    "skandha": 10,
    "chapter": 78,
    "sloka": 37,
    "sanskrit": "किं वः कामो मुनिश्रेष्ठा ब्रूताहं करवाण्यथ अजानतस्त्वपचितिं यथा मे चिन्त्यतां बुधाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-038",
    "skandha": 10,
    "chapter": 78,
    "sloka": 38,
    "sanskrit": "इल्वलस्य सुतो घोरो बल्वलो नाम दानवः स दूषयति नः सत्रमेत्य पर्वणि पर्वणि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "ऋषय ऊचुः ।"
  },
  {
    "id": "skandha-10-chapter-78-sloka-039",
    "skandha": 10,
    "chapter": 78,
    "sloka": 39,
    "sanskrit": "तं पापं जहि दाशार्ह तन्नः शुश्रूषणं परम् पूयशोणितविन्मूत्र सुरामांसाभिवर्षिणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-78-sloka-040",
    "skandha": 10,
    "chapter": 78,
    "sloka": 40,
    "sanskrit": "ततश्च भारतं वर्षं परीत्य सुसमाहितः चरित्वा द्वादशमासांस्तीर्थस्नायी विशुध्यसि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]