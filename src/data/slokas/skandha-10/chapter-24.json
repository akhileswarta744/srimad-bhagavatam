[
  {
    "id": "skandha-10-chapter-24-sloka-001",
    "skandha": 10,
    "chapter": 24,
    "sloka": 1,
    "sanskrit": "भगवानपि तत्रैव बलदेवेन संयुतः अपश्यन्निवसन्गोपानिन्द्रयागकृतोद्यमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-24-sloka-002",
    "skandha": 10,
    "chapter": 24,
    "sloka": 2,
    "sanskrit": "तदभिज्ञोऽपि भगवान्सर्वात्मा सर्वदर्शनः प्रश्रयावनतोऽपृच्छद्वृद्धान्नन्दपुरोगमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-003",
    "skandha": 10,
    "chapter": 24,
    "sloka": 3,
    "sanskrit": "कथ्यतां मे पितः कोऽयं सम्भ्रमो व उपागतः किं फलं कस्य वोद्देशः केन वा साध्यते मखः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-004",
    "skandha": 10,
    "chapter": 24,
    "sloka": 4,
    "sanskrit": "एतद्ब्रूहि महान्कामो मह्यं शुश्रूषवे पितः न हि गोप्यं हि सधूनां कृत्यं सर्वात्मनामिह अस्त्यस्वपरदृष्टीनाममित्रोदास्तविद्विषाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-005",
    "skandha": 10,
    "chapter": 24,
    "sloka": 5,
    "sanskrit": "उदासीनोऽरिवद्वर्ज्य आत्मवत्सुहृदुच्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-006",
    "skandha": 10,
    "chapter": 24,
    "sloka": 6,
    "sanskrit": "ज्ञत्वाज्ञात्वा च कर्माणि जनोऽयमनुतिष्ठति विदुषः कर्मसिद्धिः स्याद्यथा नाविदुषो भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-007",
    "skandha": 10,
    "chapter": 24,
    "sloka": 7,
    "sanskrit": "तत्र तावत्क्रियायोगो भवतां किं विचारितः अथ वा लौकिकस्तन्मे पृच्छतः साधु भण्यताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-008",
    "skandha": 10,
    "chapter": 24,
    "sloka": 8,
    "sanskrit": "पर्जन्यो भगवानिन्द्रो मेघास्तस्यात्ममूर्तयः तेऽभिवर्षन्ति भूतानां प्रीणनं जीवनं पयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीनन्द उवाच ।"
  },
  {
    "id": "skandha-10-chapter-24-sloka-009",
    "skandha": 10,
    "chapter": 24,
    "sloka": 9,
    "sanskrit": "तं तात वयमन्ये च वार्मुचां पतिमीश्वरम् द्रव्यैस्तद्रेतसा सिद्धैर्यजन्ते क्रतुभिर्नराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-010",
    "skandha": 10,
    "chapter": 24,
    "sloka": 10,
    "sanskrit": "तच्छेषेणोपजीवन्ति त्रिवर्गफलहेतवे पुंसां पुरुषकाराणां पर्जन्यः फलभावनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-011",
    "skandha": 10,
    "chapter": 24,
    "sloka": 11,
    "sanskrit": "य एनं विसृजेद्धर्मं परम्पर्यागतं नरः कामाद्द्वेषाद्भयाल्लोभात्स वै नाप्नोति शोभनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-012",
    "skandha": 10,
    "chapter": 24,
    "sloka": 12,
    "sanskrit": "वचो निशम्य नन्दस्य तथान्येषां व्रजौकसाम् इन्द्राय मन्युं जनयन्पितरं प्राह केशवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-24-sloka-013",
    "skandha": 10,
    "chapter": 24,
    "sloka": 13,
    "sanskrit": "कर्मणा जायते जन्तुः कर्मणैव प्रलीयते सुखं दुःखं भयं क्षेमं कर्मणैवाभिपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-10-chapter-24-sloka-014",
    "skandha": 10,
    "chapter": 24,
    "sloka": 14,
    "sanskrit": "अस्ति चेदीश्वरः कश्चित्फलरूप्यन्यकर्मणाम् कर्तारं भजते सोऽपि न ह्यकर्तुः प्रभुर्हि सः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-015",
    "skandha": 10,
    "chapter": 24,
    "sloka": 15,
    "sanskrit": "किमिन्द्रेणेह भूतानां स्वस्वकर्मानुवर्तिनाम् अनीशेनान्यथा कर्तुं स्वभावविहितं नृणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-016",
    "skandha": 10,
    "chapter": 24,
    "sloka": 16,
    "sanskrit": "स्वभावतन्त्रो हि जनः स्वभावमनुवर्तते स्वभावस्थमिदं सर्वं सदेवासुरमानुषम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-017",
    "skandha": 10,
    "chapter": 24,
    "sloka": 17,
    "sanskrit": "देहानुच्चावचाञ्जन्तुः प्राप्योत्सृजति कर्मणा शत्रुर्मित्रमुदासीनः कर्मैव गुरुरीश्वरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-018",
    "skandha": 10,
    "chapter": 24,
    "sloka": 18,
    "sanskrit": "तस्मात्सम्पूजयेत्कर्म स्वभावस्थः स्वकर्मकृत् अञ्जसा येन वर्तेत तदेवास्य हि दैवतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-019",
    "skandha": 10,
    "chapter": 24,
    "sloka": 19,
    "sanskrit": "आजीव्यैकतरं भावं यस्त्वन्यमुपजीवति न तस्माद्विन्दते क्षेमं जारान्नार्यसती यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-020",
    "skandha": 10,
    "chapter": 24,
    "sloka": 20,
    "sanskrit": "वर्तेत ब्रह्मणा विप्रो राजन्यो रक्षया भुवः वैश्यस्तु वार्तया जीवेच्छूद्रस्तु द्विजसेवया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-021",
    "skandha": 10,
    "chapter": 24,
    "sloka": 21,
    "sanskrit": "कृषिवाणिज्यगोरक्षा कुसीदं तूर्यमुच्यते वार्ता चतुर्विधा तत्र वयं गोवृत्तयोऽनिशम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-022",
    "skandha": 10,
    "chapter": 24,
    "sloka": 22,
    "sanskrit": "सत्त्वं रजस्तम इति स्थित्युत्पत्त्यन्तहेतवः रजसोत्पद्यते विश्वमन्योन्यं विविधं जगत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-023",
    "skandha": 10,
    "chapter": 24,
    "sloka": 23,
    "sanskrit": "रजसा चोदिता मेघा वर्षन्त्यम्बूनि सर्वतः प्रजास्तैरेव सिध्यन्ति महेन्द्रः किं करिष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-024",
    "skandha": 10,
    "chapter": 24,
    "sloka": 24,
    "sanskrit": "न नः पुरोजनपदा न ग्रामा न गृहा वयम् वनौकसस्तात नित्यं वनशैलनिवासिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-025",
    "skandha": 10,
    "chapter": 24,
    "sloka": 25,
    "sanskrit": "तस्माद्गवां ब्राह्मणानामद्रेश्चारभ्यतां मखः य इन्द्रयागसम्भारास्तैरयं साध्यतां मखः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-026",
    "skandha": 10,
    "chapter": 24,
    "sloka": 26,
    "sanskrit": "पच्यन्तां विविधाः पाकाः सूपान्ताः पायसादयः संयावापूपशष्कुल्यः सर्वदोहश्च गृह्यताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-027",
    "skandha": 10,
    "chapter": 24,
    "sloka": 27,
    "sanskrit": "हूयन्तामग्नयः सम्यग्ब्राह्मणैर्ब्रह्मवादिभिः अन्नं बहुगुणं तेभ्यो देयं वो धेनुदक्षिणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-028",
    "skandha": 10,
    "chapter": 24,
    "sloka": 28,
    "sanskrit": "अन्येभ्यश्चाश्वचाण्डाल पतितेभ्यो यथार्हतः यवसं च गवां दत्त्वा गिरये दीयतां बलिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-029",
    "skandha": 10,
    "chapter": 24,
    "sloka": 29,
    "sanskrit": "स्वलङ्कृता भुक्तवन्तः स्वनुलिप्ताः सुवाससः प्रदक्षिणां च कुरुत गोविप्रानलपर्वतान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-030",
    "skandha": 10,
    "chapter": 24,
    "sloka": 30,
    "sanskrit": "एतन्मम मतं तात क्रियतां यदि रोचते अयं गोब्राह्मणाद्रीणां मह्यं च दयितो मखः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-031",
    "skandha": 10,
    "chapter": 24,
    "sloka": 31,
    "sanskrit": "कालात्मना भगवता शक्रदर्पजिघांसया प्रोक्तं निशम्य नन्दाद्याः साध्वगृह्णन्त तद्वचः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-24-sloka-032",
    "skandha": 10,
    "chapter": 24,
    "sloka": 32,
    "sanskrit": "तथा च व्यदधुः सर्वं यथाह मधुसूदनः वाचयित्वा स्वस्त्ययनं तद्द्रव्येण गिरिद्विजान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-033",
    "skandha": 10,
    "chapter": 24,
    "sloka": 33,
    "sanskrit": "उपहृत्य बलीन्सम्यगादृता यवसं गवाम् गोधनानि पुरस्कृत्य गिरिं चक्रुः प्रदक्षिणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-034",
    "skandha": 10,
    "chapter": 24,
    "sloka": 34,
    "sanskrit": "अनांस्यनडुद्युक्तानि ते चारुह्य स्वलङ्कृताः गोप्यश्च कृष्णवीर्याणि गायन्त्यः सद्विजाशिषः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-035",
    "skandha": 10,
    "chapter": 24,
    "sloka": 35,
    "sanskrit": "कृष्णस्त्वन्यतमं रूपं गोपविश्रम्भणं गतः शैलोऽस्मीति ब्रुवन्भूरि बलिमादद्बृहद्वपुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-036",
    "skandha": 10,
    "chapter": 24,
    "sloka": 36,
    "sanskrit": "तस्मै नमो व्रजजनैः सह चक्र आत्मनात्मने अहो पश्यत शैलोऽसौ रूपी नोऽनुग्रहं व्यधात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-037",
    "skandha": 10,
    "chapter": 24,
    "sloka": 37,
    "sanskrit": "एषोऽवजानतो मर्त्यान्कामरूपी वनौकसः हन्ति ह्यस्मै नमस्यामः शर्मणे आत्मनो गवाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-24-sloka-038",
    "skandha": 10,
    "chapter": 24,
    "sloka": 38,
    "sanskrit": "इत्यद्रिगोद्विजमखं वासुदेवप्रचोदिताः यथा विधाय ते गोपा सहकृष्णा व्रजं ययुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]