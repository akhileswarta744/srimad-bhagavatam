[
  {
    "id": "skandha-10-chapter-55-sloka-001",
    "skandha": 10,
    "chapter": 55,
    "sloka": 1,
    "sanskrit": "कामस्तु वासुदेवांशो दग्धः प्राग्रुद्रमन्युना देहोपपत्तये भूयस्तमेव प्रत्यपद्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-55-sloka-002",
    "skandha": 10,
    "chapter": 55,
    "sloka": 2,
    "sanskrit": "स एव जातो वैदर्भ्यां कृष्णवीर्यसमुद्भवः प्रद्युम्न इति विख्यातः सर्वतोऽनवमः पितुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-003",
    "skandha": 10,
    "chapter": 55,
    "sloka": 3,
    "sanskrit": "तं शम्बरः कामरूपी हृत्वा तोकमनिर्दशम् स विदित्वात्मनः शत्रुं प्रास्योदन्वत्यगाद्गृहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-004",
    "skandha": 10,
    "chapter": 55,
    "sloka": 4,
    "sanskrit": "तं निर्जगार बलवान्मीनः सोऽप्यपरैः सह वृतो जालेन महता गृहीतो मत्स्यजीविभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-005",
    "skandha": 10,
    "chapter": 55,
    "sloka": 5,
    "sanskrit": "तं शम्बराय कैवर्ता उपाजह्रुरुपायनम् सूदा महानसं नीत्वा वद्यन्सुधितिनाद्भुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-006",
    "skandha": 10,
    "chapter": 55,
    "sloka": 6,
    "sanskrit": "दृष्ट्वा तदुदरे बालम्मायावत्यै न्यवेदयन् नारदोऽकथयत्सर्वं तस्याः शङ्कितचेतसः बालस्य तत्त्वमुत्पत्तिं मत्स्योदरनिवेशनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-007",
    "skandha": 10,
    "chapter": 55,
    "sloka": 7,
    "sanskrit": "सा च कामस्य वै पत्नी रतिर्नाम यशस्विनी पत्युर्निर्दग्धदेहस्य देहोत्पत्तिम्प्रतीक्षती",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-008",
    "skandha": 10,
    "chapter": 55,
    "sloka": 8,
    "sanskrit": "निरूपिता शम्बरेण सा सूदौदनसाधने कामदेवं शिशुं बुद्ध्वा चक्रे स्नेहं तदार्भके",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-009",
    "skandha": 10,
    "chapter": 55,
    "sloka": 9,
    "sanskrit": "नातिदीर्घेण कालेन स कार्ष्णि रूढयौवनः जनयामास नारीणां वीक्षन्तीनां च विभ्रमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-010",
    "skandha": 10,
    "chapter": 55,
    "sloka": 10,
    "sanskrit": "सा तम्पतिं पद्मदलायतेक्षणं प्रलम्बबाहुं नरलोकसुन्दरम् सव्रीडहासोत्तभितभ्रुवेक्षती प्रीत्योपतस्थे रतिरङ्ग सौरतैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-011",
    "skandha": 10,
    "chapter": 55,
    "sloka": 11,
    "sanskrit": "तामह भगवान्कार्ष्णिर्मातस्ते मतिरन्यथा मातृभावमतिक्रम्य वर्तसे कामिनी यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-012",
    "skandha": 10,
    "chapter": 55,
    "sloka": 12,
    "sanskrit": "भवान्नारायणसुतः शम्बरेण हृतो गृहात् अहं तेऽधिकृता पत्नी रतिः कामो भवान्प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "रतिरुवाच ।"
  },
  {
    "id": "skandha-10-chapter-55-sloka-013",
    "skandha": 10,
    "chapter": 55,
    "sloka": 13,
    "sanskrit": "एष त्वानिर्दशं सिन्धावक्षिपच्छम्बरोऽसुरः मत्स्योऽग्रसीत्तदुदरादितः प्राप्तो भवान्प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-014",
    "skandha": 10,
    "chapter": 55,
    "sloka": 14,
    "sanskrit": "तमिमं जहि दुर्धर्षं दुर्जयं शत्रुमात्मनः मायाशतविदं तं च मायाभिर्मोहनादिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-015",
    "skandha": 10,
    "chapter": 55,
    "sloka": 15,
    "sanskrit": "परीशोचति ते माता कुररीव गतप्रजा पुत्रस्नेहाकुला दीना विवत्सा गौरिवातुरा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-016",
    "skandha": 10,
    "chapter": 55,
    "sloka": 16,
    "sanskrit": "प्रभाष्यैवं ददौ विद्यां प्रद्युम्नाय महात्मने मायावती महामायां सर्वमायाविनाशिनीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-017",
    "skandha": 10,
    "chapter": 55,
    "sloka": 17,
    "sanskrit": "स च शम्बरमभ्येत्य संयुगाय समाह्वयत् अविषह्यैस्तमाक्षेपैः क्षिपन्सञ्जनयन्कलिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-018",
    "skandha": 10,
    "chapter": 55,
    "sloka": 18,
    "sanskrit": "सोऽधिक्षिप्तो दुर्वाचोभिः पदाहत इवोरगः निश्चक्राम गदापाणिरमर्षात्ताम्रलोचनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-019",
    "skandha": 10,
    "chapter": 55,
    "sloka": 19,
    "sanskrit": "गदामाविध्य तरसा प्रद्युम्नाय महात्मने प्रक्षिप्य व्यनदन्नादं वज्रनिष्पेषनिष्ठुरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-020",
    "skandha": 10,
    "chapter": 55,
    "sloka": 20,
    "sanskrit": "तामापतन्तीं भगवान्प्रद्युम्नो गदया गदाम् अपास्य शत्रवे क्रुद्धः प्राहिणोत्स्वगदां नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-021",
    "skandha": 10,
    "chapter": 55,
    "sloka": 21,
    "sanskrit": "स च मायां समाश्रित्य दैतेयीं मयदर्शितम् मुमुचेऽस्त्रमयं वर्षं कार्ष्णौ वैहायसोऽसुरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-022",
    "skandha": 10,
    "chapter": 55,
    "sloka": 22,
    "sanskrit": "बाध्यमानोऽस्त्रवर्षेण रौक्मिणेयो महारथः सत्त्वात्मिकां महाविद्यां सर्वमायोपमर्दिनीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-023",
    "skandha": 10,
    "chapter": 55,
    "sloka": 23,
    "sanskrit": "ततो गौह्यकगान्धर्व पैशाचोरगराक्षसीः प्रायुङ्क्त शतशो दैत्यः कार्ष्णिर्व्यधमयत्स ताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-024",
    "skandha": 10,
    "chapter": 55,
    "sloka": 24,
    "sanskrit": "निशातमसिमुद्यम्य सकिरीटं सकुण्डलम् शम्बरस्य शिरः कायात्ताम्रश्मश्र्वोजसाहरत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-025",
    "skandha": 10,
    "chapter": 55,
    "sloka": 25,
    "sanskrit": "आकीर्यमाणो दिविजैः स्तुवद्भिः कुसुमोत्करैः भार्ययाम्बरचारिण्या पुरं नीतो विहायसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-026",
    "skandha": 10,
    "chapter": 55,
    "sloka": 26,
    "sanskrit": "अन्तःपुरवरं राजन्ललनाशतसङ्कुलम् विवेश पत्न्या गगनाद्विद्युतेव बलाहकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-027",
    "skandha": 10,
    "chapter": 55,
    "sloka": 27,
    "sanskrit": "तं दृष्ट्वा जलदश्यामं पीतकौशेयवाससम् प्रलम्बबाहुं ताम्राक्षं सुस्मितं रुचिराननम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-028",
    "skandha": 10,
    "chapter": 55,
    "sloka": 28,
    "sanskrit": "स्वलङ्कृतमुखाम्भोजं नीलवक्रालकालिभिः कृष्णं मत्वा स्त्रियो ह्रीता निलिल्युस्तत्र तत्र ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-029",
    "skandha": 10,
    "chapter": 55,
    "sloka": 29,
    "sanskrit": "अवधार्य शनैरीषद्वैलक्षण्येन योषितः उपजग्मुः प्रमुदिताः सस्त्री रत्नं सुविस्मिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-030",
    "skandha": 10,
    "chapter": 55,
    "sloka": 30,
    "sanskrit": "अथ तत्रासितापाङ्गी वैदर्भी वल्गुभाषिणी अस्मरत्स्वसुतं नष्टं स्नेहस्नुतपयोधरा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-031",
    "skandha": 10,
    "chapter": 55,
    "sloka": 31,
    "sanskrit": "को न्वयम्नरवैदूर्यः कस्य वा कमलेक्षणः धृतः कया वा जठरे केयं लब्धा त्वनेन वा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-032",
    "skandha": 10,
    "chapter": 55,
    "sloka": 32,
    "sanskrit": "मम चाप्यात्मजो नष्टो नीतो यः सूतिकागृहात् एतत्तुल्यवयोरूपो यदि जीवति कुत्रचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-033",
    "skandha": 10,
    "chapter": 55,
    "sloka": 33,
    "sanskrit": "कथं त्वनेन सम्प्राप्तं सारूप्यं शार्ङ्गधन्वनः आकृत्यावयवैर्गत्या स्वरहासावलोकनैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-034",
    "skandha": 10,
    "chapter": 55,
    "sloka": 34,
    "sanskrit": "स एव वा भवेन्नूनं यो मे गर्भे धृतोऽर्भकः अमुष्मिन्प्रीतिरधिका वामः स्फुरति मे भुजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-035",
    "skandha": 10,
    "chapter": 55,
    "sloka": 35,
    "sanskrit": "एवं मीमांसमणायां वैदर्भ्यां देवकीसुतः देवक्यानकदुन्दुभ्यामुत्तमःश्लोक आगमत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-036",
    "skandha": 10,
    "chapter": 55,
    "sloka": 36,
    "sanskrit": "विज्ञातार्थोऽपि भगवांस्तूष्णीमास जनार्दनः नारदोऽकथयत्सर्वं शम्बराहरणादिकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-037",
    "skandha": 10,
    "chapter": 55,
    "sloka": 37,
    "sanskrit": "तच्छ्रुत्वा महदाश्चर्यं कृष्णान्तःपुरयोषितः अभ्यनन्दन्बहूनब्दान्नष्टं मृतमिवागतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-038",
    "skandha": 10,
    "chapter": 55,
    "sloka": 38,
    "sanskrit": "देवकी वसुदेवश्च कृष्णरामौ तथा स्त्रियः दम्पती तौ परिष्वज्य रुक्मिणी च ययुर्मुदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-039",
    "skandha": 10,
    "chapter": 55,
    "sloka": 39,
    "sanskrit": "नष्टं प्रद्युम्नमायातमाकर्ण्य द्वारकौकसः अहो मृत इवायातो बालो दिष्ट्येति हाब्रुवन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-55-sloka-040",
    "skandha": 10,
    "chapter": 55,
    "sloka": 40,
    "sanskrit": "यं वै मुहुः पितृसरूपनिजेशभावास् तन्मातरो यदभजन्रहरूढभावाः चित्रं न तत्खलु रमास्पदबिम्बबिम्बे कामे स्मरेऽक्षविषये किमुतान्यनार्यः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]