[
  {
    "id": "skandha-10-chapter-11-sloka-001",
    "skandha": 10,
    "chapter": 11,
    "sloka": 1,
    "sanskrit": "गोपा नन्दादयः श्रुत्वा द्रुमयोः पततो रवम् तत्राजग्मुः कुरुश्रेष्ठ निर्घातभयशङ्किताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-11-sloka-002",
    "skandha": 10,
    "chapter": 11,
    "sloka": 2,
    "sanskrit": "भूम्यां निपतितौ तत्र ददृशुर्यमलार्जुनौ बभ्रमुस्तदविज्ञाय लक्ष्यं पतनकारणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-003",
    "skandha": 10,
    "chapter": 11,
    "sloka": 3,
    "sanskrit": "उलूखलं विकर्षन्तं दाम्ना बद्धं च बालकम् कस्येदं कुत आश्चर्यमुत्पात इति कातराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-004",
    "skandha": 10,
    "chapter": 11,
    "sloka": 4,
    "sanskrit": "बाला ऊचुरनेनेति तिर्यग्गतमुलूखलम् विकर्षता मध्यगेन पुरुषावप्यचक्ष्महि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-005",
    "skandha": 10,
    "chapter": 11,
    "sloka": 5,
    "sanskrit": "न ते तदुक्तं जगृहुर्न घटेतेति तस्य तत् बालस्योत्पाटनं तर्वोः केचित्सन्दिग्धचेतसः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-006",
    "skandha": 10,
    "chapter": 11,
    "sloka": 6,
    "sanskrit": "उलूखलं विकर्षन्तं दाम्ना बद्धं स्वमात्मजम् विलोक्य नन्दः प्रहसद् वदनो विमुमोच ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-007",
    "skandha": 10,
    "chapter": 11,
    "sloka": 7,
    "sanskrit": "गोपीभिः स्तोभितोऽनृत्यद्भगवान्बालवत्क्वचित् उद्गायति क्वचिन्मुग्धस्तद्वशो दारुयन्त्रवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-008",
    "skandha": 10,
    "chapter": 11,
    "sloka": 8,
    "sanskrit": "बिभर्ति क्वचिदाज्ञप्तः पीठकोन्मानपादुकम् बाहुक्षेपं च कुरुते स्वानां च प्रीतिमावहन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-009",
    "skandha": 10,
    "chapter": 11,
    "sloka": 9,
    "sanskrit": "दर्शयंस्तद्विदां लोक आत्मनो भृत्यवश्यताम् व्रजस्योवाह वै हर्षं भगवान्बालचेष्टितैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-010",
    "skandha": 10,
    "chapter": 11,
    "sloka": 10,
    "sanskrit": "क्रीणीहि भोः फलानीति श्रुत्वा सत्त्वरमच्युतः फलार्थी धान्यमादाय ययौ सर्वफलप्रदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-011",
    "skandha": 10,
    "chapter": 11,
    "sloka": 11,
    "sanskrit": "फलविक्रयिणी तस्य च्युतधान्यकरद्वयम् फलैरपूरयद्रत्नैः फलभाण्डमपूरि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-012",
    "skandha": 10,
    "chapter": 11,
    "sloka": 12,
    "sanskrit": "सरित्तीरगतं कृष्णं भग्नार्जुनमथाह्वयत् रामं च रोहिणी देवी क्रीडन्तं बालकैर्भृशम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-013",
    "skandha": 10,
    "chapter": 11,
    "sloka": 13,
    "sanskrit": "नोपेयातां यदाहूतौ क्रीडासङ्गेन पुत्रकौ यशोदां प्रेषयामास रोहिणी पुत्रवत्सलाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-014",
    "skandha": 10,
    "chapter": 11,
    "sloka": 14,
    "sanskrit": "क्रीडन्तं सा सुतं बालैरतिवेलं सहाग्रजम् यशोदाजोहवीत्कृष्णं पुत्रस्नेहस्नुतस्तनी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-015",
    "skandha": 10,
    "chapter": 11,
    "sloka": 15,
    "sanskrit": "कृष्ण कृष्णारविन्दाक्ष तात एहि स्तनं पिब अलं विहारैः क्षुत्क्षान्तः क्रीडाश्रान्तोऽसि पुत्रक",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-016",
    "skandha": 10,
    "chapter": 11,
    "sloka": 16,
    "sanskrit": "हे रामागच्छ ताताशु सानुजः कुलनन्दन प्रातरेव कृताहारस्तद्भवान्भोक्तुमर्हति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-017",
    "skandha": 10,
    "chapter": 11,
    "sloka": 17,
    "sanskrit": "प्रतीक्षते त्वां दाशार्ह भोक्ष्यमाणो व्रजाधिपः एह्यावयोः प्रियं धेहि स्वगृहान्यात बालकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-018",
    "skandha": 10,
    "chapter": 11,
    "sloka": 18,
    "sanskrit": "धूलिधूसरिताङ्गस्त्वं पुत्र मज्जनमावह जन्मर्क्षं तेऽद्य भवति विप्रेभ्यो देहि गाः शुचिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-019",
    "skandha": 10,
    "chapter": 11,
    "sloka": 19,
    "sanskrit": "पश्य पश्य वयस्यांस्ते मातृमृष्टान्स्वलङ्कृतान् त्वं च स्नातः कृताहारो विहरस्व स्वलङ्कृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-020",
    "skandha": 10,
    "chapter": 11,
    "sloka": 20,
    "sanskrit": "इत्थं यशोदा तमशेषशेखरं मत्वा सुतं स्नेहनिबद्धधीर्नृप हस्ते गृहीत्वा सहराममच्युतं नीत्वा स्ववाटं कृतवत्यथोदयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-021",
    "skandha": 10,
    "chapter": 11,
    "sloka": 21,
    "sanskrit": "गोपवृद्धा महोत्पाताननुभूय बृहद्वने नन्दादयः समागम्य व्रजकार्यममन्त्रयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-11-sloka-022",
    "skandha": 10,
    "chapter": 11,
    "sloka": 22,
    "sanskrit": "तत्रोपानन्दनामाह गोपो ज्ञानवयोऽधिकः देशकालार्थतत्त्वज्ञः प्रियकृद्रामकृष्णयोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-023",
    "skandha": 10,
    "chapter": 11,
    "sloka": 23,
    "sanskrit": "उत्थातव्यमितोऽस्माभिर्गोकुलस्य हितैषिभिः आयान्त्यत्र महोत्पाता बालानां नाशहेतवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-024",
    "skandha": 10,
    "chapter": 11,
    "sloka": 24,
    "sanskrit": "मुक्तः कथञ्चिद्राक्षस्या बालघ्न्या बालको ह्यसौ हरेरनुग्रहान्नूनमनश्चोपरि नापतत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-025",
    "skandha": 10,
    "chapter": 11,
    "sloka": 25,
    "sanskrit": "चक्रवातेन नीतोऽयं दैत्येन विपदं वियत् शिलायां पतितस्तत्र परित्रातः सुरेश्वरैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-026",
    "skandha": 10,
    "chapter": 11,
    "sloka": 26,
    "sanskrit": "यन्न म्रियेत द्रुमयोरन्तरं प्राप्य बालकः असावन्यतमो वापि तदप्यच्युतरक्षणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-027",
    "skandha": 10,
    "chapter": 11,
    "sloka": 27,
    "sanskrit": "यावदौत्पातिकोऽरिष्टो व्रजं नाभिभवेदितः तावद्बालानुपादाय यास्यामोऽन्यत्र सानुगाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-028",
    "skandha": 10,
    "chapter": 11,
    "sloka": 28,
    "sanskrit": "वनं वृन्दावनं नाम पशव्यं नवकाननम् गोपगोपीगवां सेव्यं पुण्याद्रितृणवीरुधम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-029",
    "skandha": 10,
    "chapter": 11,
    "sloka": 29,
    "sanskrit": "तत्तत्राद्यैव यास्यामः शकटान्युङ्क्त मा चिरम् गोधनान्यग्रतो यान्तु भवतां यदि रोचते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-030",
    "skandha": 10,
    "chapter": 11,
    "sloka": 30,
    "sanskrit": "तच्छ्रुत्वैकधियो गोपाः साधु साध्विति वादिनः व्रजान्स्वान्स्वान्समायुज्य ययू रूढपरिच्छदाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-031",
    "skandha": 10,
    "chapter": 11,
    "sloka": 31,
    "sanskrit": "वृद्धान्बालान्स्त्रियो राजन्सर्वोपकरणानि च अनःस्वारोप्य गोपाला यत्ता आत्तशरासनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-032",
    "skandha": 10,
    "chapter": 11,
    "sloka": 32,
    "sanskrit": "गोधनानि पुरस्कृत्य शृङ्गाण्यापूर्य सर्वतः तूर्यघोषेण महता ययुः सहपुरोहिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-033",
    "skandha": 10,
    "chapter": 11,
    "sloka": 33,
    "sanskrit": "गोप्यो रूढरथा नूत्न कुचकुङ्कुमकान्तयः कृष्णलीला जगुः प्रीत्या निष्ककण्ठ्यः सुवाससः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-034",
    "skandha": 10,
    "chapter": 11,
    "sloka": 34,
    "sanskrit": "तथा यशोदारोहिण्यावेकं शकटमास्थिते रेजतुः कृष्णरामाभ्यां तत्कथाश्रवणोत्सुके",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-035",
    "skandha": 10,
    "chapter": 11,
    "sloka": 35,
    "sanskrit": "वृन्दावनं सम्प्रविश्य सर्वकालसुखावहम् तत्र चक्रुर्व्रजावासं शकटैरर्धचन्द्रवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-036",
    "skandha": 10,
    "chapter": 11,
    "sloka": 36,
    "sanskrit": "वृन्दावनं गोवर्धनं यमुनापुलिनानि च वीक्ष्यासीदुत्तमा प्रीती राममाधवयोर्नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-037",
    "skandha": 10,
    "chapter": 11,
    "sloka": 37,
    "sanskrit": "एवं व्रजौकसां प्रीतिं यच्छन्तौ बालचेष्टितैः कलवाक्यैः स्वकालेन वत्सपालौ बभूवतुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-038",
    "skandha": 10,
    "chapter": 11,
    "sloka": 38,
    "sanskrit": "अविदूरे व्रजभुवः सह गोपालदारकैः चारयामासतुर्वत्सान्नानाक्रीडापरिच्छदौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-039",
    "skandha": 10,
    "chapter": 11,
    "sloka": 39,
    "sanskrit": "क्वचिद्वादयतो वेणुं क्षेपणैः क्षिपतः क्वचित् क्वचित्पादैः किङ्किणीभिः क्वचित्कृत्रिमगोवृषैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-040",
    "skandha": 10,
    "chapter": 11,
    "sloka": 40,
    "sanskrit": "वृषायमाणौ नर्दन्तौ युयुधाते परस्परम् अनुकृत्य रुतैर्जन्तूंश्चेरतुः प्राकृतौ यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-041",
    "skandha": 10,
    "chapter": 11,
    "sloka": 41,
    "sanskrit": "कदाचिद्यमुनातीरे वत्सांश्चारयतोः स्वकैः वयस्यैः कृष्णबलयोर्जिघांसुर्दैत्य आगमत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-042",
    "skandha": 10,
    "chapter": 11,
    "sloka": 42,
    "sanskrit": "तं वत्सरूपिणं वीक्ष्य वत्सयूथगतं हरिः दर्शयन्बलदेवाय शनैर्मुग्ध इवासदत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-043",
    "skandha": 10,
    "chapter": 11,
    "sloka": 43,
    "sanskrit": "गृहीत्वापरपादाभ्यां सहलाङ्गूलमच्युतः भ्रामयित्वा कपित्थाग्रे प्राहिणोद्गतजीवितम् स कपित्थैर्महाकायः पात्यमानैः पपात ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-044",
    "skandha": 10,
    "chapter": 11,
    "sloka": 44,
    "sanskrit": "तं वीक्ष्य विस्मिता बालाः शशंसुः साधु साध्विति देवाश्च परिसन्तुष्टा बभूवुः पुष्पवर्षिणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-11-sloka-045",
    "skandha": 10,
    "chapter": 11,
    "sloka": 45,
