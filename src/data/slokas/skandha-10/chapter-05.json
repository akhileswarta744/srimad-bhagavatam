[
  {
    "id": "skandha-10-chapter-05-sloka-001",
    "skandha": 10,
    "chapter": 5,
    "sloka": 1,
    "sanskrit": "नन्दस्त्वात्मज उत्पन्ने जाताह्लादो महामनाः आहूय विप्रान्वेदज्ञान्स्नातः शुचिरलङ्कृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-05-sloka-002",
    "skandha": 10,
    "chapter": 5,
    "sloka": 2,
    "sanskrit": "वाचयित्वा स्वस्त्ययनं जातकर्मात्मजस्य वै कारयामास विधिवत्पितृदेवार्चनं तथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-003",
    "skandha": 10,
    "chapter": 5,
    "sloka": 3,
    "sanskrit": "धेनूनां नियुते प्रादाद्विप्रेभ्यः समलङ्कृते तिलाद्रीन्सप्त रत्नौघ शातकौम्भाम्बरावृतान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-004",
    "skandha": 10,
    "chapter": 5,
    "sloka": 4,
    "sanskrit": "कालेन स्नानशौचाभ्यां संस्कारैस्तपसेज्यया शुध्यन्ति दानैः सन्तुष्ट्या द्रव्याण्यात्मात्मविद्यया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-005",
    "skandha": 10,
    "chapter": 5,
    "sloka": 5,
    "sanskrit": "सौमङ्गल्यगिरो विप्राः सूतमागधवन्दिनः गायकाश्च जगुर्नेदुर्भेर्यो दुन्दुभयो मुहुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-006",
    "skandha": 10,
    "chapter": 5,
    "sloka": 6,
    "sanskrit": "व्रजः सम्मृष्टसंसिक्त द्वाराजिरगृहान्तरः चित्रध्वजपताकास्रक् चैलपल्लवतोरणैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-007",
    "skandha": 10,
    "chapter": 5,
    "sloka": 7,
    "sanskrit": "गावो वृषा वत्सतरा हरिद्रातैलरूषिताः विचित्रधातुबर्हस्रग् वस्त्रकाञ्चनमालिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-008",
    "skandha": 10,
    "chapter": 5,
    "sloka": 8,
    "sanskrit": "महार्हवस्त्राभरण कञ्चुकोष्णीषभूषिताः गोपाः समाययू राजन्नानोपायनपाणयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-009",
    "skandha": 10,
    "chapter": 5,
    "sloka": 9,
    "sanskrit": "गोप्यश्चाकर्ण्य मुदिता यशोदायाः सुतोद्भवम् आत्मानं भूषयां चक्रुर्वस्त्राकल्पाञ्जनादिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-010",
    "skandha": 10,
    "chapter": 5,
    "sloka": 10,
    "sanskrit": "नवकुङ्कुमकिञ्जल्क मुखपङ्कजभूतयः बलिभिस्त्वरितं जग्मुः पृथुश्रोण्यश्चलत्कुचाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-011",
    "skandha": 10,
    "chapter": 5,
    "sloka": 11,
    "sanskrit": "गोप्यः सुमृष्टमणिकुण्डलनिष्ककण्ठ्यश् चित्राम्बराः पथि शिखाच्युतमाल्यवर्षाः नन्दालयं सवलया व्रजतीर्विरेजुर् व्यालोलकुण्डलपयोधरहारशोभाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-012",
    "skandha": 10,
    "chapter": 5,
    "sloka": 12,
    "sanskrit": "ता आशिषः प्रयुञ्जानाश्चिरं पाहीति बालके हरिद्राचूर्णतैलाद्भिः सिञ्चन्त्योऽजनमुज्जगुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-013",
    "skandha": 10,
    "chapter": 5,
    "sloka": 13,
    "sanskrit": "अवाद्यन्त विचित्राणि वादित्राणि महोत्सवे कृष्णे विश्वेश्वरेऽनन्ते नन्दस्य व्रजमागते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-014",
    "skandha": 10,
    "chapter": 5,
    "sloka": 14,
    "sanskrit": "गोपाः परस्परं हृष्टा दधिक्षीरघृताम्बुभिः आसिञ्चन्तो विलिम्पन्तो नवनीतैश्च चिक्षिपुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-015",
    "skandha": 10,
    "chapter": 5,
    "sloka": 15,
    "sanskrit": "नन्दो महामनास्तेभ्यो वासोऽलङ्कारगोधनम् सूतमागधवन्दिभ्यो येऽन्ये विद्योपजीविनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-016",
    "skandha": 10,
    "chapter": 5,
    "sloka": 16,
    "sanskrit": "तैस्तैः कामैरदीनात्मा यथोचितमपूजयत् विष्णोराराधनार्थाय स्वपुत्रस्योदयाय च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-017",
    "skandha": 10,
    "chapter": 5,
    "sloka": 17,
    "sanskrit": "रोहिणी च महाभागा नन्दगोपाभिनन्दिता व्यचरद्दिव्यवासस्रक् कण्ठाभरणभूषिता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-018",
    "skandha": 10,
    "chapter": 5,
    "sloka": 18,
    "sanskrit": "तत आरभ्य नन्दस्य व्रजः सर्वसमृद्धिमान् हरेर्निवासात्मगुणै रमाक्रीडमभून्नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-019",
    "skandha": 10,
    "chapter": 5,
    "sloka": 19,
    "sanskrit": "गोपान्गोकुलरक्षायां निरूप्य मथुरां गतः नन्दः कंसस्य वार्षिक्यं करं दातुं कुरूद्वह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-020",
    "skandha": 10,
    "chapter": 5,
    "sloka": 20,
    "sanskrit": "वसुदेव उपश्रुत्य भ्रातरं नन्दमागतम् ज्ञात्वा दत्तकरं राज्ञे ययौ तदवमोचनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-021",
    "skandha": 10,
    "chapter": 5,
    "sloka": 21,
    "sanskrit": "तं दृष्ट्वा सहसोत्थाय देहः प्राणमिवागतम् प्रीतः प्रियतमं दोर्भ्यां सस्वजे प्रेमविह्वलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-022",
    "skandha": 10,
    "chapter": 5,
    "sloka": 22,
    "sanskrit": "पूजितः सुखमासीनः पृष्ट्वानामयमादृतः प्रसक्तधीः स्वात्मजयोरिदमाह विशाम्पते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-023",
    "skandha": 10,
    "chapter": 5,
    "sloka": 23,
    "sanskrit": "दिष्ट्या भ्रातः प्रवयस इदानीमप्रजस्य ते प्रजाशाया निवृत्तस्य प्रजा यत्समपद्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-024",
    "skandha": 10,
    "chapter": 5,
    "sloka": 24,
    "sanskrit": "दिष्ट्या संसारचक्रेऽस्मिन्वर्तमानः पुनर्भवः उपलब्धो भवानद्य दुर्लभं प्रियदर्शनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-025",
    "skandha": 10,
    "chapter": 5,
    "sloka": 25,
    "sanskrit": "नैकत्र प्रियसंवासः सुहृदां चित्रकर्मणाम् ओघेन व्यूह्यमानानां प्लवानां स्रोतसो यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-026",
    "skandha": 10,
    "chapter": 5,
    "sloka": 26,
    "sanskrit": "कच्चित्पशव्यं निरुजं भूर्यम्बुतृणवीरुधम् बृहद्वनं तदधुना यत्रास्से त्वं सुहृद्वृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-027",
    "skandha": 10,
    "chapter": 5,
    "sloka": 27,
    "sanskrit": "भ्रातर्मम सुतः कच्चिन्मात्रा सह भवद्व्रजे तातं भवन्तं मन्वानो भवद्भ्यामुपलालितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-028",
    "skandha": 10,
    "chapter": 5,
    "sloka": 28,
    "sanskrit": "पुंसस्त्रिवर्गो विहितः सुहृदो ह्यनुभावितः न तेषु क्लिश्यमानेषु त्रिवर्गोऽर्थाय कल्पते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-029",
    "skandha": 10,
    "chapter": 5,
    "sloka": 29,
    "sanskrit": "अहो ते देवकीपुत्राः कंसेन बहवो हताः एकावशिष्टावरजा कन्या सापि दिवं गता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीनन्द उवाच ।"
  },
  {
    "id": "skandha-10-chapter-05-sloka-030",
    "skandha": 10,
    "chapter": 5,
    "sloka": 30,
    "sanskrit": "नूनं ह्यदृष्टनिष्ठोऽयमदृष्टपरमो जनः अदृष्टमात्मनस्तत्त्वं यो वेद न स मुह्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-05-sloka-031",
    "skandha": 10,
    "chapter": 5,
    "sloka": 31,
    "sanskrit": "करो वै वार्षिको दत्तो राज्ञे दृष्टा वयं च वः नेह स्थेयं बहुतिथं सन्त्युत्पाताश्च गोकुले",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीवसुदेव उवाच ।"
  },
  {
    "id": "skandha-10-chapter-05-sloka-032",
    "skandha": 10,
    "chapter": 5,
    "sloka": 32,
    "sanskrit": "इति नन्दादयो गोपाः प्रोक्तास्ते शौरिणा ययुः अनोभिरनडुद्युक्तैस्तमनुज्ञाप्य गोकुलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  }
]