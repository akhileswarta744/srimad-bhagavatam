[
  {
    "id": "skandha-10-chapter-34-sloka-001",
    "skandha": 10,
    "chapter": 34,
    "sloka": 1,
    "sanskrit": "एकदा देवयात्रायां गोपाला जातकौतुकाः अनोभिरनडुद्युक्तैः प्रययुस्तेऽम्बिकावनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-34-sloka-002",
    "skandha": 10,
    "chapter": 34,
    "sloka": 2,
    "sanskrit": "तत्र स्नात्वा सरस्वत्यां देवं पशुपतिं विभुम् आनर्चुरर्हणैर्भक्त्या देवीं च णृपतेऽम्बिकाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-003",
    "skandha": 10,
    "chapter": 34,
    "sloka": 3,
    "sanskrit": "गावो हिरण्यं वासांसि मधु मध्वन्नमादृताः ब्राह्मणेभ्यो ददुः सर्वे देवो नः प्रीयतामिति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-004",
    "skandha": 10,
    "chapter": 34,
    "sloka": 4,
    "sanskrit": "ऊषुः सरस्वतीतीरे जलं प्राश्य यतव्रताः रजनीं तां महाभागा नन्दसुनन्दकादयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-005",
    "skandha": 10,
    "chapter": 34,
    "sloka": 5,
    "sanskrit": "कश्चिन्महानहिस्तस्मिन्विपिनेऽतिबुभुक्षितः यदृच्छयागतो नन्दं शयानमुरगोऽग्रसीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-006",
    "skandha": 10,
    "chapter": 34,
    "sloka": 6,
    "sanskrit": "स चुक्रोशाहिना ग्रस्तः कृष्ण कृष्ण महानयम् सर्पो मां ग्रसते तात प्रपन्नं परिमोचय",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-007",
    "skandha": 10,
    "chapter": 34,
    "sloka": 7,
    "sanskrit": "तस्य चाक्रन्दितं श्रुत्वा गोपालाः सहसोत्थिताः ग्रस्तं च दृष्ट्वा विभ्रान्ताः सर्पं विव्यधुरुल्मुकैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-008",
    "skandha": 10,
    "chapter": 34,
    "sloka": 8,
    "sanskrit": "अलातैर्दह्यमानोऽपि नामुञ्चत्तमुरङ्गमः तमस्पृशत्पदाभ्येत्य भगवान्सात्वतां पतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-009",
    "skandha": 10,
    "chapter": 34,
    "sloka": 9,
    "sanskrit": "स वै भगवतः श्रीमत्पादस्पर्शहताशुभः भेजे सर्पवपुर्हित्वा रूपं विद्याधरार्चितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-010",
    "skandha": 10,
    "chapter": 34,
    "sloka": 10,
    "sanskrit": "तमपृच्छद्धृषीकेशः प्रणतं समवस्थितम् दीप्यमानेन वपुषा पुरुषं हेममालिनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-011",
    "skandha": 10,
    "chapter": 34,
    "sloka": 11,
    "sanskrit": "को भवान्परया लक्ष्म्या रोचतेऽद्भुतदर्शनः कथं जुगुप्सितामेतां गतिं वा प्रापितोऽवशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-012",
    "skandha": 10,
    "chapter": 34,
    "sloka": 12,
    "sanskrit": "अहं विद्याधरः कश्चित्सुदर्शन इति श्रुतः श्रिया स्वरूपसम्पत्त्या विमानेनाचरन्दिशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "सर्प उवाच ।"
  },
  {
    "id": "skandha-10-chapter-34-sloka-013",
    "skandha": 10,
    "chapter": 34,
    "sloka": 13,
    "sanskrit": "ऋषीन्विरूपाङ्गिरसः प्राहसं रूपदर्पितः तैरिमां प्रापितो योनिं प्रलब्धैः स्वेन पाप्मना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-014",
    "skandha": 10,
    "chapter": 34,
    "sloka": 14,
    "sanskrit": "शापो मेऽनुग्रहायैव कृतस्तैः करुणात्मभिः यदहं लोकगुरुणा पदा स्पृष्टो हताशुभः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-015",
    "skandha": 10,
    "chapter": 34,
    "sloka": 15,
    "sanskrit": "तं त्वाहं भवभीतानां प्रपन्नानां भयापहम् आपृच्छे शापनिर्मुक्तः पादस्पर्शादमीवहन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-016",
    "skandha": 10,
    "chapter": 34,
    "sloka": 16,
    "sanskrit": "प्रपन्नोऽस्मि महायोगिन्महापुरुष सत्पते अनुजानीहि मां देव सर्वलोकेश्वरेश्वर",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-017",
    "skandha": 10,
    "chapter": 34,
    "sloka": 17,
    "sanskrit": "ब्रह्मदण्डाद्विमुक्तोऽहं सद्यस्तेऽच्युत दर्शनात् यन्नाम गृह्णन्नखिलान्श्रोतॄनात्मानमेव च सद्यः पुनाति किं भूयस्तस्य स्पृष्टः पदा हि ते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-018",
    "skandha": 10,
    "chapter": 34,
    "sloka": 18,
    "sanskrit": "इत्यनुज्ञाप्य दाशार्हं परिक्रम्याभिवन्द्य च सुदर्शनो दिवं यातः कृच्छ्रान्नन्दश्च मोचितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-019",
    "skandha": 10,
    "chapter": 34,
    "sloka": 19,
    "sanskrit": "निशाम्य कृष्णस्य तदात्मवैभवं व्रजौकसो विस्मितचेतसस्ततः समाप्य तस्मिन्नियमं पुनर्व्रजं णृपाययुस्तत्कथयन्त आदृताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-020",
    "skandha": 10,
    "chapter": 34,
    "sloka": 20,
    "sanskrit": "कदाचिदथ गोविन्दो रामश्चाद्भुतविक्रमः विजह्रतुर्वने रात्र्यां मध्यगौ व्रजयोषिताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-021",
    "skandha": 10,
    "chapter": 34,
    "sloka": 21,
    "sanskrit": "उपगीयमानौ ललितं स्त्रीजनैर्बद्धसौहृदैः स्वलङ्कृतानुलिप्ताङ्गौ स्रग्विनौ विरजोऽम्बरौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-022",
    "skandha": 10,
    "chapter": 34,
    "sloka": 22,
    "sanskrit": "निशामुखं मानयन्तावुदितोडुपतारकम् मल्लिकागन्धमत्तालि जुष्टं कुमुदवायुना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-023",
    "skandha": 10,
    "chapter": 34,
    "sloka": 23,
    "sanskrit": "जगतुः सर्वभूतानां मनःश्रवणमङ्गलम् तौ कल्पयन्तौ युगपत्स्वरमण्डलमूर्च्छितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-024",
    "skandha": 10,
    "chapter": 34,
    "sloka": 24,
    "sanskrit": "गोप्यस्तद्गीतमाकर्ण्य मूर्च्छिता नाविदन्नृप स्रंसद्दुकूलमात्मानं स्रस्तकेशस्रजं ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-025",
    "skandha": 10,
    "chapter": 34,
    "sloka": 25,
    "sanskrit": "एवं विक्रीडतोः स्वैरं गायतोः सम्प्रमत्तवत् शङ्खचूड इति ख्यातो धनदानुचरोऽभ्यगात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-026",
    "skandha": 10,
    "chapter": 34,
    "sloka": 26,
    "sanskrit": "तयोर्निरीक्षतो राजंस्तन्नाथं प्रमदाजनम् क्रोशन्तं कालयामास दिश्युदीच्यामशङ्कितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-027",
    "skandha": 10,
    "chapter": 34,
    "sloka": 27,
    "sanskrit": "क्रोशन्तं कृष्ण रामेति विलोक्य स्वपरिग्रहम् यथा गा दस्युना ग्रस्ता भ्रातरावन्वधावताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-028",
    "skandha": 10,
    "chapter": 34,
    "sloka": 28,
    "sanskrit": "मा भैष्टेत्यभयारावौ शालहस्तौ तरस्विनौ आसेदतुस्तं तरसा त्वरितं गुह्यकाधमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-029",
    "skandha": 10,
    "chapter": 34,
    "sloka": 29,
    "sanskrit": "स वीक्ष्य तावनुप्राप्तौ कालमृत्यू इवोद्विजन् विषृज्य स्त्रीजनं मूढः प्राद्रवज्जीवितेच्छया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-030",
    "skandha": 10,
    "chapter": 34,
    "sloka": 30,
    "sanskrit": "तमन्वधावद्गोविन्दो यत्र यत्र स धावति जिहीर्षुस्तच्छिरोरत्नं तस्थौ रक्षन्स्त्रियो बलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-031",
    "skandha": 10,
    "chapter": 34,
    "sloka": 31,
    "sanskrit": "अविदूर इवाभ्येत्य शिरस्तस्य दुरात्मनः जहार मुष्टिनैवाङ्ग सहचूडमणिं विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-34-sloka-032",
    "skandha": 10,
    "chapter": 34,
    "sloka": 32,
    "sanskrit": "शङ्खचूडं निहत्यैवं मणिमादाय भास्वरम् अग्रजायाददात्प्रीत्या पश्यन्तीनां च योषिताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]