[
  {
    "id": "skandha-10-chapter-57-sloka-001",
    "skandha": 10,
    "chapter": 57,
    "sloka": 1,
    "sanskrit": "विज्ञातार्थोऽपि गोविन्दो दग्धानाकर्ण्य पाण्डवान् कुन्तीं च कुल्यकरणे सहरामो ययौ कुरून्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीबादरायणिरुवाच ।"
  },
  {
    "id": "skandha-10-chapter-57-sloka-002",
    "skandha": 10,
    "chapter": 57,
    "sloka": 2,
    "sanskrit": "भीष्मं कृपं स विदुरं गान्धारीं द्रोणमेव च तुल्यदुःखौ च सङ्गम्य हा कष्टमिति होचतुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-003",
    "skandha": 10,
    "chapter": 57,
    "sloka": 3,
    "sanskrit": "लब्ध्वैतदन्तरं राजन्शतधन्वानमूचतुः अक्रूरकृतवर्माणौ मनिः कस्मान्न गृह्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-004",
    "skandha": 10,
    "chapter": 57,
    "sloka": 4,
    "sanskrit": "योऽस्मभ्यं सम्प्रतिश्रुत्य कन्यारत्नं विगर्ह्य नः कृष्णायादान्न सत्राजित्कस्माद्भ्रातरमन्वियात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-005",
    "skandha": 10,
    "chapter": 57,
    "sloka": 5,
    "sanskrit": "एवं भिन्नमतिस्ताभ्यां सत्राजितमसत्तमः शयानमवधील्लोभात्स पापः क्षीण जीवितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-006",
    "skandha": 10,
    "chapter": 57,
    "sloka": 6,
    "sanskrit": "स्त्रीणां विक्रोशमानानां क्रन्दन्तीनामनाथवत् हत्वा पशून्सौनिकवन्मणिमादाय जग्मिवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-007",
    "skandha": 10,
    "chapter": 57,
    "sloka": 7,
    "sanskrit": "सत्यभामा च पितरं हतं वीक्ष्य शुचार्पिता व्यलपत्तात तातेति हा हतास्मीति मुह्यती",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-008",
    "skandha": 10,
    "chapter": 57,
    "sloka": 8,
    "sanskrit": "तैलद्रोण्यां मृतं प्रास्य जगाम गजसाह्वयम् कृष्णाय विदितार्थाय तप्ताचख्यौ पितुर्वधम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-009",
    "skandha": 10,
    "chapter": 57,
    "sloka": 9,
    "sanskrit": "तदाकर्ण्येश्वरौ राजन्ननुसृत्य नृलोकताम् अहो नः परमं कष्टमित्यस्राक्षौ विलेपतुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-010",
    "skandha": 10,
    "chapter": 57,
    "sloka": 10,
    "sanskrit": "आगत्य भगवांस्तस्मात्सभार्यः साग्रजः पुरम् शतधन्वानमारेभे हन्तुं हर्तुं मणिं ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-011",
    "skandha": 10,
    "chapter": 57,
    "sloka": 11,
    "sanskrit": "सोऽपि कृतोद्यमं ज्ञात्वा भीतः प्राणपरीप्सया साहाय्ये कृतवर्माणमयाचत स चाब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-012",
    "skandha": 10,
    "chapter": 57,
    "sloka": 12,
    "sanskrit": "नाहमीस्वरयोः कुर्यां हेलनं रामकृष्णयोः को नु क्षेमाय कल्पेत तयोर्वृजिनमाचरन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-013",
    "skandha": 10,
    "chapter": 57,
    "sloka": 13,
    "sanskrit": "कंसः सहानुगोऽपीतो यद्द्वेषात्त्याजितः श्रिया जरासन्धः सप्तदश संयुगाद्विरथो गतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-014",
    "skandha": 10,
    "chapter": 57,
    "sloka": 14,
    "sanskrit": "प्रत्याख्यातः स चाक्रूरं पार्ष्णिग्राहमयाचत सोऽप्याह को विरुध्येत विद्वानीश्वरयोर्बलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-015",
    "skandha": 10,
    "chapter": 57,
    "sloka": 15,
    "sanskrit": "य इदं लीलया विश्वं सृजत्यवति हन्ति च चेष्टां विश्वसृजो यस्य न विदुर्मोहिताजया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-016",
    "skandha": 10,
    "chapter": 57,
    "sloka": 16,
    "sanskrit": "यः सप्तहायनः शैलमुत्पाट्यैकेन पाणिना दधार लीलया बाल उच्छिलीन्ध्रमिवार्भकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-017",
    "skandha": 10,
    "chapter": 57,
    "sloka": 17,
    "sanskrit": "नमस्तस्मै भगवते कृष्णायाद्भुतकर्मणे अनन्तायादिभूताय कूटस्थायात्मने नमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-018",
    "skandha": 10,
    "chapter": 57,
    "sloka": 18,
    "sanskrit": "प्रत्याख्यातः स तेनापि शतधन्वा महामणिम् तस्मिन्न्यस्याश्वमारुह्य शतयोजनगं ययौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-019",
    "skandha": 10,
    "chapter": 57,
    "sloka": 19,
    "sanskrit": "गरुडध्वजमारुह्य रथं रामजनार्दनौ अन्वयातां महावेगैरश्वै राजन्गुरुद्रुहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-020",
    "skandha": 10,
    "chapter": 57,
    "sloka": 20,
    "sanskrit": "मिथिलायामुपवने विसृज्य पतितं हयम् पद्भ्यामधावत्सन्त्रस्तः कृष्णोऽप्यन्वद्रवद्रुषा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-021",
    "skandha": 10,
    "chapter": 57,
    "sloka": 21,
    "sanskrit": "पदातेर्भगवांस्तस्य पदातिस्तिग्मनेमिना चक्रेण शिर उत्कृत्य वाससोर्व्यचिनोन्मणिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-022",
    "skandha": 10,
    "chapter": 57,
    "sloka": 22,
    "sanskrit": "अलब्धमणिरागत्य कृष्ण आहाग्रजान्तिकम् वृथा हतः शतधनुर्मणिस्तत्र न विद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-023",
    "skandha": 10,
    "chapter": 57,
    "sloka": 23,
    "sanskrit": "तत आह बलो नूनं स मणिः शतधन्वना कस्मिंश्चित्पुरुषे न्यस्तस्तमन्वेष पुरं व्रज",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-024",
    "skandha": 10,
    "chapter": 57,
    "sloka": 24,
    "sanskrit": "अहं वैदेहमिच्छामि द्रष्टुं प्रियतमं मम इत्युक्त्वा मिथिलां राजन्विवेश यदनन्दनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-025",
    "skandha": 10,
    "chapter": 57,
    "sloka": 25,
    "sanskrit": "तं दृष्ट्वा सहसोत्थाय मैथिलः प्रीतमानसः अर्हयां आस विधिवदर्हणीयं समर्हणैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-026",
    "skandha": 10,
    "chapter": 57,
    "sloka": 26,
    "sanskrit": "उवास तस्यां कतिचिन्मिथिलायां समा विभुः मानितः प्रीतियुक्तेन जनकेन महात्मना ततोऽशिक्षद्गदां काले धार्तराष्ट्रः सुयोधनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-027",
    "skandha": 10,
    "chapter": 57,
    "sloka": 27,
    "sanskrit": "केशवो द्वारकामेत्य निधनं शतधन्वनः अप्राप्तिं च मणेः प्राह प्रियायाः प्रियकृद्विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-028",
    "skandha": 10,
    "chapter": 57,
    "sloka": 28,
    "sanskrit": "ततः स कारयामास क्रिया बन्धोर्हतस्य वै साकं सुहृद्भिर्भगवान्या याः स्युः साम्परायिकीः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-029",
    "skandha": 10,
    "chapter": 57,
    "sloka": 29,
    "sanskrit": "अक्रूरः कृतवर्मा च श्रुत्वा शतधनोर्वधम् व्यूषतुर्भयवित्रस्तौ द्वारकायाः प्रयोजकौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-030",
    "skandha": 10,
    "chapter": 57,
    "sloka": 30,
    "sanskrit": "अक्रूरे प्रोषितेऽरिष्टान्यासन्वै द्वारकौकसाम् शारीरा मानसास्तापा मुहुर्दैविकभौतिकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-031",
    "skandha": 10,
    "chapter": 57,
    "sloka": 31,
    "sanskrit": "इत्यङ्गोपदिशन्त्येके विस्मृत्य प्रागुदाहृतम् मुनिवासनिवासे किं घटेतारिष्टदर्शनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-032",
    "skandha": 10,
    "chapter": 57,
    "sloka": 32,
    "sanskrit": "देवेऽवर्षति काशीशः श्वफल्कायागताय वै स्वसुतां गाण्डिनीं प्रादात्ततोऽवर्षत्स्म काशिषु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-033",
    "skandha": 10,
    "chapter": 57,
    "sloka": 33,
    "sanskrit": "तत्सुतस्तत्प्रभावोऽसावक्रूरो यत्र यत्र ह देवोऽभिवर्षते तत्र नोपतापा न मारीकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-034",
    "skandha": 10,
    "chapter": 57,
    "sloka": 34,
    "sanskrit": "इति वृद्धवचः श्रुत्वा नैतावदिह कारणम् इति मत्वा समानाय्य प्राहाक्रूरं जनार्दनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-035",
    "skandha": 10,
    "chapter": 57,
    "sloka": 35,
    "sanskrit": "पूजयित्वाभिभाष्यैनं कथयित्वा प्रियाः कथाः विज्ञताखिलचित्त ज्ञः स्मयमान उवाच ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-036",
    "skandha": 10,
    "chapter": 57,
    "sloka": 36,
    "sanskrit": "ननु दानपते न्यस्तस्त्वय्यास्ते शतधन्वना स्यमन्तको मनिः श्रीमान्विदितः पूर्वमेव नः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-037",
    "skandha": 10,
    "chapter": 57,
    "sloka": 37,
    "sanskrit": "सत्राजितोऽनपत्यत्वाद्गृह्णीयुर्दुहितुः सुताः दायं निनीयापः पिण्डान्विमुच्यर्णं च शेषितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-038",
    "skandha": 10,
    "chapter": 57,
    "sloka": 38,
    "sanskrit": "तथापि दुर्धरस्त्वन्यैस्त्वय्यास्तां सुव्रते मणिः किन्तु मामग्रजः सम्यङ्न प्रत्येति मणिं प्रति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-039",
    "skandha": 10,
    "chapter": 57,
    "sloka": 39,
    "sanskrit": "दर्शयस्व महाभाग बन्धूनां शान्तिमावह अव्युच्छिन्ना मखास्तेऽद्य वर्तन्ते रुक्मवेदयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-040",
    "skandha": 10,
    "chapter": 57,
    "sloka": 40,
    "sanskrit": "एवं सामभिरालब्धः श्वफल्कतनयो मणिम् आदाय वाससाच्छन्नः ददौ सूर्यसमप्रभम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-041",
    "skandha": 10,
    "chapter": 57,
    "sloka": 41,
    "sanskrit": "स्यमन्तकं दर्शयित्वा ज्ञातिभ्यो रज आत्मनः विमृज्य मणिना भूयस्तस्मै प्रत्यर्पयत्प्रभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-57-sloka-042",
    "skandha": 10,
    "chapter": 57,
    "sloka": 42,
    "sanskrit": "यस्त्वेतद्भगवत ईश्वरस्य विष्णोर् वीर्याढ्यं वृजिनहरं सुमङ्गलं च आख्यानं पठति शृणोत्यनुस्मरेद्वा दुष्कीर्तिं दुरितमपोह्य याति शान्तिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]