[
  {
    "id": "skandha-10-chapter-76-sloka-001",
    "skandha": 10,
    "chapter": 76,
    "sloka": 1,
    "sanskrit": "अथान्यदपि कृष्णस्य शृणु कर्माद्भुतं नृप क्रीडानरशरीरस्य यथा सौभपतिर्हतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-76-sloka-002",
    "skandha": 10,
    "chapter": 76,
    "sloka": 2,
    "sanskrit": "शिशुपालसखः शाल्वो रुक्मिण्युद्वाह आगतः यदुभिर्निर्जितः सङ्ख्ये जरासन्धादयस्तथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-003",
    "skandha": 10,
    "chapter": 76,
    "sloka": 3,
    "sanskrit": "शाल्वः प्रतिज्ञामकरोच्छृण्वतां सर्वभूभुजाम् अयादवां क्ष्मां करिष्ये पौरुषं मम पश्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-004",
    "skandha": 10,
    "chapter": 76,
    "sloka": 4,
    "sanskrit": "इति मूढः प्रतिज्ञाय देवं पशुपतिं प्रभुम् आराधयामास नृपः पांशुमुष्टिं सकृद्ग्रसन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-005",
    "skandha": 10,
    "chapter": 76,
    "sloka": 5,
    "sanskrit": "संवत्सरान्ते भगवानाशुतोष उमापतिः वरेण च्छन्दयामास शाल्वं शरणमागतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-006",
    "skandha": 10,
    "chapter": 76,
    "sloka": 6,
    "sanskrit": "देवासुरमनुष्याणां गन्धर्वोरगरक्षसाम् अभेद्यं कामगं वव्रे स यानं वृष्णिभीषणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-007",
    "skandha": 10,
    "chapter": 76,
    "sloka": 7,
    "sanskrit": "तथेति गिरिशादिष्टो मयः परपुरंजयः पुरं निर्माय शाल्वाय प्रादात्सौभमयस्मयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-008",
    "skandha": 10,
    "chapter": 76,
    "sloka": 8,
    "sanskrit": "स लब्ध्वा कामगं यानं तमोधाम दुरासदम् ययस्द्वारवतीं शाल्वो वैरं वृष्णिकृतं स्मरन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-009",
    "skandha": 10,
    "chapter": 76,
    "sloka": 9,
    "sanskrit": "निरुध्य सेनया शाल्वो महत्या भरतर्षभ पुरीं बभञ्जोपवनानुद्यानानि च सर्वशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-010",
    "skandha": 10,
    "chapter": 76,
    "sloka": 10,
    "sanskrit": "सगोपुराणि द्वाराणि प्रासादाट्टालतोलिकाः विहारान्स विमानाग्र्यान्निपेतुः शस्त्रवृष्टयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-011",
    "skandha": 10,
    "chapter": 76,
    "sloka": 11,
    "sanskrit": "शिलाद्रुमाश्चाशनयः सर्पा आसारशर्कराः प्रचण्डश्चक्रवातोऽभूद्रजसाच्छादिता दिशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-012",
    "skandha": 10,
    "chapter": 76,
    "sloka": 12,
    "sanskrit": "इत्यर्द्यमाना सौभेन कृष्णस्य नगरी भृशम् नाभ्यपद्यत शं राजंस्त्रिपुरेण यथा मही",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-013",
    "skandha": 10,
    "chapter": 76,
    "sloka": 13,
    "sanskrit": "प्रद्युम्नो भगवान्वीक्ष्य बाध्यमाना निजाः प्रजाः म भैष्टेत्यभ्यधाद्वीरो रथारूढो महायशाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-014",
    "skandha": 10,
    "chapter": 76,
    "sloka": 14,
    "sanskrit": "सात्यकिश्चारुदेष्णश्च साम्बोऽक्रूरः सहानुजः हार्दिक्यो भानुविन्दश्च गदश्च शुकसारणौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-015",
    "skandha": 10,
    "chapter": 76,
    "sloka": 15,
    "sanskrit": "अपरे च महेष्वासा रथयूथपयूथपाः निर्ययुर्दंशिता गुप्ता रथेभाश्वपदातिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-016",
    "skandha": 10,
    "chapter": 76,
    "sloka": 16,
    "sanskrit": "ततः प्रववृते युद्धं शाल्वानां यदुभिः सह यथासुराणां विबुधैस्तुमुलं लोमहर्षणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-017",
    "skandha": 10,
    "chapter": 76,
    "sloka": 17,
    "sanskrit": "ताश्च सौभपतेर्माया दिव्यास्त्रै रुक्मिणीसुतः क्षणेन नाशयामास नैशं तम इवोष्णगुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-018",
    "skandha": 10,
    "chapter": 76,
    "sloka": 18,
    "sanskrit": "विव्याध पञ्चविंशत्या स्वर्णपुङ्खैरयोमुखैः शाल्वस्य ध्वजिनीपालं शरैः सन्नतपर्वभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-019",
    "skandha": 10,
    "chapter": 76,
    "sloka": 19,
    "sanskrit": "शतेनाताडयच्छाल्वमेकैकेनास्य सैनिकान् दशभिर्दशभिर्नेतॄन्वाहनानि त्रिभिस्त्रिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-020",
    "skandha": 10,
    "chapter": 76,
    "sloka": 20,
    "sanskrit": "तदद्भुतं महत्कर्म प्रद्युम्नस्य महात्मनः दृष्ट्वा तं पूजयामासुः सर्वे स्वपरसैनिकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-021",
    "skandha": 10,
    "chapter": 76,
    "sloka": 21,
    "sanskrit": "बहुरूपैकरूपं तद्दृश्यते न च दृश्यते मायामयं मयकृतं दुर्विभाव्यं परैरभूत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-022",
    "skandha": 10,
    "chapter": 76,
    "sloka": 22,
    "sanskrit": "क्वचिद्भूमौ क्वचिद्व्योम्नि गिरिमूर्ध्नि जले क्वचित् अलातचक्रवद्भ्राम्यत्सौभं तद्दुरवस्थितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-023",
    "skandha": 10,
    "chapter": 76,
    "sloka": 23,
    "sanskrit": "यत्र यत्रोपलक्ष्येत ससौभः सहसैनिकः शाल्वस्ततस्ततोऽमुञ्चञ्छरान्सात्वतयूथपाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-024",
    "skandha": 10,
    "chapter": 76,
    "sloka": 24,
    "sanskrit": "शरैरग्न्यर्कसंस्पर्शैराशीविषदुरासदैः पीड्यमानपुरानीकः शाल्वोऽमुह्यत्परेरितैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-025",
    "skandha": 10,
    "chapter": 76,
    "sloka": 25,
    "sanskrit": "शाल्वानीकपशस्त्रौघैर्वृष्णिवीरा भृशार्दिताः न तत्यजू रणं स्वं स्वं लोकद्वयजिगीषवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-026",
    "skandha": 10,
    "chapter": 76,
    "sloka": 26,
    "sanskrit": "शाल्वामात्यो द्युमान्नाम प्रद्युम्नं प्रक्प्रपीडितः आसाद्य गदया मौर्व्या व्याहत्य व्यनदद्बली",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-027",
    "skandha": 10,
    "chapter": 76,
    "sloka": 27,
    "sanskrit": "प्रद्युम्नं गदया सीर्ण वक्षःस्थलमरिंदमम् अपोवाह रणात्सूतो धर्मविद्दारुकात्मजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-028",
    "skandha": 10,
    "chapter": 76,
    "sloka": 28,
    "sanskrit": "लब्धसम्ज्ञो मुहूर्तेन कार्ष्णिः सारथिमब्रवीत् अहो असाध्विदं सूत यद्रणान्मेऽपसर्पणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-029",
    "skandha": 10,
    "chapter": 76,
    "sloka": 29,
    "sanskrit": "न यदूनां कुले जातः श्रूयते रणविच्युतः विना मत्क्लीबचित्तेन सूतेन प्राप्तकिल्बिषात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-030",
    "skandha": 10,
    "chapter": 76,
    "sloka": 30,
    "sanskrit": "किं नु वक्ष्येऽभिसङ्गम्य पितरौ रामकेशवौ युद्धात्सम्यगपक्रान्तः पृष्टस्तत्रात्मनः क्षमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-031",
    "skandha": 10,
    "chapter": 76,
    "sloka": 31,
    "sanskrit": "व्यक्तं मे कथयिष्यन्ति हसन्त्यो भ्रातृजामयः क्लैब्यं कथं कथं वीर तवान्यैः कथ्यतां मृधे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-76-sloka-032",
    "skandha": 10,
    "chapter": 76,
    "sloka": 32,
    "sanskrit": "धर्मं विजानतायुष्मन्कृतमेतन्मया विभो सूतः कृच्छ्रगतं रक्षेद्रथिनं सारथिं रथी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "सारथिरुवाच ।"
  },
  {
    "id": "skandha-10-chapter-76-sloka-033",
    "skandha": 10,
    "chapter": 76,
    "sloka": 33,
    "sanskrit": "एतद्विदित्वा तु भवान्मयापोवाहितो रणात् उपसृष्टः परेणेति मूर्च्छितो गदया हतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]