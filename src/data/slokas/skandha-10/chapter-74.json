[
  {
    "id": "skandha-10-chapter-74-sloka-001",
    "skandha": 10,
    "chapter": 74,
    "sloka": 1,
    "sanskrit": "एवं युधिष्ठिरो राजा जरासन्धवधं विभोः कृष्णस्य चानुभावं तं श्रुत्वा प्रीतस्तमब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-74-sloka-002",
    "skandha": 10,
    "chapter": 74,
    "sloka": 2,
    "sanskrit": "ये स्युस्त्रैलोक्यगुरवः सर्वे लोका महेश्वराः वहन्ति दुर्लभं लब्द्वा शिरसैवानुशासनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीयुधिष्ठिर उवाच ।"
  },
  {
    "id": "skandha-10-chapter-74-sloka-003",
    "skandha": 10,
    "chapter": 74,
    "sloka": 3,
    "sanskrit": "स भवानरविन्दाक्षो दीनानामीशमानिनाम् धत्तेऽनुशासनं भूमंस्तदत्यन्तविडम्बनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-004",
    "skandha": 10,
    "chapter": 74,
    "sloka": 4,
    "sanskrit": "न ह्येकस्याद्वितीयस्य ब्रह्मणः परमात्मनः कर्मभिर्वर्धते तेजो ह्रसते च यथा रवेः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-005",
    "skandha": 10,
    "chapter": 74,
    "sloka": 5,
    "sanskrit": "न वै तेऽजित भक्तानां ममाहमिति माधव त्वं तवेति च नानाधीः पशूनामिव वैकृती",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-006",
    "skandha": 10,
    "chapter": 74,
    "sloka": 6,
    "sanskrit": "इत्युक्त्वा यज्ञिये काले वव्रे युक्तान्स ऋत्विजः कृष्णानुमोदितः पार्थो ब्राह्मणान्ब्रह्मवादिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-74-sloka-007",
    "skandha": 10,
    "chapter": 74,
    "sloka": 7,
    "sanskrit": "द्वैपायनो भरद्वाजः सुमन्तुर्गोतमोऽसितः वसिष्ठश्च्यवनः कण्वो मैत्रेयः कवषस्त्रितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-008",
    "skandha": 10,
    "chapter": 74,
    "sloka": 8,
    "sanskrit": "विश्वामित्रो वामदेवः सुमतिर्जैमिनिः क्रतुः पैलः पराशरो गर्गो वैशम्पायन एव च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-009",
    "skandha": 10,
    "chapter": 74,
    "sloka": 9,
    "sanskrit": "अथर्वा कश्यपो धौम्यो रामो भार्गव आसुरिः वीतिहोत्रो मधुच्छन्दा वीरसेनोऽकृतव्रणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-010",
    "skandha": 10,
    "chapter": 74,
    "sloka": 10,
    "sanskrit": "उपहूतास्तथा चान्ये द्रोणभीष्मकृपादयः धृतराष्ट्रः सहसुतो विदुरश्च महामतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-011",
    "skandha": 10,
    "chapter": 74,
    "sloka": 11,
    "sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्रा यज्ञदिदृक्षवः तत्रेयुः सर्वराजानो राज्ञां प्रकृतयो नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-012",
    "skandha": 10,
    "chapter": 74,
    "sloka": 12,
    "sanskrit": "ततस्ते देवयजनं ब्राह्मणाः स्वर्णलाङ्गलैः कृष्ट्वा तत्र यथाम्नायं दीक्षयां चक्रिरे नृपम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-013",
    "skandha": 10,
    "chapter": 74,
    "sloka": 13,
    "sanskrit": "हैमाः किलोपकरणा वरुणस्य यथा पुरा इन्द्रादयो लोकपाला विरिञ्चिभवसंयुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-014",
    "skandha": 10,
    "chapter": 74,
    "sloka": 14,
    "sanskrit": "सगणाः सिद्धगन्धर्वा विद्याधरमहोरगाः मुनयो यक्षरक्षांसि खगकिन्नरचारणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-015",
    "skandha": 10,
    "chapter": 74,
    "sloka": 15,
    "sanskrit": "राजानश्च समाहूता राजपत्न्यश्च सर्वशः राजसूयं समीयुः स्म राज्ञः पाण्डुसुतस्य वै मेनिरे कृष्णभक्तस्य सूपपन्नमविस्मिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-016",
    "skandha": 10,
    "chapter": 74,
    "sloka": 16,
    "sanskrit": "अयाजयन्महाराजं याजका देववर्चसः राजसूयेन विधिवत्प्रचेतसमिवामराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-017",
    "skandha": 10,
    "chapter": 74,
    "sloka": 17,
    "sanskrit": "सूत्येऽहन्यवनीपालो याजकान्सदसस्पतीन् अपूजयन्महाभागान्यथावत्सुसमाहितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-018",
    "skandha": 10,
    "chapter": 74,
    "sloka": 18,
    "sanskrit": "सदस्याग्र्यार्हणार्हं वै विमृशन्तः सभासदः नाध्यगच्छन्ननैकान्त्यात्सहदेवस्तदाब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-019",
    "skandha": 10,
    "chapter": 74,
    "sloka": 19,
    "sanskrit": "अर्हति ह्यच्युतः श्रैष्ठ्यं भगवान्सात्वतां पतिः एष वै देवताः सर्वा देशकालधनादयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-020",
    "skandha": 10,
    "chapter": 74,
    "sloka": 20,
    "sanskrit": "यदात्मकमिदं विश्वं क्रतवश्च यदात्मकाः अग्निराहुतयो मन्त्रा साङ्ख्यं योगश्च यत्परः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-021",
    "skandha": 10,
    "chapter": 74,
    "sloka": 21,
    "sanskrit": "एक एवाद्वितीयोऽसावैतदात्म्यमिदं जगत् आत्मनात्माश्रयः सभ्याः सृजत्यवति हन्त्यजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-022",
    "skandha": 10,
    "chapter": 74,
    "sloka": 22,
    "sanskrit": "विविधानीह कर्माणि जनयन्यदवेक्षया ईहते यदयं सर्वः श्रेयो धर्मादिलक्षणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-023",
    "skandha": 10,
    "chapter": 74,
    "sloka": 23,
    "sanskrit": "तस्मात्कृष्णाय महते दीयतां परमार्हणम् एवं चेत्सर्वभूतानामात्मनश्चार्हणं भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-024",
    "skandha": 10,
    "chapter": 74,
    "sloka": 24,
    "sanskrit": "सर्वभूतात्मभूताय कृष्णायानन्यदर्शिने देयं शान्ताय पूर्णाय दत्तस्यानन्त्यमिच्छता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-025",
    "skandha": 10,
    "chapter": 74,
    "sloka": 25,
    "sanskrit": "इत्युक्त्वा सहदेवोऽभूत्तूष्णीं कृष्णानुभाववित् तच्छ्रुत्वा तुष्टुवुः सर्वे साधु साध्विति सत्तमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-026",
    "skandha": 10,
    "chapter": 74,
    "sloka": 26,
    "sanskrit": "श्रुत्वा द्विजेरितं राजा ज्ञात्वा हार्दं सभासदाम् समर्हयद्धृषीकेशं प्रीतः प्रणयविह्वलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-027",
    "skandha": 10,
    "chapter": 74,
    "sloka": 27,
    "sanskrit": "तत्पादाववनिज्यापः शिरसा लोकपावनीः सभार्यः सानुजामात्यः सकुटुम्बो वहन्मुदा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-028",
    "skandha": 10,
    "chapter": 74,
    "sloka": 28,
    "sanskrit": "वासोभिः पीतकौषेयैर्भूषणैश्च महाधनैः अर्हयित्वाश्रुपूर्णाक्षो नाशकत्समवेक्षितुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-029",
    "skandha": 10,
    "chapter": 74,
    "sloka": 29,
    "sanskrit": "इत्थं सभाजितं वीक्ष्य सर्वे प्राञ्जलयो जनाः नमो जयेति नेमुस्तं निपेतुः पुष्पवृष्टयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-030",
    "skandha": 10,
    "chapter": 74,
    "sloka": 30,
    "sanskrit": "इत्थं निशम्य दमघोषसुतः स्वपीठाद् उत्थाय कृष्णगुणवर्णनजातमन्युः उत्क्षिप्य बाहुमिदमाह सदस्यमर्षी संश्रावयन्भगवते परुषाण्यभीतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-031",
    "skandha": 10,
    "chapter": 74,
    "sloka": 31,
    "sanskrit": "ईशो दुरत्ययः काल इति सत्यवती स्रुतिः वृद्धानामपि यद्बुद्धिर्बालवाक्यैर्विभिद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-032",
    "skandha": 10,
    "chapter": 74,
    "sloka": 32,
    "sanskrit": "यूयं पात्रविदां श्रेष्ठा मा मन्ध्वं बालभाषीतम् सदसस्पतयः सर्वे कृष्णो यत्सम्मतोऽर्हणे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-033",
    "skandha": 10,
    "chapter": 74,
    "sloka": 33,
    "sanskrit": "तपोविद्याव्रतधरान्ज्ञानविध्वस्तकल्मषान् परमऋषीन्ब्रह्मनिष्ठांल्लोकपालैश्च पूजितान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-034",
    "skandha": 10,
    "chapter": 74,
    "sloka": 34,
    "sanskrit": "सदस्पतीनतिक्रम्य गोपालः कुलपांसनः यथा काकः पुरोडाशं सपर्यां कथमर्हति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-035",
    "skandha": 10,
    "chapter": 74,
    "sloka": 35,
    "sanskrit": "वर्णाश्रमकुलापेतः सर्वधर्मबहिष्कृतः स्वैरवर्ती गुणैर्हीनः सपर्यां कथमर्हति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-036",
    "skandha": 10,
    "chapter": 74,
    "sloka": 36,
    "sanskrit": "ययातिनैषां हि कुलं शप्तं सद्भिर्बहिष्कृतम् वृथापानरतं शश्वत्सपर्यां कथमर्हति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-037",
    "skandha": 10,
    "chapter": 74,
    "sloka": 37,
    "sanskrit": "ब्रह्मर्षिसेवितान्देशान्हित्वैतेऽब्रह्मवर्चसम् समुद्रं दुर्गमाश्रित्य बाधन्ते दस्यवः प्रजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-038",
    "skandha": 10,
    "chapter": 74,
    "sloka": 38,
    "sanskrit": "एवमादीन्यभद्राणि बभाषे नष्टमङ्गलः नोवाच किञ्चिद्भगवान्यथा सिंहः शिवारुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-039",
    "skandha": 10,
    "chapter": 74,
    "sloka": 39,
    "sanskrit": "भगवन्निन्दनं श्रुत्वा दुःसहं तत्सभासदः कर्णौ पिधाय निर्जग्मुः शपन्तश्चेदिपं रुषा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-040",
    "skandha": 10,
    "chapter": 74,
    "sloka": 40,
    "sanskrit": "निन्दां भगवतः शृण्वंस्तत्परस्य जनस्य वा ततो नापैति यः सोऽपि यात्यधः सुकृताच्च्युतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-041",
    "skandha": 10,
    "chapter": 74,
    "sloka": 41,
    "sanskrit": "ततः पाण्डुसुताः क्रुद्धा मत्स्यकैकयसृञ्जयाः उदायुधाः समुत्तस्थुः शिशुपालजिघांसवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-042",
    "skandha": 10,
    "chapter": 74,
    "sloka": 42,
    "sanskrit": "ततश्चैद्यस्त्वसम्भ्रान्तो जगृहे खड्गचर्मणी भर्त्सयन्कृष्णपक्षीयान्राज्ञः सदसि भारत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-043",
    "skandha": 10,
    "chapter": 74,
    "sloka": 43,
    "sanskrit": "तावदुत्थाय भगवान्स्वान्निवार्य स्वयं रुषा शिरः क्षुरान्तचक्रेण जहार पततो रिपोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-74-sloka-044",
    "skandha": 10,
    "chapter": 74,
    "sloka": 44,
    "sanskrit": "शब्दः कोलाहलोऽथासीच्छिशुपाले हते महान् तस्यानुयायिनो भूपा दुद्रुवुर्जीवितैषिणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
