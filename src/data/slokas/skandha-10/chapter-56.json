[
  {
    "id": "skandha-10-chapter-56-sloka-001",
    "skandha": 10,
    "chapter": 56,
    "sloka": 1,
    "sanskrit": "सत्राजितः स्वतनयां कृष्णाय कृतकिल्बिषः स्यमन्तकेन मणिना स्वयमुद्यम्य दत्तवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-56-sloka-002",
    "skandha": 10,
    "chapter": 56,
    "sloka": 2,
    "sanskrit": "सत्राजितः किमकरोद्ब्रह्मन्कृष्णस्य किल्बिषः स्यमन्तकः कुतस्तस्य कस्माद्दत्ता सुता हरेः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीराजोवाच ।"
  },
  {
    "id": "skandha-10-chapter-56-sloka-003",
    "skandha": 10,
    "chapter": 56,
    "sloka": 3,
    "sanskrit": "आसीत्सत्राजितः सूर्यो भक्तस्य परमः सखा प्रीतस्तस्मै मणिं प्रादात्स च तुष्टः स्यमन्तकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-56-sloka-004",
    "skandha": 10,
    "chapter": 56,
    "sloka": 4,
    "sanskrit": "स तं बिभ्रन्मणिं कण्ठे भ्राजमानो यथा रविः प्रविष्टो द्वारकां राजन्तेजसा नोपलक्षितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-005",
    "skandha": 10,
    "chapter": 56,
    "sloka": 5,
    "sanskrit": "तं विलोक्य जना दूरात्तेजसा मुष्टदृष्टयः दीव्यतेऽक्षैर्भगवते शशंसुः सूर्यशङ्किताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-006",
    "skandha": 10,
    "chapter": 56,
    "sloka": 6,
    "sanskrit": "नारायण नमस्तेऽस्तु शङ्खचक्रगदाधर दामोदरारविन्दाक्ष गोविन्द यदुनन्दन",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-007",
    "skandha": 10,
    "chapter": 56,
    "sloka": 7,
    "sanskrit": "एष आयाति सविता त्वां दिदृक्षुर्जगत्पते मुष्णन्गभस्तिचक्रेण नृणां चक्षूंषि तिग्मगुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-008",
    "skandha": 10,
    "chapter": 56,
    "sloka": 8,
    "sanskrit": "नन्वन्विच्छन्ति ते मार्गं त्रीलोक्यां विबुधर्षभाः ज्ञात्वाद्य गूढं यदुषु द्रष्टुं त्वां यात्यजः प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-009",
    "skandha": 10,
    "chapter": 56,
    "sloka": 9,
    "sanskrit": "निशम्य बालवचनं प्रहस्याम्बुजलोचनः प्राह नासौ रविर्देवः सत्राजिन्मणिना ज्वलन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-56-sloka-010",
    "skandha": 10,
    "chapter": 56,
    "sloka": 10,
    "sanskrit": "सत्राजित्स्वगृहं श्रीमत्कृतकौतुकमङ्गलम् प्रविश्य देवसदने मणिं विप्रैर्न्यवेशयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-011",
    "skandha": 10,
    "chapter": 56,
    "sloka": 11,
    "sanskrit": "दिने दिने स्वर्णभारानष्टौ स सृजति प्रभो दुर्भिक्षमार्यरिष्टानि सर्पाधिव्याधयोऽशुभाः न सन्ति मायिनस्तत्र यत्रास्तेऽभ्यर्चितो मणिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-012",
    "skandha": 10,
    "chapter": 56,
    "sloka": 12,
    "sanskrit": "स याचितो मणिं क्वापि यदुराजाय शौरिणा नैवार्थकामुकः प्रादाद्याच्ञाभङ्गमतर्कयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-013",
    "skandha": 10,
    "chapter": 56,
    "sloka": 13,
    "sanskrit": "तमेकदा मणिं कण्ठे प्रतिमुच्य महाप्रभम् प्रसेनो हयमारुह्य मृगायां व्यचरद्वने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-014",
    "skandha": 10,
    "chapter": 56,
    "sloka": 14,
    "sanskrit": "प्रसेनं सहयं हत्वा मणिमाच्छिद्य केशरी गिरिं विशञ्जाम्बवता निहतो मणिमिच्छता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-015",
    "skandha": 10,
    "chapter": 56,
    "sloka": 15,
    "sanskrit": "सोऽपि चक्रे कुमारस्य मणिं क्रीडनकं बिले अपश्यन्भ्रातरं भ्राता सत्राजित्पर्यतप्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-016",
    "skandha": 10,
    "chapter": 56,
    "sloka": 16,
    "sanskrit": "प्रायः कृष्णेन निहतो मणिग्रीवो वनं गतः भ्राता ममेति तच्छ्रुत्वा कर्णे कर्णेऽजपञ्जनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-017",
    "skandha": 10,
    "chapter": 56,
    "sloka": 17,
    "sanskrit": "भगवांस्तदुपश्रुत्य दुर्यशो लिप्तमात्मनि मार्ष्टुं प्रसेनपदवीमन्वपद्यत नागरैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-018",
    "skandha": 10,
    "chapter": 56,
    "sloka": 18,
    "sanskrit": "हतं प्रसेनं अश्वं च वीक्ष्य केशरिणा वने तं चाद्रिपृष्ठे निहतमृक्षेण ददृशुर्जनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-019",
    "skandha": 10,
    "chapter": 56,
    "sloka": 19,
    "sanskrit": "ऋक्षराजबिलं भीममन्धेन तमसावृतम् एको विवेश भगवानवस्थाप्य बहिः प्रजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-020",
    "skandha": 10,
    "chapter": 56,
    "sloka": 20,
    "sanskrit": "तत्र दृष्ट्वा मणिप्रेष्ठं बालक्रीडनकं कृतम् हर्तुं कृतमतिस्तस्मिन्नवतस्थेऽर्भकान्तिके",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-021",
    "skandha": 10,
    "chapter": 56,
    "sloka": 21,
    "sanskrit": "तमपूर्वं नरं दृष्ट्वा धात्री चुक्रोश भीतवत् तच्छ्रुत्वाभ्यद्रवत्क्रुद्धो जाम्बवान्बलिनां वरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-022",
    "skandha": 10,
    "chapter": 56,
    "sloka": 22,
    "sanskrit": "स वै भगवता तेन युयुधे स्वामीनात्मनः पुरुषम्प्राकृतं मत्वा कुपितो नानुभाववित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-023",
    "skandha": 10,
    "chapter": 56,
    "sloka": 23,
    "sanskrit": "द्वन्द्वयुद्धं सुतुमुलमुभयोर्विजिगीषतोः आयुधाश्मद्रुमैर्दोर्भिः क्रव्यार्थे श्येनयोरिव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-024",
    "skandha": 10,
    "chapter": 56,
    "sloka": 24,
    "sanskrit": "आसीत्तदष्टाविम्शाहमितरेतरमुष्टिभिः वज्रनिष्पेषपरुषैरविश्रममहर्निशम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-025",
    "skandha": 10,
    "chapter": 56,
    "sloka": 25,
    "sanskrit": "कृष्णमुष्टिविनिष्पात निष्पिष्टाङ्गोरु बन्धनः क्षीणसत्त्वः स्विन्नगात्रस्तमाहातीव विस्मितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-026",
    "skandha": 10,
    "chapter": 56,
    "sloka": 26,
    "sanskrit": "जाने त्वां सऋवभूतानां प्राण ओजः सहो बलम् विष्णुं पुराणपुरुषं प्रभविष्णुमधीश्वरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-027",
    "skandha": 10,
    "chapter": 56,
    "sloka": 27,
    "sanskrit": "त्वं हि विश्वसृजाम्स्रष्टा सृष्टानामपि यच्च सत् कालः कलयतामीशः पर आत्मा तथात्मनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-028",
    "skandha": 10,
    "chapter": 56,
    "sloka": 28,
    "sanskrit": "यस्येषदुत्कलितरोषकटाक्षमोक्षैर् वर्त्मादिशत्क्षुभितनक्रतिमिङ्गलोऽब्धिः सेतुः कृतः स्वयश उज्ज्वलिता च लङ्का रक्षःशिरांसि भुवि पेतुरिषुक्षतानि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-029",
    "skandha": 10,
    "chapter": 56,
    "sloka": 29,
    "sanskrit": "इति विज्ञातवीज्ञानमृक्षराजानमच्युतः व्याजहार महाराज भगवान्देवकीसुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-030",
    "skandha": 10,
    "chapter": 56,
    "sloka": 30,
    "sanskrit": "अभिमृश्यारविन्दाक्षः पाणिना शंकरेण तम् कृपया परया भक्तं मेघगम्भीरया गिरा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-031",
    "skandha": 10,
    "chapter": 56,
    "sloka": 31,
    "sanskrit": "मणिहेतोरिह प्राप्ता वयमृक्षपते बिलम् मिथ्याभिशापं प्रमृजन्नात्मनो मणिनामुना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-032",
    "skandha": 10,
    "chapter": 56,
    "sloka": 32,
    "sanskrit": "इत्युक्तः स्वां दुहितरं कन्यां जाम्बवतीं मुदा अर्हणार्थम्स मणिना कृष्णायोपजहार ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-033",
    "skandha": 10,
    "chapter": 56,
    "sloka": 33,
    "sanskrit": "अदृष्ट्वा निर्गमं शौरेः प्रविष्टस्य बिलं जनाः प्रतीक्ष्य द्वादशाहानि दुःखिताः स्वपुरं ययुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-034",
    "skandha": 10,
    "chapter": 56,
    "sloka": 34,
    "sanskrit": "निशम्य देवकी देवी रक्मिण्यानकदुन्दुभिः सुहृदो ज्ञातयोऽशोचन्बिलात्कृष्णमनिर्गतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-035",
    "skandha": 10,
    "chapter": 56,
    "sloka": 35,
    "sanskrit": "सत्राजितं शपन्तस्ते दुःखिता द्वारकौकसः उपतस्थुश्चन्द्रभागां दुर्गां कृष्णोपलब्धये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-036",
    "skandha": 10,
    "chapter": 56,
    "sloka": 36,
    "sanskrit": "तेषां तु देव्युपस्थानात्प्रत्यादिष्टाशिषा स च प्रादुर्बभूव सिद्धार्थः सदारो हर्षयन्हरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-037",
    "skandha": 10,
    "chapter": 56,
    "sloka": 37,
    "sanskrit": "उपलभ्य हृषीकेशं मृतं पुनरिवागतम् सह पत्न्या मणिग्रीवं सर्वे जातमहोत्सवाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-038",
    "skandha": 10,
    "chapter": 56,
    "sloka": 38,
    "sanskrit": "सत्राजितं समाहूय सभायां राजसन्निधौ प्राप्तिं चाख्याय भगवान्मणिं तस्मै न्यवेदयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-039",
    "skandha": 10,
    "chapter": 56,
    "sloka": 39,
    "sanskrit": "स चातिव्रीडितो रत्नं गृहीत्वावाङ्मुखस्ततः अनुतप्यमानो भवनमगमत्स्वेन पाप्मना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-040",
    "skandha": 10,
    "chapter": 56,
    "sloka": 40,
    "sanskrit": "सोऽनुध्यायंस्तदेवाघं बलवद्विग्रहाकुलः कथं मृजाम्यात्मरजः प्रसीदेद्वाच्युतः कथम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-041",
    "skandha": 10,
    "chapter": 56,
    "sloka": 41,
    "sanskrit": "किम्कृत्वा साधु मह्यं स्यान्न शपेद्वा जनो यथा अदीर्घदर्शनं क्षुद्रं मूढं द्रविणलोलुपम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-042",
    "skandha": 10,
    "chapter": 56,
    "sloka": 42,
    "sanskrit": "दास्ये दुहितरं तस्मै स्त्रीरत्नं रत्नमेव च उपायोऽयं समीचीनस्तस्य शान्तिर्न चान्यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-043",
    "skandha": 10,
    "chapter": 56,
    "sloka": 43,
    "sanskrit": "एवं व्यवसितो बुद्ध्या सत्राजित्स्वसुतां शुभाम् मणिं च स्वयमुद्यम्य कृष्णायोपजहार ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-56-sloka-044",
    "skandha": 10,
    "chapter": 56,
    "sloka": 44,
    "sanskrit": "तां सत्यभामां भगवानुपयेमे यथाविधि बहुभिर्याचितां शील रूपौदार्यगुणान्विताम्",
