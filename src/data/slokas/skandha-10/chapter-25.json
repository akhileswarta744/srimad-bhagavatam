[
  {
    "id": "skandha-10-chapter-25-sloka-001",
    "skandha": 10,
    "chapter": 25,
    "sloka": 1,
    "sanskrit": "इन्द्रस्तदात्मनः पूजां विज्ञाय विहतां नृप गोपेभ्यः कृष्णनाथेभ्यो नन्दादिभ्यश्चुकोप ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-25-sloka-002",
    "skandha": 10,
    "chapter": 25,
    "sloka": 2,
    "sanskrit": "गणं सांवर्तकं नाम मेघानां चान्तकारीणाम् इन्द्रः प्रचोदयत्क्रुद्धो वाक्यं चाहेशमान्युत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-003",
    "skandha": 10,
    "chapter": 25,
    "sloka": 3,
    "sanskrit": "अहो श्रीमदमाहात्म्यं गोपानां काननौकसाम् कृष्णं मर्त्यमुपाश्रित्य ये चक्रुर्देवहेलनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-004",
    "skandha": 10,
    "chapter": 25,
    "sloka": 4,
    "sanskrit": "यथादृढैः कर्ममयैः क्रतुभिर्नामनौनिभैः विद्यामान्वीक्षिकीं हित्वा तितीर्षन्ति भवार्णवम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-005",
    "skandha": 10,
    "chapter": 25,
    "sloka": 5,
    "sanskrit": "वाचालं बालिशं स्तब्धमज्ञं पण्डितमानिनम् कृष्णं मर्त्यमुपाश्रित्य गोपा मे चक्रुरप्रियम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-006",
    "skandha": 10,
    "chapter": 25,
    "sloka": 6,
    "sanskrit": "एषां श्रियावलिप्तानां कृष्णेनाध्मापितात्मनाम् धुनुत श्रीमदस्तम्भं पशून्नयत सङ्क्षयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-007",
    "skandha": 10,
    "chapter": 25,
    "sloka": 7,
    "sanskrit": "अहं चैरावतं नागमारुह्यानुव्रजे व्रजम् मरुद्गणैर्महावेगैर्नन्दगोष्ठजिघांसया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-008",
    "skandha": 10,
    "chapter": 25,
    "sloka": 8,
    "sanskrit": "इत्थं मघवताज्ञप्ता मेघा निर्मुक्तबन्धनाः नन्दगोकुलमासारैः पीडयामासुरोजसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-25-sloka-009",
    "skandha": 10,
    "chapter": 25,
    "sloka": 9,
    "sanskrit": "विद्योतमाना विद्युद्भिः स्तनन्तः स्तनयित्नुभिः तीव्रैर्मरुद्गणैर्नुन्ना ववृषुर्जलशर्कराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-010",
    "skandha": 10,
    "chapter": 25,
    "sloka": 10,
    "sanskrit": "स्थूणास्थूला वर्षधारा मुञ्चत्स्वभ्रेष्वभीक्ष्णशः जलौघैः प्लाव्यमाना भूर्नादृश्यत नतोन्नतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-011",
    "skandha": 10,
    "chapter": 25,
    "sloka": 11,
    "sanskrit": "अत्यासारातिवातेन पशवो जातवेपनाः गोपा गोप्यश्च शीतार्ता गोविन्दं शरणं ययुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-012",
    "skandha": 10,
    "chapter": 25,
    "sloka": 12,
    "sanskrit": "शिरः सुतांश्च कायेन प्रच्छाद्यासारपीडिताः वेपमाना भगवतः पादमूलमुपाययुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-013",
    "skandha": 10,
    "chapter": 25,
    "sloka": 13,
    "sanskrit": "कृष्ण कृष्ण महाभाग त्वन्नाथं गोकुलं प्रभो त्रातुमर्हसि देवान्नः कुपिताद्भक्तवत्सल",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-014",
    "skandha": 10,
    "chapter": 25,
    "sloka": 14,
    "sanskrit": "शिलावर्षातिवातेन हन्यमानमचेतनम् निरीक्ष्य भगवान्मेने कुपितेन्द्रकृतं हरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-015",
    "skandha": 10,
    "chapter": 25,
    "sloka": 15,
    "sanskrit": "अपर्त्वत्युल्बणं वर्षमतिवातं शिलामयम् स्वयागे विहतेऽस्माभिरिन्द्रो नाशाय वर्षति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-016",
    "skandha": 10,
    "chapter": 25,
    "sloka": 16,
    "sanskrit": "तत्र प्रतिविधिं सम्यगात्मयोगेन साधये लोकेशमानिनां मौढ्याद्धनिष्ये श्रीमदं तमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-017",
    "skandha": 10,
    "chapter": 25,
    "sloka": 17,
    "sanskrit": "न हि सद्भावयुक्तानां सुराणामीशविस्मयः मत्तोऽसतां मानभङ्गः प्रशमायोपकल्पते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-018",
    "skandha": 10,
    "chapter": 25,
    "sloka": 18,
    "sanskrit": "तस्मान्मच्छरणं गोष्ठं मन्नाथं मत्परिग्रहम् गोपाये स्वात्मयोगेन सोऽयं मे व्रत आहितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-019",
    "skandha": 10,
    "chapter": 25,
    "sloka": 19,
    "sanskrit": "इत्युक्त्वैकेन हस्तेन कृत्वा गोवर्धनाचलम् दधार लीलया विष्णुश्छत्राकमिव बालकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-020",
    "skandha": 10,
    "chapter": 25,
    "sloka": 20,
    "sanskrit": "अथाह भगवान्गोपान्हेऽम्ब तात व्रजौकसः यथोपजोषं विशत गिरिगर्तं सगोधनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-021",
    "skandha": 10,
    "chapter": 25,
    "sloka": 21,
    "sanskrit": "न त्रास इह वः कार्यो मद्धस्ताद्रिनिपातनात् वातवर्षभयेनालं तत्त्राणं विहितं हि वः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-022",
    "skandha": 10,
    "chapter": 25,
    "sloka": 22,
    "sanskrit": "तथा निर्विविशुर्गर्तं कृष्णाश्वासितमानसः यथावकाशं सधनाः सव्रजाः सोपजीविनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-023",
    "skandha": 10,
    "chapter": 25,
    "sloka": 23,
    "sanskrit": "क्षुत्तृड्व्यथां सुखापेक्षां हित्वा तैर्व्रजवासिभिः वीक्ष्यमाणो दधाराद्रिं सप्ताहं नाचलत्पदात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-024",
    "skandha": 10,
    "chapter": 25,
    "sloka": 24,
    "sanskrit": "कृष्णयोगानुभावं तं निशम्येन्द्रोऽतिविस्मितः निस्तम्भो भ्रष्टसङ्कल्पः स्वान्मेघान्सन्न्यवारयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-025",
    "skandha": 10,
    "chapter": 25,
    "sloka": 25,
    "sanskrit": "खं व्यभ्रमुदितादित्यं वातवर्षं च दारुणम् निशम्योपरतं गोपान्गोवर्धनधरोऽब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-026",
    "skandha": 10,
    "chapter": 25,
    "sloka": 26,
    "sanskrit": "निर्यात त्यजत त्रासं गोपाः सस्त्रीधनार्भकाः उपारतं वातवर्षं व्युदप्रायाश्च निम्नगाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-027",
    "skandha": 10,
    "chapter": 25,
    "sloka": 27,
    "sanskrit": "ततस्ते निर्ययुर्गोपाः स्वं स्वमादाय गोधनम् शकटोढोपकरणं स्त्रीबालस्थविराः शनैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-028",
    "skandha": 10,
    "chapter": 25,
    "sloka": 28,
    "sanskrit": "भगवानपि तं शैलं स्वस्थाने पूर्ववत्प्रभुः पश्यतां सर्वभूतानां स्थापयामास लीलया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-029",
    "skandha": 10,
    "chapter": 25,
    "sloka": 29,
    "sanskrit": "तं प्रेमवेगान्निर्भृता व्रजौकसो यथा समीयुः परिरम्भणादिभिः गोप्यश्च सस्नेहमपूजयन्मुदा दध्यक्षताद्भिर्युयुजुः सदाशिषः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-030",
    "skandha": 10,
    "chapter": 25,
    "sloka": 30,
    "sanskrit": "यशोदा रोहिणी नन्दो रामश्च बलिनां वरः कृष्णमालिङ्ग्य युयुजुराशिषः स्नेहकातराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-031",
    "skandha": 10,
    "chapter": 25,
    "sloka": 31,
    "sanskrit": "दिवि देवगणाः सिद्धाः साध्या गन्धर्वचारणाः तुष्टुवुर्मुमुचुस्तुष्टाः पुष्पवर्षाणि पार्थिव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-032",
    "skandha": 10,
    "chapter": 25,
    "sloka": 32,
    "sanskrit": "शङ्खदुन्दुभयो नेदुर्दिवि देवप्रचोदिताः जगुर्गन्धर्वपतयस्तुम्बुरुप्रमुखा नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-25-sloka-033",
    "skandha": 10,
    "chapter": 25,
    "sloka": 33,
    "sanskrit": "ततोऽनुरक्तैः पशुपैः परिश्रितो राजन्स्वगोष्ठं सबलोऽव्रजद्धरिः तथाविधान्यस्य कृतानि गोपिका गायन्त्य ईयुर्मुदिता हृदिस्पृशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]