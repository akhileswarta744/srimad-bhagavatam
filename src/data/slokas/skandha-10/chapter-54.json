[
  {
    "id": "skandha-10-chapter-54-sloka-001",
    "skandha": 10,
    "chapter": 54,
    "sloka": 1,
    "sanskrit": "इति सर्वे सुसंरब्धा वाहानारुह्य दंशिताः स्वैः स्वैर्बलैः परिक्रान्ता अन्वीयुर्धृतकार्मुकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-54-sloka-002",
    "skandha": 10,
    "chapter": 54,
    "sloka": 2,
    "sanskrit": "तानापतत आलोक्य यादवानीकयूथपाः तस्थुस्तत्सम्मुखा राजन्विस्फूर्ज्य स्वधनूंषि ते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-003",
    "skandha": 10,
    "chapter": 54,
    "sloka": 3,
    "sanskrit": "अश्वपृष्ठे गजस्कन्धे रथोपस्थेऽस्त्र कोविदाः मुमुचुः शरवर्षाणि मेघा अद्रिष्वपो यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-004",
    "skandha": 10,
    "chapter": 54,
    "sloka": 4,
    "sanskrit": "पत्युर्बलं शरासारैश्छन्नं वीक्ष्य सुमध्यमा सव्रीड्मैक्षत्तद्वक्त्रं भयविह्वललोचना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-005",
    "skandha": 10,
    "chapter": 54,
    "sloka": 5,
    "sanskrit": "प्रहस्य भगवानाह मा स्म भैर्वामलोचने विनङ्क्ष्यत्यधुनैवैतत्तावकैः शात्रवं बलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-006",
    "skandha": 10,
    "chapter": 54,
    "sloka": 6,
    "sanskrit": "तेषां तद्विक्रमं वीरा गदसङ्कर्षनादयः अमृष्यमाणा नाराचैर्जघ्नुर्हयगजान्रथान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-007",
    "skandha": 10,
    "chapter": 54,
    "sloka": 7,
    "sanskrit": "पेतुः शिरांसि रथिनामश्विनां गजिनां भुवि सकुण्डलकिरीटानि सोष्णीषाणि च कोटिशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-008",
    "skandha": 10,
    "chapter": 54,
    "sloka": 8,
    "sanskrit": "हस्ताः सासिगदेष्वासाः करभा ऊरवोऽङ्घ्रयः अश्वाश्वतरनागोष्ट्र खरमर्त्यशिरांसि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-009",
    "skandha": 10,
    "chapter": 54,
    "sloka": 9,
    "sanskrit": "हन्यमानबलानीका वृष्णिभिर्जयकाङ्क्षिभिः राजानो विमुखा जग्मुर्जरासन्धपुरःसराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-010",
    "skandha": 10,
    "chapter": 54,
    "sloka": 10,
    "sanskrit": "शिशुपालं समभ्येत्य हृतदारमिवातुरम् नष्टत्विषं गतोत्साहं शुष्यद्वदनमब्रुवन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-011",
    "skandha": 10,
    "chapter": 54,
    "sloka": 11,
    "sanskrit": "भो भोः पुरुषशार्दूल दौर्मनस्यमिदं त्यज न प्रियाप्रिययो राजन्निष्ठा देहिषु दृश्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-012",
    "skandha": 10,
    "chapter": 54,
    "sloka": 12,
    "sanskrit": "यथा दारुमयी योषित्नृत्यते कुहकेच्छया एवमीश्वरतन्त्रोऽयमीहते सुखदुःखयोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-013",
    "skandha": 10,
    "chapter": 54,
    "sloka": 13,
    "sanskrit": "शौरेः सप्तदशाहं वै संयुगानि पराजितः त्रयोविंशतिभिः सैन्यैर्जिग्ये एकमहं परम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-014",
    "skandha": 10,
    "chapter": 54,
    "sloka": 14,
    "sanskrit": "तथाप्यहं न शोचामि न प्रहृष्यामि कर्हिचित् कालेन दैवयुक्तेन जानन्विद्रावितं जगत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-015",
    "skandha": 10,
    "chapter": 54,
    "sloka": 15,
    "sanskrit": "अधुनापि वयं सर्वे वीरयूथपयूथपाः पराजिताः फल्गुतन्त्रैर्यदुभिः कृष्णपालितैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-016",
    "skandha": 10,
    "chapter": 54,
    "sloka": 16,
    "sanskrit": "रिपवो जिग्युरधुना काल आत्मानुसारिणि तदा वयं विजेष्यामो यदा कालः प्रदक्षिणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-017",
    "skandha": 10,
    "chapter": 54,
    "sloka": 17,
    "sanskrit": "एवं प्रबोधितो मित्रैश्चैद्योऽगात्सानुगः पुरम् हतशेषाः पुनस्तेऽपि ययुः स्वं स्वं पुरं नृपाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-54-sloka-018",
    "skandha": 10,
    "chapter": 54,
    "sloka": 18,
    "sanskrit": "रुक्मी तु राक्षसोद्वाहं कृष्णद्विडसहन्स्वसुः पृष्ठतोऽन्वगमत्कृष्णमक्षौहिण्या वृतो बली",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-019",
    "skandha": 10,
    "chapter": 54,
    "sloka": 19,
    "sanskrit": "रुक्म्यमर्षी सुसंरब्धः शृण्वतां सर्वभूभुजाम् प्रतिजज्ञे महाबाहुर्दंशितः सशरासनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-020",
    "skandha": 10,
    "chapter": 54,
    "sloka": 20,
    "sanskrit": "अहत्वा समरे कृष्णमप्रत्यूह्य च रुक्मिणीम् कुण्डिनं न प्रवेक्ष्यामि सत्यमेतद्ब्रवीमि वः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-021",
    "skandha": 10,
    "chapter": 54,
    "sloka": 21,
    "sanskrit": "इत्युक्त्वा रथमारुह्य सारथिं प्राह सत्त्वरः चोदयाश्वान्यतः कृष्णः तस्य मे संयुगं भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-022",
    "skandha": 10,
    "chapter": 54,
    "sloka": 22,
    "sanskrit": "अद्याहं निशितैर्बाणैर्गोपालस्य सुदुर्मतेः नेष्ये वीर्यमदं येन स्वसा मे प्रसभं हृता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-023",
    "skandha": 10,
    "chapter": 54,
    "sloka": 23,
    "sanskrit": "विकत्थमानः कुमतिरीश्वरस्याप्रमाणवित् रथेनैकेन गोविन्दं तिष्ठ तिष्ठेत्यथाह्वयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-024",
    "skandha": 10,
    "chapter": 54,
    "sloka": 24,
    "sanskrit": "धनुर्विकृष्य सुदृढं जघ्ने कृष्णं त्रिभिः शरैः आह चात्र क्षणं तिष्ठ यदूनां कुलपांसन",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-025",
    "skandha": 10,
    "chapter": 54,
    "sloka": 25,
    "sanskrit": "यत्र यासि स्वसारं मे मुषित्वा ध्वाङ्क्षवद्धविः हरिष्येऽद्य मदं मन्द मायिनः कूटयोधिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-026",
    "skandha": 10,
    "chapter": 54,
    "sloka": 26,
    "sanskrit": "यावन्न मे हतो बाणैः शयीथा मुञ्च दारीकाम् स्मयन्कृष्णो धनुश्छित्त्वा षड्भिर्विव्याध रुक्मिणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-027",
    "skandha": 10,
    "chapter": 54,
    "sloka": 27,
    "sanskrit": "अष्टभिश्चतुरो वाहान्द्वाभ्यां सूतं ध्वजं त्रिभिः स चान्यद्धनुराधाय कृष्णं विव्याध पञ्चभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-028",
    "skandha": 10,
    "chapter": 54,
    "sloka": 28,
    "sanskrit": "तैस्तादितः शरौघैस्तु चिच्छेद धनुरच्युतः पुनरन्यदुपादत्त तदप्यच्छिनदव्ययः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-029",
    "skandha": 10,
    "chapter": 54,
    "sloka": 29,
    "sanskrit": "परिघं पट्टिशं शूलं चर्मासी शक्तितोमरौ यद्यदायुधमादत्त तत्सर्वं सोऽच्छिनद्धरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-030",
    "skandha": 10,
    "chapter": 54,
    "sloka": 30,
    "sanskrit": "ततो रथादवप्लुत्य खड्गपाणिर्जिघांसया कृष्णमभ्यद्रवत्क्रुद्धः पतङ्ग इव पावकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-031",
    "skandha": 10,
    "chapter": 54,
    "sloka": 31,
    "sanskrit": "तस्य चापततः खड्गं तिलशश्चर्म चेषुभिः छित्त्वासिमाददे तिग्मं रुक्मिणं हन्तुमुद्यतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-032",
    "skandha": 10,
    "chapter": 54,
    "sloka": 32,
    "sanskrit": "दृष्ट्वा भ्रातृवधोद्योगं रुक्मिणी भयविह्वला पतित्वा पादयोर्भर्तुरुवाच करुणं सती",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-033",
    "skandha": 10,
    "chapter": 54,
    "sloka": 33,
    "sanskrit": "योगेश्वराप्रमेयात्मन्देवदेव जगत्पते हन्तुं नार्हसि कल्याण भ्रातरं मे महाभुज",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीरुक्मिण्युवाच ।"
  },
  {
    "id": "skandha-10-chapter-54-sloka-034",
    "skandha": 10,
    "chapter": 54,
    "sloka": 34,
    "sanskrit": "तया परित्रासविकम्पिताङ्गया शुचावशुष्यन्मुखरुद्धकण्ठया कातर्यविस्रंसितहेममालया गृहीतपादः करुणो न्यवर्तत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-54-sloka-035",
    "skandha": 10,
    "chapter": 54,
    "sloka": 35,
    "sanskrit": "चैलेन बद्ध्वा तमसाधुकारीणं सश्मश्रुकेशं प्रवपन्व्यरूपयत् तावन्ममर्दुः परसैन्यमद्भुतं यदुप्रवीरा नलिनीं यथा गजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-036",
    "skandha": 10,
    "chapter": 54,
    "sloka": 36,
    "sanskrit": "कृष्णान्तिकमुपव्रज्य ददृशुस्तत्र रुक्मिणम् तथाभूतं हतप्रायं दृष्ट्वा सङ्कर्षणो विभुः विमुच्य बद्धं करुणो भगवान्कृष्णमब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-037",
    "skandha": 10,
    "chapter": 54,
    "sloka": 37,
    "sanskrit": "असाध्विदं त्वया कृष्ण कृतमस्मज्जुगुप्सितम् वपनं श्मश्रुकेशानां वैरूप्यं सुहृदो वधः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-038",
    "skandha": 10,
    "chapter": 54,
    "sloka": 38,
    "sanskrit": "मैवास्मान्साध्व्यसूयेथा भ्रातुर्वैरूप्यचिन्तया सुखदुःखदो न चान्योऽस्ति यतः स्वकृतभुक्पुमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-039",
    "skandha": 10,
    "chapter": 54,
    "sloka": 39,
    "sanskrit": "बन्धुर्वधार्हदोषोऽपि न बन्धोर्वधमर्हति त्याज्यः स्वेनैव दोषेण हतः किं हन्यते पुनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-040",
    "skandha": 10,
    "chapter": 54,
    "sloka": 40,
    "sanskrit": "क्षत्रियाणामयं धर्मः प्रजापतिविनिर्मितः भ्रातापि भ्रातरं हन्याद्येन घोरतमस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-041",
    "skandha": 10,
    "chapter": 54,
    "sloka": 41,
    "sanskrit": "राज्यस्य भूमेर्वित्तस्य स्त्रियो मानस्य तेजसः मानिनोऽन्यस्य वा हेतोः श्रीमदान्धाः क्षिपन्ति हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-042",
    "skandha": 10,
    "chapter": 54,
    "sloka": 42,
    "sanskrit": "तवेयं विषमा बुद्धिः सर्वभूतेषु दुर्हृदाम् यन्मन्यसे सदाभद्रं सुहृदां भद्रमज्ञवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-043",
    "skandha": 10,
    "chapter": 54,
    "sloka": 43,
    "sanskrit": "आत्ममोहो नृणामेव कल्पते देवमायया सुहृद्दुर्हृदुदासीन इति देहात्ममानिनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-54-sloka-044",
    "skandha": 10,
    "chapter": 54,
    "sloka": 44,
