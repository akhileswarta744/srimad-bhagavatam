[
  {
    "id": "skandha-10-chapter-04-sloka-001",
    "skandha": 10,
    "chapter": 4,
    "sloka": 1,
    "sanskrit": "बहिरन्तःपुरद्वारः सर्वाः पूर्ववदावृताः ततो बालध्वनिं श्रुत्वा गृहपालाः समुत्थिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-04-sloka-002",
    "skandha": 10,
    "chapter": 4,
    "sloka": 2,
    "sanskrit": "ते तु तूर्णमुपव्रज्य देवक्या गर्भजन्म तत् आचख्युर्भोजराजाय यदुद्विग्नः प्रतीक्षते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-003",
    "skandha": 10,
    "chapter": 4,
    "sloka": 3,
    "sanskrit": "स तल्पात्तूर्णमुत्थाय कालोऽयमिति विह्वलः सूतीगृहमगात्तूर्णं प्रस्खलन्मुक्तमूर्धजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-004",
    "skandha": 10,
    "chapter": 4,
    "sloka": 4,
    "sanskrit": "तमाह भ्रातरं देवी कृपणा करुणं सती स्नुषेयं तव कल्याण स्त्रियं मा हन्तुमर्हसि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-005",
    "skandha": 10,
    "chapter": 4,
    "sloka": 5,
    "sanskrit": "बहवो हिंसिता भ्रातः शिशवः पावकोपमाः त्वया दैवनिसृष्टेन पुत्रिकैका प्रदीयताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-006",
    "skandha": 10,
    "chapter": 4,
    "sloka": 6,
    "sanskrit": "नन्वहं ते ह्यवरजा दीना हतसुता प्रभो दातुमर्हसि मन्दाया अङ्गेमां चरमां प्रजाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-007",
    "skandha": 10,
    "chapter": 4,
    "sloka": 7,
    "sanskrit": "उपगुह्यात्मजामेवं रुदत्या दीनदीनवत् याचितस्तां विनिर्भर्त्स्य हस्तादाचिच्छिदे खलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-04-sloka-008",
    "skandha": 10,
    "chapter": 4,
    "sloka": 8,
    "sanskrit": "तां गृहीत्वा चरणयोर्जातमात्रां स्वसुः सुताम् अपोथयच्छिलापृष्ठे स्वार्थोन्मूलितसौहृदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-009",
    "skandha": 10,
    "chapter": 4,
    "sloka": 9,
    "sanskrit": "सा तद्धस्तात्समुत्पत्य सद्यो देव्यम्बरं गता अदृश्यतानुजा विष्णोः सायुधाष्टमहाभुजा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-010",
    "skandha": 10,
    "chapter": 4,
    "sloka": 10,
    "sanskrit": "दिव्यस्रगम्बरालेप रत्नाभरणभूषिता धनुःशूलेषुचर्मासि शङ्खचक्रगदाधरा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-011",
    "skandha": 10,
    "chapter": 4,
    "sloka": 11,
    "sanskrit": "सिद्धचारणगन्धर्वैरप्सरःकिन्नरोरगैः उपाहृतोरुबलिभिः स्तूयमानेदमब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-012",
    "skandha": 10,
    "chapter": 4,
    "sloka": 12,
    "sanskrit": "किं मया हतया मन्द जातः खलु तवान्तकृत् यत्र क्व वा पूर्वशत्रुर्मा हिंसीः कृपणान्वृथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-013",
    "skandha": 10,
    "chapter": 4,
    "sloka": 13,
    "sanskrit": "इति प्रभाष्य तं देवी माया भगवती भुवि बहुनामनिकेतेषु बहुनामा बभूव ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-014",
    "skandha": 10,
    "chapter": 4,
    "sloka": 14,
    "sanskrit": "तयाभिहितमाकर्ण्य कंसः परमविस्मितः देवकीं वसुदेवं च विमुच्य प्रश्रितोऽब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-015",
    "skandha": 10,
    "chapter": 4,
    "sloka": 15,
    "sanskrit": "अहो भगिन्यहो भाम मया वां बत पाप्मना पुरुषाद इवापत्यं बहवो हिंसिताः सुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-016",
    "skandha": 10,
    "chapter": 4,
    "sloka": 16,
    "sanskrit": "स त्वहं त्यक्तकारुण्यस्त्यक्तज्ञातिसुहृत्खलः कान्लोकान्वै गमिष्यामि ब्रह्महेव मृतः श्वसन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-017",
    "skandha": 10,
    "chapter": 4,
    "sloka": 17,
    "sanskrit": "दैवमप्यनृतं वक्ति न मर्त्या एव केवलम् यद्विश्रम्भादहं पापः स्वसुर्निहतवाञ्छिशून्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-018",
    "skandha": 10,
    "chapter": 4,
    "sloka": 18,
    "sanskrit": "मा शोचतं महाभागावात्मजान्स्वकृतं भुजः जान्तवो न सदैकत्र दैवाधीनास्तदासते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-019",
    "skandha": 10,
    "chapter": 4,
    "sloka": 19,
    "sanskrit": "भुवि भौमानि भूतानि यथा यान्त्यपयान्ति च नायमात्मा तथैतेषु विपर्येति यथैव भूः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-020",
    "skandha": 10,
    "chapter": 4,
    "sloka": 20,
    "sanskrit": "यथानेवंविदो भेदो यत आत्मविपर्ययः देहयोगवियोगौ च संसृतिर्न निवर्तते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-021",
    "skandha": 10,
    "chapter": 4,
    "sloka": 21,
    "sanskrit": "तस्माद्भद्रे स्वतनयान्मया व्यापादितानपि मानुशोच यतः सर्वः स्वकृतं विन्दतेऽवशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-022",
    "skandha": 10,
    "chapter": 4,
    "sloka": 22,
    "sanskrit": "यावद्धतोऽस्मि हन्तास्मी त्यात्मानं मन्यतेऽस्वदृक् तावत्तदभिमान्यज्ञो बाध्यबाधकतामियात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-023",
    "skandha": 10,
    "chapter": 4,
    "sloka": 23,
    "sanskrit": "क्षमध्वं मम दौरात्म्यं साधवो दीनवत्सलाः इत्युक्त्वाश्रुमुखः पादौ श्यालः स्वस्रोरथाग्रहीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-024",
    "skandha": 10,
    "chapter": 4,
    "sloka": 24,
    "sanskrit": "मोचयामास निगडाद्विश्रब्धः कन्यकागिरा देवकीं वसुदेवं च दर्शयन्नात्मसौहृदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-025",
    "skandha": 10,
    "chapter": 4,
    "sloka": 25,
    "sanskrit": "भ्रातुः समनुतप्तस्य क्षान्तरोषा च देवकी व्यसृजद्वसुदेवश्च प्रहस्य तमुवाच ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-026",
    "skandha": 10,
    "chapter": 4,
    "sloka": 26,
    "sanskrit": "एवमेतन्महाभाग यथा वदसि देहिनाम् अज्ञानप्रभवाहंधीः स्वपरेति भिदा यतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-027",
    "skandha": 10,
    "chapter": 4,
    "sloka": 27,
    "sanskrit": "शोकहर्षभयद्वेष लोभमोहमदान्विताः मिथो घ्नन्तं न पश्यन्ति भावैर्भावं पृथग्दृशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-028",
    "skandha": 10,
    "chapter": 4,
    "sloka": 28,
    "sanskrit": "कंस एवं प्रसन्नाभ्यां विशुद्धं प्रतिभाषितः देवकीवसुदेवाभ्यामनुज्ञातोऽविशद्गृहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-04-sloka-029",
    "skandha": 10,
    "chapter": 4,
    "sloka": 29,
    "sanskrit": "तस्यां रात्र्यां व्यतीतायां कंस आहूय मन्त्रिणः तेभ्य आचष्ट तत्सर्वं यदुक्तं योगनिद्रया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-030",
    "skandha": 10,
    "chapter": 4,
    "sloka": 30,
    "sanskrit": "आकर्ण्य भर्तुर्गदितं तमूचुर्देवशत्रवः देवान्प्रति कृतामर्षा दैतेया नातिकोविदाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-031",
    "skandha": 10,
    "chapter": 4,
    "sloka": 31,
    "sanskrit": "एवं चेत्तर्हि भोजेन्द्र पुरग्रामव्रजादिषु अनिर्दशान्निर्दशांश्च हनिष्यामोऽद्य वै शिशून्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-032",
    "skandha": 10,
    "chapter": 4,
    "sloka": 32,
    "sanskrit": "किमुद्यमैः करिष्यन्ति देवाः समरभीरवः नित्यमुद्विग्नमनसो ज्याघोषैर्धनुषस्तव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-033",
    "skandha": 10,
    "chapter": 4,
    "sloka": 33,
    "sanskrit": "अस्यतस्ते शरव्रातैर्हन्यमानाः समन्ततः जिजीविषव उत्सृज्य पलायनपरा ययुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-034",
    "skandha": 10,
    "chapter": 4,
    "sloka": 34,
    "sanskrit": "केचित्प्राञ्जलयो दीना न्यस्तशस्त्रा दिवौकसः मुक्तकच्छशिखाः केचिद्भीताः स्म इति वादिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-035",
    "skandha": 10,
    "chapter": 4,
    "sloka": 35,
    "sanskrit": "न त्वं विस्मृतशस्त्रास्त्रान्विरथान्भयसंवृतान् हंस्यन्यासक्तविमुखान्भग्नचापानयुध्यतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-036",
    "skandha": 10,
    "chapter": 4,
    "sloka": 36,
    "sanskrit": "किं क्षेमशूरैर्विबुधैरसंयुगविकत्थनैः रहोजुषा किं हरिणा शम्भुना वा वनौकसा किमिन्द्रेणाल्पवीर्येण ब्रह्मणा वा तपस्यता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-037",
    "skandha": 10,
    "chapter": 4,
    "sloka": 37,
    "sanskrit": "तथापि देवाः सापत्न्यान्नोपेक्ष्या इति मन्महे ततस्तन्मूलखनने नियुङ्क्ष्वास्माननुव्रतान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-038",
    "skandha": 10,
    "chapter": 4,
    "sloka": 38,
    "sanskrit": "यथामयोऽङ्गे समुपेक्षितो नृभिर्न शक्यते रूढपदश्चिकित्सितुम् यथेन्द्रियग्राम उपेक्षितस्तथा रिपुर्महान्बद्धबलो न चाल्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-039",
    "skandha": 10,
    "chapter": 4,
    "sloka": 39,
    "sanskrit": "मूलं हि विष्णुर्देवानां यत्र धर्मः सनातनः तस्य च ब्रह्मगोविप्रास्तपो यज्ञाः सदक्षिणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-040",
    "skandha": 10,
    "chapter": 4,
    "sloka": 40,
    "sanskrit": "तस्मात्सर्वात्मना राजन्ब्राह्मणान्ब्रह्मवादिनः तपस्विनो यज्ञशीलान्गाश्च हन्मो हविर्दुघाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-041",
    "skandha": 10,
    "chapter": 4,
    "sloka": 41,
    "sanskrit": "विप्रा गावश्च वेदाश्च तपः सत्यं दमः शमः श्रद्धा दया तितिक्षा च क्रतवश्च हरेस्तनूः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-042",
    "skandha": 10,
    "chapter": 4,
    "sloka": 42,
    "sanskrit": "स हि सर्वसुराध्यक्षो ह्यसुरद्विड्गुहाशयः तन्मूला देवताः सर्वाः सेश्वराः सचतुर्मुखाः अयं वै तद्वधोपायो यदृषीणां विहिंसनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-043",
    "skandha": 10,
    "chapter": 4,
    "sloka": 43,
    "sanskrit": "एवं दुर्मन्त्रिभिः कंसः सह सम्मन्त्र्य दुर्मतिः ब्रह्महिंसां हितं मेने कालपाशावृतोऽसुरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-04-sloka-044",
    "skandha": 10,
    "chapter": 4,
    "sloka": 44,
    "sanskrit": "सन्दिश्य साधुलोकस्य कदने कदनप्रियान् कामरूपधरान्दिक्षु दानवान्गृहमाविशत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-04-sloka-045",
    "skandha": 10,
    "chapter": 4,
    "sloka": 45,
