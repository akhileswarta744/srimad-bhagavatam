[
  {
    "id": "skandha-10-chapter-20-sloka-001",
    "skandha": 10,
    "chapter": 20,
    "sloka": 1,
    "sanskrit": "तयोस्तदद्भुतं कर्म दावाग्नेर्मोक्षमात्मनः गोपाः स्त्रीभ्यः समाचख्युः प्रलम्बवधमेव च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-20-sloka-002",
    "skandha": 10,
    "chapter": 20,
    "sloka": 2,
    "sanskrit": "गोपवृद्धाश्च गोप्यश्च तदुपाकर्ण्य विस्मिताः मेनिरे देवप्रवरौ कृष्णरामौ व्रजं गतौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-003",
    "skandha": 10,
    "chapter": 20,
    "sloka": 3,
    "sanskrit": "ततः प्रावर्तत प्रावृट्सर्वसत्त्वसमुद्भवा विद्योतमानपरिधिर्विस्फूर्जितनभस्तला",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-004",
    "skandha": 10,
    "chapter": 20,
    "sloka": 4,
    "sanskrit": "सान्द्रनीलाम्बुदैर्व्योम सविद्युत्स्तनयित्नुभिः अस्पष्टज्योतिराच्छन्नं ब्रह्मेव सगुणं बभौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-005",
    "skandha": 10,
    "chapter": 20,
    "sloka": 5,
    "sanskrit": "अष्टौ मासान्निपीतं यद्भूम्याश्चोदमयं वसु स्वगोभिर्मोक्तुमारेभे पर्जन्यः काल आगते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-006",
    "skandha": 10,
    "chapter": 20,
    "sloka": 6,
    "sanskrit": "तडिद्वन्तो महामेघाश्चण्ड श्वसन वेपिताः प्रीणनं जीवनं ह्यस्य मुमुचुः करुणा इव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-007",
    "skandha": 10,
    "chapter": 20,
    "sloka": 7,
    "sanskrit": "तपःकृशा देवमीढा आसीद्वर्षीयसी मही यथैव काम्यतपसस्तनुः सम्प्राप्य तत्फलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-008",
    "skandha": 10,
    "chapter": 20,
    "sloka": 8,
    "sanskrit": "निशामुखेषु खद्योतास्तमसा भान्ति न ग्रहाः यथा पापेन पाषण्डा न हि वेदाः कलौ युगे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-009",
    "skandha": 10,
    "chapter": 20,
    "sloka": 9,
    "sanskrit": "श्रुत्वा पर्जन्यनिनदं मण्डुकाः ससृजुर्गिरः तूष्णीं शयानाः प्राग्यद्वद्ब्राह्मणा नियमात्यये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-010",
    "skandha": 10,
    "chapter": 20,
    "sloka": 10,
    "sanskrit": "आसन्नुत्पथगामिन्यः क्षुद्रनद्योऽनुशुष्यतीः पुंसो यथास्वतन्त्रस्य देहद्रविण सम्पदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-011",
    "skandha": 10,
    "chapter": 20,
    "sloka": 11,
    "sanskrit": "हरिता हरिभिः शष्पैरिन्द्रगोपैश्च लोहिता उच्छिलीन्ध्रकृतच्छाया नृणां श्रीरिव भूरभूत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-012",
    "skandha": 10,
    "chapter": 20,
    "sloka": 12,
    "sanskrit": "क्षेत्राणि शष्यसम्पद्भिः कर्षकाणां मुदं ददुः मानिनामनुतापं वै दैवाधीनमजानताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-013",
    "skandha": 10,
    "chapter": 20,
    "sloka": 13,
    "sanskrit": "जलस्थलौकसः सर्वे नववारिनिषेवया अबिभ्रन्रुचिरं रूपं यथा हरिनिषेवया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-014",
    "skandha": 10,
    "chapter": 20,
    "sloka": 14,
    "sanskrit": "सरिद्भिः सङ्गतः सिन्धुश्चुक्षोभ श्वसनोर्मिमान् अपक्वयोगिनश्चित्तं कामाक्तं गुणयुग्यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-015",
    "skandha": 10,
    "chapter": 20,
    "sloka": 15,
    "sanskrit": "गिरयो वर्षधाराभिर्हन्यमाना न विव्यथुः अभिभूयमाना व्यसनैर्यथाधोक्षजचेतसः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-016",
    "skandha": 10,
    "chapter": 20,
    "sloka": 16,
    "sanskrit": "मार्गा बभूवुः सन्दिग्धास्तृणैश्छन्ना ह्यसंस्कृताः नाभ्यस्यमानाः श्रुतयो द्विजैः कालेन चाहताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-017",
    "skandha": 10,
    "chapter": 20,
    "sloka": 17,
    "sanskrit": "लोकबन्धुषु मेघेषु विद्युतश्चलसौहृदाः स्थैर्यं न चक्रुः कामिन्यः पुरुषेषु गुणिष्विव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-018",
    "skandha": 10,
    "chapter": 20,
    "sloka": 18,
    "sanskrit": "धनुर्वियति माहेन्द्रं निर्गुणं च गुणिन्यभात् व्यक्ते गुणव्यतिकरेऽगुणवान्पुरुषो यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-019",
    "skandha": 10,
    "chapter": 20,
    "sloka": 19,
    "sanskrit": "न रराजोडुपश्छन्नः स्वज्योत्स्नाराजितैर्घनैः अहंमत्या भासितया स्वभासा पुरुषो यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-020",
    "skandha": 10,
    "chapter": 20,
    "sloka": 20,
    "sanskrit": "मेघागमोत्सवा हृष्टाः प्रत्यनन्दञ्छिखण्डिनः गृहेषु तप्तनिर्विण्णा यथाच्युतजनागमे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-021",
    "skandha": 10,
    "chapter": 20,
    "sloka": 21,
    "sanskrit": "पीत्वापः पादपाः पद्भिरासन्नानात्ममूर्तयः प्राक्क्षामास्तपसा श्रान्ता यथा कामानुसेवया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-022",
    "skandha": 10,
    "chapter": 20,
    "sloka": 22,
    "sanskrit": "सरःस्वशान्तरोधःसु न्यूषुरङ्गापि सारसाः गृहेष्वशान्तकृत्येषु ग्राम्या इव दुराशयाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-023",
    "skandha": 10,
    "chapter": 20,
    "sloka": 23,
    "sanskrit": "जलौघैर्निरभिद्यन्त सेतवो वर्षतीश्वरे पाषण्डिनामसद्वादैर्वेदमार्गाः कलौ यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-024",
    "skandha": 10,
    "chapter": 20,
    "sloka": 24,
    "sanskrit": "व्यमुञ्चन्वायुभिर्नुन्ना भूतेभ्यश्चामृतं घनाः यथाशिषो विश्पतयः काले काले द्विजेरिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-025",
    "skandha": 10,
    "chapter": 20,
    "sloka": 25,
    "sanskrit": "एवं वनं तद्वर्षिष्ठं पक्वखर्जुरजम्बुमत् गोगोपालैर्वृतो रन्तुं सबलः प्राविशद्धरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-026",
    "skandha": 10,
    "chapter": 20,
    "sloka": 26,
    "sanskrit": "धेनवो मन्दगामिन्य ऊधोभारेण भूयसा ययुर्भगवताहूता द्रुतं प्रीत्या स्नुतस्तनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-027",
    "skandha": 10,
    "chapter": 20,
    "sloka": 27,
    "sanskrit": "वनौकसः प्रमुदिता वनराजीर्मधुच्युतः जलधारा गिरेर्नादादासन्ना ददृशे गुहाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-028",
    "skandha": 10,
    "chapter": 20,
    "sloka": 28,
    "sanskrit": "क्वचिद्वनस्पतिक्रोडे गुहायां चाभिवर्षति निर्विश्य भगवान्रेमे कन्दमूलफलाशनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-029",
    "skandha": 10,
    "chapter": 20,
    "sloka": 29,
    "sanskrit": "दध्योदनं समानीतं शिलायां सलिलान्तिके सम्भोजनीयैर्बुभुजे गोपैः सङ्कर्षणान्वितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-030",
    "skandha": 10,
    "chapter": 20,
    "sloka": 30,
    "sanskrit": "शाद्वलोपरि संविश्य चर्वतो मीलितेक्षणान् तृप्तान्वृषान्वत्सतरान्गाश्च स्वोधोभरश्रमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-031",
    "skandha": 10,
    "chapter": 20,
    "sloka": 31,
    "sanskrit": "प्रावृट्श्रियं च तां वीक्ष्य सर्वकालसुखावहाम् भगवान्पूजयां चक्रे आत्मशक्त्युपबृंहिताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-032",
    "skandha": 10,
    "chapter": 20,
    "sloka": 32,
    "sanskrit": "एवं निवसतोस्तस्मिन्रामकेशवयोर्व्रजे शरत्समभवद्व्यभ्रा स्वच्छाम्ब्वपरुषानिला",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-033",
    "skandha": 10,
    "chapter": 20,
    "sloka": 33,
    "sanskrit": "शरदा नीरजोत्पत्त्या नीराणि प्रकृतिं ययुः भ्रष्टानामिव चेतांसि पुनर्योगनिषेवया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-034",
    "skandha": 10,
    "chapter": 20,
    "sloka": 34,
    "sanskrit": "व्योम्नोऽब्भ्रं भूतशाबल्यं भुवः पङ्कमपां मलम् शरज्जहाराश्रमिणां कृष्णे भक्तिर्यथाशुभम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-035",
    "skandha": 10,
    "chapter": 20,
    "sloka": 35,
    "sanskrit": "सर्वस्वं जलदा हित्वा विरेजुः शुभ्रवर्चसः यथा त्यक्तैषणाः शान्ता मुनयो मुक्तकिल्बिषाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-036",
    "skandha": 10,
    "chapter": 20,
    "sloka": 36,
    "sanskrit": "गिरयो मुमुचुस्तोयं क्वचिन्न मुमुचुः शिवम् यथा ज्ञानामृतं काले ज्ञानिनो ददते न वा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-037",
    "skandha": 10,
    "chapter": 20,
    "sloka": 37,
    "sanskrit": "नैवाविदन्क्षीयमाणं जलं गाधजलेचराः यथायुरन्वहं क्षय्यं नरा मूढाः कुटुम्बिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-038",
    "skandha": 10,
    "chapter": 20,
    "sloka": 38,
    "sanskrit": "गाधवारिचरास्तापमविन्दञ्छरदर्कजम् यथा दरिद्रः कृपणः कुटुम्ब्यविजितेन्द्रियः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-039",
    "skandha": 10,
    "chapter": 20,
    "sloka": 39,
    "sanskrit": "शनैः शनैर्जहुः पङ्कं स्थलान्यामं च वीरुधः यथाहंममतां धीराः शरीरादिष्वनात्मसु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-040",
    "skandha": 10,
    "chapter": 20,
    "sloka": 40,
    "sanskrit": "निश्चलाम्बुरभूत्तूष्णीं समुद्रः शरदागमे आत्मन्युपरते सम्यङ्मुनिर्व्युपरतागमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-041",
    "skandha": 10,
    "chapter": 20,
    "sloka": 41,
    "sanskrit": "केदारेभ्यस्त्वपोऽगृह्णन्कर्षका दृढसेतुभिः यथा प्राणैः स्रवज्ज्ञानं तन्निरोधेन योगिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-042",
    "skandha": 10,
    "chapter": 20,
    "sloka": 42,
    "sanskrit": "शरदर्कांशुजांस्तापान्भूतानामुडुपोऽहरत् देहाभिमानजं बोधो मुकुन्दो व्रजयोषिताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-043",
    "skandha": 10,
    "chapter": 20,
    "sloka": 43,
    "sanskrit": "खमशोभत निर्मेघं शरद्विमलतारकम् सत्त्वयुक्तं यथा चित्तं शब्दब्रह्मार्थदर्शनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-044",
    "skandha": 10,
    "chapter": 20,
    "sloka": 44,
    "sanskrit": "अखण्डमण्डलो व्योम्नि रराजोडुगणैः शशी यथा यदुपतिः कृष्णो वृष्णिचक्रावृतो भुवि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-20-sloka-045",
    "skandha": 10,
