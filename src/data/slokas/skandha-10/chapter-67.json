[
  {
    "id": "skandha-10-chapter-67-sloka-001",
    "skandha": 10,
    "chapter": 67,
    "sloka": 1,
    "sanskrit": "भुयोऽहं श्रोतुमिच्छामि रामस्याद्भुतकर्मणः अनन्तस्याप्रमेयस्य यदन्यत्कृतवान्प्रभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीराजोवाच ।"
  },
  {
    "id": "skandha-10-chapter-67-sloka-002",
    "skandha": 10,
    "chapter": 67,
    "sloka": 2,
    "sanskrit": "नरकस्य सखा कश्चिद्द्विविदो नाम वानरः सुग्रीवसचिवः सोऽथ भ्राता मैन्दस्य वीर्यवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-67-sloka-003",
    "skandha": 10,
    "chapter": 67,
    "sloka": 3,
    "sanskrit": "सख्युः सोऽपचितिं कुर्वन्वानरो राष्ट्रविप्लवम् पुरग्रामाकरान्घोषानदहद्वह्निमुत्सृजन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-004",
    "skandha": 10,
    "chapter": 67,
    "sloka": 4,
    "sanskrit": "क्वचित्स शैलानुत्पाट्य तैर्देशान्समचूर्णयत् आनर्तान्सुतरामेव यत्रास्ते मित्रहा हरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-005",
    "skandha": 10,
    "chapter": 67,
    "sloka": 5,
    "sanskrit": "क्वचित्समुद्रमध्यस्थो दोर्भ्यामुत्क्षिप्य तज्जलम् देशान्नागायुतप्राणो वेलाकूले न्यमज्जयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-006",
    "skandha": 10,
    "chapter": 67,
    "sloka": 6,
    "sanskrit": "आश्रमानृषिमुख्यानां कृत्वा भग्नवनस्पतीन् अदूषयच्छकृन्मूत्रैरग्नीन्वैतानिकान्खलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-007",
    "skandha": 10,
    "chapter": 67,
    "sloka": 7,
    "sanskrit": "पुरुषान्योषितो दृप्तः क्ष्माभृद्द्रोनीगुहासु सः निक्षिप्य चाप्यधाच्छैलैः पेशष्कारीव कीटकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-008",
    "skandha": 10,
    "chapter": 67,
    "sloka": 8,
    "sanskrit": "एवं देशान्विप्रकुर्वन्दूषयंश्च कुलस्त्रियः श्रुत्वा सुललितं गीतं गिरिं रैवतकं ययौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-009",
    "skandha": 10,
    "chapter": 67,
    "sloka": 9,
    "sanskrit": "तत्रापश्यद्यदुपतिं रामं पुष्करमालिनम् सुदर्शनीयसर्वाङ्गं ललनायूथमध्यगम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-010",
    "skandha": 10,
    "chapter": 67,
    "sloka": 10,
    "sanskrit": "गायन्तं वारुणीं पीत्वा मदविह्वललोचनम् विभ्राजमानं वपुषा प्रभिन्नमिव वारणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-011",
    "skandha": 10,
    "chapter": 67,
    "sloka": 11,
    "sanskrit": "दुष्टः शाखामृगः शाखामारूढः कम्पयन्द्रुमान् चक्रे किलकिलाशब्दमात्मानं सम्प्रदर्शयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-012",
    "skandha": 10,
    "chapter": 67,
    "sloka": 12,
    "sanskrit": "तस्य धार्ष्ट्यं कपेर्वीक्ष्य तरुण्यो जातिचापलाः हास्यप्रिया विजहसुर्बलदेवपरिग्रहाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-013",
    "skandha": 10,
    "chapter": 67,
    "sloka": 13,
    "sanskrit": "ता हेलयामास कपिर्भ्रूक्षेपैर्सम्मुखादिभिः दर्शयन्स्वगुदं तासां रामस्य च निरीक्षितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-014",
    "skandha": 10,
    "chapter": 67,
    "sloka": 14,
    "sanskrit": "तं ग्राव्णा प्राहरत्क्रुद्धो बलः प्रहरतां वरः स वञ्चयित्वा ग्रावाणं मदिराकलशं कपिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-015",
    "skandha": 10,
    "chapter": 67,
    "sloka": 15,
    "sanskrit": "गृहीत्वा हेलयामास धूर्तस्तं कोपयन्हसन् निर्भिद्य कलशं दुष्टो वासांस्यास्फालयद्बलम् कदर्थीकृत्य बलवान्विप्रचक्रे मदोद्धतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-016",
    "skandha": 10,
    "chapter": 67,
    "sloka": 16,
    "sanskrit": "तं तस्याविनयं दृष्ट्वा देशांश्च तदुपद्रुतान् क्रुद्धो मुषलमादत्त हलं चारिजिघांसया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-017",
    "skandha": 10,
    "chapter": 67,
    "sloka": 17,
    "sanskrit": "द्विविदोऽपि महावीर्यः शालमुद्यम्य पाणिना अभ्येत्य तरसा तेन बलं मूर्धन्यताडयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-018",
    "skandha": 10,
    "chapter": 67,
    "sloka": 18,
    "sanskrit": "तं तु सङ्कर्षणो मूर्ध्नि पतन्तमचलो यथा प्रतिजग्राह बलवान्सुनन्देनाहनच्च तम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-019",
    "skandha": 10,
    "chapter": 67,
    "sloka": 19,
    "sanskrit": "मूषलाहतमस्तिष्को विरेजे रक्तधारया गिरिर्यथा गैरिकया प्रहारं नानुचिन्तयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-020",
    "skandha": 10,
    "chapter": 67,
    "sloka": 20,
    "sanskrit": "पुनरन्यं समुत्क्षिप्य कृत्वा निष्पत्रमोजसा तेनाहनत्सुसङ्क्रुद्धस्तं बलः शतधाच्छिनत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-021",
    "skandha": 10,
    "chapter": 67,
    "sloka": 21,
    "sanskrit": "ततोऽन्येन रुषा जघ्ने तं चापि शतधाच्छिनत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-022",
    "skandha": 10,
    "chapter": 67,
    "sloka": 22,
    "sanskrit": "एवं युध्यन्भगवता भग्ने भग्ने पुनः पुनः आकृष्य सर्वतो वृक्षान्निर्वृक्षमकरोद्वनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-023",
    "skandha": 10,
    "chapter": 67,
    "sloka": 23,
    "sanskrit": "ततोऽमुञ्चच्छिलावर्षं बलस्योपर्यमर्षितः तत्सर्वं चूर्णयां आस लीलया मुषलायुधः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-024",
    "skandha": 10,
    "chapter": 67,
    "sloka": 24,
    "sanskrit": "स बाहू तालसङ्काशौ मुष्टीकृत्य कपीश्वरः आसाद्य रोहिणीपुत्रं ताभ्यां वक्षस्यरूरुजत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-025",
    "skandha": 10,
    "chapter": 67,
    "sloka": 25,
    "sanskrit": "यादवेन्द्रोऽपि तं दोर्भ्यां त्यक्त्वा मुषललाङ्गले जत्रावभ्यर्दयत्क्रुद्धः सोऽपतद्रुधिरं वमन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-026",
    "skandha": 10,
    "chapter": 67,
    "sloka": 26,
    "sanskrit": "चकम्पे तेन पतता सटङ्कः सवनस्पतिः पर्वतः कुरुशार्दूल वायुना नौरिवाम्भसि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-027",
    "skandha": 10,
    "chapter": 67,
    "sloka": 27,
    "sanskrit": "जयशब्दो नमःशब्दः साधु साध्विति चाम्बरे सुरसिद्धमुनीन्द्राणामासीत्कुसुमवर्षिणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-67-sloka-028",
    "skandha": 10,
    "chapter": 67,
    "sloka": 28,
    "sanskrit": "एवं निहत्य द्विविदं जगद्व्यतिकरावहम् संस्तूयमानो भगवान्जनैः स्वपुरमाविशत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]