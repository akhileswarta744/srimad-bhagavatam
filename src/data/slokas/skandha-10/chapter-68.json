[
  {
    "id": "skandha-10-chapter-68-sloka-001",
    "skandha": 10,
    "chapter": 68,
    "sloka": 1,
    "sanskrit": "दुर्योधनसुतां राजन्लक्ष्मणां समितिंजयः स्वयंवरस्थामहरत्साम्बो जाम्बवतीसुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-68-sloka-002",
    "skandha": 10,
    "chapter": 68,
    "sloka": 2,
    "sanskrit": "कौरवाः कुपिता ऊचुर्दुर्विनीतोऽयमर्भकः कदर्थीकृत्य नः कन्यामकामामहरद्बलात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-003",
    "skandha": 10,
    "chapter": 68,
    "sloka": 3,
    "sanskrit": "बध्नीतेमं दुर्विनीतं किं करिष्यन्ति वृष्णयः येऽस्मत्प्रसादोपचितां दत्तां नो भुञ्जते महीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-004",
    "skandha": 10,
    "chapter": 68,
    "sloka": 4,
    "sanskrit": "निगृहीतं सुतं श्रुत्वा यद्येष्यन्तीह वृष्णयः भग्नदर्पाः शमं यान्ति प्राणा इव सुसंयताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-005",
    "skandha": 10,
    "chapter": 68,
    "sloka": 5,
    "sanskrit": "इति कर्णः शलो भूरिर्यज्ञकेतुः सुयोधनः साम्बमारेभिरे योद्धुं कुरुवृद्धानुमोदिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-006",
    "skandha": 10,
    "chapter": 68,
    "sloka": 6,
    "sanskrit": "दृष्ट्वानुधावतः साम्बो धार्तराष्ट्रान्महारथः प्रगृह्य रुचिरं चापं तस्थौ सिंह इवैकलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-007",
    "skandha": 10,
    "chapter": 68,
    "sloka": 7,
    "sanskrit": "तं ते जिघृक्षवः क्रुद्धास्तिष्ठ तिष्ठेति भाषिणः आसाद्य धन्विनो बाणैः कर्णाग्रण्यः समाकिरन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-008",
    "skandha": 10,
    "chapter": 68,
    "sloka": 8,
    "sanskrit": "सोऽपविद्धः कुरुश्रेष्ठ कुरुभिर्यदुनन्दनः नामृष्यत्तदचिन्त्यार्भः सिंह क्षुद्रमृगैरिव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-009",
    "skandha": 10,
    "chapter": 68,
    "sloka": 9,
    "sanskrit": "विस्फूर्ज्य रुचिरं चापं सर्वान्विव्याध सायकैः कर्णादीन्षड्रथान्वीरस्तावद्भिर्युगपत्पृथक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-010",
    "skandha": 10,
    "chapter": 68,
    "sloka": 10,
    "sanskrit": "चतुर्भिश्चतुरो वाहानेकैकेन च सारथीन् रथिनश्च महेष्वासांस्तस्य तत्तेऽभ्यपूजयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-011",
    "skandha": 10,
    "chapter": 68,
    "sloka": 11,
    "sanskrit": "तं तु ते विरथं चक्रुश्चत्वारश्चतुरो हयान् एकस्तु सारथिं जघ्ने चिच्छेदण्यः शरासनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-012",
    "skandha": 10,
    "chapter": 68,
    "sloka": 12,
    "sanskrit": "तं बद्ध्वा विरथीकृत्य कृच्छ्रेण कुरवो युधि कुमारं स्वस्य कन्यां च स्वपुरं जयिनोऽविशन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-013",
    "skandha": 10,
    "chapter": 68,
    "sloka": 13,
    "sanskrit": "तच्छ्रुत्वा नारदोक्तेन राजन्सञ्जातमन्यवः कुरून्प्रत्युद्यमं चक्रुरुग्रसेनप्रचोदिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-014",
    "skandha": 10,
    "chapter": 68,
    "sloka": 14,
    "sanskrit": "सान्त्वयित्वा तु तान्रामः सन्नद्धान्वृष्णिपुङ्गवान् नैच्छत्कुरूणां वृष्णीनां कलिं कलिमलापहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-015",
    "skandha": 10,
    "chapter": 68,
    "sloka": 15,
    "sanskrit": "जगाम हास्तिनपुरं रथेनादित्यवर्चसा ब्राह्मणैः कुलवृद्धैश्च वृतश्चन्द्र इव ग्रहैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-016",
    "skandha": 10,
    "chapter": 68,
    "sloka": 16,
    "sanskrit": "गत्वा गजाह्वयं रामो बाह्योपवनमास्थितः उद्धवं प्रेषयामास धृतराष्ट्रं बुभुत्सया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-017",
    "skandha": 10,
    "chapter": 68,
    "sloka": 17,
    "sanskrit": "सोऽभिवन्द्याम्बिकापुत्रं भीष्मं द्रोणं च बाह्लिकम् दुर्योधनं च विधिवद्राममागतं अब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-018",
    "skandha": 10,
    "chapter": 68,
    "sloka": 18,
    "sanskrit": "तेऽतिप्रीतास्तमाकर्ण्य प्राप्तं रामं सुहृत्तमम् तमर्चयित्वाभिययुः सर्वे मङ्गलपाणयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-019",
    "skandha": 10,
    "chapter": 68,
    "sloka": 19,
    "sanskrit": "तं सङ्गम्य यथान्यायं गामर्घ्यं च न्यवेदयन् तेषां ये तत्प्रभावज्ञाः प्रणेमुः शिरसा बलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-020",
    "skandha": 10,
    "chapter": 68,
    "sloka": 20,
    "sanskrit": "बन्धून्कुशलिनः श्रुत्वा पृष्ट्वा शिवमनामयम् परस्परमथो रामो बभाषेऽविक्लवं वचः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-021",
    "skandha": 10,
    "chapter": 68,
    "sloka": 21,
    "sanskrit": "उग्रसेनः क्षितेशेशो यद्व आज्ञापयत्प्रभुः तदव्यग्रधियः श्रुत्वा कुरुध्वमविलम्बितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-022",
    "skandha": 10,
    "chapter": 68,
    "sloka": 22,
    "sanskrit": "यद्यूयं बहवस्त्वेकं जित्वाधर्मेण धार्मिकम् अबध्नीताथ तन्मृष्ये बन्धूनामैक्यकाम्यया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-023",
    "skandha": 10,
    "chapter": 68,
    "sloka": 23,
    "sanskrit": "वीर्यशौर्यबलोन्नद्धमात्मशक्तिसमं वचः कुरवो बलदेवस्य निशम्योचुः प्रकोपिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-024",
    "skandha": 10,
    "chapter": 68,
    "sloka": 24,
    "sanskrit": "अहो महच्चित्रमिदं कालगत्या दुरत्यया आरुरुक्षत्युपानद्वै शिरो मुकुटसेवितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-025",
    "skandha": 10,
    "chapter": 68,
    "sloka": 25,
    "sanskrit": "एते यौनेन सम्बद्धाः सहशय्यासनाशनाः वृष्णयस्तुल्यतां नीता अस्मद्दत्तनृपासनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-026",
    "skandha": 10,
    "chapter": 68,
    "sloka": 26,
    "sanskrit": "चामरव्यजने शङ्खमातपत्रं च पाण्डुरम् किरीटमासनं शय्यां भुञ्जतेऽस्मदुपेक्षया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-027",
    "skandha": 10,
    "chapter": 68,
    "sloka": 27,
    "sanskrit": "अलं यदूनां नरदेवलाञ्छनैर्दातुः प्रतीपैः फणिनामिवामृतम् येऽस्मत्प्रसादोपचिता हि यादवा आज्ञापयन्त्यद्य गतत्रपा बत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-028",
    "skandha": 10,
    "chapter": 68,
    "sloka": 28,
    "sanskrit": "कथमिन्द्रोऽपि कुरुभिर्भीष्मद्रोणार्जुनादिभिः अदत्तमवरुन्धीत सिंहग्रस्तमिवोरणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-029",
    "skandha": 10,
    "chapter": 68,
    "sloka": 29,
    "sanskrit": "जन्मबन्धुश्रीयोन्नद्ध मदास्ते भरतर्षभ आश्राव्य रामं दुर्वाच्यमसभ्याः पुरमाविशन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीबादरायणिरुवाच ।"
  },
  {
    "id": "skandha-10-chapter-68-sloka-030",
    "skandha": 10,
    "chapter": 68,
    "sloka": 30,
    "sanskrit": "दृष्ट्वा कुरूनां दौःशील्यं श्रुत्वावाच्यानि चाच्युतः अवोचत्कोपसंरब्धो दुष्प्रेक्ष्यः प्रहसन्मुहुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-031",
    "skandha": 10,
    "chapter": 68,
    "sloka": 31,
    "sanskrit": "नूनं नानामदोन्नद्धाः शान्तिं नेच्छन्त्यसाधवः तेषां हि प्रशमो दण्डः पशूनां लगुडो यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-032",
    "skandha": 10,
    "chapter": 68,
    "sloka": 32,
    "sanskrit": "अहो यदून्सुसंरब्धान्कृष्णं च कुपितं शनैः सान्त्वयित्वाहमेतेषां शममिच्छन्निहागतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-033",
    "skandha": 10,
    "chapter": 68,
    "sloka": 33,
    "sanskrit": "त इमे मन्दमतयः कलहाभिरताः खलाः तं मामवज्ञाय मुहुर्दुर्भाषान्मानिनोऽब्रुवन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-034",
    "skandha": 10,
    "chapter": 68,
    "sloka": 34,
    "sanskrit": "नोग्रसेनः किल विभुर्भोजवृष्ण्यन्धकेश्वरः शक्रादयो लोकपाला यस्यादेशानुवर्तिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-035",
    "skandha": 10,
    "chapter": 68,
    "sloka": 35,
    "sanskrit": "सुधर्माक्रम्यते येन पारिजातोऽमराङ्घ्रिपः आनीय भुज्यते सोऽसौ न किलाध्यासनार्हणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-036",
    "skandha": 10,
    "chapter": 68,
    "sloka": 36,
    "sanskrit": "यस्य पादयुगं साक्षाच्छ्रीरुपास्तेऽखिलेश्वरी स नार्हति किल श्रीशो नरदेवपरिच्छदान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-037",
    "skandha": 10,
    "chapter": 68,
    "sloka": 37,
    "sanskrit": "यस्याङ्घ्रिपङ्कजरजोऽखिललोकपालैर् मौल्युत्तमैर्धृतमुपासिततीर्थतीर्थम् ब्रह्मा भवोऽहमपि यस्य कलाः कलायाः श्रीश्चोद्वहेम चिरमस्य नृपासनं क्व",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-038",
    "skandha": 10,
    "chapter": 68,
    "sloka": 38,
    "sanskrit": "भुञ्जते कुरुभिर्दत्तं भूखण्डं वृष्णयः किल उपानहः किल वयं स्वयं तु कुरवः शिरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-039",
    "skandha": 10,
    "chapter": 68,
    "sloka": 39,
    "sanskrit": "अहो ऐश्वर्यमत्तानां मत्तानामिव मानिनाम् असम्बद्धा गिऋओ रुक्षाः कः सहेतानुशासीता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-040",
    "skandha": 10,
    "chapter": 68,
    "sloka": 40,
    "sanskrit": "अद्य निष्कौरवं पृथ्वीं करिष्यामीत्यमर्षितः गृहीत्वा हलमुत्तस्थौ दहन्निव जगत्त्रयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-041",
    "skandha": 10,
    "chapter": 68,
    "sloka": 41,
    "sanskrit": "लाङ्गलाग्रेण नगरमुद्विदार्य गजाह्वयम् विचकर्ष स गङ्गायां प्रहरिष्यन्नमर्षितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-042",
    "skandha": 10,
    "chapter": 68,
    "sloka": 42,
    "sanskrit": "जलयानमिवाघूर्णं गङ्गायां नगरं पतत् आकृष्यमाणमालोक्य कौरवाः जातसम्भ्रमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-043",
    "skandha": 10,
    "chapter": 68,
    "sloka": 43,
    "sanskrit": "तमेव शरणं जग्मुः सकुटुम्बा जिजीविषवः सलक्ष्मणं पुरस्कृत्य साम्बं प्राञ्जलयः प्रभुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-68-sloka-044",
    "skandha": 10,
    "chapter": 68,
    "sloka": 44,
