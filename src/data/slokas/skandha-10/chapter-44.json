[
  {
    "id": "skandha-10-chapter-44-sloka-001",
    "skandha": 10,
    "chapter": 44,
    "sloka": 1,
    "sanskrit": "एवं चर्चितसङ्कल्पो भगवान्मधुसूदनः आससादाथ चणूरं मुष्ट्तिकं रोहिणीसुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-10-chapter-44-sloka-002",
    "skandha": 10,
    "chapter": 44,
    "sloka": 2,
    "sanskrit": "हस्ताभ्यां हस्तयोर्बद्ध्वा पद्भ्यामेव च पादयोः विचकर्षतुरन्योन्यं प्रसह्य विजिगीषया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-003",
    "skandha": 10,
    "chapter": 44,
    "sloka": 3,
    "sanskrit": "अरत्नी द्वे अरत्निभ्यां जानुभ्यां चैव जानुनी शिरः शीर्ष्णोरसोरस्तावन्योन्यमभिजघ्नतुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-004",
    "skandha": 10,
    "chapter": 44,
    "sloka": 4,
    "sanskrit": "परिभ्रामणविक्षेप परिरम्भावपातनैः उत्सर्पणापसर्पणैश्चान्योन्यं प्रत्यरुन्धताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-005",
    "skandha": 10,
    "chapter": 44,
    "sloka": 5,
    "sanskrit": "उत्थापनैरुन्नयनैश्चालनैः स्थापनैरपि परस्परं जिगीषन्तावपचक्रतुरात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-006",
    "skandha": 10,
    "chapter": 44,
    "sloka": 6,
    "sanskrit": "तद्बलाबलवद्युद्धं समेताः सर्वयोषितः ऊचुः परस्परं राजन्सानुकम्पा वरूथशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-007",
    "skandha": 10,
    "chapter": 44,
    "sloka": 7,
    "sanskrit": "महानयं बताधर्म एषां राजसभासदाम् ये बलाबलवद्युद्धं राज्ञोऽन्विच्छन्ति पश्यतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-008",
    "skandha": 10,
    "chapter": 44,
    "sloka": 8,
    "sanskrit": "क्व वज्रसारसर्वाङ्गौ मल्लौ शैलेन्द्रसन्निभौ क्व चातिसुकुमाराङ्गौ किशोरौ नाप्तयौवनौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-009",
    "skandha": 10,
    "chapter": 44,
    "sloka": 9,
    "sanskrit": "धर्मव्यतिक्रमो ह्यस्य समाजस्य ध्रुवं भवेत् यत्राधर्मः समुत्तिष्ठेन्न स्थेयं तत्र कर्हिचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-010",
    "skandha": 10,
    "chapter": 44,
    "sloka": 10,
    "sanskrit": "न सभां प्रविशेत्प्राज्ञः सभ्यदोषाननुस्मरन् अब्रुवन्विब्रुवन्नज्ञो नरः किल्बिषमश्नुते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-011",
    "skandha": 10,
    "chapter": 44,
    "sloka": 11,
    "sanskrit": "वल्गतः शत्रुमभितः कृष्णस्य वदनाम्बुजम् वीक्ष्यतां श्रमवार्युप्तं पद्मकोशमिवाम्बुभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-012",
    "skandha": 10,
    "chapter": 44,
    "sloka": 12,
    "sanskrit": "किं न पश्यत रामस्य मुखमाताम्रलोचनम् मुष्टिकं प्रति सामर्षं हाससंरम्भशोभितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-013",
    "skandha": 10,
    "chapter": 44,
    "sloka": 13,
    "sanskrit": "पुण्या बत व्रजभुवो यदयं नृलिङ्ग गूढः पुराणपुरुषो वनचित्रमाल्यः गाः पालयन्सहबलः क्वणयंश्च वेणुं विक्रीदयाञ्चति गिरित्ररमार्चिताङ्घ्रिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-014",
    "skandha": 10,
    "chapter": 44,
    "sloka": 14,
    "sanskrit": "गोप्यस्तपः किमचरन्यदमुष्य रूपं लावण्यसारमसमोर्ध्वमनन्यसिद्धम् दृग्भिः पिबन्त्यनुसवाभिनवं दुरापम् एकान्तधाम यशसः श्रीय ऐश्वरस्य",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-015",
    "skandha": 10,
    "chapter": 44,
    "sloka": 15,
    "sanskrit": "या दोहनेऽवहनने मथनोपलेप प्रेङ्खेङ्खनार्भरुदितोक्षणमार्जनादौ गायन्ति चैनमनुरक्तधियोऽश्रुकण्ठ्यो धन्या व्रजस्त्रिय उरुक्रमचित्तयानाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-016",
    "skandha": 10,
    "chapter": 44,
    "sloka": 16,
    "sanskrit": "प्रातर्व्रजाद्व्रजत आविशतश्च सायं गोभिः समं क्वणयतोऽस्य निशम्य वेणुम् निर्गम्य तूर्णमबलाः पथि भूरिपुण्याः पश्यन्ति सस्मितमुखं सदयावलोकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-017",
    "skandha": 10,
    "chapter": 44,
    "sloka": 17,
    "sanskrit": "एवं प्रभाषमाणासु स्त्रीषु योगेश्वरो हरिः शत्रुं हन्तुं मनश्चक्रे भगवान्भरतर्षभ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-018",
    "skandha": 10,
    "chapter": 44,
    "sloka": 18,
    "sanskrit": "सभयाः स्त्रीगिरः श्रुत्वा पुत्रस्नेहशुचातुरौ पितरावन्वतप्येतां पुत्रयोरबुधौ बलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-019",
    "skandha": 10,
    "chapter": 44,
    "sloka": 19,
    "sanskrit": "तैस्तैर्नियुद्धविधिभिर्विविधैरच्युतेतरौ युयुधाते यथान्योन्यं तथैव बलमुष्टिकौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-020",
    "skandha": 10,
    "chapter": 44,
    "sloka": 20,
    "sanskrit": "भगवद्गात्रनिष्पातैर्वज्रनीष्पेषनिष्ठुरैः चाणूरो भज्यमानाङ्गो मुहुर्ग्लानिमवाप ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-021",
    "skandha": 10,
    "chapter": 44,
    "sloka": 21,
    "sanskrit": "स श्येनवेग उत्पत्य मुष्टीकृत्य करावुभौ भगवन्तं वासुदेवं क्रुद्धो वक्षस्यबाधत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-022",
    "skandha": 10,
    "chapter": 44,
    "sloka": 22,
    "sanskrit": "नाचलत्तत्प्रहारेण मालाहत इव द्विपः बाह्वोर्निगृह्य चाणूरं बहुशो भ्रामयन्हरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-023",
    "skandha": 10,
    "chapter": 44,
    "sloka": 23,
    "sanskrit": "भूपृष्ठे पोथयामास तरसा क्षीण जीवितम् विस्रस्ताकल्पकेशस्रगिन्द्रध्वज इवापतत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-024",
    "skandha": 10,
    "chapter": 44,
    "sloka": 24,
    "sanskrit": "तथैव मुष्टिकः पूर्वं स्वमुष्ट्याभिहतेन वै बलभद्रेण बलिना तलेनाभिहतो भृशम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-025",
    "skandha": 10,
    "chapter": 44,
    "sloka": 25,
    "sanskrit": "प्रवेपितः स रुधिरमुद्वमन्मुखतोऽर्दितः व्यसुः पपातोर्व्युपस्थे वाताहत इवाङ्घ्रिपः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-026",
    "skandha": 10,
    "chapter": 44,
    "sloka": 26,
    "sanskrit": "ततः कूटमनुप्राप्तं रामः प्रहरतां वरः अवधील्लीलया राजन्सावज्ञं वाममुष्टिना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-027",
    "skandha": 10,
    "chapter": 44,
    "sloka": 27,
    "sanskrit": "तर्ह्येव हि शलः कृष्ण प्रपदाहतशीर्षकः द्विधा विदीर्णस्तोशलक उभावपि निपेततुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-028",
    "skandha": 10,
    "chapter": 44,
    "sloka": 28,
    "sanskrit": "चाणूरे मुष्टिके कूटे शले तोशलके हते शेषाः प्रदुद्रुवुर्मल्लाः सर्वे प्राणपरीप्सवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-029",
    "skandha": 10,
    "chapter": 44,
    "sloka": 29,
    "sanskrit": "गोपान्वयस्यानाकृष्य तैः संसृज्य विजह्रतुः वाद्यमानेषु तूर्येषु वल्गन्तौ रुतनूपुरौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-030",
    "skandha": 10,
    "chapter": 44,
    "sloka": 30,
    "sanskrit": "जनाः प्रजहृषुः सर्वे कर्मणा रामकृष्णयोः ऋते कंसं विप्रमुख्याः साधवः साधु साध्विति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-031",
    "skandha": 10,
    "chapter": 44,
    "sloka": 31,
    "sanskrit": "हतेषु मल्लवर्येषु विद्रुतेषु च भोजराट् न्यवारयत्स्वतूर्याणि वाक्यं चेदमुवाच ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-032",
    "skandha": 10,
    "chapter": 44,
    "sloka": 32,
    "sanskrit": "निःसारयत दुर्वृत्तौ वसुदेवात्मजौ पुरात् धनं हरत गोपानां नन्दं बध्नीत दुर्मतिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-033",
    "skandha": 10,
    "chapter": 44,
    "sloka": 33,
    "sanskrit": "वसुदेवस्तु दुर्मेधा हन्यतामाश्वसत्तमः उग्रसेनः पिता चापि सानुगः परपक्षगः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-034",
    "skandha": 10,
    "chapter": 44,
    "sloka": 34,
    "sanskrit": "एवं विकत्थमाने वै कंसे प्रकुपितोऽव्ययः लघिम्नोत्पत्य तरसा मञ्चमुत्तुङ्गमारुहत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-035",
    "skandha": 10,
    "chapter": 44,
    "sloka": 35,
    "sanskrit": "तमाविशन्तमालोक्य मृत्युमात्मन आसनात् मनस्वी सहसोत्थाय जगृहे सोऽसिचर्मणी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-036",
    "skandha": 10,
    "chapter": 44,
    "sloka": 36,
    "sanskrit": "तं खड्गपाणिं विचरन्तमाशु श्येनं यथा दक्षिणसव्यमम्बरे समग्रहीद्दुर्विषहोग्रतेजा यथोरगं तार्क्ष्यसुतः प्रसह्य",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-037",
    "skandha": 10,
    "chapter": 44,
    "sloka": 37,
    "sanskrit": "प्रगृह्य केशेषु चलत्किरीतं निपात्य रङ्गोपरि तुङ्गमञ्चात् तस्योपरिष्टात्स्वयमब्जनाभः पपात विश्वाश्रय आत्मतन्त्रः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-038",
    "skandha": 10,
    "chapter": 44,
    "sloka": 38,
    "sanskrit": "तं सम्परेतं विचकर्ष भूमौ हरिर्यथेभं जगतो विपश्यतः हा हेति शब्दः सुमहांस्तदाभूदुदीरितः सर्वजनैर्नरेन्द्र",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-039",
    "skandha": 10,
    "chapter": 44,
    "sloka": 39,
    "sanskrit": "स नित्यदोद्विग्नधिया तमीश्वरं पिबन्नदन्वा विचरन्स्वपन्श्वसन् ददर्श चक्रायुधमग्रतो यतस्तदेव रूपं दुरवापमाप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-040",
    "skandha": 10,
    "chapter": 44,
    "sloka": 40,
    "sanskrit": "तस्यानुजा भ्रातरोऽष्टौ कङ्कन्यग्रोधकादयः अभ्यधावन्नतिक्रुद्धा भ्रातुर्निर्वेशकारिणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-041",
    "skandha": 10,
    "chapter": 44,
    "sloka": 41,
    "sanskrit": "तथातिरभसांस्तांस्तु संयत्तान्रोहिणीसुतः अहन्परिघमुद्यम्य पशूनिव मृगाधिपः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-042",
    "skandha": 10,
    "chapter": 44,
    "sloka": 42,
    "sanskrit": "नेदुर्दुन्दुभयो व्योम्नि ब्रह्मेशाद्या विभूतयः पुष्पैः किरन्तस्तं प्रीताः शशंसुर्ननृतुः स्त्रियः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-043",
    "skandha": 10,
    "chapter": 44,
    "sloka": 43,
    "sanskrit": "तेषां स्त्रियो महाराज सुहृन्मरणदुःखिताः तत्राभीयुर्विनिघ्नन्त्यः शीर्षाण्यश्रुविलोचनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-10-chapter-44-sloka-044",
    "skandha": 10,
