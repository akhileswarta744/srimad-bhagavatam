[
  {
    "id": "skandha-08-chapter-13-sloka-001",
    "skandha": 8,
    "chapter": 13,
    "sloka": 1,
    "sanskrit": "मनुर्विवस्वतः पुत्रः श्राद्धदेव इति श्रुतः सप्तमो वर्तमानो यस्तदपत्यानि मे शृणु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-08-chapter-13-sloka-002",
    "skandha": 8,
    "chapter": 13,
    "sloka": 2,
    "sanskrit": "इक्ष्वाकुर्नभगश्चैव धृष्टः शर्यातिरेव च नरिष्यन्तोऽथ नाभागः सप्तमो दिष्ट उच्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-003",
    "skandha": 8,
    "chapter": 13,
    "sloka": 3,
    "sanskrit": "तरूषश्च पृषध्रश्च दशमो वसुमान्स्मृतः मनोर्वैवस्वतस्यैते दशपुत्राः परन्तप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-004",
    "skandha": 8,
    "chapter": 13,
    "sloka": 4,
    "sanskrit": "आदित्या वसवो रुद्रा विश्वेदेवा मरुद्गणाः अश्विनावृभवो राजन्निन्द्रस्तेषां पुरन्दरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-005",
    "skandha": 8,
    "chapter": 13,
    "sloka": 5,
    "sanskrit": "कश्यपोऽत्रिर्वसिष्ठश्च विश्वामित्रोऽथ गौतमः जमदग्निर्भरद्वाज इति सप्तर्षयः स्मृताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-006",
    "skandha": 8,
    "chapter": 13,
    "sloka": 6,
    "sanskrit": "अत्रापि भगवज्जन्म कश्यपाददितेरभूत् आदित्यानामवरजो विष्णुर्वामनरूपधृक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-007",
    "skandha": 8,
    "chapter": 13,
    "sloka": 7,
    "sanskrit": "सङ्क्षेपतो मयोक्तानि सप्तमन्वन्तराणि ते भविष्याण्यथ वक्ष्यामि विष्णोः शक्त्यान्वितानि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-008",
    "skandha": 8,
    "chapter": 13,
    "sloka": 8,
    "sanskrit": "विवस्वतश्च द्वे जाये विश्वकर्मसुते उभे संज्ञा छाया च राजेन्द्र ये प्रागभिहिते तव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-009",
    "skandha": 8,
    "chapter": 13,
    "sloka": 9,
    "sanskrit": "तृतीयां वडवामेके तासां संज्ञासुतास्त्रयः यमो यमी श्राद्धदेवश्छायायाश्च सुताञ्छृणु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-010",
    "skandha": 8,
    "chapter": 13,
    "sloka": 10,
    "sanskrit": "सावर्णिस्तपती कन्या भार्या संवरणस्य या शनैश्चरस्तृतीयोऽभूदश्विनौ वडवात्मजौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-011",
    "skandha": 8,
    "chapter": 13,
    "sloka": 11,
    "sanskrit": "अष्टमेऽन्तर आयाते सावर्णिर्भविता मनुः निर्मोकविरजस्काद्याः सावर्णितनया नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-012",
    "skandha": 8,
    "chapter": 13,
    "sloka": 12,
    "sanskrit": "तत्र देवाः सुतपसो विरजा अमृतप्रभाः तेषां विरोचनसुतो बलिरिन्द्रो भविष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-013",
    "skandha": 8,
    "chapter": 13,
    "sloka": 13,
    "sanskrit": "दत्त्वेमां याचमानाय विष्णवे यः पदत्रयम् राद्धमिन्द्रपदं हित्वा ततः सिद्धिमवाप्स्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-014",
    "skandha": 8,
    "chapter": 13,
    "sloka": 14,
    "sanskrit": "योऽसौ भगवता बद्धः प्रीतेन सुतले पुनः निवेशितोऽधिके स्वर्गादधुनास्ते स्वराडिव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-015",
    "skandha": 8,
    "chapter": 13,
    "sloka": 15,
    "sanskrit": "गालवो दीप्तिमान्रामो द्रोणपुत्रः कृपस्तथा ऋष्यशृङ्गः पितास्माकं भगवान्बादरायणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-016",
    "skandha": 8,
    "chapter": 13,
    "sloka": 16,
    "sanskrit": "इमे सप्तर्षयस्तत्र भविष्यन्ति स्वयोगतः इदानीमासते राजन्स्वे स्व आश्रममण्डले",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-017",
    "skandha": 8,
    "chapter": 13,
    "sloka": 17,
    "sanskrit": "देवगुह्यात्सरस्वत्यां सार्वभौम इति प्रभुः स्थानं पुरन्दराद्धृत्वा बलये दास्यतीश्वरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-018",
    "skandha": 8,
    "chapter": 13,
    "sloka": 18,
    "sanskrit": "नवमो दक्षसावर्णिर्मनुर्वरुणसम्भवः भूतकेतुर्दीप्तकेतुरित्याद्यास्तत्सुता नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-019",
    "skandha": 8,
    "chapter": 13,
    "sloka": 19,
    "sanskrit": "पारामरीचिगर्भाद्या देवा इन्द्रोऽद्भुतः स्मृतः द्युतिमत्प्रमुखास्तत्र भविष्यन्त्यृषयस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-020",
    "skandha": 8,
    "chapter": 13,
    "sloka": 20,
    "sanskrit": "आयुष्मतोऽम्बुधारायामृषभो भगवत्कला भविता येन संराद्धां त्रिलोकीं भोक्ष्यतेऽद्भुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-021",
    "skandha": 8,
    "chapter": 13,
    "sloka": 21,
    "sanskrit": "दशमो ब्रह्मसावर्णिरुपश्लोकसुतो मनुः तत्सुता भूरिषेणाद्या हविष्मत्प्रमुखा द्विजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-022",
    "skandha": 8,
    "chapter": 13,
    "sloka": 22,
    "sanskrit": "हविष्मान्सुकृतः सत्यो जयो मूर्तिस्तदा द्विजाः सुवासनविरुद्धाद्या देवाः शम्भुः सुरेश्वरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-023",
    "skandha": 8,
    "chapter": 13,
    "sloka": 23,
    "sanskrit": "विष्वक्सेनो विषूच्यां तु शम्भोः सख्यं करिष्यति जातः स्वांशेन भगवान्गृहे विश्वसृजो विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-024",
    "skandha": 8,
    "chapter": 13,
    "sloka": 24,
    "sanskrit": "मनुर्वै धर्मसावर्णिरेकादशम आत्मवान् अनागतास्तत्सुताश्च सत्यधर्मादयो दश",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-025",
    "skandha": 8,
    "chapter": 13,
    "sloka": 25,
    "sanskrit": "विहङ्गमाः कामगमा निर्वाणरुचयः सुराः इन्द्रश्च वैधृतस्तेषामृषयश्चारुणादयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-026",
    "skandha": 8,
    "chapter": 13,
    "sloka": 26,
    "sanskrit": "आर्यकस्य सुतस्तत्र धर्मसेतुरिति स्मृतः वैधृतायां हरेरंशस्त्रिलोकीं धारयिष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-027",
    "skandha": 8,
    "chapter": 13,
    "sloka": 27,
    "sanskrit": "भविता रुद्रसावर्णी राजन्द्वादशमो मनुः देववानुपदेवश्च देवश्रेष्ठादयः सुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-028",
    "skandha": 8,
    "chapter": 13,
    "sloka": 28,
    "sanskrit": "ऋतधामा च तत्रेन्द्रो देवाश्च हरितादयः ऋषयश्च तपोमूर्तिस्तपस्व्याग्नीध्रकादयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-029",
    "skandha": 8,
    "chapter": 13,
    "sloka": 29,
    "sanskrit": "स्वधामाख्यो हरेरंशः साधयिष्यति तन्मनोः अन्तरं सत्यसहसः सुनृतायाः सुतो विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-030",
    "skandha": 8,
    "chapter": 13,
    "sloka": 30,
    "sanskrit": "मनुस्त्रयोदशो भाव्यो देवसावर्णिरात्मवान् चित्रसेनविचित्राद्या देवसावर्णिदेहजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-031",
    "skandha": 8,
    "chapter": 13,
    "sloka": 31,
    "sanskrit": "देवाः सुकर्मसुत्राम संज्ञा इन्द्रो दिवस्पतिः निर्मोकतत्त्वदर्शाद्या भविष्यन्त्यृषयस्तदा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-032",
    "skandha": 8,
    "chapter": 13,
    "sloka": 32,
    "sanskrit": "देवहोत्रस्य तनय उपहर्ता दिवस्पतेः योगेश्वरो हरेरंशो बृहत्यां सम्भविष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-033",
    "skandha": 8,
    "chapter": 13,
    "sloka": 33,
    "sanskrit": "मनुर्वा इन्द्रसावर्णिश्चतुर्दशम एष्यति उरुगम्भीरबुधाद्या इन्द्रसावर्णिवीर्यजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-034",
    "skandha": 8,
    "chapter": 13,
    "sloka": 34,
    "sanskrit": "पवित्राश्चाक्षुषा देवाः शुचिरिन्द्रो भविष्यति अग्निर्बाहुः शुचिः शुद्धो मागधाद्यास्तपस्विनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-035",
    "skandha": 8,
    "chapter": 13,
    "sloka": 35,
    "sanskrit": "सत्रायणस्य तनयो बृहद्भानुस्तदा हरिः वितानायां महाराज क्रियातन्तून्वितायिता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-13-sloka-036",
    "skandha": 8,
    "chapter": 13,
    "sloka": 36,
    "sanskrit": "राजंश्चतुर्दशैतानि त्रिकालानुगतानि ते प्रोक्तान्येभिर्मितः कल्पो युगसाहस्रपर्ययः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]