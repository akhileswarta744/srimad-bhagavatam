[
  {
    "id": "skandha-08-chapter-16-sloka-001",
    "skandha": 8,
    "chapter": 16,
    "sloka": 1,
    "sanskrit": "एवं पुत्रेषु नष्टेषु देवमातादितिस्तदा हृते त्रिविष्टपे दैत्यैः पर्यतप्यदनाथवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-08-chapter-16-sloka-002",
    "skandha": 8,
    "chapter": 16,
    "sloka": 2,
    "sanskrit": "एकदा कश्यपस्तस्या आश्रमं भगवानगात् निरुत्सवं निरानन्दं समाधेर्विरतश्चिरात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-003",
    "skandha": 8,
    "chapter": 16,
    "sloka": 3,
    "sanskrit": "स पत्नीं दीनवदनां कृतासनपरिग्रहः सभाजितो यथान्यायमिदमाह कुरूद्वह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-004",
    "skandha": 8,
    "chapter": 16,
    "sloka": 4,
    "sanskrit": "अप्यभद्रं न विप्राणां भद्रे लोकेऽधुनागतम् न धर्मस्य न लोकस्य मृत्योश्छन्दानुवर्तिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-005",
    "skandha": 8,
    "chapter": 16,
    "sloka": 5,
    "sanskrit": "अपि वाकुशलं किञ्चिद्गृहेषु गृहमेधिनि धर्मस्यार्थस्य कामस्य यत्र योगो ह्ययोगिनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-006",
    "skandha": 8,
    "chapter": 16,
    "sloka": 6,
    "sanskrit": "अपि वातिथयोऽभ्येत्य कुटुम्बासक्तया त्वया गृहादपूजिता याताः प्रत्युत्थानेन वा क्वचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-007",
    "skandha": 8,
    "chapter": 16,
    "sloka": 7,
    "sanskrit": "गृहेषु येष्वतिथयो नार्चिताः सलिलैरपि यदि निर्यान्ति ते नूनं फेरुराजगृहोपमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-008",
    "skandha": 8,
    "chapter": 16,
    "sloka": 8,
    "sanskrit": "अप्यग्नयस्तु वेलायां न हुता हविषा सति त्वयोद्विग्नधिया भद्रे प्रोषिते मयि कर्हिचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-009",
    "skandha": 8,
    "chapter": 16,
    "sloka": 9,
    "sanskrit": "यत्पूजया कामदुघान्याति लोकान्गृहान्वितः ब्राह्मणोऽग्निश्च वै विष्णोः सर्वदेवात्मनो मुखम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-010",
    "skandha": 8,
    "chapter": 16,
    "sloka": 10,
    "sanskrit": "अपि सर्वे कुशलिनस्तव पुत्रा मनस्विनि लक्षयेऽस्वस्थमात्मानं भवत्या लक्षणैरहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-011",
    "skandha": 8,
    "chapter": 16,
    "sloka": 11,
    "sanskrit": "भद्रं द्विजगवां ब्रह्मन्धर्मस्यास्य जनस्य च त्रिवर्गस्य परं क्षेत्रं गृहमेधिन्गृहा इमे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीअदितिरुवाच ।"
  },
  {
    "id": "skandha-08-chapter-16-sloka-012",
    "skandha": 8,
    "chapter": 16,
    "sloka": 12,
    "sanskrit": "अग्नयोऽतिथयो भृत्या भिक्षवो ये च लिप्सवः सर्वं भगवतो ब्रह्मन्ननुध्यानान्न रिष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-013",
    "skandha": 8,
    "chapter": 16,
    "sloka": 13,
    "sanskrit": "को नु मे भगवन्कामो न सम्पद्येत मानसः यस्या भवान्प्रजाध्यक्ष एवं धर्मान्प्रभाषते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-014",
    "skandha": 8,
    "chapter": 16,
    "sloka": 14,
    "sanskrit": "तवैव मारीच मनःशरीरजाः प्रजा इमाः सत्त्वरजस्तमोजुषः समो भवांस्तास्वसुरादिषु प्रभो तथापि भक्तं भजते महेश्वरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-015",
    "skandha": 8,
    "chapter": 16,
    "sloka": 15,
    "sanskrit": "तस्मादीश भजन्त्या मे श्रेयश्चिन्तय सुव्रत हृतश्रियो हृतस्थानान्सपत्नैः पाहि नः प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-016",
    "skandha": 8,
    "chapter": 16,
    "sloka": 16,
    "sanskrit": "परैर्विवासिता साहं मग्ना व्यसनसागरे ऐश्वर्यं श्रीर्यशः स्थानं हृतानि प्रबलैर्मम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-017",
    "skandha": 8,
    "chapter": 16,
    "sloka": 17,
    "sanskrit": "यथा तानि पुनः साधो प्रपद्येरन्ममात्मजाः तथा विधेहि कल्याणं धिया कल्याणकृत्तम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-018",
    "skandha": 8,
    "chapter": 16,
    "sloka": 18,
    "sanskrit": "एवमभ्यर्थितोऽदित्या कस्तामाह स्मयन्निव अहो मायाबलं विष्णोः स्नेहबद्धमिदं जगत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-08-chapter-16-sloka-019",
    "skandha": 8,
    "chapter": 16,
    "sloka": 19,
    "sanskrit": "क्व देहो भौतिकोऽनात्मा क्व चात्मा प्रकृतेः परः कस्य के पतिपुत्राद्या मोह एव हि कारणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-020",
    "skandha": 8,
    "chapter": 16,
    "sloka": 20,
    "sanskrit": "उपतिष्ठस्व पुरुषं भगवन्तं जनार्दनम् सर्वभूतगुहावासं वासुदेवं जगद्गुरुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-021",
    "skandha": 8,
    "chapter": 16,
    "sloka": 21,
    "sanskrit": "स विधास्यति ते कामान्हरिर्दीनानुकम्पनः अमोघा भगवद्भक्तिर्नेतरेति मतिर्मम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-022",
    "skandha": 8,
    "chapter": 16,
    "sloka": 22,
    "sanskrit": "केनाहं विधिना ब्रह्मन्नुपस्थास्ये जगत्पतिम् यथा मे सत्यसङ्कल्पो विदध्यात्स मनोरथम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीअदितिरुवाच ।"
  },
  {
    "id": "skandha-08-chapter-16-sloka-023",
    "skandha": 8,
    "chapter": 16,
    "sloka": 23,
    "sanskrit": "आदिश त्वं द्विजश्रेष्ठ विधिं तदुपधावनम् आशु तुष्यति मे देवः सीदन्त्याः सह पुत्रकैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-024",
    "skandha": 8,
    "chapter": 16,
    "sloka": 24,
    "sanskrit": "एतन्मे भगवान्पृष्टः प्रजाकामस्य पद्मजः यदाह ते प्रवक्ष्यामि व्रतं केशवतोषणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीकश्यप उवाच ।"
  },
  {
    "id": "skandha-08-chapter-16-sloka-025",
    "skandha": 8,
    "chapter": 16,
    "sloka": 25,
    "sanskrit": "फाल्गुनस्यामले पक्षे द्वादशाहं पयोव्रतम् अर्चयेदरविन्दाक्षं भक्त्या परमयान्वितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-026",
    "skandha": 8,
    "chapter": 16,
    "sloka": 26,
    "sanskrit": "सिनीवाल्यां मृदालिप्य स्नायात्क्रोडविदीर्णया यदि लभ्येत वै स्रोतस्येतं मन्त्रमुदीरयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-027",
    "skandha": 8,
    "chapter": 16,
    "sloka": 27,
    "sanskrit": "त्वं देव्यादिवराहेण रसायाः स्थानमिच्छता उद्धृतासि नमस्तुभ्यं पाप्मानं मे प्रणाशय",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-028",
    "skandha": 8,
    "chapter": 16,
    "sloka": 28,
    "sanskrit": "निर्वर्तितात्मनियमो देवमर्चेत्समाहितः अर्चायां स्थण्डिले सूर्ये जले वह्नौ गुरावपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-029",
    "skandha": 8,
    "chapter": 16,
    "sloka": 29,
    "sanskrit": "नमस्तुभ्यं भगवते पुरुषाय महीयसे सर्वभूतनिवासाय वासुदेवाय साक्षिणे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-030",
    "skandha": 8,
    "chapter": 16,
    "sloka": 30,
    "sanskrit": "नमोऽव्यक्ताय सूक्ष्माय प्रधानपुरुषाय च चतुर्विंशद्गुणज्ञाय गुणसङ्ख्यानहेतवे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-031",
    "skandha": 8,
    "chapter": 16,
    "sloka": 31,
    "sanskrit": "नमो द्विशीर्ष्णे त्रिपदे चतुःशृङ्गाय तन्तवे सप्तहस्ताय यज्ञाय त्रयीविद्यात्मने नमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-032",
    "skandha": 8,
    "chapter": 16,
    "sloka": 32,
    "sanskrit": "नमः शिवाय रुद्राय नमः शक्तिधराय च सर्वविद्याधिपतये भूतानां पतये नमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-033",
    "skandha": 8,
    "chapter": 16,
    "sloka": 33,
    "sanskrit": "नमो हिरण्यगर्भाय प्राणाय जगदात्मने योगैश्वर्यशरीराय नमस्ते योगहेतवे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-034",
    "skandha": 8,
    "chapter": 16,
    "sloka": 34,
    "sanskrit": "नमस्त आदिदेवाय साक्षिभूताय ते नमः नारायणाय ऋषये नराय हरये नमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-035",
    "skandha": 8,
    "chapter": 16,
    "sloka": 35,
    "sanskrit": "नमो मरकतश्याम वपुषेऽधिगतश्रिये केशवाय नमस्तुभ्यं नमस्ते पीतवाससे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-036",
    "skandha": 8,
    "chapter": 16,
    "sloka": 36,
    "sanskrit": "त्वं सर्ववरदः पुंसां वरेण्य वरदर्षभ अतस्ते श्रेयसे धीराः पादरेणुमुपासते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-037",
    "skandha": 8,
    "chapter": 16,
    "sloka": 37,
    "sanskrit": "अन्ववर्तन्त यं देवाः श्रीश्च तत्पादपद्मयोः स्पृहयन्त इवामोदं भगवान्मे प्रसीदताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-038",
    "skandha": 8,
    "chapter": 16,
    "sloka": 38,
    "sanskrit": "एतैर्मन्त्रैर्हृषीकेशमावाहनपुरस्कृतम् अर्चयेच्छ्रद्धया युक्तः पाद्योपस्पर्शनादिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-039",
    "skandha": 8,
    "chapter": 16,
    "sloka": 39,
    "sanskrit": "अर्चित्वा गन्धमाल्याद्यैः पयसा स्नपयेद्विभुम् वस्त्रोपवीताभरण पाद्योपस्पर्शनैस्ततः गन्धधूपादिभिश्चार्चेद्द्वादशाक्षरविद्यया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-040",
    "skandha": 8,
    "chapter": 16,
    "sloka": 40,
    "sanskrit": "शृतं पयसि नैवेद्यं शाल्यन्नं विभवे सति ससर्पिः सगुडं दत्त्वा जुहुयान्मूलविद्यया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-041",
    "skandha": 8,
    "chapter": 16,
    "sloka": 41,
    "sanskrit": "निवेदितं तद्भक्ताय दद्याद्भुञ्जीत वा स्वयम् दत्त्वाचमनमर्चित्वा ताम्बूलं च निवेदयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-042",
    "skandha": 8,
    "chapter": 16,
    "sloka": 42,
    "sanskrit": "जपेदष्टोत्तरशतं स्तुवीत स्तुतिभिः प्रभुम् कृत्वा प्रदक्षिणं भूमौ प्रणमेद्दण्डवन्मुदा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-043",
    "skandha": 8,
    "chapter": 16,
    "sloka": 43,
    "sanskrit": "कृत्वा शिरसि तच्छेषां देवमुद्वासयेत्ततः द्व्यवरान्भोजयेद्विप्रान्पायसेन यथोचितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-044",
    "skandha": 8,
    "chapter": 16,
    "sloka": 44,
    "sanskrit": "भुञ्जीत तैरनुज्ञातः सेष्टः शेषं सभाजितैः ब्रह्मचार्यथ तद्रात्र्यां श्वो भूते प्रथमेऽहनि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-16-sloka-045",
    "skandha": 8,
    "chapter": 16,
    "sloka": 45,
    "sanskrit": "स्नातः शुचिर्यथोक्तेन विधिना सुसमाहितः पयसा स्नापयित्वार्चेद्यावद्व्रतसमापनम्",
    "malayalamMeaning": "",
