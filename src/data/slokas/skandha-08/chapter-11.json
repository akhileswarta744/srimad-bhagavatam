[
  {
    "id": "skandha-08-chapter-11-sloka-001",
    "skandha": 8,
    "chapter": 11,
    "sloka": 1,
    "sanskrit": "अथो सुराः प्रत्युपलब्धचेतसः परस्य पुंसः परयानुकम्पया जघ्नुर्भृशं शक्रसमीरणादयस्तांस्तान्रणे यैरभिसंहताः पुरा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-08-chapter-11-sloka-002",
    "skandha": 8,
    "chapter": 11,
    "sloka": 2,
    "sanskrit": "वैरोचनाय संरब्धो भगवान्पाकशासनः उदयच्छद्यदा वज्रं प्रजा हा हेति चुक्रुशुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-003",
    "skandha": 8,
    "chapter": 11,
    "sloka": 3,
    "sanskrit": "वज्रपाणिस्तमाहेदं तिरस्कृत्य पुरःस्थितम् मनस्विनं सुसम्पन्नं विचरन्तं महामृधे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-004",
    "skandha": 8,
    "chapter": 11,
    "sloka": 4,
    "sanskrit": "नटवन्मूढ मायाभिर्मायेशान्नो जिगीषसि जित्वा बालान्निबद्धाक्षान्नटो हरति तद्धनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-005",
    "skandha": 8,
    "chapter": 11,
    "sloka": 5,
    "sanskrit": "आरुरुक्षन्ति मायाभिरुत्सिसृप्सन्ति ये दिवम् तान्दस्यून्विधुनोम्यज्ञान्पूर्वस्माच्च पदादधः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-006",
    "skandha": 8,
    "chapter": 11,
    "sloka": 6,
    "sanskrit": "सोऽहं दुर्मायिनस्तेऽद्य वज्रेण शतपर्वणा शिरो हरिष्ये मन्दात्मन्घटस्व ज्ञातिभिः सह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-007",
    "skandha": 8,
    "chapter": 11,
    "sloka": 7,
    "sanskrit": "सङ्ग्रामे वर्तमानानां कालचोदितकर्मणाम् कीर्तिर्जयोऽजयो मृत्युः सर्वेषां स्युरनुक्रमात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीबलिरुवाच ।"
  },
  {
    "id": "skandha-08-chapter-11-sloka-008",
    "skandha": 8,
    "chapter": 11,
    "sloka": 8,
    "sanskrit": "तदिदं कालरशनं जगत्पश्यन्ति सूरयः न हृष्यन्ति न शोचन्ति तत्र यूयमपण्डिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-009",
    "skandha": 8,
    "chapter": 11,
    "sloka": 9,
    "sanskrit": "न वयं मन्यमानानामात्मानं तत्र साधनम् गिरो वः साधुशोच्यानां गृह्णीमो मर्मताडनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-010",
    "skandha": 8,
    "chapter": 11,
    "sloka": 10,
    "sanskrit": "इत्याक्षिप्य विभुं वीरो नाराचैर्वीरमर्दनः आकर्णपूर्णैरहनदाक्षेपैराह तं पुनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-08-chapter-11-sloka-011",
    "skandha": 8,
    "chapter": 11,
    "sloka": 11,
    "sanskrit": "एवं निराकृतो देवो वैरिणा तथ्यवादिना नामृष्यत्तदधिक्षेपं तोत्राहत इव द्विपः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-012",
    "skandha": 8,
    "chapter": 11,
    "sloka": 12,
    "sanskrit": "प्राहरत्कुलिशं तस्मा अमोघं परमर्दनः सयानो न्यपतद्भूमौ छिन्नपक्ष इवाचलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-013",
    "skandha": 8,
    "chapter": 11,
    "sloka": 13,
    "sanskrit": "सखायं पतितं दृष्ट्वा जम्भो बलिसखः सुहृत् अभ्ययात्सौहृदं सख्युर्हतस्यापि समाचरन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-014",
    "skandha": 8,
    "chapter": 11,
    "sloka": 14,
    "sanskrit": "स सिंहवाह आसाद्य गदामुद्यम्य रंहसा जत्रावताडयच्छक्रं गजं च सुमहाबलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-015",
    "skandha": 8,
    "chapter": 11,
    "sloka": 15,
    "sanskrit": "गदाप्रहारव्यथितो भृशं विह्वलितो गजः जानुभ्यां धरणीं स्पृष्ट्वा कश्मलं परमं ययौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-016",
    "skandha": 8,
    "chapter": 11,
    "sloka": 16,
    "sanskrit": "ततो रथो मातलिना हरिभिर्दशशतैर्वृतः आनीतो द्विपमुत्सृज्य रथमारुरुहे विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-017",
    "skandha": 8,
    "chapter": 11,
    "sloka": 17,
    "sanskrit": "तस्य तत्पूजयन्कर्म यन्तुर्दानवसत्तमः शूलेन ज्वलता तं तु स्मयमानोऽहनन्मृधे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-018",
    "skandha": 8,
    "chapter": 11,
    "sloka": 18,
    "sanskrit": "सेहे रुजं सुदुर्मर्षां सत्त्वमालम्ब्य मातलिः इन्द्रो जम्भस्य सङ्क्रुद्धो वज्रेणापाहरच्छिरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-019",
    "skandha": 8,
    "chapter": 11,
    "sloka": 19,
    "sanskrit": "जम्भं श्रुत्वा हतं तस्य ज्ञातयो नारदादृषेः नमुचिश्च बलः पाकस्तत्रापेतुस्त्वरान्विताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-020",
    "skandha": 8,
    "chapter": 11,
    "sloka": 20,
    "sanskrit": "वचोभिः परुषैरिन्द्रमर्दयन्तोऽस्य मर्मसु शरैरवाकिरन्मेघा धाराभिरिव पर्वतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-021",
    "skandha": 8,
    "chapter": 11,
    "sloka": 21,
    "sanskrit": "हरीन्दशशतान्याजौ हर्यश्वस्य बलः शरैः तावद्भिरर्दयामास युगपल्लघुहस्तवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-022",
    "skandha": 8,
    "chapter": 11,
    "sloka": 22,
    "sanskrit": "शताभ्यां मातलिं पाको रथं सावयवं पृथक् सकृत्सन्धानमोक्षेण तदद्भुतमभूद्रणे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-023",
    "skandha": 8,
    "chapter": 11,
    "sloka": 23,
    "sanskrit": "नमुचिः पञ्चदशभिः स्वर्णपुङ्खैर्महेषुभिः आहत्य व्यनदत्सङ्ख्ये सतोय इव तोयदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-024",
    "skandha": 8,
    "chapter": 11,
    "sloka": 24,
    "sanskrit": "सर्वतः शरकूटेन शक्रं सरथसारथिम् छादयामासुरसुराः प्रावृट्सूर्यमिवाम्बुदाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-025",
    "skandha": 8,
    "chapter": 11,
    "sloka": 25,
    "sanskrit": "अलक्षयन्तस्तमतीव विह्वला विचुक्रुशुर्देवगणाः सहानुगाः अनायकाः शत्रुबलेन निर्जिता वणिक्पथा भिन्ननवो यथार्णवे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-026",
    "skandha": 8,
    "chapter": 11,
    "sloka": 26,
    "sanskrit": "ततस्तुराषाडिषुबद्धपञ्जराद्विनिर्गतः साश्वरथध्वजाग्रणीः बभौ दिशः खं पृथिवीं च रोचयन्स्वतेजसा सूर्य इव क्षपात्यये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-027",
    "skandha": 8,
    "chapter": 11,
    "sloka": 27,
    "sanskrit": "निरीक्ष्य पृतनां देवः परैरभ्यर्दितां रणे उदयच्छद्रिपुं हन्तुं वज्रं वज्रधरो रुषा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-028",
    "skandha": 8,
    "chapter": 11,
    "sloka": 28,
    "sanskrit": "स तेनैवाष्टधारेण शिरसी बलपाकयोः ज्ञातीनां पश्यतां राजञ्जहार जनयन्भयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-029",
    "skandha": 8,
    "chapter": 11,
    "sloka": 29,
    "sanskrit": "नमुचिस्तद्वधं दृष्ट्वा शोकामर्षरुषान्वितः जिघांसुरिन्द्रं नृपते चकार परमोद्यमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-030",
    "skandha": 8,
    "chapter": 11,
    "sloka": 30,
    "sanskrit": "अश्मसारमयं शूलं घण्टावद्धेमभूषणम् प्रगृह्याभ्यद्रवत्क्रुद्धो हतोऽसीति वितर्जयन् प्राहिणोद्देवराजाय निनदन्मृगराडिव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-031",
    "skandha": 8,
    "chapter": 11,
    "sloka": 31,
    "sanskrit": "तदापतद्गगनतले महाजवं विचिच्छिदे हरिरिषुभिः सहस्रधा तमाहनन्नृप कुलिशेन कन्धरे रुषान्वितस्त्रिदशपतिः शिरो हरन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-032",
    "skandha": 8,
    "chapter": 11,
    "sloka": 32,
    "sanskrit": "न तस्य हि त्वचमपि वज्र ऊर्जितो बिभेद यः सुरपतिनौजसेरितः तदद्भुतं परमतिवीर्यवृत्रभित्तिरस्कृतो नमुचिशिरोधरत्वचा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-033",
    "skandha": 8,
    "chapter": 11,
    "sloka": 33,
    "sanskrit": "तस्मादिन्द्रोऽबिभेच्छत्रोर्वज्रः प्रतिहतो यतः किमिदं दैवयोगेन भूतं लोकविमोहनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-034",
    "skandha": 8,
    "chapter": 11,
    "sloka": 34,
    "sanskrit": "येन मे पूर्वमद्रीणां पक्षच्छेदः प्रजात्यये कृतो निविशतां भारैः पतत्त्रैः पततां भुवि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-035",
    "skandha": 8,
    "chapter": 11,
    "sloka": 35,
    "sanskrit": "तपःसारमयं त्वाष्ट्रं वृत्रो येन विपाटितः अन्ये चापि बलोपेताः सर्वास्त्रैरक्षतत्वचः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-036",
    "skandha": 8,
    "chapter": 11,
    "sloka": 36,
    "sanskrit": "सोऽयं प्रतिहतो वज्रो मया मुक्तोऽसुरेऽल्पके नाहं तदाददे दण्डं ब्रह्मतेजोऽप्यकारणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-037",
    "skandha": 8,
    "chapter": 11,
    "sloka": 37,
    "sanskrit": "इति शक्रं विषीदन्तमाह वागशरीरिणी नायं शुष्कैरथो नार्द्रैर्वधमर्हति दानवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-038",
    "skandha": 8,
    "chapter": 11,
    "sloka": 38,
    "sanskrit": "मयास्मै यद्वरो दत्तो मृत्युर्नैवार्द्रशुष्कयोः अतोऽन्यश्चिन्तनीयस्ते उपायो मघवन्रिपोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-039",
    "skandha": 8,
    "chapter": 11,
    "sloka": 39,
    "sanskrit": "तां दैवीं गिरमाकर्ण्य मघवान्सुसमाहितः ध्यायन्फेनमथापश्यदुपायमुभयात्मकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-040",
    "skandha": 8,
    "chapter": 11,
    "sloka": 40,
    "sanskrit": "न शुष्केण न चार्द्रेण जहार नमुचेः शिरः तं तुष्टुवुर्मुनिगणा माल्यैश्चावाकिरन्विभुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-041",
    "skandha": 8,
    "chapter": 11,
    "sloka": 41,
    "sanskrit": "गन्धर्वमुख्यौ जगतुर्विश्वावसुपरावसू देवदुन्दुभयो नेदुर्नर्तक्यो ननृतुर्मुदा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-042",
    "skandha": 8,
    "chapter": 11,
    "sloka": 42,
    "sanskrit": "अन्येऽप्येवं प्रतिद्वन्द्वान्वाय्वग्निवरुणादयः सूदयामासुरसुरान्मृगान्केसरिणो यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-043",
    "skandha": 8,
    "chapter": 11,
    "sloka": 43,
    "sanskrit": "ब्रह्मणा प्रेषितो देवान्देवर्षिर्नारदो नृप वारयामास विबुधान्दृष्ट्वा दानवसङ्क्षयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-11-sloka-044",
    "skandha": 8,
    "chapter": 11,
    "sloka": 44,
    "sanskrit": "भवद्भिरमृतं प्राप्तं नारायणभुजाश्रयैः श्रिया समेधिताः सर्व उपारमत विग्रहात्",
