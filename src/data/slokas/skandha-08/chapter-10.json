[
  {
    "id": "skandha-08-chapter-10-sloka-001",
    "skandha": 8,
    "chapter": 10,
    "sloka": 1,
    "sanskrit": "इति दानवदैतेया नाविन्दन्नमृतं नृप युक्ताः कर्मणि यत्ताश्च वासुदेवपराङ्मुखाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-08-chapter-10-sloka-002",
    "skandha": 8,
    "chapter": 10,
    "sloka": 2,
    "sanskrit": "साधयित्वामृतं राजन्पाययित्वा स्वकान्सुरान् पश्यतां सर्वभूतानां ययौ गरुडवाहनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-003",
    "skandha": 8,
    "chapter": 10,
    "sloka": 3,
    "sanskrit": "सपत्नानां परामृद्धिं दृष्ट्वा ते दितिनन्दनाः अमृष्यमाणा उत्पेतुर्देवान्प्रत्युद्यतायुधाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-004",
    "skandha": 8,
    "chapter": 10,
    "sloka": 4,
    "sanskrit": "ततः सुरगणाः सर्वे सुधया पीतयैधिताः प्रतिसंयुयुधुः शस्त्रैर्नारायणपदाश्रयाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-005",
    "skandha": 8,
    "chapter": 10,
    "sloka": 5,
    "sanskrit": "तत्र दैवासुरो नाम रणः परमदारुणः रोधस्युदन्वतो राजंस्तुमुलो रोमहर्षणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-006",
    "skandha": 8,
    "chapter": 10,
    "sloka": 6,
    "sanskrit": "तत्रान्योन्यं सपत्नास्ते संरब्धमनसो रणे समासाद्यासिभिर्बाणैर्निजघ्नुर्विविधायुधैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-007",
    "skandha": 8,
    "chapter": 10,
    "sloka": 7,
    "sanskrit": "शङ्खतूर्यमृदङ्गानां भेरीडमरिणां महान् हस्त्यश्वरथपत्तीनां नदतां निस्वनोऽभवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-008",
    "skandha": 8,
    "chapter": 10,
    "sloka": 8,
    "sanskrit": "रथिनो रथिभिस्तत्र पत्तिभिः सह पत्तयः हया हयैरिभाश्चेभैः समसज्जन्त संयुगे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-009",
    "skandha": 8,
    "chapter": 10,
    "sloka": 9,
    "sanskrit": "उष्ट्रैः केचिदिभैः केचिदपरे युयुधुः खरैः केचिद्गौरमुखैरृक्षैर्द्वीपिभिर्हरिभिर्भटाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-010",
    "skandha": 8,
    "chapter": 10,
    "sloka": 10,
    "sanskrit": "गृध्रैः कङ्कैर्बकैरन्ये श्येनभासैस्तिमिङ्गिलैः शरभैर्महिषैः खड्गैर्गोवृषैर्गवयारुणैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-011",
    "skandha": 8,
    "chapter": 10,
    "sloka": 11,
    "sanskrit": "शिवाभिराखुभिः केचित्कृकलासैः शशैर्नरैः बस्तैरेके कृष्णसारैर्हंसैरन्ये च सूकरैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-012",
    "skandha": 8,
    "chapter": 10,
    "sloka": 12,
    "sanskrit": "अन्ये जलस्थलखगैः सत्त्वैर्विकृतविग्रहैः सेनयोरुभयो राजन्विविशुस्तेऽग्रतोऽग्रतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-013",
    "skandha": 8,
    "chapter": 10,
    "sloka": 13,
    "sanskrit": "चित्रध्वजपटै राजन्नातपत्रैः सितामलैः महाधनैर्वज्रदण्डैर्व्यजनैर्बार्हचामरैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-014",
    "skandha": 8,
    "chapter": 10,
    "sloka": 14,
    "sanskrit": "वातोद्धूतोत्तरोष्णीषैरर्चिर्भिर्वर्मभूषणैः स्फुरद्भिर्विशदैः शस्त्रैः सुतरां सूर्यरश्मिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-015",
    "skandha": 8,
    "chapter": 10,
    "sloka": 15,
    "sanskrit": "देवदानववीराणां ध्वजिन्यौ पाण्डुनन्दन रेजतुर्वीरमालाभिर्यादसामिव सागरौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-016",
    "skandha": 8,
    "chapter": 10,
    "sloka": 16,
    "sanskrit": "वैरोचनो बलिः सङ्ख्ये सोऽसुराणां चमूपतिः यानं वैहायसं नाम कामगं मयनिर्मितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-017",
    "skandha": 8,
    "chapter": 10,
    "sloka": 17,
    "sanskrit": "सर्वसाङ्ग्रामिकोपेतं सर्वाश्चर्यमयं प्रभो अप्रतर्क्यमनिर्देश्यं दृश्यमानमदर्शनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-018",
    "skandha": 8,
    "chapter": 10,
    "sloka": 18,
    "sanskrit": "आस्थितस्तद्विमानाग्र्यं सर्वानीकाधिपैर्वृतः बालव्यजनछत्राग्र्यै रेजे चन्द्र इवोदये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-019",
    "skandha": 8,
    "chapter": 10,
    "sloka": 19,
    "sanskrit": "तस्यासन्सर्वतो यानैर्यूथानां पतयोऽसुराः नमुचिः शम्बरो बाणो विप्रचित्तिरयोमुखः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-020",
    "skandha": 8,
    "chapter": 10,
    "sloka": 20,
    "sanskrit": "द्विमूर्धा कालनाभोऽथ प्रहेतिर्हेतिरिल्वलः शकुनिर्भूतसन्तापो वज्रदंष्ट्रो विरोचनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-021",
    "skandha": 8,
    "chapter": 10,
    "sloka": 21,
    "sanskrit": "हयग्रीवः शङ्कुशिराः कपिलो मेघदुन्दुभिः तारकश्चक्रदृक्षुम्भो निशुम्भो जम्भ उत्कलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-022",
    "skandha": 8,
    "chapter": 10,
    "sloka": 22,
    "sanskrit": "अरिष्टोऽरिष्टनेमिश्च मयश्च त्रिपुराधिपः अन्ये पौलोमकालेया निवातकवचादयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-023",
    "skandha": 8,
    "chapter": 10,
    "sloka": 23,
    "sanskrit": "अलब्धभागाः सोमस्य केवलं क्लेशभागिनः सर्व एते रणमुखे बहुशो निर्जितामराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-024",
    "skandha": 8,
    "chapter": 10,
    "sloka": 24,
    "sanskrit": "सिंहनादान्विमुञ्चन्तः शङ्खान्दध्मुर्महारवान् दृष्ट्वा सपत्नानुत्सिक्तान्बलभित्कुपितो भृशम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-025",
    "skandha": 8,
    "chapter": 10,
    "sloka": 25,
    "sanskrit": "ऐरावतं दिक्करिणमारूढः शुशुभे स्वराट् यथा स्रवत्प्रस्रवणमुदयाद्रिमहर्पतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-026",
    "skandha": 8,
    "chapter": 10,
    "sloka": 26,
    "sanskrit": "तस्यासन्सर्वतो देवा नानावाहध्वजायुधाः लोकपालाः सहगणैर्वाय्वग्निवरुणादयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-027",
    "skandha": 8,
    "chapter": 10,
    "sloka": 27,
    "sanskrit": "तेऽन्योन्यमभिसंसृत्य क्षिपन्तो मर्मभिर्मिथः आह्वयन्तो विशन्तोऽग्रे युयुधुर्द्वन्द्वयोधिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-028",
    "skandha": 8,
    "chapter": 10,
    "sloka": 28,
    "sanskrit": "युयोध बलिरिन्द्रेण तारकेण गुहोऽस्यत वरुणो हेतिनायुध्यन्मित्रो राजन्प्रहेतिना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-029",
    "skandha": 8,
    "chapter": 10,
    "sloka": 29,
    "sanskrit": "यमस्तु कालनाभेन विश्वकर्मा मयेन वै शम्बरो युयुधे त्वष्ट्रा सवित्रा तु विरोचनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-030",
    "skandha": 8,
    "chapter": 10,
    "sloka": 30,
    "sanskrit": "अपराजितेन नमुचिरश्विनौ वृषपर्वणा सूर्यो बलिसुतैर्देवो बाणज्येष्ठैः शतेन च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-031",
    "skandha": 8,
    "chapter": 10,
    "sloka": 31,
    "sanskrit": "राहुणा च तथा सोमः पुलोम्ना युयुधेऽनिलः निशुम्भशुम्भयोर्देवी भद्रकाली तरस्विनी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-032",
    "skandha": 8,
    "chapter": 10,
    "sloka": 32,
    "sanskrit": "वृषाकपिस्तु जम्भेन महिषेण विभावसुः इल्वलः सह वातापिर्ब्रह्मपुत्रैररिन्दम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-033",
    "skandha": 8,
    "chapter": 10,
    "sloka": 33,
    "sanskrit": "कामदेवेन दुर्मर्ष उत्कलो मातृभिः सह बृहस्पतिश्चोशनसा नरकेण शनैश्चरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-034",
    "skandha": 8,
    "chapter": 10,
    "sloka": 34,
    "sanskrit": "मरुतो निवातकवचैः कालेयैर्वसवोऽमराः विश्वेदेवास्तु पौलोमै रुद्राः क्रोधवशैः सह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-035",
    "skandha": 8,
    "chapter": 10,
    "sloka": 35,
    "sanskrit": "त एवमाजावसुराः सुरेन्द्रा द्वन्द्वेन संहत्य च युध्यमानाः अन्योन्यमासाद्य निजघ्नुरोजसा जिगीषवस्तीक्ष्णशरासितोमरैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-036",
    "skandha": 8,
    "chapter": 10,
    "sloka": 36,
    "sanskrit": "भुशुण्डिभिश्चक्रगदर्ष्टिपट्टिशैः शक्त्युल्मुकैः प्रासपरश्वधैरपि निस्त्रिंशभल्लैः परिघैः समुद्गरैः सभिन्दिपालैश्च शिरांसि चिच्छिदुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-037",
    "skandha": 8,
    "chapter": 10,
    "sloka": 37,
    "sanskrit": "गजास्तुरङ्गाः सरथाः पदातयः सारोहवाहा विविधा विखण्डिताः निकृत्तबाहूरुशिरोधराङ्घ्रयश्छिन्नध्वजेष्वासतनुत्रभूषणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-038",
    "skandha": 8,
    "chapter": 10,
    "sloka": 38,
    "sanskrit": "तेषां पदाघातरथाङ्गचूर्णितादायोधनादुल्बण उत्थितस्तदा रेणुर्दिशः खं द्युमणिं च छादयन्न्यवर्ततासृक्स्रुतिभिः परिप्लुतात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-039",
    "skandha": 8,
    "chapter": 10,
    "sloka": 39,
    "sanskrit": "शिरोभिरुद्धूतकिरीटकुण्डलैः संरम्भदृग्भिः परिदष्टदच्छदैः महाभुजैः साभरणैः सहायुधैः सा प्रास्तृता भूः करभोरुभिर्बभौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-040",
    "skandha": 8,
    "chapter": 10,
    "sloka": 40,
    "sanskrit": "कबन्धास्तत्र चोत्पेतुः पतितस्वशिरोऽक्षिभिः उद्यतायुधदोर्दण्डैराधावन्तो भटान्मृधे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-041",
    "skandha": 8,
    "chapter": 10,
    "sloka": 41,
    "sanskrit": "बलिर्महेन्द्रं दशभिस्त्रिभिरैरावतं शरैः चतुर्भिश्चतुरो वाहानेकेनारोहमार्च्छयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-042",
    "skandha": 8,
    "chapter": 10,
    "sloka": 42,
    "sanskrit": "स तानापततः शक्रस्तावद्भिः शीघ्रविक्रमः चिच्छेद निशितैर्भल्लैरसम्प्राप्तान्हसन्निव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-043",
    "skandha": 8,
    "chapter": 10,
    "sloka": 43,
    "sanskrit": "तस्य कर्मोत्तमं वीक्ष्य दुर्मर्षः शक्तिमाददे तां ज्वलन्तीं महोल्काभां हस्तस्थामच्छिनद्धरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-08-chapter-10-sloka-044",
    "skandha": 8,
    "chapter": 10,
    "sloka": 44,
