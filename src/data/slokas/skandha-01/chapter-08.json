[
  {
    "id": "skandha-01-chapter-08-sloka-001",
    "skandha": 1,
    "chapter": 8,
    "sloka": 1,
    "malayalamMeaning": "അശ്വത്ഥാമാവ് പാണ്ഡവവംശത്തെ മുടിക്കാൻ ഉത്തരാഗർഭത്തിലേക്ക് ബ്രഹ്മാസ്ത്രം പ്രയോഗിച്ചപ്പോൾ, ഗർഭസ്ഥശിശുവായ പരീക്ഷിത്തിനെ രക്ഷിക്കാനായി ഉത്തര ശ്രീകൃഷ്ണനെ ശരണം പ്രാപിച്ചു.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-08-sloka-002",
    "skandha": 1,
    "chapter": 8,
    "sloka": 2,
    "malayalamMeaning": "ഭഗവാൻ ശ്രീകൃഷ്ണൻ തന്റെ സുദർശനചക്രം കൊണ്ട് ഉത്തരാഗർഭത്തിൽ പ്രവേശിച്ച് ആ ശിശുവിനെ സംരക്ഷിച്ചു.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-08-sloka-003",
    "skandha": 1,
    "chapter": 8,
    "sloka": 3,
    "malayalamMeaning": "തുടർന്ന് കുന്തീദേവി ഭഗവാനെ സ്തുതിച്ചു: 'മായാവനികയാൽ മറയ്ക്കപ്പെട്ടവനും ഇന്ദ്രിയങ്ങൾക്ക് അഗോചരനുമായ പരമപുരുഷനെ ഞാൻ പ്രണമിക്കുന്നു. വിപത്തുകൾ വരുമ്പോഴാണ് ഞങ്ങൾ അങ്ങയെ കൂടുതൽ സ്മരിക്കുന്നത്; അതിനാൽ സദാ അങ്ങയെ സ്മരിക്കാൻ ഞങ്ങൾക്ക് വീണ്ടും വീണ്ടും വിപത്തുകൾ തന്നെ ഉണ്ടാകട്ടെ!'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-08-sloka-004",
    "skandha": 1,
    "chapter": 8,
    "sloka": 4,
    "malayalamMeaning": "'അകിഞ്ചനന്മാരുടെ (ലൗകിക ധനമില്ലാത്തവരുടെ) ധനമാണ് അവിടുന്ന്. ഐശ്വര്യമദമുള്ളവർക്ക് അങ്ങയുടെ നാമം ഉച്ചരിക്കാൻ കഴിയില്ല. ഗംഗ സമുദ്രത്തിലേക്കെന്നപോലെ എന്റെ മനസ്സ് സദാ അങ്ങയുടെ പാദാരവിന്ദങ്ങളിൽ ഒഴുകിയെത്തുമാറാകട്ടെ!'",
    "source": "Sanskrit Documents / Gitapress"
  },
