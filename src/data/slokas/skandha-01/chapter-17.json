[
  {
    "id": "skandha-01-chapter-17-sloka-001",
    "skandha": 1,
    "chapter": 17,
    "sloka": 1,
    "malayalamMeaning": "രാജവേഷം ധരിച്ച കലി ആ പശുവിനെയും കാളയെയും ക്രൂരമായി അടിക്കുന്നത് കണ്ട പരീക്ഷിത്ത് കോപത്തോടെ വാളൂരി.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-17-sloka-002",
    "skandha": 1,
    "chapter": 17,
    "sloka": 2,
    "malayalamMeaning": "രാജാവിന്റെ ക്രോധം കണ്ട് ഭയന്ന കലി കിരീടം അഴിച്ചുവെച്ച് പരീക്ഷിത്തിന്റെ പാദങ്ങളിൽ വീണ് അഭയം യാചിച്ചു.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-17-sloka-003",
    "skandha": 1,
    "chapter": 17,
    "sloka": 3,
    "malayalamMeaning": "ശരണാഗതനായ കലിയെ വധിക്കാതെ, അവന് വസിക്കാനായി നാല് ഇടങ്ങൾ രാജാവ് അനുവദിച്ചുകൊടുത്തു: ചൂതാട്ടം, മദ്യപാനം, സ്ത്രീലോലുപത, ഹിംസ എന്നിവ നടക്കുന്ന സ്ഥലങ്ങൾ. കൂടാതെ ഇവയുടെയെല്ലാം ഇരിപ്പിടമായ 'സ്വർണ്ണം' (അന്യായമായ ധനം) ഉള്ളിടത്തും വസിക്കാൻ അനുമതി നൽകി.",
    "source": "Sanskrit Documents / Gitapress"
  },
