[
  {
    "id": "skandha-01-chapter-06-sloka-001",
    "skandha": 1,
    "chapter": 6,
    "sloka": 1,
    "malayalamMeaning": "വ്യാസന്റെ ചോദ്യത്തിന് ഉത്തരമായി നാരദൻ തന്റെ പൂർവ്വജന്മകഥ വിവരിച്ചു: 'കഴിഞ്ഞ കല്പത്തിൽ ഞാൻ ഒരു ദാസിയുടെ പുത്രനായി ജനിച്ചു. ചാതുർമ്മാസ്യവ്രതം അനുഷ്ഠിക്കാൻ വന്ന ഭക്തന്മാരായ ബ്രാഹ്മണരെ ശുശ്രൂഷിക്കാൻ എനിക്ക് അവസരം ലഭിച്ചു.'",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-06-sloka-002",
    "skandha": 1,
    "chapter": 6,
    "sloka": 2,
    "malayalamMeaning": "'അവരുടെ ഭഗവദ്കഥാശ്രവണവും ഉച്ചിഷ്ടഭക്ഷണവും വഴി എന്റെ ഹൃദയത്തിലെ സകല പാപങ്ങളും നശിക്കുകയും ഭഗവാനിൽ അനന്യമായ ഭക്തി ജനിക്കുകയും ചെയ്തു.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-06-sloka-003",
    "skandha": 1,
    "chapter": 6,
    "sloka": 3,
    "malayalamMeaning": "'മാതാവിന്റെ നിര്യാണശേഷം വനത്തിൽ ചെന്ന് തപസ്സുചെയ്ത എനിക്ക് ഭഗവാന്റെ ക്ഷണികമായ ഒരു ദിവ്യദർശനം ലഭിച്ചു. അടുത്ത ജന്മത്തിൽ അങ്ങേക്ക് എന്റെ നിത്യപാർഷദനാകാം എന്ന് ഭഗവാൻ അരുളിച്ചെയ്തു. അങ്ങനെ ഈ ജന്മത്തിൽ ഞാൻ ബ്രഹ്മപുത്രനായ ദേവർഷി നാരദനായി അവതരിച്ചു.'",
    "source": "Sanskrit Documents / Gitapress"
  },
