[
  {
    "id": "skandha-01-chapter-09-sloka-001",
    "skandha": 1,
    "chapter": 9,
    "sloka": 1,
    "malayalamMeaning": "ശരശയ്യയിൽ കിടക്കുന്ന പിതാമഹനായ ഭീഷ്മരെ സന്ദർശിക്കാൻ ധർമ്മപുത്രരും ശ്രീകൃഷ്ണനും മഹർഷിമാരും കുരുക്ഷേത്രഭൂമിയിൽ എത്തിച്ചേർന്നു.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-09-sloka-002",
    "skandha": 1,
    "chapter": 9,
    "sloka": 2,
    "malayalamMeaning": "ഭീഷ്മർ യുധിഷ്ഠിരന് സർവ്വ രാജധർമ്മങ്ങളും മോക്ഷധർമ്മങ്ങളും ഉപദേശിച്ചു നൽകി.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-09-sloka-003",
    "skandha": 1,
    "chapter": 9,
    "sloka": 3,
    "malayalamMeaning": "സൂര്യന്റെ ഉത്തരായനപുണ്യകാലത്ത് തന്റെ മുന്നിൽ നിൽക്കുന്ന ചതുർഭുജനായ ശ്രീകൃഷ്ണഭഗവാനിൽ ദൃഷ്ടിയുറപ്പിച്ച് ഭീഷ്മർ സ്തുതിച്ചു: 'യുദ്ധരംഗത്ത് പൊടിപടലങ്ങളേറ്റ് തിളങ്ങുന്ന ചുരുണ്ട അളകഭാരത്തോടും, പാർത്ഥന്റെ സാരഥിയായി ചമ്മട്ടിയേന്തി നിന്ന ആ മനോഹരരൂപത്തിലും എന്റെ മനസ്സ് ലയിക്കട്ടെ!'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-09-sloka-004",
    "skandha": 1,
    "chapter": 9,
    "sloka": 4,
    "malayalamMeaning": "ഭഗവാന്റെ ദിവ്യരൂപത്തിൽ പൂർണ്ണമായി മനസ്സ് സമർപ്പിച്ച് ഭീഷ്മർ തന്റെ പ്രാണനെ പരബ്രഹ്മത്തിൽ ലയിപ്പിച്ചു. ആകാശത്തുനിന്ന് ദേവന്മാർ പുഷ്പവൃഷ്ടി ചൊരിഞ്ഞു.",
    "source": "Sanskrit Documents / Gitapress"
  },
