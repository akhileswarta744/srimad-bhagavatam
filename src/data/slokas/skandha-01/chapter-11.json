[
  {
    "id": "skandha-01-chapter-11-sloka-001",
    "skandha": 1,
    "chapter": 11,
    "sloka": 1,
    "malayalamMeaning": "ഭഗവാൻ ശ്രീകൃഷ്ണൻ തന്റെ സ്വന്തം നഗരമായ ആനന്ദസമ്പന്നമായ ദ്വാരകയിൽ എത്തിച്ചേർന്നു. പാഞ്ചജന്യമെന്ന തന്റെ ശംഖ് മുഴക്കിക്കൊണ്ട് ഭഗവാൻ ആഗമനം അറിയിച്ചു.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-11-sloka-002",
    "skandha": 1,
    "chapter": 11,
    "sloka": 2,
    "malayalamMeaning": "ശംഖനാദം കേട്ട് ദ്വാരകാവാസികൾ അതീവ ആനന്ദത്തോടെ ഭഗവാനെ എതിരേൽക്കാൻ ഓടിയെത്തി. പുഷ്പതോരണങ്ങളാലും കൊടിതോരണങ്ങളാലും നഗരം അലങ്കരിക്കപ്പെട്ടു.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-11-sloka-003",
    "skandha": 1,
    "chapter": 11,
    "sloka": 3,
    "malayalamMeaning": "മാതാപിതാക്കളായ വസുദേവ-ദേവകിമാരെയും മുതിർന്നവരെയും വന്ദിച്ച ഭഗവാൻ തന്റെ പതിനാറായിരത്തോളം വരുന്ന അരമനകളിലേക്ക് പ്രവേശിച്ചു.",
    "source": "Sanskrit Documents / Gitapress"
  },
