[
  {
    "id": "skandha-01-chapter-10-sloka-001",
    "skandha": 1,
    "chapter": 10,
    "sloka": 1,
    "malayalamMeaning": "പാണ്ഡവരെ സാന്ത്വനിപ്പിച്ച് യുധിഷ്ഠിരനെ ധർമ്മരാജ്യത്തിന്റെ സിംഹാസനത്തിൽ ഇരുത്തിയ ശേഷം, ഭഗവാൻ ശ്രീകൃഷ്ണൻ ദ്വാരകയിലേക്ക് മടങ്ങാൻ ഒരുങ്ങി.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "ശൗനകാദി മുനിമാർ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-10-sloka-002",
    "skandha": 1,
    "chapter": 10,
    "sloka": 2,
    "malayalamMeaning": "ഭഗവാന്റെ വിരഹം താങ്ങാനാവാതെ പാണ്ഡവരും കുന്തീദേവിയും പൗരജനങ്ങളും കണ്ണീരോടെ ഭഗവാന്റെ രഥത്തിന് പിന്നാലെ യാത്രയായി.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-10-sloka-003",
    "skandha": 1,
    "chapter": 10,
    "sloka": 3,
    "malayalamMeaning": "ഹസ്തിനപുരത്തിലെ സ്ത്രീകൾ മണിമാളികകളിൽ കയറിനിന്ന് ഭഗവാന്റെ ദിവ്യരൂപത്തെ വാഴ്ത്തുകയും പുഷ്പവൃഷ്ടി ചൊരിയുകയും ചെയ്തു.",
    "source": "Sanskrit Documents / Gitapress"
  },
