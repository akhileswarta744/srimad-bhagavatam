[
  {
    "id": "skandha-01-chapter-15-sloka-001",
    "skandha": 1,
    "chapter": 15,
    "sloka": 1,
    "malayalamMeaning": "ദ്വാരകയിൽ നിന്ന് മടങ്ങിയെത്തിയ അർജ്ജുനൻ കണ്ണീരോടെ തലകുനിച്ചുനിന്നു. ശ്രീകൃഷ്ണവിരഹത്താൽ അദ്ദേഹത്തിന്റെ മുഖം വാടിയിരുന്നു.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-15-sloka-002",
    "skandha": 1,
    "chapter": 15,
    "sloka": 2,
    "malayalamMeaning": "അർജ്ജുനൻ പറഞ്ഞു: 'എന്റെ സഖാവും സർവ്വസ്വവുമായ ഭഗവാൻ എന്നെ വിട്ടുപിരിഞ്ഞു. അവിടുത്തെ കൃപകൊണ്ടുമാത്രം ഞാൻ ജയിച്ച ഗാണ്ഡീവവും അസ്ത്രങ്ങളും ഇപ്പോൾ ഭഗവാനില്ലാത്തതിനാൽ നിർജ്ജീവമായിത്തീർന്നിരിക്കുന്നു.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-15-sloka-003",
    "skandha": 1,
    "chapter": 15,
    "sloka": 3,
    "malayalamMeaning": "ഭഗവാന്റെ തിരോധാനം ഉറപ്പായപ്പോൾ, പാണ്ഡവർ പരീക്ഷിത്തിനെ ഹസ്തിനപുരത്തിന്റെ ചക്രവർത്തിയായും വജ്രനെ മഥുരയുടെ രാജാവായും വാഴിച്ചു.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-15-sloka-004",
    "skandha": 1,
    "chapter": 15,
    "sloka": 4,
    "malayalamMeaning": "പാണ്ഡവരും ദ്രൗപദിയും സകല രാജ്യഭോഗങ്ങളും പരിത്യജിച്ച്, ഈശ്വരധ്യാനത്തിൽ മനസ്സ് അർപ്പിച്ച് ഉത്തരദിക്കിലേക്ക് മഹാപ്രസ്ഥാനം ചെയ്തു.",
    "source": "Sanskrit Documents / Gitapress"
  },
