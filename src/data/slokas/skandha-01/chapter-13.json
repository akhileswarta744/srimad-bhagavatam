[
  {
    "id": "skandha-01-chapter-13-sloka-001",
    "skandha": 1,
    "chapter": 13,
    "sloka": 1,
    "malayalamMeaning": "തീർത്ഥയാത്രകൾ കഴിഞ്ഞ് ആത്മജ്ഞാനിയായ വിദുരർ ഹസ്തിനപുരത്തിൽ തിരിച്ചെത്തി.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-13-sloka-002",
    "skandha": 1,
    "chapter": 13,
    "sloka": 2,
    "malayalamMeaning": "തന്റെ ജ്യേഷ്ഠനായ ധൃതരാഷ്ട്രർ വാർദ്ധക്യത്തിലും ഭീമസേനൻ നൽകുന്ന അന്നം കഴിഞ്ഞ് ആസക്തിയോടെ കഴിയുന്നത് കണ്ട് വിദുരർ അദ്ദേഹത്തെ ഉദ്ബോധിപ്പിച്ചു: 'ഹേ രാജാവേ, കാലം അങ്ങയുടെ ജീവനെ കാർന്നുതിന്നുന്നു. ഇനിയും ലൗകികസുഖങ്ങളിൽ ഭ്രമിക്കാതെ ഈ ശരീരം ഈശ്വരചിന്തയിൽ ഉപേക്ഷിക്കൂ.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-13-sloka-003",
    "skandha": 1,
    "chapter": 13,
    "sloka": 3,
    "malayalamMeaning": "വിദുരരുടെ ജ്ഞാനോപദേശം കേട്ട് വൈരാഗ്യം പൂണ്ട ധൃതരാഷ്ട്രരും ഗാന്ധാരിയും ആരുമറിയാതെ അന്നുരാത്രിതന്നെ ഹിമാലയത്തിലേക്ക് തപസ്സിനായി യാത്രയായി.",
    "source": "Sanskrit Documents / Gitapress"
  },
