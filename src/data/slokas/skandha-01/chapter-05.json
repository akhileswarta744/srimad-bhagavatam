[
  {
    "id": "skandha-01-chapter-05-sloka-001",
    "skandha": 1,
    "chapter": 5,
    "sloka": 1,
    "malayalamMeaning": "നാരദൻ ചോദിച്ചു: 'ഹേ മഹാഭാഗ്യവാനായ വ്യാസാ! അങ്ങ് വേദങ്ങളും മഹാഭാരതവും രചിച്ചുവെങ്കിലും അങ്ങയുടെ ഹൃദയം അസന്തുഷ്ടമായിരിക്കുന്നത് എന്തുകൊണ്ടാണ്?'",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-05-sloka-002",
    "skandha": 1,
    "chapter": 5,
    "sloka": 2,
    "malayalamMeaning": "വ്യാസൻ പറഞ്ഞു: 'അങ്ങു പറഞ്ഞത് സത്യമാണ്. എന്റെ മനസ്സിന് എന്തുകൊണ്ടാണ് ശാന്തി ലഭിക്കാത്തതെന്ന് സർവ്വജ്ഞനായ അങ്ങ് എനിക്ക് ഉപദേശിച്ചുതന്നാലും.'",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "നാരദൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-05-sloka-003",
    "skandha": 1,
    "chapter": 5,
    "sloka": 3,
    "malayalamMeaning": "നാരദൻ ഉപദേശിച്ചു: 'അങ്ങ് ധർമ്മാർത്ഥകാമങ്ങളെക്കുറിച്ച് വിസ്തരിച്ചു പറഞ്ഞു എങ്കിലും, ഭഗവാൻ ശ്രീകൃഷ്ണന്റെ നിർമ്മലമായ മാഹാത്മ്യത്തെയും ലീലകളെയും പൂർണ്ണമായി വർണ്ണിച്ചില്ല. ഭഗവത്കീർത്തനമില്ലാത്ത വാക്യങ്ങൾ കാക്കകൾ വസിക്കുന്ന അഴുക്കുചാലുപോലെയാണ്; എന്നാൽ ഭഗവദ്ഗുണങ്ങൾ നിറഞ്ഞ വാക്കുകൾ സർവ്വപാപങ്ങളെയും ദൂരീകരിക്കുന്നു.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-05-sloka-004",
    "skandha": 1,
    "chapter": 5,
    "sloka": 4,
    "malayalamMeaning": "'അതുകൊണ്ട് സമാധിയിലൂടെ ഭഗവാന്റെ ലീലാചരിതങ്ങളെ പൂർണ്ണമായി ധ്യാനിച്ച് ഈ ലോകത്തിന് ശാന്തി നൽകുന്ന ശ്രീമദ് ഭാഗവതം രചിച്ചാലും.'",
    "source": "Sanskrit Documents / Gitapress"
  },
