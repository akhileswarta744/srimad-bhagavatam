[
  {
    "id": "skandha-01-chapter-18-sloka-001",
    "skandha": 1,
    "chapter": 18,
    "sloka": 1,
    "malayalamMeaning": "ഒരിക്കൽ നായാട്ടു കഴിഞ്ഞ് ദാഹിച്ചു വലഞ്ഞ പരീക്ഷിത്ത് ശമീകമുനിയുടെ ആശ്രമത്തിൽ എത്തി. ധ്യാനനിമഗ്നനായിരുന്ന മുനി രാജാവിന്റെ സാന്നിധ്യം അറിഞ്ഞില്ല.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-18-sloka-002",
    "skandha": 1,
    "chapter": 18,
    "sloka": 2,
    "malayalamMeaning": "ദാഹത്താലും വിശപ്പാലും കലിയുടെ പ്രേരണയാലും നിയന്ത്രണം നഷ്ടപ്പെട്ട രാജാവ് സമീപത്തു കിടന്ന ഒരു ചത്ത പാമ്പിനെ വില്ലിൻതുമ്പുകൊണ്ട് എടുത്ത് മുനിയുടെ കഴുത്തിലിട്ടു.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-18-sloka-003",
    "skandha": 1,
    "chapter": 18,
    "sloka": 3,
    "malayalamMeaning": "ഇതറിഞ്ഞ് കോപിഷ്ഠനായ ശമീകപുത്രൻ ശൃംഗി കൗശികീനദീജലം തൊട്ട് ശപിച്ചു: 'എന്റെ പിതാവിനെ അപമാനിച്ച ആ ദുഷ്ടരാജാവ് ഇന്നേക്ക് ഏഴാം നാൾ തക്ഷകൻ എന്ന സർപ്പത്തിന്റെ ദംശനമേറ്റ് മരിക്കട്ടെ!'",
    "source": "Sanskrit Documents / Gitapress"
  },
