[
  {
    "id": "skandha-01-chapter-14-sloka-001",
    "skandha": 1,
    "chapter": 14,
    "sloka": 1,
    "malayalamMeaning": "ദ്വാരകയിലെ വിശേഷങ്ങൾ അറിയാൻ പോയ അർജ്ജുനൻ മാസങ്ങൾ കഴിഞ്ഞിട്ടും തിരിച്ചെത്താതിരുന്നപ്പോൾ യുധിഷ്ഠിരൻ അത്യന്തം വ്യാകുലനായി.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-14-sloka-002",
    "skandha": 1,
    "chapter": 14,
    "sloka": 2,
    "malayalamMeaning": "പ്രകൃതിയിൽ അശുഭകരമായ ദുർന്നിമിത്തങ്ങൾ കണ്ടുതുടങ്ങി: ഇടതുകണ്ണും ഇടതുകൈയും വിറയ്ക്കുന്നു, നക്ഷത്രങ്ങൾ പകൽപോലും വീഴുന്നു, മൃഗങ്ങൾ ഭയന്നു നിലവിളിക്കുന്നു.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-14-sloka-003",
    "skandha": 1,
    "chapter": 14,
    "sloka": 3,
    "malayalamMeaning": "യുധിഷ്ഠിരൻ ഭീമനോട് പറഞ്ഞു: 'ഭഗവാൻ ശ്രീകൃഷ്ണൻ തന്റെ ഭൂലോകലീലകൾ അവസാനിപ്പിച്ച് സ്വധാമത്തിലേക്ക് മടങ്ങിയോ എന്ന് ഞാൻ ഭയപ്പെടുന്നു.'",
    "source": "Sanskrit Documents / Gitapress"
  },
