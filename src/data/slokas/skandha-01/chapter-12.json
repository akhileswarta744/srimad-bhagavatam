[
  {
    "id": "skandha-01-chapter-12-sloka-001",
    "skandha": 1,
    "chapter": 12,
    "sloka": 1,
    "malayalamMeaning": "ശൗനകൻ ചോദിച്ചു: 'ഗർഭത്തിലിരിക്കുമ്പോൾത്തന്നെ ശ്രീകൃഷ്ണനാൽ രക്ഷിക്കപ്പെട്ട ആ പരീക്ഷിത്ത് മഹാരാജാവിന്റെ ജനനവും ഗുണങ്ങളും എന്തെല്ലാമായിരുന്നു?'",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "ശൗനകാദി മുനിമാർ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-12-sloka-002",
    "skandha": 1,
    "chapter": 12,
    "sloka": 2,
    "malayalamMeaning": "സൂതൻ പറഞ്ഞു: 'ഗർഭത്തിൽ കത്തുന്ന അഗ്നിയെക്കണ്ട് ഭയന്ന ശിശു, തന്റെ മുൻപിൽ പീതാംബരം ധരിച്ച് ചതുർഭുജനായി ഗദാധാരിയായി നിന്ന ഭഗവാനെ ദർശിച്ചു. ആ രൂപം അവന്റെ ഹൃദയത്തിൽ മായാതെ നിന്നു.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-12-sloka-003",
    "skandha": 1,
    "chapter": 12,
    "sloka": 3,
    "malayalamMeaning": "ജനിച്ചശേഷം താൻ ഗർഭത്തിൽ കണ്ട ആ പരമപുരുഷനെ സകല മനുഷ്യരിലും പരീക്ഷിച്ചു നോക്കിയതുകൊണ്ടാണ് ആ കുമാരന് 'പരീക്ഷിത്ത്' എന്ന് പേരുണ്ടായത്.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-12-sloka-004",
    "skandha": 1,
    "chapter": 12,
    "sloka": 4,
    "malayalamMeaning": "ജ്യോതിഷികൾ പ്രവചിച്ചു: 'ഈ കുമാരൻ ഇക്ഷ്വാകുവിനെപ്പോലെ പ്രജാവാത്സല്യമുള്ളവനും, ശ്രീരാമനെപ്പോലെ സത്യസന്ധനും, ശിബിയെപ്പോലെ ത്യാഗിയും, വ്യാസപുത്രനായ ശുകദേവനിൽ നിന്ന് ആത്മജ്ഞാനം നേടി ഗംഗാതീരത്ത് മോക്ഷം പ്രാപിക്കുന്നവനുമായിത്തീരും.'",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
