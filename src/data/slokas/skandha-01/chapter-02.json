[
  {
    "id": "skandha-01-chapter-02-sloka-001",
    "skandha": 1,
    "chapter": 2,
    "sloka": 1,
    "malayalamMeaning": "വ്യാസപുത്രനായ ശ്രീ ശുകബ്രഹ്മർഷി ഉപനയനാദി സംസ്കാരങ്ങളൊന്നും കൂടാതെ ഏകാകിയായി സന്യസിച്ചു പോകുമ്പോൾ, പുത്രവിരഹത്താൽ 'ഹാ പുത്രാ!' എന്ന് വ്യാസൻ വിലപിച്ചു വിളിച്ചപ്പോൾ, വൃക്ഷങ്ങളും പർവ്വതങ്ങളും സർവ്വചരാചരങ്ങളും പ്രതിധ്വനികളിലൂടെ ഉത്തരം നൽകി. അങ്ങനെയുള്ള സർവ്വഭൂതാത്മകനായ ആ ശുകമുനിയെ ഞാൻ പ്രണമിക്കുന്നു.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-02-sloka-002",
    "skandha": 1,
    "chapter": 2,
    "sloka": 2,
    "malayalamMeaning": "സംസാരസാഗരത്തിൽ വീണുഴലുന്ന ജീവന്മാർക്ക് അജ്ഞാനമാകുന്ന അന്ധകാരത്തെ നീക്കുവാനായി, സകല വേദങ്ങളുടെയും ഉപനിഷത്തുകളുടെയും രഹസ്യസാരമെടുത്ത് അത്യന്തം ദിവ്യമായ ഈ ഭാഗവതപുരാണം ഉപദേശിച്ച പരമഹംസ ഗുരുവായ ശുകദേവനെ ഞാൻ സദാ വണങ്ങുന്നു.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-02-sloka-003",
    "skandha": 1,
    "chapter": 2,
    "sloka": 3,
    "malayalamMeaning": "നരനാരായണന്മാരെയും സരസ്വതീദേവിയെയും വ്യാസഭഗവാനെയും വണങ്ങിയിട്ട് വേണം ജയമെന്ന ഈ ഇതിഹാസപുരാണം പാരായണം ചെയ്യുവാൻ.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-02-sloka-004",
    "skandha": 1,
    "chapter": 2,
    "sloka": 4,
    "malayalamMeaning": "സൂതൻ പറഞ്ഞു: 'ഹേ മുനിശ്രേഷ്ഠന്മാരേ! ലോകമംഗളത്തിനായി നിങ്ങൾ എന്നോട് ചോദിച്ച ഈ ചോദ്യങ്ങൾ അത്യന്തം ശ്ലാഘനീയമാണ്. എന്തുകൊണ്ടെന്നാൽ കൃഷ്ണകഥാശ്രവണം മനുഷ്യന്റെ മനസ്സിനെ പൂർണ്ണമായും പരിശുദ്ധമാക്കുന്നു.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-02-sloka-005",
    "skandha": 1,
    "chapter": 2,
    "sloka": 5,
    "malayalamMeaning": "'ഏതൊരു ധർമ്മാനുഷ്ഠാനത്താലാണോ അധോക്ഷജനായ ഭഗവാനിൽ നിഷ്കാമവും അചഞ്ചലവുമായ ഭക്തി ഉളവാകുന്നത്, അതാണ് മനുഷ്യർക്ക് ഏറ്റവും ശ്രേഷ്ഠമായ പരമധർമ്മം. ആ ഭക്തിയാൽ മാത്രമേ ആത്മാവിന് ശാശ്വതമായ ശാന്തി ലഭിക്കുകയുള്ളൂ.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-02-sloka-006",
    "skandha": 1,
    "chapter": 2,
    "sloka": 6,
    "malayalamMeaning": "'ഭഗവാൻ വാസുദേവനിൽ ഭക്തിയോടെ സമർപ്പിക്കുന്ന സാധന പെട്ടെന്നുതന്നെ വൈരാഗ്യത്തെയും, ഫലേച്ഛയില്ലാത്ത ആത്മജ്ഞാനത്തെയും ഉളവാക്കുന്നു.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-02-sloka-007",
    "skandha": 1,
    "chapter": 2,
    "sloka": 7,
    "malayalamMeaning": "'വർണ്ണാശ്രമ ധർമ്മങ്ങൾ എത്ര ഭംഗിയായി അനുഷ്ഠിച്ചാലും, ഭഗവദ്കഥകളിൽ ഭക്തിയോ ശ്രദ്ധയോ ഉണ്ടാകുന്നില്ലെങ്കിൽ ആ കർമ്മങ്ങളെല്ലാം വെറും പാഴ്വേല മാത്രമായി അവശേഷിക്കുന്നു.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-02-sloka-008",
    "skandha": 1,
    "chapter": 2,
    "sloka": 8,
    "malayalamMeaning": "'ധർമ്മത്തിന്റെ യഥാർത്ഥ ഫലം മോക്ഷമാണ്, ലൗകിക സുഖങ്ങളല്ല. ലൗകിക സുഖങ്ങളുടെ ലക്ഷ്യം ജീവരക്ഷ മാത്രമാണ്, ഇന്ദ്രിയതൃപ്തിയല്ല. ജീവിതത്തിന്റെ ലക്ഷ്യം തത്ത്വജിജ്ഞാസയാണ്, കർമ്മഫലമല്ല.'",
    "source": "Sanskrit Documents / Gitapress"
  },
