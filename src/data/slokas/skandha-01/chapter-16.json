[
  {
    "id": "skandha-01-chapter-16-sloka-001",
    "skandha": 1,
    "chapter": 16,
    "sloka": 1,
    "malayalamMeaning": "പരീക്ഷിത്ത് മഹാരാജാവ് ധർമ്മിഷ്ഠനായി ഭൂമി ഭരിക്കുമ്പോൾ, കലിയുഗത്തിന്റെ പ്രഭാവം ലോകത്തിൽ പടരുന്നതായി അദ്ദേഹം കണ്ടു.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "സൂതൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-01-chapter-16-sloka-002",
    "skandha": 1,
    "chapter": 16,
    "sloka": 2,
    "malayalamMeaning": "ഒരു കാളയുടെ വേഷത്തിലുള്ള ധർമ്മദേവനും പശുവിന്റെ വേഷത്തിലുള്ള ഭൂമീദേവിയും തമ്മിൽ സംസാരിക്കുന്നത് രാജാവ് കണ്ടു. മൂന്ന് കാലുകളും നഷ്ടപ്പെട്ട് ഒറ്റക്കാലിൽ നിൽക്കുകയായിരുന്നു ധർമ്മം.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-01-chapter-16-sloka-003",
    "skandha": 1,
    "chapter": 16,
    "sloka": 3,
    "malayalamMeaning": "ഭൂമീദേവി കണ്ണീരോടെ വിലപിച്ചു: 'ഭഗവാൻ ശ്രീകൃഷ്ണൻ ഭൂമിയിലുണ്ടായിരുന്നപ്പോൾ സകല സൗഭാഗ്യങ്ങളും ഉണ്ടായിരുന്നു. അവിടുന്ന് സ്വധാമത്തിലേക്ക് മടങ്ങിയതോടെ കലിയുടെ അധർമ്മം എന്നെ വേട്ടയാടുന്നു.'",
    "source": "Sanskrit Documents / Gitapress"
  },
