[
  {
    "id": "skandha-07-chapter-14-sloka-001",
    "skandha": 7,
    "chapter": 14,
    "sloka": 1,
    "sanskrit": "गृहस्थ एतां पदवीं विधिना येन चाञ्जसा यायाद्देवऋषे ब्रूहि मादृशो गृहमूढधीः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीयुधिष्ठिर उवाच ।"
  },
  {
    "id": "skandha-07-chapter-14-sloka-002",
    "skandha": 7,
    "chapter": 14,
    "sloka": 2,
    "sanskrit": "गृहेष्ववस्थितो राजन्क्रियाः कुर्वन्यथोचिताः वासुदेवार्पणं साक्षादुपासीत महामुनीन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीनारद उवाच ।"
  },
  {
    "id": "skandha-07-chapter-14-sloka-003",
    "skandha": 7,
    "chapter": 14,
    "sloka": 3,
    "sanskrit": "शृण्वन्भगवतोऽभीक्ष्णमवतारकथामृतम् श्रद्दधानो यथाकालमुपशान्तजनावृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-004",
    "skandha": 7,
    "chapter": 14,
    "sloka": 4,
    "sanskrit": "सत्सङ्गाच्छनकैः सङ्गमात्मजायात्मजादिषु विमुञ्चेन्मुच्यमानेषु स्वयं स्वप्नवदुत्थितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-005",
    "skandha": 7,
    "chapter": 14,
    "sloka": 5,
    "sanskrit": "यावदर्थमुपासीनो देहे गेहे च पण्डितः विरक्तो रक्तवत्तत्र नृलोके नरतां न्यसेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-006",
    "skandha": 7,
    "chapter": 14,
    "sloka": 6,
    "sanskrit": "ज्ञातयः पितरौ पुत्रा भ्रातरः सुहृदोऽपरे यद्वदन्ति यदिच्छन्ति चानुमोदेत निर्ममः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-007",
    "skandha": 7,
    "chapter": 14,
    "sloka": 7,
    "sanskrit": "दिव्यं भौमं चान्तरीक्षं वित्तमच्युतनिर्मितम् तत्सर्वमुपयुञ्जान एतत्कुर्यात्स्वतो बुधः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-008",
    "skandha": 7,
    "chapter": 14,
    "sloka": 8,
    "sanskrit": "यावद्भ्रियेत जठरं तावत्स्वत्वं हि देहिनाम् अधिकं योऽभिमन्येत स स्तेनो दण्डमर्हति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-009",
    "skandha": 7,
    "chapter": 14,
    "sloka": 9,
    "sanskrit": "मृगोष्ट्रखरमर्काखु सरीसृप्खगमक्षिकाः आत्मनः पुत्रवत्पश्येत्तैरेषामन्तरं कियत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-010",
    "skandha": 7,
    "chapter": 14,
    "sloka": 10,
    "sanskrit": "त्रिवर्गं नातिकृच्छ्रेण भजेत गृहमेध्यपि यथादेशं यथाकालं यावद्दैवोपपादितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-011",
    "skandha": 7,
    "chapter": 14,
    "sloka": 11,
    "sanskrit": "आश्वाघान्तेऽवसायिभ्यः कामान्संविभजेद्यथा अप्येकामात्मनो दारां नृणां स्वत्वग्रहो यतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-012",
    "skandha": 7,
    "chapter": 14,
    "sloka": 12,
    "sanskrit": "जह्याद्यदर्थे स्वान्प्राणान्हन्याद्वा पितरं गुरुम् तस्यां स्वत्वं स्त्रियां जह्याद्यस्तेन ह्यजितो जितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-013",
    "skandha": 7,
    "chapter": 14,
    "sloka": 13,
    "sanskrit": "कृमिविड्भस्मनिष्ठान्तं क्वेदं तुच्छं कलेवरम् क्व तदीयरतिर्भार्या क्वायमात्मा नभश्छदिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-014",
    "skandha": 7,
    "chapter": 14,
    "sloka": 14,
    "sanskrit": "सिद्धैर्यज्ञावशिष्टार्थैः कल्पयेद्वृत्तिमात्मनः शेषे स्वत्वं त्यजन्प्राज्ञः पदवीं महतामियात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-015",
    "skandha": 7,
    "chapter": 14,
    "sloka": 15,
    "sanskrit": "देवानृषीन्नृभूतानि पितॄनात्मानमन्वहम् स्ववृत्त्यागतवित्तेन यजेत पुरुषं पृथक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-016",
    "skandha": 7,
    "chapter": 14,
    "sloka": 16,
    "sanskrit": "यर्ह्यात्मनोऽधिकाराद्याः सर्वाः स्युर्यज्ञसम्पदः वैतानिकेन विधिना अग्निहोत्रादिना यजेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-017",
    "skandha": 7,
    "chapter": 14,
    "sloka": 17,
    "sanskrit": "न ह्यग्निमुखतोऽयं वै भगवान्सर्वयज्ञभुक् इज्येत हविषा राजन्यथा विप्रमुखे हुतैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-018",
    "skandha": 7,
    "chapter": 14,
    "sloka": 18,
    "sanskrit": "तस्माद्ब्राह्मणदेवेषु मर्त्यादिषु यथार्हतः तैस्तैः कामैर्यजस्वैनं क्षेत्रज्ञं ब्राह्मणाननु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-019",
    "skandha": 7,
    "chapter": 14,
    "sloka": 19,
    "sanskrit": "कुर्यादपरपक्षीयं मासि प्रौष्ठपदे द्विजः श्राद्धं पित्रोर्यथावित्तं तद्बन्धूनां च वित्तवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-020",
    "skandha": 7,
    "chapter": 14,
    "sloka": 20,
    "sanskrit": "अयने विषुवे कुर्याद्व्यतीपाते दिनक्षये चन्द्रादित्योपरागे च द्वादश्यां श्रवणेषु च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-021",
    "skandha": 7,
    "chapter": 14,
    "sloka": 21,
    "sanskrit": "तृतीयायां शुक्लपक्षे नवम्यामथ कार्तिके चतसृष्वप्यष्टकासु हेमन्ते शिशिरे तथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-022",
    "skandha": 7,
    "chapter": 14,
    "sloka": 22,
    "sanskrit": "माघे च सितसप्तम्यां मघाराकासमागमे राकया चानुमत्या च मासर्क्षाणि युतान्यपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-023",
    "skandha": 7,
    "chapter": 14,
    "sloka": 23,
    "sanskrit": "द्वादश्यामनुराधा स्याच्छ्रवणस्तिस्र उत्तराः तिसृष्वेकादशी वासु जन्मर्क्षश्रोणयोगयुक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-024",
    "skandha": 7,
    "chapter": 14,
    "sloka": 24,
    "sanskrit": "त एते श्रेयसः काला नॄणां श्रेयोविवर्धनाः कुर्यात्सर्वात्मनैतेषु श्रेयोऽमोघं तदायुषः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-025",
    "skandha": 7,
    "chapter": 14,
    "sloka": 25,
    "sanskrit": "एषु स्नानं जपो होमो व्रतं देवद्विजार्चनम् पितृदेवनृभूतेभ्यो यद्दत्तं तद्ध्यनश्वरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-026",
    "skandha": 7,
    "chapter": 14,
    "sloka": 26,
    "sanskrit": "संस्कारकालो जायाया अपत्यस्यात्मनस्तथा प्रेतसंस्था मृताहश्च कर्मण्यभ्युदये नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-027",
    "skandha": 7,
    "chapter": 14,
    "sloka": 27,
    "sanskrit": "अथ देशान्प्रवक्ष्यामि धर्मादिश्रेयावहान् स वै पुण्यतमो देशः सत्पात्रं यत्र लभ्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-028",
    "skandha": 7,
    "chapter": 14,
    "sloka": 28,
    "sanskrit": "बिम्बं भगवतो यत्र सर्वमेतच्चराचरम् यत्र ह ब्राह्मणकुलं तपोविद्यादयान्वितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-029",
    "skandha": 7,
    "chapter": 14,
    "sloka": 29,
    "sanskrit": "यत्र यत्र हरेरर्चा स देशः श्रेयसां पदम् यत्र गङ्गादयो नद्यः पुराणेषु च विश्रुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-030",
    "skandha": 7,
    "chapter": 14,
    "sloka": 30,
    "sanskrit": "सरांसि पुष्करादीनि क्षेत्राण्यर्हाश्रितान्युत कुरुक्षेत्रं गयशिरः प्रयागः पुलहाश्रमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-031",
    "skandha": 7,
    "chapter": 14,
    "sloka": 31,
    "sanskrit": "नैमिषं फाल्गुनं सेतुः प्रभासोऽथ कुशस्थली वाराणसी मधुपुरी पम्पा बिन्दुसरस्तथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-032",
    "skandha": 7,
    "chapter": 14,
    "sloka": 32,
    "sanskrit": "नारायणाश्रमो नन्दा सीतारामाश्रमादयः सर्वे कुलाचला राजन्महेन्द्रमलयादयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-033",
    "skandha": 7,
    "chapter": 14,
    "sloka": 33,
    "sanskrit": "एते पुण्यतमा देशा हरेरर्चाश्रिताश्च ये एतान्देशान्निषेवेत श्रेयस्कामो ह्यभीक्ष्णशः धर्मो ह्यत्रेहितः पुंसां सहस्राधिफलोदयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-034",
    "skandha": 7,
    "chapter": 14,
    "sloka": 34,
    "sanskrit": "पात्रं त्वत्र निरुक्तं वै कविभिः पात्रवित्तमैः हरिरेवैक उर्वीश यन्मयं वै चराचरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-035",
    "skandha": 7,
    "chapter": 14,
    "sloka": 35,
    "sanskrit": "देवर्ष्यर्हत्सु वै सत्सु तत्र ब्रह्मात्मजादिषु राजन्यदग्रपूजायां मतः पात्रतयाच्युतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-036",
    "skandha": 7,
    "chapter": 14,
    "sloka": 36,
    "sanskrit": "जीवराशिभिराकीर्ण अण्डकोशाङ्घ्रिपो महान् तन्मूलत्वादच्युतेज्या सर्वजीवात्मतर्पणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-037",
    "skandha": 7,
    "chapter": 14,
    "sloka": 37,
    "sanskrit": "पुराण्यनेन सृष्टानि नृतिर्यगृषिदेवताः शेते जीवेन रूपेण पुरेषु पुरुषो ह्यसौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-038",
    "skandha": 7,
    "chapter": 14,
    "sloka": 38,
    "sanskrit": "तेष्वेव भगवान्राजंस्तारतम्येन वर्तते तस्मात्पात्रं हि पुरुषो यावानात्मा यथेयते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-039",
    "skandha": 7,
    "chapter": 14,
    "sloka": 39,
    "sanskrit": "दृष्ट्वा तेषां मिथो नृणामवज्ञानात्मतां नृप त्रेतादिषु हरेरर्चा क्रियायै कविभिः कृता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-040",
    "skandha": 7,
    "chapter": 14,
    "sloka": 40,
    "sanskrit": "ततोऽर्चायां हरिं केचित्संश्रद्धाय सपर्यया उपासत उपास्तापि नार्थदा पुरुषद्विषाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-041",
    "skandha": 7,
    "chapter": 14,
    "sloka": 41,
    "sanskrit": "पुरुषेष्वपि राजेन्द्र सुपात्रं ब्राह्मणं विदुः तपसा विद्यया तुष्ट्या धत्ते वेदं हरेस्तनुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-14-sloka-042",
    "skandha": 7,
    "chapter": 14,
    "sloka": 42,
    "sanskrit": "नन्वस्य ब्राह्मणा राजन्कृष्णस्य जगदात्मनः पुनन्तः पादरजसा त्रिलोकीं दैवतं महत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]