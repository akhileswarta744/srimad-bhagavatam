[
  {
    "id": "skandha-07-chapter-12-sloka-001",
    "skandha": 7,
    "chapter": 12,
    "sloka": 1,
    "sanskrit": "ब्रह्मचारी गुरुकुले वसन्दान्तो गुरोर्हितम् आचरन्दासवन्नीचो गुरौ सुदृढसौहृदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीनारद उवाच ।"
  },
  {
    "id": "skandha-07-chapter-12-sloka-002",
    "skandha": 7,
    "chapter": 12,
    "sloka": 2,
    "sanskrit": "सायं प्रातरुपासीत गुर्वग्न्यर्कसुरोत्तमान् सन्ध्ये उभे च यतवाग्जपन्ब्रह्म समाहितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-003",
    "skandha": 7,
    "chapter": 12,
    "sloka": 3,
    "sanskrit": "छन्दांस्यधीयीत गुरोराहूतश्चेत्सुयन्त्रितः उपक्रमेऽवसाने च चरणौ शिरसा नमेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-004",
    "skandha": 7,
    "chapter": 12,
    "sloka": 4,
    "sanskrit": "मेखलाजिनवासांसि जटादण्डकमण्डलून् बिभृयादुपवीतं च दर्भपाणिर्यथोदितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-005",
    "skandha": 7,
    "chapter": 12,
    "sloka": 5,
    "sanskrit": "सायं प्रातश्चरेद्भैक्ष्यं गुरवे तन्निवेदयेत् भुञ्जीत यद्यनुज्ञातो नो चेदुपवसेत्क्वचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-006",
    "skandha": 7,
    "chapter": 12,
    "sloka": 6,
    "sanskrit": "सुशीलो मितभुग्दक्षः श्रद्दधानो जितेन्द्रियः यावदर्थं व्यवहरेत्स्त्रीषु स्त्रीनिर्जितेषु च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-007",
    "skandha": 7,
    "chapter": 12,
    "sloka": 7,
    "sanskrit": "वर्जयेत्प्रमदागाथामगृहस्थो बृहद्व्रतः इन्द्रियाणि प्रमाथीनि हरन्त्यपि यतेर्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-008",
    "skandha": 7,
    "chapter": 12,
    "sloka": 8,
    "sanskrit": "केशप्रसाधनोन्मर्द स्नपनाभ्यञ्जनादिकम् गुरुस्त्रीभिर्युवतिभिः कारयेन्नात्मनो युवा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-009",
    "skandha": 7,
    "chapter": 12,
    "sloka": 9,
    "sanskrit": "नन्वग्निः प्रमदा नाम घृतकुम्भसमः पुमान् सुतामपि रहो जह्यादन्यदा यावदर्थकृत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-010",
    "skandha": 7,
    "chapter": 12,
    "sloka": 10,
    "sanskrit": "कल्पयित्वात्मना यावदाभासमिदमीश्वरः द्वैतं तावन्न विरमेत्ततो ह्यस्य विपर्ययः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-011",
    "skandha": 7,
    "chapter": 12,
    "sloka": 11,
    "sanskrit": "एतत्सर्वं गृहस्थस्य समाम्नातं यतेरपि गुरुवृत्तिर्विकल्पेन गृहस्थस्यर्तुगामिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-012",
    "skandha": 7,
    "chapter": 12,
    "sloka": 12,
    "sanskrit": "अञ्जनाभ्यञ्जनोन्मर्द स्त्र्यवलेखामिषं मधु स्रग्गन्धलेपालङ्कारांस्त्यजेयुर्ये बृहद्व्रताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-013",
    "skandha": 7,
    "chapter": 12,
    "sloka": 13,
    "sanskrit": "उषित्वैवं गुरुकुले द्विजोऽधीत्यावबुध्य च त्रयीं साङ्गोपनिषदं यावदर्थं यथाबलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-014",
    "skandha": 7,
    "chapter": 12,
    "sloka": 14,
    "sanskrit": "दत्त्वा वरमनुज्ञातो गुरोः कामं यदीश्वरः गृहं वनं वा प्रविशेत्प्रव्रजेत्तत्र वा वसेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-015",
    "skandha": 7,
    "chapter": 12,
    "sloka": 15,
    "sanskrit": "अग्नौ गुरावात्मनि च सर्वभूतेष्वधोक्षजम् भूतैः स्वधामभिः पश्येदप्रविष्टं प्रविष्टवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-016",
    "skandha": 7,
    "chapter": 12,
    "sloka": 16,
    "sanskrit": "एवं विधो ब्रह्मचारी वानप्रस्थो यतिर्गृही चरन्विदितविज्ञानः परं ब्रह्माधिगच्छति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-017",
    "skandha": 7,
    "chapter": 12,
    "sloka": 17,
    "sanskrit": "वानप्रस्थस्य वक्ष्यामि नियमान्मुनिसम्मतान् यानास्थाय मुनिर्गच्छेदृषिलोकमुहाञ्जसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-018",
    "skandha": 7,
    "chapter": 12,
    "sloka": 18,
    "sanskrit": "न कृष्टपच्यमश्नीयादकृष्टं चाप्यकालतः अग्निपक्वमथामं वा अर्कपक्वमुताहरेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-019",
    "skandha": 7,
    "chapter": 12,
    "sloka": 19,
    "sanskrit": "वन्यैश्चरुपुरोडाशान्निर्वपेत्कालचोदितान् लब्धे नवे नवेऽन्नाद्ये पुराणं च परित्यजेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-020",
    "skandha": 7,
    "chapter": 12,
    "sloka": 20,
    "sanskrit": "अग्न्यर्थमेव शरणमुटजं वाद्रिकन्दरम् श्रयेत हिमवाय्वग्नि वर्षार्कातपषाट्स्वयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-021",
    "skandha": 7,
    "chapter": 12,
    "sloka": 21,
    "sanskrit": "केशरोमनखश्मश्रु मलानि जटिलो दधत् कमण्डल्वजिने दण्ड वल्कलाग्निपरिच्छदान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-022",
    "skandha": 7,
    "chapter": 12,
    "sloka": 22,
    "sanskrit": "चरेद्वने द्वादशाब्दानष्टौ वा चतुरो मुनिः द्वावेकं वा यथा बुद्धिर्न विपद्येत कृच्छ्रतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-023",
    "skandha": 7,
    "chapter": 12,
    "sloka": 23,
    "sanskrit": "यदाकल्पः स्वक्रियायां व्याधिभिर्जरयाथवा आन्वीक्षिक्यां वा विद्यायां कुर्यादनशनादिकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-024",
    "skandha": 7,
    "chapter": 12,
    "sloka": 24,
    "sanskrit": "आत्मन्यग्नीन्समारोप्य सन्न्यस्याहं ममात्मताम् कारणेषु न्यसेत्सम्यक्सङ्घातं तु यथार्हतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-025",
    "skandha": 7,
    "chapter": 12,
    "sloka": 25,
    "sanskrit": "खे खानि वायौ निश्वासांस्तेजःसूष्माणमात्मवान् अप्स्वसृक्ष्लेष्मपूयानि क्षितौ शेषं यथोद्भवम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-026",
    "skandha": 7,
    "chapter": 12,
    "sloka": 26,
    "sanskrit": "वाचमग्नौ सवक्तव्यामिन्द्रे शिल्पं करावपि पदानि गत्या वयसि रत्योपस्थं प्रजापतौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-027",
    "skandha": 7,
    "chapter": 12,
    "sloka": 27,
    "sanskrit": "मृत्यौ पायुं विसर्गं च यथास्थानं विनिर्दिशेत् दिक्षु श्रोत्रं सनादेन स्पर्शेनाध्यात्मनि त्वचम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-028",
    "skandha": 7,
    "chapter": 12,
    "sloka": 28,
    "sanskrit": "रूपाणि चक्षुषा राजञ्ज्योतिष्यभिनिवेशयेत् अप्सु प्रचेतसा जिह्वां घ्रेयैर्घ्राणं क्षितौ न्यसेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-029",
    "skandha": 7,
    "chapter": 12,
    "sloka": 29,
    "sanskrit": "मनो मनोरथैश्चन्द्रे बुद्धिं बोध्यैः कवौ परे कर्माण्यध्यात्मना रुद्रे यदहं ममताक्रिया सत्त्वेन चित्तं क्षेत्रज्ञे गुणैर्वैकारिकं परे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-030",
    "skandha": 7,
    "chapter": 12,
    "sloka": 30,
    "sanskrit": "अप्सु क्षितिमपो ज्योतिष्यदो वायौ नभस्यमुम् कूटस्थे तच्च महति तदव्यक्तेऽक्षरे च तत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-07-chapter-12-sloka-031",
    "skandha": 7,
    "chapter": 12,
    "sloka": 31,
    "sanskrit": "इत्यक्षरतयात्मानं चिन्मात्रमवशेषितम् ज्ञात्वाद्वयोऽथ विरमेद्दग्धयोनिरिवानलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]