[
  {
    "id": "skandha-05-chapter-05-sloka-001",
    "skandha": 5,
    "chapter": 5,
    "sloka": 1,
    "malayalamMeaning": "ഋഷഭദേവ ഭഗവാൻ പുത്രന്മാരോട് ഉപദേശിച്ചു: 'പ്രിയപുത്രന്മാരേ! മനുഷ്യശരീരം ലഭിച്ചത് മലം ഭക്ഷിക്കുന്ന പന്നികളെപ്പോലെ കേവലം ഇന്ദ്രിയസുഖങ്ങൾ അനുഭവിച്ചു തീർക്കാനല്ല; മറിച്ച് ദിവ്യമായ തപസ്സിലൂടെ മനസ്സ് ശുദ്ധീകരിച്ച് ശാശ്വതമായ ബ്രഹ്മാനന്ദം അനുഭവിക്കാനാണ്.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-05-chapter-05-sloka-002",
    "skandha": 5,
    "chapter": 5,
    "sloka": 2,
    "malayalamMeaning": "'മഹാത്മാക്കളെ സേവിക്കുന്നത് മോക്ഷത്തിന്റെ തുറന്ന കവാടമാണ്. എന്നാൽ വിഷയലമ്പടന്മാരുമായുള്ള സംസർഗ്ഗം സംസാരദുഃഖങ്ങളിലേക്കുള്ള അന്ധകാര വഴിയാണ്.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-05-chapter-05-sloka-003",
    "skandha": 5,
    "chapter": 5,
    "sloka": 3,
    "malayalamMeaning": "'ശാന്തചിത്തരും, സർവ്വഭൂതങ്ങളിലും സമഭാവമുള്ളവരും, ക്രോധമില്ലാത്തവരും, ഭഗവാനിൽ സമ്പൂർണ്ണമായി സമർപ്പിച്ചവരുമായ സജ്ജനങ്ങളാണ് യഥാർത്ഥ മഹാത്മാക്കൾ.'",
    "source": "Sanskrit Documents / Gitapress"
  },
