[
  {
    "id": "skandha-04-chapter-10-sloka-001",
    "skandha": 4,
    "chapter": 10,
    "sloka": 1,
    "sanskrit": "प्रजापतेर्दुहितरं शिशुमारस्य वै ध्रुवः उपयेमे भ्रमिं नाम तत्सुतौ कल्पवत्सरौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-04-chapter-10-sloka-002",
    "skandha": 4,
    "chapter": 10,
    "sloka": 2,
    "sanskrit": "इलायामपि भार्यायां वायोः पुत्र्यां महाबलः पुत्रमुत्कलनामानं योषिद्रत्नमजीजनत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-003",
    "skandha": 4,
    "chapter": 10,
    "sloka": 3,
    "sanskrit": "उत्तमस्त्वकृतोद्वाहो मृगयायां बलीयसा हतः पुण्यजनेनाद्रौ तन्मातास्य गतिं गता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-004",
    "skandha": 4,
    "chapter": 10,
    "sloka": 4,
    "sanskrit": "ध्रुवो भ्रातृवधं श्रुत्वा कोपामर्षशुचार्पितः जैत्रं स्यन्दनमास्थाय गतः पुण्यजनालयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-005",
    "skandha": 4,
    "chapter": 10,
    "sloka": 5,
    "sanskrit": "गत्वोदीचीं दिशं राजा रुद्रानुचरसेविताम् ददर्श हिमवद्द्रोण्यां पुरीं गुह्यकसङ्कुलाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-006",
    "skandha": 4,
    "chapter": 10,
    "sloka": 6,
    "sanskrit": "दध्मौ शङ्खं बृहद्बाहुः खं दिशश्चानुनादयन् येनोद्विग्नदृशः क्षत्तरुपदेव्योऽत्रसन्भृशम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-007",
    "skandha": 4,
    "chapter": 10,
    "sloka": 7,
    "sanskrit": "ततो निष्क्रम्य बलिन उपदेवमहाभटाः असहन्तस्तन्निनादमभिपेतुरुदायुधाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-008",
    "skandha": 4,
    "chapter": 10,
    "sloka": 8,
    "sanskrit": "स तानापततो वीर उग्रधन्वा महारथः एकैकं युगपत्सर्वानहन्बाणैस्त्रिभिस्त्रिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-009",
    "skandha": 4,
    "chapter": 10,
    "sloka": 9,
    "sanskrit": "ते वै ललाटलग्नैस्तैरिषुभिः सर्व एव हि मत्वा निरस्तमात्मानमाशंसन्कर्म तस्य तत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-010",
    "skandha": 4,
    "chapter": 10,
    "sloka": 10,
    "sanskrit": "तेऽपि चामुममृष्यन्तः पादस्पर्शमिवोरगाः शरैरविध्यन्युगपद्द्विगुणं प्रचिकीर्षवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-011",
    "skandha": 4,
    "chapter": 10,
    "sloka": 11,
    "sanskrit": "ततः परिघनिस्त्रिंशैः प्रासशूलपरश्वधैः शक्त्यृष्टिभिर्भुशुण्डीभिश्चित्रवाजैः शरैरपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-012",
    "skandha": 4,
    "chapter": 10,
    "sloka": 12,
    "sanskrit": "अभ्यवर्षन्प्रकुपिताः सरथं सहसारथिम् इच्छन्तस्तत्प्रतीकर्तुमयुतानां त्रयोदश",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-013",
    "skandha": 4,
    "chapter": 10,
    "sloka": 13,
    "sanskrit": "औत्तानपादिः स तदा शस्त्रवर्षेण भूरिणा न एवादृश्यताच्छन्न आसारेण यथा गिरिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-014",
    "skandha": 4,
    "chapter": 10,
    "sloka": 14,
    "sanskrit": "हाहाकारस्तदैवासीत्सिद्धानां दिवि पश्यताम् हतोऽयं मानवः सूर्यो मग्नः पुण्यजनार्णवे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-015",
    "skandha": 4,
    "chapter": 10,
    "sloka": 15,
    "sanskrit": "नदत्सु यातुधानेषु जयकाशिष्वथो मृधे उदतिष्ठद्रथस्तस्य नीहारादिव भास्करः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-016",
    "skandha": 4,
    "chapter": 10,
    "sloka": 16,
    "sanskrit": "धनुर्विस्फूर्जयन्दिव्यं द्विषतां खेदमुद्वहन् अस्त्रौघं व्यधमद्बाणैर्घनानीकमिवानिलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-017",
    "skandha": 4,
    "chapter": 10,
    "sloka": 17,
    "sanskrit": "तस्य ते चापनिर्मुक्ता भित्त्वा वर्माणि रक्षसाम् कायानाविविशुस्तिग्मा गिरीनशनयो यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-018",
    "skandha": 4,
    "chapter": 10,
    "sloka": 18,
    "sanskrit": "भल्लैः सञ्छिद्यमानानां शिरोभिश्चारुकुण्डलैः ऊरुभिर्हेमतालाभैर्दोर्भिर्वलयवल्गुभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-019",
    "skandha": 4,
    "chapter": 10,
    "sloka": 19,
    "sanskrit": "हारकेयूरमुकुटैरुष्णीषैश्च महाधनैः आस्तृतास्ता रणभुवो रेजुर्वीरमनोहराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-020",
    "skandha": 4,
    "chapter": 10,
    "sloka": 20,
    "sanskrit": "हतावशिष्टा इतरे रणाजिराद्रक्षोगणाः क्षत्रियवर्यसायकैः प्रायो विवृक्णावयवा विदुद्रुवुर्मृगेन्द्रविक्रीडितयूथपा इव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-021",
    "skandha": 4,
    "chapter": 10,
    "sloka": 21,
    "sanskrit": "अपश्यमानः स तदाततायिनं महामृधे कञ्चन मानवोत्तमः पुरीं दिदृक्षन्नपि नाविशद्द्विषां न मायिनां वेद चिकीर्षितं जनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-022",
    "skandha": 4,
    "chapter": 10,
    "sloka": 22,
    "sanskrit": "इति ब्रुवंश्चित्ररथः स्वसारथिं यत्तः परेषां प्रतियोगशङ्कितः शुश्राव शब्दं जलधेरिवेरितं नभस्वतो दिक्षु रजोऽन्वदृश्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-023",
    "skandha": 4,
    "chapter": 10,
    "sloka": 23,
    "sanskrit": "क्षणेनाच्छादितं व्योम घनानीकेन सर्वतः विस्फुरत्तडिता दिक्षु त्रासयत्स्तनयित्नुना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-024",
    "skandha": 4,
    "chapter": 10,
    "sloka": 24,
    "sanskrit": "ववृषू रुधिरौघासृक् पूयविण्मूत्रमेदसः निपेतुर्गगनादस्य कबन्धान्यग्रतोऽनघ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-025",
    "skandha": 4,
    "chapter": 10,
    "sloka": 25,
    "sanskrit": "ततः खेऽदृश्यत गिरिर्निपेतुः सर्वतोदिशम् गदापरिघनिस्त्रिंश मुसलाः साश्मवर्षिणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-026",
    "skandha": 4,
    "chapter": 10,
    "sloka": 26,
    "sanskrit": "अहयोऽशनिनिःश्वासा वमन्तोऽग्निं रुषाक्षिभिः अभ्यधावन्गजा मत्ताः सिंहव्याघ्राश्च यूथशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-027",
    "skandha": 4,
    "chapter": 10,
    "sloka": 27,
    "sanskrit": "समुद्र ऊर्मिभिर्भीमः प्लावयन्सर्वतो भुवम् आससाद महाह्रादः कल्पान्त इव भीषणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-028",
    "skandha": 4,
    "chapter": 10,
    "sloka": 28,
    "sanskrit": "एवंविधान्यनेकानि त्रासनान्यमनस्विनाम् ससृजुस्तिग्मगतय आसुर्या माययासुराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-029",
    "skandha": 4,
    "chapter": 10,
    "sloka": 29,
    "sanskrit": "ध्रुवे प्रयुक्तामसुरैस्तां मायामतिदुस्तराम् निशम्य तस्य मुनयः शमाशंसन्समागताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-10-sloka-030",
    "skandha": 4,
    "chapter": 10,
    "sloka": 30,
    "sanskrit": "औत्तानपाद भगवांस्तव शार्ङ्गधन्वा देवः क्षिणोत्ववनतार्तिहरो विपक्षान् यन्नामधेयमभिधाय निशम्य चाद्धा लोकोऽञ्जसा तरति दुस्तरमङ्ग मृत्युम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मुनय ऊचुः ।"
  }
]