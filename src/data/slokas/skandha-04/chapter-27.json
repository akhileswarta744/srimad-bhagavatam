[
  {
    "id": "skandha-04-chapter-27-sloka-001",
    "skandha": 4,
    "chapter": 27,
    "sloka": 1,
    "sanskrit": "इत्थं पुरञ्जनं सध्र्यग्वशमानीय विभ्रमैः पुरञ्जनी महाराज रेमे रमयती पतिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "नारद उवाच ।"
  },
  {
    "id": "skandha-04-chapter-27-sloka-002",
    "skandha": 4,
    "chapter": 27,
    "sloka": 2,
    "sanskrit": "स राजा महिषीं राजन्सुस्नातां रुचिराननाम् कृतस्वस्त्ययनां तृप्तामभ्यनन्ददुपागताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-003",
    "skandha": 4,
    "chapter": 27,
    "sloka": 3,
    "sanskrit": "तयोपगूढः परिरब्धकन्धरो रहोऽनुमन्त्रैरपकृष्टचेतनः न कालरंहो बुबुधे दुरत्ययं दिवा निशेति प्रमदापरिग्रहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-004",
    "skandha": 4,
    "chapter": 27,
    "sloka": 4,
    "sanskrit": "शयान उन्नद्धमदो महामना महार्हतल्पे महिषीभुजोपधिः तामेव वीरो मनुते परं यतस्तमोऽभिभूतो न निजं परं च यत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-005",
    "skandha": 4,
    "chapter": 27,
    "sloka": 5,
    "sanskrit": "तयैवं रममाणस्य कामकश्मलचेतसः क्षणार्धमिव राजेन्द्र व्यतिक्रान्तं नवं वयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-006",
    "skandha": 4,
    "chapter": 27,
    "sloka": 6,
    "sanskrit": "तस्यामजनयत्पुत्रान्पुरञ्जन्यां पुरञ्जनः शतान्येकादश विराडायुषोऽर्धमथात्यगात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-007",
    "skandha": 4,
    "chapter": 27,
    "sloka": 7,
    "sanskrit": "दुहितॄर्दशोत्तरशतं पितृमातृयशस्करीः शीलौदार्यगुणोपेताः पौरञ्जन्यः प्रजापते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-008",
    "skandha": 4,
    "chapter": 27,
    "sloka": 8,
    "sanskrit": "स पञ्चालपतिः पुत्रान्पितृवंशविवर्धनान् दारैः संयोजयामास दुहितॄः सदृशैर्वरैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-009",
    "skandha": 4,
    "chapter": 27,
    "sloka": 9,
    "sanskrit": "पुत्राणां चाभवन्पुत्रा एकैकस्य शतं शतम् यैर्वै पौरञ्जनो वंशः पञ्चालेषु समेधितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-010",
    "skandha": 4,
    "chapter": 27,
    "sloka": 10,
    "sanskrit": "तेषु तद्रिक्थहारेषु गृहकोशानुजीविषु निरूढेन ममत्वेन विषयेष्वन्वबध्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-011",
    "skandha": 4,
    "chapter": 27,
    "sloka": 11,
    "sanskrit": "ईजे च क्रतुभिर्घोरैर्दीक्षितः पशुमारकैः देवान्पितॄन्भूतपतीन्नानाकामो यथा भवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-012",
    "skandha": 4,
    "chapter": 27,
    "sloka": 12,
    "sanskrit": "युक्तेष्वेवं प्रमत्तस्य कुटुम्बासक्तचेतसः आससाद स वै कालो योऽप्रियः प्रिययोषिताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-013",
    "skandha": 4,
    "chapter": 27,
    "sloka": 13,
    "sanskrit": "चण्डवेग इति ख्यातो गन्धर्वाधिपतिर्नृप गन्धर्वास्तस्य बलिनः षष्ट्युत्तरशतत्रयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-014",
    "skandha": 4,
    "chapter": 27,
    "sloka": 14,
    "sanskrit": "गन्धर्व्यस्तादृशीरस्य मैथुन्यश्च सितासिताः परिवृत्त्या विलुम्पन्ति सर्वकामविनिर्मिताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-015",
    "skandha": 4,
    "chapter": 27,
    "sloka": 15,
    "sanskrit": "ते चण्डवेगानुचराः पुरञ्जनपुरं यदा हर्तुमारेभिरे तत्र प्रत्यषेधत्प्रजागरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-016",
    "skandha": 4,
    "chapter": 27,
    "sloka": 16,
    "sanskrit": "स सप्तभिः शतैरेको विंशत्या च शतं समाः पुरञ्जनपुराध्यक्षो गन्धर्वैर्युयुधे बली",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-017",
    "skandha": 4,
    "chapter": 27,
    "sloka": 17,
    "sanskrit": "क्षीयमाणे स्वसम्बन्धे एकस्मिन्बहुभिर्युधा चिन्तां परां जगामार्तः सराष्ट्रपुरबान्धवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-018",
    "skandha": 4,
    "chapter": 27,
    "sloka": 18,
    "sanskrit": "स एव पुर्यां मधुभुक्पञ्चालेषु स्वपार्षदैः उपनीतं बलिं गृह्णन्स्त्रीजितो नाविदद्भयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-019",
    "skandha": 4,
    "chapter": 27,
    "sloka": 19,
    "sanskrit": "कालस्य दुहिता काचित्त्रिलोकीं वरमिच्छती पर्यटन्ती न बर्हिष्मन्प्रत्यनन्दत कश्चन",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-020",
    "skandha": 4,
    "chapter": 27,
    "sloka": 20,
    "sanskrit": "दौर्भाग्येनात्मनो लोके विश्रुता दुर्भगेति सा या तुष्टा राजर्षये तु वृतादात्पूरवे वरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-021",
    "skandha": 4,
    "chapter": 27,
    "sloka": 21,
    "sanskrit": "कदाचिदटमाना सा ब्रह्मलोकान्महीं गतम् वव्रे बृहद्व्रतं मां तु जानती काममोहिता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-022",
    "skandha": 4,
    "chapter": 27,
    "sloka": 22,
    "sanskrit": "मयि संरभ्य विपुल मदाच्छापं सुदुःसहम् स्थातुमर्हसि नैकत्र मद्याच्ञाविमुखो मुने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-023",
    "skandha": 4,
    "chapter": 27,
    "sloka": 23,
    "sanskrit": "ततो विहतसङ्कल्पा कन्यका यवनेश्वरम् मयोपदिष्टमासाद्य वव्रे नाम्ना भयं पतिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-024",
    "skandha": 4,
    "chapter": 27,
    "sloka": 24,
    "sanskrit": "ऋषभं यवनानां त्वां वृणे वीरेप्सितं पतिम् सङ्कल्पस्त्वयि भूतानां कृतः किल न रिष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-025",
    "skandha": 4,
    "chapter": 27,
    "sloka": 25,
    "sanskrit": "द्वाविमावनुशोचन्ति बालावसदवग्रहौ यल्लोकशास्त्रोपनतं न राति न तदिच्छति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-026",
    "skandha": 4,
    "chapter": 27,
    "sloka": 26,
    "sanskrit": "अथो भजस्व मां भद्र भजन्तीं मे दयां कुरु एतावान्पौरुषो धर्मो यदार्ताननुकम्पते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-027",
    "skandha": 4,
    "chapter": 27,
    "sloka": 27,
    "sanskrit": "कालकन्योदितवचो निशम्य यवनेश्वरः चिकीर्षुर्देवगुह्यं स सस्मितं तामभाषत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-028",
    "skandha": 4,
    "chapter": 27,
    "sloka": 28,
    "sanskrit": "मया निरूपितस्तुभ्यं पतिरात्मसमाधिना नाभिनन्दति लोकोऽयं त्वामभद्रामसम्मताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-029",
    "skandha": 4,
    "chapter": 27,
    "sloka": 29,
    "sanskrit": "त्वमव्यक्तगतिर्भुङ्क्ष्व लोकं कर्मविनिर्मितम् या हि मे पृतनायुक्ता प्रजानाशं प्रणेष्यसि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-27-sloka-030",
    "skandha": 4,
    "chapter": 27,
    "sloka": 30,
    "sanskrit": "प्रज्वारोऽयं मम भ्राता त्वं च मे भगिनी भव चराम्युभाभ्यां लोकेऽस्मिन्नव्यक्तो भीमसैनिकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]