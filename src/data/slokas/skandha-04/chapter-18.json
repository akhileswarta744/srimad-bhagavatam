[
  {
    "id": "skandha-04-chapter-18-sloka-001",
    "skandha": 4,
    "chapter": 18,
    "sloka": 1,
    "sanskrit": "इत्थं पृथुमभिष्टूय रुषा प्रस्फुरिताधरम् पुनराहावनिर्भीता संस्तभ्यात्मानमात्मना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-04-chapter-18-sloka-002",
    "skandha": 4,
    "chapter": 18,
    "sloka": 2,
    "sanskrit": "सन्नियच्छाभिभो मन्युं निबोध श्रावितं च मे सर्वतः सारमादत्ते यथा मधुकरो बुधः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-003",
    "skandha": 4,
    "chapter": 18,
    "sloka": 3,
    "sanskrit": "अस्मिन्लोकेऽथवामुष्मिन्मुनिभिस्तत्त्वदर्शिभिः दृष्टा योगाः प्रयुक्ताश्च पुंसां श्रेयःप्रसिद्धये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-004",
    "skandha": 4,
    "chapter": 18,
    "sloka": 4,
    "sanskrit": "तानातिष्ठति यः सम्यगुपायान्पूर्वदर्शितान् अवरः श्रद्धयोपेत उपेयान्विन्दतेऽञ्जसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-005",
    "skandha": 4,
    "chapter": 18,
    "sloka": 5,
    "sanskrit": "ताननादृत्य योऽविद्वानर्थानारभते स्वयम् तस्य व्यभिचरन्त्यर्था आरब्धाश्च पुनः पुनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-006",
    "skandha": 4,
    "chapter": 18,
    "sloka": 6,
    "sanskrit": "पुरा सृष्टा ह्योषधयो ब्रह्मणा या विशाम्पते भुज्यमाना मया दृष्टा असद्भिरधृतव्रतैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-007",
    "skandha": 4,
    "chapter": 18,
    "sloka": 7,
    "sanskrit": "अपालितानादृता च भवद्भिर्लोकपालकैः चोरीभूतेऽथ लोकेऽहं यज्ञार्थेऽग्रसमोषधीः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-008",
    "skandha": 4,
    "chapter": 18,
    "sloka": 8,
    "sanskrit": "नूनं ता वीरुधः क्षीणा मयि कालेन भूयसा तत्र योगेन दृष्टेन भवानादातुमर्हति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-009",
    "skandha": 4,
    "chapter": 18,
    "sloka": 9,
    "sanskrit": "वत्सं कल्पय मे वीर येनाहं वत्सला तव धोक्ष्ये क्षीरमयान्कामाननुरूपं च दोहनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-010",
    "skandha": 4,
    "chapter": 18,
    "sloka": 10,
    "sanskrit": "दोग्धारं च महाबाहो भूतानां भूतभावन अन्नमीप्सितमूर्जस्वद्भगवान्वाञ्छते यदि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-011",
    "skandha": 4,
    "chapter": 18,
    "sloka": 11,
    "sanskrit": "समां च कुरु मां राजन्देववृष्टं यथा पयः अपर्तावपि भद्रं ते उपावर्तेत मे विभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-012",
    "skandha": 4,
    "chapter": 18,
    "sloka": 12,
    "sanskrit": "इति प्रियं हितं वाक्यं भुव आदाय भूपतिः वत्सं कृत्वा मनुं पाणावदुहत्सकलौषधीः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-013",
    "skandha": 4,
    "chapter": 18,
    "sloka": 13,
    "sanskrit": "तथापरे च सर्वत्र सारमाददते बुधाः ततोऽन्ये च यथाकामं दुदुहुः पृथुभाविताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-014",
    "skandha": 4,
    "chapter": 18,
    "sloka": 14,
    "sanskrit": "ऋषयो दुदुहुर्देवीमिन्द्रियेष्वथ सत्तम वत्सं बृहस्पतिं कृत्वा पयश्छन्दोमयं शुचि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-015",
    "skandha": 4,
    "chapter": 18,
    "sloka": 15,
    "sanskrit": "कृत्वा वत्सं सुरगणा इन्द्रं सोममदूदुहन् हिरण्मयेन पात्रेण वीर्यमोजो बलं पयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-016",
    "skandha": 4,
    "chapter": 18,
    "sloka": 16,
    "sanskrit": "दैतेया दानवा वत्सं प्रह्लादमसुरर्षभम् विधायादूदुहन्क्षीरमयःपात्रे सुरासवम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-017",
    "skandha": 4,
    "chapter": 18,
    "sloka": 17,
    "sanskrit": "गन्धर्वाप्सरसोऽधुक्षन्पात्रे पद्ममये पयः वत्सं विश्वावसुं कृत्वा गान्धर्वं मधु सौभगम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-018",
    "skandha": 4,
    "chapter": 18,
    "sloka": 18,
    "sanskrit": "वत्सेन पितरोऽर्यम्णा कव्यं क्षीरमधुक्षत आमपात्रे महाभागाः श्रद्धया श्राद्धदेवताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-019",
    "skandha": 4,
    "chapter": 18,
    "sloka": 19,
    "sanskrit": "प्रकल्प्य वत्सं कपिलं सिद्धाः सङ्कल्पनामयीम् सिद्धिं नभसि विद्यां च ये च विद्याधरादयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-020",
    "skandha": 4,
    "chapter": 18,
    "sloka": 20,
    "sanskrit": "अन्ये च मायिनो मायामन्तर्धानाद्भुतात्मनाम् मयं प्रकल्प्य वत्सं ते दुदुहुर्धारणामयीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-021",
    "skandha": 4,
    "chapter": 18,
    "sloka": 21,
    "sanskrit": "यक्षरक्षांसि भूतानि पिशाचाः पिशिताशनाः भूतेशवत्सा दुदुहुः कपाले क्षतजासवम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-022",
    "skandha": 4,
    "chapter": 18,
    "sloka": 22,
    "sanskrit": "तथाहयो दन्दशूकाः सर्पा नागाश्च तक्षकम् विधाय वत्सं दुदुहुर्बिलपात्रे विषं पयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-023",
    "skandha": 4,
    "chapter": 18,
    "sloka": 23,
    "sanskrit": "पशवो यवसं क्षीरं वत्सं कृत्वा च गोवृषम् अरण्यपात्रे चाधुक्षन्मृगेन्द्रेण च दंष्ट्रिणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-024",
    "skandha": 4,
    "chapter": 18,
    "sloka": 24,
    "sanskrit": "क्रव्यादाः प्राणिनः क्रव्यं दुदुहुः स्वे कलेवरे सुपर्णवत्सा विहगाश्चरं चाचरमेव च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-025",
    "skandha": 4,
    "chapter": 18,
    "sloka": 25,
    "sanskrit": "वटवत्सा वनस्पतयः पृथग्रसमयं पयः गिरयो हिमवद्वत्सा नानाधातून्स्वसानुषु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-026",
    "skandha": 4,
    "chapter": 18,
    "sloka": 26,
    "sanskrit": "सर्वे स्वमुख्यवत्सेन स्वे स्वे पात्रे पृथक्पयः सर्वकामदुघां पृथ्वीं दुदुहुः पृथुभाविताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-027",
    "skandha": 4,
    "chapter": 18,
    "sloka": 27,
    "sanskrit": "एवं पृथ्वादयः पृथ्वीमन्नादाः स्वन्नमात्मनः दोहवत्सादिभेदेन क्षीरभेदं कुरूद्वह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-028",
    "skandha": 4,
    "chapter": 18,
    "sloka": 28,
    "sanskrit": "ततो महीपतिः प्रीतः सर्वकामदुघां पृथुः दुहितृत्वे चकारेमां प्रेम्णा दुहितृवत्सलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-029",
    "skandha": 4,
    "chapter": 18,
    "sloka": 29,
    "sanskrit": "चूर्णयन्स्वधनुष्कोट्या गिरिकूटानि राजराट् भूमण्डलमिदं वैन्यः प्रायश्चक्रे समं विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-030",
    "skandha": 4,
    "chapter": 18,
    "sloka": 30,
    "sanskrit": "अथास्मिन्भगवान्वैन्यः प्रजानां वृत्तिदः पिता निवासान्कल्पयां चक्रे तत्र तत्र यथार्हतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-031",
    "skandha": 4,
    "chapter": 18,
    "sloka": 31,
    "sanskrit": "ग्रामान्पुरः पत्तनानि दुर्गाणि विविधानि च घोषान्व्रजान्सशिबिरानाकरान्खेटखर्वटान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-18-sloka-032",
    "skandha": 4,
    "chapter": 18,
    "sloka": 32,
    "sanskrit": "प्राक्पृथोरिह नैवैषा पुरग्रामादिकल्पना यथासुखं वसन्ति स्म तत्र तत्राकुतोभयाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]