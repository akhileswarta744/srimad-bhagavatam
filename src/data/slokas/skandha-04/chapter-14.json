[
  {
    "id": "skandha-04-chapter-14-sloka-001",
    "skandha": 4,
    "chapter": 14,
    "sloka": 1,
    "sanskrit": "भृग्वादयस्ते मुनयो लोकानां क्षेमदर्शिनः गोप्तर्यसति वै नॄणां पश्यन्तः पशुसाम्यताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-04-chapter-14-sloka-002",
    "skandha": 4,
    "chapter": 14,
    "sloka": 2,
    "sanskrit": "वीरमातरमाहूय सुनीथां ब्रह्मवादिनः प्रकृत्यसम्मतं वेनमभ्यषिञ्चन्पतिं भुवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-003",
    "skandha": 4,
    "chapter": 14,
    "sloka": 3,
    "sanskrit": "श्रुत्वा नृपासनगतं वेनमत्युग्रशासनम् निलिल्युर्दस्यवः सद्यः सर्पत्रस्ता इवाखवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-004",
    "skandha": 4,
    "chapter": 14,
    "sloka": 4,
    "sanskrit": "स आरूढनृपस्थान उन्नद्धोऽष्टविभूतिभिः अवमेने महाभागान्स्तब्धः सम्भावितः स्वतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-005",
    "skandha": 4,
    "chapter": 14,
    "sloka": 5,
    "sanskrit": "एवं मदान्ध उत्सिक्तो निरङ्कुश इव द्विपः पर्यटन्रथमास्थाय कम्पयन्निव रोदसी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-006",
    "skandha": 4,
    "chapter": 14,
    "sloka": 6,
    "sanskrit": "न यष्टव्यं न दातव्यं न होतव्यं द्विजाः क्वचित् इति न्यवारयद्धर्मं भेरीघोषेण सर्वशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-007",
    "skandha": 4,
    "chapter": 14,
    "sloka": 7,
    "sanskrit": "वेनस्यावेक्ष्य मुनयो दुर्वृत्तस्य विचेष्टितम् विमृश्य लोकव्यसनं कृपयोचुः स्म सत्रिणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-008",
    "skandha": 4,
    "chapter": 14,
    "sloka": 8,
    "sanskrit": "अहो उभयतः प्राप्तं लोकस्य व्यसनं महत् दारुण्युभयतो दीप्ते इव तस्करपालयोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-009",
    "skandha": 4,
    "chapter": 14,
    "sloka": 9,
    "sanskrit": "अराजकभयादेष कृतो राजातदर्हणः ततोऽप्यासीद्भयं त्वद्य कथं स्यात्स्वस्ति देहिनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-010",
    "skandha": 4,
    "chapter": 14,
    "sloka": 10,
    "sanskrit": "अहेरिव पयःपोषः पोषकस्याप्यनर्थभृत् वेनः प्रकृत्यैव खलः सुनीथागर्भसम्भवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-011",
    "skandha": 4,
    "chapter": 14,
    "sloka": 11,
    "sanskrit": "निरूपितः प्रजापालः स जिघांसति वै प्रजाः तथापि सान्त्वयेमामुं नास्मांस्तत्पातकं स्पृशेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-012",
    "skandha": 4,
    "chapter": 14,
    "sloka": 12,
    "sanskrit": "तद्विद्वद्भिरसद्वृत्तो वेनोऽस्माभिः कृतो नृपः सान्त्वितो यदि नो वाचं न ग्रहीष्यत्यधर्मकृत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-013",
    "skandha": 4,
    "chapter": 14,
    "sloka": 13,
    "sanskrit": "लोकधिक्कारसन्दग्धं दहिष्यामः स्वतेजसा एवमध्यवसायैनं मुनयो गूढमन्यवः उपव्रज्याब्रुवन्वेनं सान्त्वयित्वा च सामभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-014",
    "skandha": 4,
    "chapter": 14,
    "sloka": 14,
    "sanskrit": "नृपवर्य निबोधैतद्यत्ते विज्ञापयाम भोः आयुःश्रीबलकीर्तीनां तव तात विवर्धनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मुनय ऊचुः ।"
  },
  {
    "id": "skandha-04-chapter-14-sloka-015",
    "skandha": 4,
    "chapter": 14,
    "sloka": 15,
    "sanskrit": "धर्म आचरितः पुंसां वाङ्मनःकायबुद्धिभिः लोकान्विशोकान्वितरत्यथानन्त्यमसङ्गिनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-016",
    "skandha": 4,
    "chapter": 14,
    "sloka": 16,
    "sanskrit": "स ते मा विनशेद्वीर प्रजानां क्षेमलक्षणः यस्मिन्विनष्टे नृपतिरैश्वर्यादवरोहति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-017",
    "skandha": 4,
    "chapter": 14,
    "sloka": 17,
    "sanskrit": "राजन्नसाध्वमात्येभ्यश्चोरादिभ्यः प्रजा नृपः रक्षन्यथा बलिं गृह्णन्निह प्रेत्य च मोदते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-018",
    "skandha": 4,
    "chapter": 14,
    "sloka": 18,
    "sanskrit": "यस्य राष्ट्रे पुरे चैव भगवान्यज्ञपूरुषः इज्यते स्वेन धर्मेण जनैर्वर्णाश्रमान्वितैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-019",
    "skandha": 4,
    "chapter": 14,
    "sloka": 19,
    "sanskrit": "तस्य राज्ञो महाभाग भगवान्भूतभावनः परितुष्यति विश्वात्मा तिष्ठतो निजशासने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-020",
    "skandha": 4,
    "chapter": 14,
    "sloka": 20,
    "sanskrit": "तस्मिंस्तुष्टे किमप्राप्यंजगतामीश्वरेश्वरे लोकाः सपाला ह्येतस्मै हरन्ति बलिमादृताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-021",
    "skandha": 4,
    "chapter": 14,
    "sloka": 21,
    "sanskrit": "तं सर्वलोकामरयज्ञसङ्ग्रहं त्रयीमयं द्रव्यमयं तपोमयम् यज्ञैर्विचित्रैर्यजतो भवाय ते राजन्स्वदेशाननुरोद्धुमर्हसि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-022",
    "skandha": 4,
    "chapter": 14,
    "sloka": 22,
    "sanskrit": "यज्ञेन युष्मद्विषये द्विजातिभिर्वितायमानेन सुराः कला हरेः स्विष्टाः सुतुष्टाः प्रदिशन्ति वाञ्छितं तद्धेलनं नार्हसि वीर चेष्टितुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-023",
    "skandha": 4,
    "chapter": 14,
    "sloka": 23,
    "sanskrit": "बालिशा बत यूयं वा अधर्मे धर्ममानिनः ये वृत्तिदं पतिं हित्वा जारं पतिमुपासते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "वेन उवाच ।"
  },
  {
    "id": "skandha-04-chapter-14-sloka-024",
    "skandha": 4,
    "chapter": 14,
    "sloka": 24,
    "sanskrit": "अवजानन्त्यमी मूढा नृपरूपिणमीश्वरम् नानुविन्दन्ति ते भद्रमिह लोके परत्र च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-025",
    "skandha": 4,
    "chapter": 14,
    "sloka": 25,
    "sanskrit": "को यज्ञपुरुषो नाम यत्र वो भक्तिरीदृशी भर्तृस्नेहविदूराणां यथा जारे कुयोषिताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-026",
    "skandha": 4,
    "chapter": 14,
    "sloka": 26,
    "sanskrit": "विष्णुर्विरिञ्चो गिरिश इन्द्रो वायुर्यमो रविः पर्जन्यो धनदः सोमः क्षितिरग्निरपाम्पतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-027",
    "skandha": 4,
    "chapter": 14,
    "sloka": 27,
    "sanskrit": "एते चान्ये च विबुधाः प्रभवो वरशापयोः देहे भवन्ति नृपतेः सर्वदेवमयो नृपः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-028",
    "skandha": 4,
    "chapter": 14,
    "sloka": 28,
    "sanskrit": "तस्मान्मां कर्मभिर्विप्रा यजध्वं गतमत्सराः बलिं च मह्यं हरत मत्तोऽन्यः कोऽग्रभुक्पुमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-029",
    "skandha": 4,
    "chapter": 14,
    "sloka": 29,
    "sanskrit": "इत्थं विपर्ययमतिः पापीयानुत्पथं गतः अनुनीयमानस्तद्याच्ञां न चक्रे भ्रष्टमङ्गलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-04-chapter-14-sloka-030",
    "skandha": 4,
    "chapter": 14,
    "sloka": 30,
    "sanskrit": "इति तेऽसत्कृतास्तेन द्विजाः पण्डितमानिना भग्नायां भव्ययाच्ञायां तस्मै विदुर चुक्रुधुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-031",
    "skandha": 4,
    "chapter": 14,
    "sloka": 31,
    "sanskrit": "हन्यतां हन्यतामेष पापः प्रकृतिदारुणः जीवञ्जगदसावाशु कुरुते भस्मसाद्ध्रुवम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-032",
    "skandha": 4,
    "chapter": 14,
    "sloka": 32,
    "sanskrit": "नायमर्हत्यसद्वृत्तो नरदेववरासनम् योऽधियज्ञपतिं विष्णुं विनिन्दत्यनपत्रपः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-033",
    "skandha": 4,
    "chapter": 14,
    "sloka": 33,
    "sanskrit": "को वैनं परिचक्षीत वेनमेकमृतेऽशुभम् प्राप्त ईदृशमैश्वर्यं यदनुग्रहभाजनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-034",
    "skandha": 4,
    "chapter": 14,
    "sloka": 34,
    "sanskrit": "इत्थं व्यवसिता हन्तुमृषयो रूढमन्यवः निजघ्नुर्हुङ्कृतैर्वेनं हतमच्युतनिन्दया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-035",
    "skandha": 4,
    "chapter": 14,
    "sloka": 35,
    "sanskrit": "ऋषिभिः स्वाश्रमपदं गते पुत्रकलेवरम् सुनीथा पालयामास विद्यायोगेन शोचती",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-036",
    "skandha": 4,
    "chapter": 14,
    "sloka": 36,
    "sanskrit": "एकदा मुनयस्ते तु सरस्वत्सलिलाप्लुताः हुत्वाग्नीन्सत्कथाश्चक्रुरुपविष्टाः सरित्तटे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-037",
    "skandha": 4,
    "chapter": 14,
    "sloka": 37,
    "sanskrit": "वीक्ष्योत्थितांस्तदोत्पातानाहुर्लोकभयङ्करान् अप्यभद्रमनाथाया दस्युभ्यो न भवेद्भुवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-038",
    "skandha": 4,
    "chapter": 14,
    "sloka": 38,
    "sanskrit": "एवं मृशन्त ऋषयो धावतां सर्वतोदिशम् पांसुः समुत्थितो भूरिश्चोराणामभिलुम्पताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-039",
    "skandha": 4,
    "chapter": 14,
    "sloka": 39,
    "sanskrit": "तदुपद्रवमाज्ञाय लोकस्य वसु लुम्पताम् भर्तर्युपरते तस्मिन्नन्योन्यं च जिघांसताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-040",
    "skandha": 4,
    "chapter": 14,
    "sloka": 40,
    "sanskrit": "चोरप्रायं जनपदं हीनसत्त्वमराजकम् लोकान्नावारयञ्छक्ता अपि तद्दोषदर्शिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-041",
    "skandha": 4,
    "chapter": 14,
    "sloka": 41,
    "sanskrit": "ब्राह्मणः समदृक्षान्तो दीनानां समुपेक्षकः स्रवते ब्रह्म तस्यापि भिन्नभाण्डात्पयो यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-042",
    "skandha": 4,
    "chapter": 14,
    "sloka": 42,
    "sanskrit": "नाङ्गस्य वंशो राजर्षेरेष संस्थातुमर्हति अमोघवीर्या हि नृपा वंशेऽस्मिन्केशवाश्रयाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-043",
    "skandha": 4,
    "chapter": 14,
    "sloka": 43,
    "sanskrit": "विनिश्चित्यैवमृषयो विपन्नस्य महीपतेः ममन्थुरूरुं तरसा तत्रासीद्बाहुको नरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-044",
    "skandha": 4,
    "chapter": 14,
    "sloka": 44,
    "sanskrit": "काककृष्णोऽतिह्रस्वाङ्गो ह्रस्वबाहुर्महाहनुः ह्रस्वपान्निम्ननासाग्रो रक्ताक्षस्ताम्रमूर्धजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-14-sloka-045",
    "skandha": 4,
    "chapter": 14,
    "sloka": 45,
