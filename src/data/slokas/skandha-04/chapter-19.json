[
  {
    "id": "skandha-04-chapter-19-sloka-001",
    "skandha": 4,
    "chapter": 19,
    "sloka": 1,
    "sanskrit": "अथादीक्षत राजा तु हयमेधशतेन सः ब्रह्मावर्ते मनोः क्षेत्रे यत्र प्राची सरस्वती",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-04-chapter-19-sloka-002",
    "skandha": 4,
    "chapter": 19,
    "sloka": 2,
    "sanskrit": "तदभिप्रेत्य भगवान्कर्मातिशयमात्मनः शतक्रतुर्न ममृषे पृथोर्यज्ञमहोत्सवम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-003",
    "skandha": 4,
    "chapter": 19,
    "sloka": 3,
    "sanskrit": "यत्र यज्ञपतिः साक्षाद्भगवान्हरिरीश्वरः अन्वभूयत सर्वात्मा सर्वलोकगुरुः प्रभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-004",
    "skandha": 4,
    "chapter": 19,
    "sloka": 4,
    "sanskrit": "अन्वितो ब्रह्मशर्वाभ्यां लोकपालैः सहानुगैः उपगीयमानो गन्धर्वैर्मुनिभिश्चाप्सरोगणैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-005",
    "skandha": 4,
    "chapter": 19,
    "sloka": 5,
    "sanskrit": "सिद्धा विद्याधरा दैत्या दानवा गुह्यकादयः सुनन्दनन्दप्रमुखाः पार्षदप्रवरा हरेः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-006",
    "skandha": 4,
    "chapter": 19,
    "sloka": 6,
    "sanskrit": "कपिलो नारदो दत्तो योगेशाः सनकादयः तमन्वीयुर्भागवता ये च तत्सेवनोत्सुकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-007",
    "skandha": 4,
    "chapter": 19,
    "sloka": 7,
    "sanskrit": "यत्र धर्मदुघा भूमिः सर्वकामदुघा सती दोग्धि स्माभीप्सितानर्थान्यजमानस्य भारत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-008",
    "skandha": 4,
    "chapter": 19,
    "sloka": 8,
    "sanskrit": "ऊहुः सर्वरसान्नद्यः क्षीरदध्यन्नगोरसान् तरवो भूरिवर्ष्माणः प्रासूयन्त मधुच्युतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-009",
    "skandha": 4,
    "chapter": 19,
    "sloka": 9,
    "sanskrit": "सिन्धवो रत्ननिकरान्गिरयोऽन्नं चतुर्विधम् उपायनमुपाजह्रुः सर्वे लोकाः सपालकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-010",
    "skandha": 4,
    "chapter": 19,
    "sloka": 10,
    "sanskrit": "इति चाधोक्षजेशस्य पृथोस्तु परमोदयम् असूयन्भगवानिन्द्रः प्रतिघातमचीकरत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-011",
    "skandha": 4,
    "chapter": 19,
    "sloka": 11,
    "sanskrit": "चरमेणाश्वमेधेन यजमाने यजुष्पतिम् वैन्ये यज्ञपशुं स्पर्धन्नपोवाह तिरोहितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-012",
    "skandha": 4,
    "chapter": 19,
    "sloka": 12,
    "sanskrit": "तमत्रिर्भगवानैक्षत्त्वरमाणं विहायसा आमुक्तमिव पाखण्डं योऽधर्मे धर्मविभ्रमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-013",
    "skandha": 4,
    "chapter": 19,
    "sloka": 13,
    "sanskrit": "अत्रिणा चोदितो हन्तुं पृथुपुत्रो महारथः अन्वधावत सङ्क्रुद्धस्तिष्ठ तिष्ठेति चाब्रवीत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-014",
    "skandha": 4,
    "chapter": 19,
    "sloka": 14,
    "sanskrit": "तं तादृशाकृतिं वीक्ष्य मेने धर्मं शरीरिणम् जटिलं भस्मनाच्छन्नं तस्मै बाणं न मुञ्चति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-015",
    "skandha": 4,
    "chapter": 19,
    "sloka": 15,
    "sanskrit": "वधान्निवृत्तं तं भूयो हन्तवेऽत्रिरचोदयत् जहि यज्ञहनं तात महेन्द्रं विबुधाधमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-016",
    "skandha": 4,
    "chapter": 19,
    "sloka": 16,
    "sanskrit": "एवं वैन्यसुतः प्रोक्तस्त्वरमाणं विहायसा अन्वद्रवदभिक्रुद्धो रावणं गृध्रराडिव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-017",
    "skandha": 4,
    "chapter": 19,
    "sloka": 17,
    "sanskrit": "सोऽश्वं रूपं च तद्धित्वा तस्मा अन्तर्हितः स्वराट् वीरः स्वपशुमादाय पितुर्यज्ञमुपेयिवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-018",
    "skandha": 4,
    "chapter": 19,
    "sloka": 18,
    "sanskrit": "तत्तस्य चाद्भुतं कर्म विचक्ष्य परमर्षयः नामधेयं ददुस्तस्मै विजिताश्व इति प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-019",
    "skandha": 4,
    "chapter": 19,
    "sloka": 19,
    "sanskrit": "उपसृज्य तमस्तीव्रं जहाराश्वं पुनर्हरिः चषालयूपतश्छन्नो हिरण्यरशनं विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-020",
    "skandha": 4,
    "chapter": 19,
    "sloka": 20,
    "sanskrit": "अत्रिः सन्दर्शयामास त्वरमाणं विहायसा कपालखट्वाङ्गधरं वीरो नैनमबाधत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-021",
    "skandha": 4,
    "chapter": 19,
    "sloka": 21,
    "sanskrit": "अत्रिणा चोदितस्तस्मै सन्दधे विशिखं रुषा सोऽश्वं रूपं च तद्धित्वा तस्थावन्तर्हितः स्वराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-022",
    "skandha": 4,
    "chapter": 19,
    "sloka": 22,
    "sanskrit": "वीरश्चाश्वमुपादाय पितृयज्ञमथाव्रजत् तदवद्यं हरे रूपं जगृहुर्ज्ञानदुर्बलाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-023",
    "skandha": 4,
    "chapter": 19,
    "sloka": 23,
    "sanskrit": "यानि रूपाणि जगृहे इन्द्रो हयजिहीर्षया तानि पापस्य खण्डानि लिङ्गं खण्डमिहोच्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-024",
    "skandha": 4,
    "chapter": 19,
    "sloka": 24,
    "sanskrit": "एवमिन्द्रे हरत्यश्वं वैन्ययज्ञजिघांसया तद्गृहीतविसृष्टेषु पाखण्डेषु मतिर्नृणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-025",
    "skandha": 4,
    "chapter": 19,
    "sloka": 25,
    "sanskrit": "धर्म इत्युपधर्मेषु नग्नरक्तपटादिषु प्रायेण सज्जते भ्रान्त्या पेशलेषु च वाग्मिषु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-026",
    "skandha": 4,
    "chapter": 19,
    "sloka": 26,
    "sanskrit": "तदभिज्ञाय भगवान्पृथुः पृथुपराक्रमः इन्द्राय कुपितो बाणमादत्तोद्यतकार्मुकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-027",
    "skandha": 4,
    "chapter": 19,
    "sloka": 27,
    "sanskrit": "तमृत्विजः शक्रवधाभिसन्धितं विचक्ष्य दुष्प्रेक्ष्यमसह्यरंहसम् निवारयामासुरहो महामते न युज्यतेऽत्रान्यवधः प्रचोदितात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-028",
    "skandha": 4,
    "chapter": 19,
    "sloka": 28,
    "sanskrit": "वयं मरुत्वन्तमिहार्थनाशनं ह्वयामहे त्वच्छ्रवसा हतत्विषम् अयातयामोपहवैरनन्तरं प्रसह्य राजञ्जुहवाम तेऽहितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-029",
    "skandha": 4,
    "chapter": 19,
    "sloka": 29,
    "sanskrit": "इत्यामन्त्र्य क्रतुपतिं विदुरास्यर्त्विजो रुषा स्रुग्घस्ताञ्जुह्वतोऽभ्येत्य स्वयम्भूः प्रत्यषेधत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-030",
    "skandha": 4,
    "chapter": 19,
    "sloka": 30,
    "sanskrit": "न वध्यो भवतामिन्द्रो यद्यज्ञो भगवत्तनुः यं जिघांसथ यज्ञेन यस्येष्टास्तनवः सुराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-031",
    "skandha": 4,
    "chapter": 19,
    "sloka": 31,
    "sanskrit": "तदिदं पश्यत महद् धर्मव्यतिकरं द्विजाः इन्द्रेणानुष्ठितं राज्ञः कर्मैतद्विजिघांसता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-032",
    "skandha": 4,
    "chapter": 19,
    "sloka": 32,
    "sanskrit": "पृथुकीर्तेः पृथोर्भूयात्तर्ह्येकोनशतक्रतुः अलं ते क्रतुभिः स्विष्टैर्यद्भवान्मोक्षधर्मवित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-033",
    "skandha": 4,
    "chapter": 19,
    "sloka": 33,
    "sanskrit": "नैवात्मने महेन्द्राय रोषमाहर्तुमर्हसि उभावपि हि भद्रं ते उत्तमश्लोकविग्रहौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-034",
    "skandha": 4,
    "chapter": 19,
    "sloka": 34,
    "sanskrit": "मास्मिन्महाराज कृथाः स्म चिन्तां निशामयास्मद्वच आदृतात्मा यद्ध्यायतो दैवहतं नु कर्तुं मनोऽतिरुष्टं विशते तमोऽन्धम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-035",
    "skandha": 4,
    "chapter": 19,
    "sloka": 35,
    "sanskrit": "क्रतुर्विरमतामेष देवेषु दुरवग्रहः धर्मव्यतिकरो यत्र पाखण्डैरिन्द्रनिर्मितैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-036",
    "skandha": 4,
    "chapter": 19,
    "sloka": 36,
    "sanskrit": "एभिरिन्द्रोपसंसृष्टैः पाखण्डैर्हारिभिर्जनम् ह्रियमाणं विचक्ष्वैनं यस्ते यज्ञध्रुगश्वमुट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-037",
    "skandha": 4,
    "chapter": 19,
    "sloka": 37,
    "sanskrit": "भवान्परित्रातुमिहावतीर्णो धर्मं जनानां समयानुरूपम् वेनापचारादवलुप्तमद्य तद्देहतो विष्णुकलासि वैन्य",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-038",
    "skandha": 4,
    "chapter": 19,
    "sloka": 38,
    "sanskrit": "स त्वं विमृश्यास्य भवं प्रजापते सङ्कल्पनं विश्वसृजां पिपीपृहि ऐन्द्रीं च मायामुपधर्ममातरं प्रचण्डपाखण्डपथं प्रभो जहि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-039",
    "skandha": 4,
    "chapter": 19,
    "sloka": 39,
    "sanskrit": "इत्थं स लोकगुरुणा समादिष्टो विशाम्पतिः तथा च कृत्वा वात्सल्यं मघोनापि च सन्दधे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-04-chapter-19-sloka-040",
    "skandha": 4,
    "chapter": 19,
    "sloka": 40,
    "sanskrit": "कृतावभृथस्नानाय पृथवे भूरिकर्मणे वरान्ददुस्ते वरदा ये तद्बर्हिषि तर्पिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-041",
    "skandha": 4,
    "chapter": 19,
    "sloka": 41,
    "sanskrit": "विप्राः सत्याशिषस्तुष्टाः श्रद्धया लब्धदक्षिणाः आशिषो युयुजुः क्षत्तरादिराजाय सत्कृताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-19-sloka-042",
    "skandha": 4,
    "chapter": 19,
    "sloka": 42,
    "sanskrit": "त्वयाहूता महाबाहो सर्व एव समागताः पूजिता दानमानाभ्यां पितृदेवर्षिमानवाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]