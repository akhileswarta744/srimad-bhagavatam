[
  {
    "id": "skandha-04-chapter-28-sloka-001",
    "skandha": 4,
    "chapter": 28,
    "sloka": 1,
    "sanskrit": "सैनिका भयनाम्नो ये बर्हिष्मन्दिष्टकारिणः प्रज्वारकालकन्याभ्यां विचेरुरवनीमिमाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "नारद उवाच ।"
  },
  {
    "id": "skandha-04-chapter-28-sloka-002",
    "skandha": 4,
    "chapter": 28,
    "sloka": 2,
    "sanskrit": "त एकदा तु रभसा पुरञ्जनपुरीं नृप रुरुधुर्भौमभोगाढ्यां जरत्पन्नगपालिताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-003",
    "skandha": 4,
    "chapter": 28,
    "sloka": 3,
    "sanskrit": "कालकन्यापि बुभुजे पुरञ्जनपुरं बलात् ययाभिभूतः पुरुषः सद्यो निःसारतामियात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-004",
    "skandha": 4,
    "chapter": 28,
    "sloka": 4,
    "sanskrit": "तयोपभुज्यमानां वै यवनाः सर्वतोदिशम् द्वार्भिः प्रविश्य सुभृशं प्रार्दयन्सकलां पुरीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-005",
    "skandha": 4,
    "chapter": 28,
    "sloka": 5,
    "sanskrit": "तस्यां प्रपीड्यमानायामभिमानी पुरञ्जनः अवापोरुविधांस्तापान्कुटुम्बी ममताकुलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-006",
    "skandha": 4,
    "chapter": 28,
    "sloka": 6,
    "sanskrit": "कन्योपगूढो नष्टश्रीः कृपणो विषयात्मकः नष्टप्रज्ञो हृतैश्वर्यो गन्धर्वयवनैर्बलात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-007",
    "skandha": 4,
    "chapter": 28,
    "sloka": 7,
    "sanskrit": "विशीर्णां स्वपुरीं वीक्ष्य प्रतिकूलाननादृतान् पुत्रान्पौत्रानुगामात्याञ्जायां च गतसौहृदाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-008",
    "skandha": 4,
    "chapter": 28,
    "sloka": 8,
    "sanskrit": "आत्मानं कन्यया ग्रस्तं पञ्चालानरिदूषितान् दुरन्तचिन्तामापन्नो न लेभे तत्प्रतिक्रियाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-009",
    "skandha": 4,
    "chapter": 28,
    "sloka": 9,
    "sanskrit": "कामानभिलषन्दीनो यातयामांश्च कन्यया विगतात्मगतिस्नेहः पुत्रदारांश्च लालयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-010",
    "skandha": 4,
    "chapter": 28,
    "sloka": 10,
    "sanskrit": "गन्धर्वयवनाक्रान्तां कालकन्योपमर्दिताम् हातुं प्रचक्रमे राजा तां पुरीमनिकामतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-011",
    "skandha": 4,
    "chapter": 28,
    "sloka": 11,
    "sanskrit": "भयनाम्नोऽग्रजो भ्राता प्रज्वारः प्रत्युपस्थितः ददाह तां पुरीं कृत्स्नां भ्रातुः प्रियचिकीर्षया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-012",
    "skandha": 4,
    "chapter": 28,
    "sloka": 12,
    "sanskrit": "तस्यां सन्दह्यमानायां सपौरः सपरिच्छदः कौटुम्बिकः कुटुम्बिन्या उपातप्यत सान्वयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-013",
    "skandha": 4,
    "chapter": 28,
    "sloka": 13,
    "sanskrit": "यवनोपरुद्धायतनो ग्रस्तायां कालकन्यया पुर्यां प्रज्वारसंसृष्टः पुरपालोऽन्वतप्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-014",
    "skandha": 4,
    "chapter": 28,
    "sloka": 14,
    "sanskrit": "न शेके सोऽवितुं तत्र पुरुकृच्छ्रोरुवेपथुः गन्तुमैच्छत्ततो वृक्ष कोटरादिव सानलात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-015",
    "skandha": 4,
    "chapter": 28,
    "sloka": 15,
    "sanskrit": "शिथिलावयवो यर्हि गन्धर्वैर्हृतपौरुषः यवनैररिभी राजन्नुपरुद्धो रुरोद ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-016",
    "skandha": 4,
    "chapter": 28,
    "sloka": 16,
    "sanskrit": "दुहितॄः पुत्रपौत्रांश्च जामिजामातृपार्षदान् स्वत्वावशिष्टं यत्किञ्चिद्गृहकोशपरिच्छदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-017",
    "skandha": 4,
    "chapter": 28,
    "sloka": 17,
    "sanskrit": "अहं ममेति स्वीकृत्य गृहेषु कुमतिर्गृही दध्यौ प्रमदया दीनो विप्रयोग उपस्थिते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-018",
    "skandha": 4,
    "chapter": 28,
    "sloka": 18,
    "sanskrit": "लोकान्तरं गतवति मय्यनाथा कुटुम्बिनी वर्तिष्यते कथं त्वेषा बालकाननुशोचती",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-019",
    "skandha": 4,
    "chapter": 28,
    "sloka": 19,
    "sanskrit": "न मय्यनाशिते भुङ्क्ते नास्नाते स्नाति मत्परा मयि रुष्टे सुसन्त्रस्ता भर्त्सिते यतवाग्भयात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-020",
    "skandha": 4,
    "chapter": 28,
    "sloka": 20,
    "sanskrit": "प्रबोधयति माविज्ञं व्युषिते शोककर्शिता वर्त्मैतद्गृहमेधीयं वीरसूरपि नेष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-021",
    "skandha": 4,
    "chapter": 28,
    "sloka": 21,
    "sanskrit": "कथं नु दारका दीना दारकीर्वापरायणाः वर्तिष्यन्ते मयि गते भिन्ननाव इवोदधौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-022",
    "skandha": 4,
    "chapter": 28,
    "sloka": 22,
    "sanskrit": "एवं कृपणया बुद्ध्या शोचन्तमतदर्हणम् ग्रहीतुं कृतधीरेनं भयनामाभ्यपद्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-023",
    "skandha": 4,
    "chapter": 28,
    "sloka": 23,
    "sanskrit": "पशुवद्यवनैरेष नीयमानः स्वकं क्षयम् अन्वद्रवन्ननुपथाः शोचन्तो भृशमातुराः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-024",
    "skandha": 4,
    "chapter": 28,
    "sloka": 24,
    "sanskrit": "पुरीं विहायोपगत उपरुद्धो भुजङ्गमः यदा तमेवानु पुरी विशीर्णा प्रकृतिं गता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-025",
    "skandha": 4,
    "chapter": 28,
    "sloka": 25,
    "sanskrit": "विकृष्यमाणः प्रसभं यवनेन बलीयसा नाविन्दत्तमसाविष्टः सखायं सुहृदं पुरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-026",
    "skandha": 4,
    "chapter": 28,
    "sloka": 26,
    "sanskrit": "तं यज्ञपशवोऽनेन संज्ञप्ता येऽदयालुना कुठारैश्चिच्छिदुः क्रुद्धाः स्मरन्तोऽमीवमस्य तत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-027",
    "skandha": 4,
    "chapter": 28,
    "sloka": 27,
    "sanskrit": "अनन्तपारे तमसि मग्नो नष्टस्मृतिः समाः शाश्वतीरनुभूयार्तिं प्रमदासङ्गदूषितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-028",
    "skandha": 4,
    "chapter": 28,
    "sloka": 28,
    "sanskrit": "तामेव मनसा गृह्णन्बभूव प्रमदोत्तमा अनन्तरं विदर्भस्य राजसिंहस्य वेश्मनि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-029",
    "skandha": 4,
    "chapter": 28,
    "sloka": 29,
    "sanskrit": "उपयेमे वीर्यपणां वैदर्भीं मलयध्वजः युधि निर्जित्य राजन्यान्पाण्ड्यः परपुरञ्जयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-030",
    "skandha": 4,
    "chapter": 28,
    "sloka": 30,
    "sanskrit": "तस्यां स जनयां चक्र आत्मजामसितेक्षणाम् यवीयसः सप्त सुतान्सप्त द्रविडभूभृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-031",
    "skandha": 4,
    "chapter": 28,
    "sloka": 31,
    "sanskrit": "एकैकस्याभवत्तेषां राजन्नर्बुदमर्बुदम् भोक्ष्यते यद्वंशधरैर्मही मन्वन्तरं परम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-032",
    "skandha": 4,
    "chapter": 28,
    "sloka": 32,
    "sanskrit": "अगस्त्यः प्राग्दुहितरमुपयेमे धृतव्रताम् यस्यां दृढच्युतो जात इध्मवाहात्मजो मुनिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-033",
    "skandha": 4,
    "chapter": 28,
    "sloka": 33,
    "sanskrit": "विभज्य तनयेभ्यः क्ष्मां राजर्षिर्मलयध्वजः आरिराधयिषुः कृष्णं स जगाम कुलाचलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-034",
    "skandha": 4,
    "chapter": 28,
    "sloka": 34,
    "sanskrit": "हित्वा गृहान्सुतान्भोगान्वैदर्भी मदिरेक्षणा अन्वधावत पाण्ड्येशं ज्योत्स्नेव रजनीकरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-035",
    "skandha": 4,
    "chapter": 28,
    "sloka": 35,
    "sanskrit": "तत्र चन्द्रवसा नाम ताम्रपर्णी वटोदका तत्पुण्यसलिलैर्नित्यमुभयत्रात्मनो मृजन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-036",
    "skandha": 4,
    "chapter": 28,
    "sloka": 36,
    "sanskrit": "कन्दाष्टिभिर्मूलफलैः पुष्पपर्णैस्तृणोदकैः वर्तमानः शनैर्गात्र कर्शनं तप आस्थितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-037",
    "skandha": 4,
    "chapter": 28,
    "sloka": 37,
    "sanskrit": "शीतोष्णवातवर्षाणि क्षुत्पिपासे प्रियाप्रिये सुखदुःखे इति द्वन्द्वान्यजयत्समदर्शनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-038",
    "skandha": 4,
    "chapter": 28,
    "sloka": 38,
    "sanskrit": "तपसा विद्यया पक्व कषायो नियमैर्यमैः युयुजे ब्रह्मण्यात्मानं विजिताक्षानिलाशयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-039",
    "skandha": 4,
    "chapter": 28,
    "sloka": 39,
    "sanskrit": "आस्ते स्थाणुरिवैकत्र दिव्यं वर्षशतं स्थिरः वासुदेवे भगवति नान्यद्वेदोद्वहन्रतिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-040",
    "skandha": 4,
    "chapter": 28,
    "sloka": 40,
    "sanskrit": "स व्यापकतयात्मानं व्यतिरिक्ततयात्मनि विद्वान्स्वप्न इवामर्श साक्षिणं विरराम ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-041",
    "skandha": 4,
    "chapter": 28,
    "sloka": 41,
    "sanskrit": "साक्षाद्भगवतोक्तेन गुरुणा हरिणा नृप विशुद्धज्ञानदीपेन स्फुरता विश्वतोमुखम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-042",
    "skandha": 4,
    "chapter": 28,
    "sloka": 42,
    "sanskrit": "परे ब्रह्मणि चात्मानं परं ब्रह्म तथात्मनि वीक्षमाणो विहायेक्षामस्मादुपरराम ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-043",
    "skandha": 4,
    "chapter": 28,
    "sloka": 43,
    "sanskrit": "पतिं परमधर्मज्ञं वैदर्भी मलयध्वजम् प्रेम्णा पर्यचरद्धित्वा भोगान्सा पतिदेवता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-044",
    "skandha": 4,
    "chapter": 28,
    "sloka": 44,
    "sanskrit": "चीरवासा व्रतक्षामा वेणीभूतशिरोरुहा बभावुप पतिं शान्ता शिखा शान्तमिवानलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-045",
    "skandha": 4,
    "chapter": 28,
    "sloka": 45,
    "sanskrit": "अजानती प्रियतमं यदोपरतमङ्गना सुस्थिरासनमासाद्य यथापूर्वमुपाचरत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-28-sloka-046",
    "skandha": 4,
    "chapter": 28,
    "sloka": 46,
    "sanskrit": "यदा नोपलभेताङ्घ्रावूष्माणं पत्युरर्चती आसीत्संविग्नहृदया यूथभ्रष्टा मृगी यथा",
