[
  {
    "id": "skandha-04-chapter-25-sloka-001",
    "skandha": 4,
    "chapter": 25,
    "sloka": 1,
    "sanskrit": "इति सन्दिश्य भगवान्बार्हिषदैरभिपूजितः पश्यतां राजपुत्राणां तत्रैवान्तर्दधे हरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "मैत्रेय उवाच ।"
  },
  {
    "id": "skandha-04-chapter-25-sloka-002",
    "skandha": 4,
    "chapter": 25,
    "sloka": 2,
    "sanskrit": "रुद्रगीतं भगवतः स्तोत्रं सर्वे प्रचेतसः जपन्तस्ते तपस्तेपुर्वर्षाणामयुतं जले",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-003",
    "skandha": 4,
    "chapter": 25,
    "sloka": 3,
    "sanskrit": "प्राचीनबर्हिषं क्षत्तः कर्मस्वासक्तमानसम् नारदोऽध्यात्मतत्त्वज्ञः कृपालुः प्रत्यबोधयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-004",
    "skandha": 4,
    "chapter": 25,
    "sloka": 4,
    "sanskrit": "श्रेयस्त्वं कतमद्राजन्कर्मणात्मन ईहसे दुःखहानिः सुखावाप्तिः श्रेयस्तन्नेह चेष्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-005",
    "skandha": 4,
    "chapter": 25,
    "sloka": 5,
    "sanskrit": "न जानामि महाभाग परं कर्मापविद्धधीः ब्रूहि मे विमलं ज्ञानं येन मुच्येय कर्मभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "राजोवाच ।"
  },
  {
    "id": "skandha-04-chapter-25-sloka-006",
    "skandha": 4,
    "chapter": 25,
    "sloka": 6,
    "sanskrit": "गृहेषु कूटधर्मेषु पुत्रदारधनार्थधीः न परं विन्दते मूढो भ्राम्यन्संसारवर्त्मसु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-007",
    "skandha": 4,
    "chapter": 25,
    "sloka": 7,
    "sanskrit": "भो भोः प्रजापते राजन्पशून्पश्य त्वयाध्वरे संज्ञापिताञ्जीवसङ्घान्निर्घृणेन सहस्रशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "नारद उवाच ।"
  },
  {
    "id": "skandha-04-chapter-25-sloka-008",
    "skandha": 4,
    "chapter": 25,
    "sloka": 8,
    "sanskrit": "एते त्वां सम्प्रतीक्षन्ते स्मरन्तो वैशसं तव सम्परेतमयःकूटैश्छिन्दन्त्युत्थितमन्यवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-009",
    "skandha": 4,
    "chapter": 25,
    "sloka": 9,
    "sanskrit": "अत्र ते कथयिष्येऽमुमितिहासं पुरातनम् पुरञ्जनस्य चरितं निबोध गदतो मम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-010",
    "skandha": 4,
    "chapter": 25,
    "sloka": 10,
    "sanskrit": "आसीत्पुरञ्जनो नाम राजा राजन्बृहच्छ्रवाः तस्याविज्ञातनामासीत्सखाविज्ञातचेष्टितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-011",
    "skandha": 4,
    "chapter": 25,
    "sloka": 11,
    "sanskrit": "सोऽन्वेषमाणः शरणं बभ्राम पृथिवीं प्रभुः नानुरूपं यदाविन्ददभूत्स विमना इव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-012",
    "skandha": 4,
    "chapter": 25,
    "sloka": 12,
    "sanskrit": "न साधु मेने ताः सर्वा भूतले यावतीः पुरः कामान्कामयमानोऽसौ तस्य तस्योपपत्तये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-013",
    "skandha": 4,
    "chapter": 25,
    "sloka": 13,
    "sanskrit": "स एकदा हिमवतो दक्षिणेष्वथ सानुषु ददर्श नवभिर्द्वार्भिः पुरं लक्षितलक्षणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-014",
    "skandha": 4,
    "chapter": 25,
    "sloka": 14,
    "sanskrit": "प्राकारोपवनाट्टाल परिखैरक्षतोरणैः स्वर्णरौप्यायसैः शृङ्गैः सङ्कुलां सर्वतो गृहैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-015",
    "skandha": 4,
    "chapter": 25,
    "sloka": 15,
    "sanskrit": "नीलस्फटिकवैदूर्य मुक्तामरकतारुणैः कॢप्तहर्म्यस्थलीं दीप्तां श्रिया भोगवतीमिव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-016",
    "skandha": 4,
    "chapter": 25,
    "sloka": 16,
    "sanskrit": "सभाचत्वररथ्याभिराक्रीडायतनापणैः चैत्यध्वजपताकाभिर्युक्तां विद्रुमवेदिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-017",
    "skandha": 4,
    "chapter": 25,
    "sloka": 17,
    "sanskrit": "पुर्यास्तु बाह्योपवने दिव्यद्रुमलताकुले नदद्विहङ्गालिकुल कोलाहलजलाशये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-018",
    "skandha": 4,
    "chapter": 25,
    "sloka": 18,
    "sanskrit": "हिमनिर्झरविप्रुष्मत् कुसुमाकरवायुना चलत्प्रवालविटप नलिनीतटसम्पदि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-019",
    "skandha": 4,
    "chapter": 25,
    "sloka": 19,
    "sanskrit": "नानारण्यमृगव्रातैरनाबाधे मुनिव्रतैः आहूतं मन्यते पान्थो यत्र कोकिलकूजितैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-020",
    "skandha": 4,
    "chapter": 25,
    "sloka": 20,
    "sanskrit": "यदृच्छयागतां तत्र ददर्श प्रमदोत्तमाम् भृत्यैर्दशभिरायान्तीमेकैकशतनायकैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-021",
    "skandha": 4,
    "chapter": 25,
    "sloka": 21,
    "sanskrit": "अञ्चशीर्षाहिना गुप्तां प्रतीहारेण सर्वतः अन्वेषमाणामृषभमप्रौढां कामरूपिणीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-022",
    "skandha": 4,
    "chapter": 25,
    "sloka": 22,
    "sanskrit": "सुनासां सुदतीं बालां सुकपोलां वराननाम् समविन्यस्तकर्णाभ्यां बिभ्रतीं कुण्डलश्रियम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-023",
    "skandha": 4,
    "chapter": 25,
    "sloka": 23,
    "sanskrit": "पिशङ्गनीवीं सुश्रोणीं श्यामां कनकमेखलाम् पद्भ्यां क्वणद्भ्यां चलन्तीं नूपुरैर्देवतामिव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-024",
    "skandha": 4,
    "chapter": 25,
    "sloka": 24,
    "sanskrit": "स्तनौ व्यञ्जितकैशोरौ समवृत्तौ निरन्तरौ वस्त्रान्तेन निगूहन्तीं व्रीडया गजगामिनीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-025",
    "skandha": 4,
    "chapter": 25,
    "sloka": 25,
    "sanskrit": "तामाह ललितं वीरः सव्रीडस्मितशोभनाम् स्निग्धेनापाङ्गपुङ्खेन स्पृष्टः प्रेमोद्भ्रमद्भ्रुवा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-026",
    "skandha": 4,
    "chapter": 25,
    "sloka": 26,
    "sanskrit": "का त्वं कञ्जपलाशाक्षि कस्यासीह कुतः सति इमामुप पुरीं भीरु किं चिकीर्षसि शंस मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-027",
    "skandha": 4,
    "chapter": 25,
    "sloka": 27,
    "sanskrit": "क एतेऽनुपथा ये त एकादश महाभटाः एता वा ललनाः सुभ्रु कोऽयं तेऽहिः पुरःसरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-028",
    "skandha": 4,
    "chapter": 25,
    "sloka": 28,
    "sanskrit": "त्वं ह्रीर्भवान्यस्यथ वाग्रमा पतिं विचिन्वती किं मुनिवद्रहो वने त्वदङ्घ्रिकामाप्तसमस्तकामं क्व पद्मकोशः पतितः कराग्रात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-029",
    "skandha": 4,
    "chapter": 25,
    "sloka": 29,
    "sanskrit": "नासां वरोर्वन्यतमा भुविस्पृक्पुरीमिमां वीरवरेण साकम् अर्हस्यलङ्कर्तुमदभ्रकर्मणा लोकं परं श्रीरिव यज्ञपुंसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-030",
    "skandha": 4,
    "chapter": 25,
    "sloka": 30,
    "sanskrit": "यदेष मापाङ्गविखण्डितेन्द्रियं सव्रीडभावस्मितविभ्रमद्भ्रुवा त्वयोपसृष्टो भगवान्मनोभवः प्रबाधतेऽथानुगृहाण शोभने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-031",
    "skandha": 4,
    "chapter": 25,
    "sloka": 31,
    "sanskrit": "त्वदाननं सुभ्रु सुतारलोचनं व्यालम्बिनीलालकवृन्दसंवृतम् उन्नीय मे दर्शय वल्गुवाचकं यद्व्रीडया नाभिमुखं शुचिस्मिते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-032",
    "skandha": 4,
    "chapter": 25,
    "sloka": 32,
    "sanskrit": "इत्थं पुरञ्जनं नारी याचमानमधीरवत् अभ्यनन्दत तं वीरं हसन्ती वीर मोहिता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "नारद उवाच ।"
  },
  {
    "id": "skandha-04-chapter-25-sloka-033",
    "skandha": 4,
    "chapter": 25,
    "sloka": 33,
    "sanskrit": "न विदाम वयं सम्यक्कर्तारं पुरुषर्षभ आत्मनश्च परस्यापि गोत्रं नाम च यत्कृतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-034",
    "skandha": 4,
    "chapter": 25,
    "sloka": 34,
    "sanskrit": "इहाद्य सन्तमात्मानं विदाम न ततः परम् येनेयं निर्मिता वीर पुरी शरणमात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-035",
    "skandha": 4,
    "chapter": 25,
    "sloka": 35,
    "sanskrit": "एते सखायः सख्यो मे नरा नार्यश्च मानद सुप्तायां मयि जागर्ति नागोऽयं पालयन्पुरीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-036",
    "skandha": 4,
    "chapter": 25,
    "sloka": 36,
    "sanskrit": "दिष्ट्यागतोऽसि भद्रं ते ग्राम्यान्कामानभीप्ससे उद्वहिष्यामि तांस्तेऽहं स्वबन्धुभिररिन्दम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-037",
    "skandha": 4,
    "chapter": 25,
    "sloka": 37,
    "sanskrit": "इमां त्वमधितिष्ठस्व पुरीं नवमुखीं विभो मयोपनीतान्गृह्णानः कामभोगान्शतं समाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-038",
    "skandha": 4,
    "chapter": 25,
    "sloka": 38,
    "sanskrit": "कं नु त्वदन्यं रमये ह्यरतिज्ञमकोविदम् असम्परायाभिमुखमश्वस्तनविदं पशुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-039",
    "skandha": 4,
    "chapter": 25,
    "sloka": 39,
    "sanskrit": "धर्मो ह्यत्रार्थकामौ च प्रजानन्दोऽमृतं यशः लोका विशोका विरजा यान्न केवलिनो विदुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-040",
    "skandha": 4,
    "chapter": 25,
    "sloka": 40,
    "sanskrit": "पितृदेवर्षिमर्त्यानां भूतानामात्मनश्च ह क्षेम्यं वदन्ति शरणं भवेऽस्मिन्यद्गृहाश्रमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-041",
    "skandha": 4,
    "chapter": 25,
    "sloka": 41,
    "sanskrit": "का नाम वीर विख्यातं वदान्यं प्रियदर्शनम् न वृणीत प्रियं प्राप्तं मादृशी त्वादृशं पतिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-042",
    "skandha": 4,
    "chapter": 25,
    "sloka": 42,
    "sanskrit": "कस्या मनस्ते भुवि भोगिभोगयोः स्त्रिया न सज्जेद्भुजयोर्महाभुज योऽनाथवर्गाधिमलं घृणोद्धत स्मितावलोकेन चरत्यपोहितुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-043",
    "skandha": 4,
    "chapter": 25,
    "sloka": 43,
    "sanskrit": "इति तौ दम्पती तत्र समुद्य समयं मिथः तां प्रविश्य पुरीं राजन्मुमुदाते शतं समाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "नारद उवाच ।"
  },
  {
    "id": "skandha-04-chapter-25-sloka-044",
    "skandha": 4,
    "chapter": 25,
    "sloka": 44,
    "sanskrit": "उपगीयमानो ललितं तत्र तत्र च गायकैः क्रीडन्परिवृतः स्त्रीभिर्ह्रदिनीमाविशच्छुचौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-25-sloka-045",
    "skandha": 4,
    "chapter": 25,
    "sloka": 45,
