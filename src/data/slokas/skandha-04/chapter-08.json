[
  {
    "id": "skandha-04-chapter-08-sloka-001",
    "skandha": 4,
    "chapter": 8,
    "sloka": 1,
    "malayalamMeaning": "മൈത്രേയൻ പറഞ്ഞു: 'ഉത്താനപാദ മഹാരാജാവിന് സുനീതി, സുരുചി എന്നീ രണ്ട് ഭാര്യമാരുണ്ടായിരുന്നു. സുരുചിയിൽ അതീവ പ്രിയനായിരുന്ന രാജാവ് സുനീതിയെ ഉപേക്ഷിച്ചതുപോലെ കഴിഞ്ഞുകൂടി.'",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "മൈത്രേയൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-04-chapter-08-sloka-002",
    "skandha": 4,
    "chapter": 8,
    "sloka": 2,
    "malayalamMeaning": "സുനീതിയുടെ പുത്രനായ ധ്രുവൻ പിതാവിന്റെ മടിയിലിരിക്കാൻ ആഗ്രഹിച്ചപ്പോൾ, രണ്ടാനമ്മയായ സുരുചി അവനെ തടയുകയും നിന്ദിച്ചു സംസാരിക്കുകയും ചെയ്തു: 'എന്റെ ഗർഭത്തിൽ ജനിക്കാത്ത നിനക്ക് രാജസിംഹാസനത്തിലിരിക്കാൻ അർഹതയില്ല.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-08-sloka-003",
    "skandha": 4,
    "chapter": 8,
    "sloka": 3,
    "malayalamMeaning": "അമ്മയായ സുനീതിയുടെ ഉപദേശപ്രകാരം പരമപുരുഷനായ ഭഗവാനെ തപസ്സുചെയ്യാൻ നിശ്ചയിച്ച് അഞ്ചുവയസ്സുള്ള ബാലനായ ധ്രുവൻ വനത്തിലേക്ക് പുറപ്പെട്ടു.",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-04-chapter-08-sloka-004",
    "skandha": 4,
    "chapter": 8,
    "sloka": 4,
    "malayalamMeaning": "വഴിയിൽ വെച്ച് കണ്ടുമുട്ടിയ നാരദമഹർഷി ധ്രുവന്റെ ദൃഢനിശ്ചയം കണ്ട് സന്തുഷ്ടനായി, മധുവനത്തിൽ ചെന്ന് തപസ്സു ചെയ്യാനായി ദ്വാദശാക്ഷര മന്ത്രമായ 'ഓം നമോ ഭഗവതേ വാസുദേവായ' ഉപദേശിച്ചു നൽകി.",
    "source": "Sanskrit Documents / Gitapress"
  },
