[
  {
    "id": "skandha-06-chapter-05-sloka-001",
    "skandha": 6,
    "chapter": 5,
    "sloka": 1,
    "sanskrit": "तस्यां स पाञ्चजन्यां वै विष्णुमायोपबृंहितः हर्यश्वसंज्ञानयुतं पुत्रानजनयद्विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-06-chapter-05-sloka-002",
    "skandha": 6,
    "chapter": 5,
    "sloka": 2,
    "sanskrit": "अपृथग्धर्मशीलास्ते सर्वे दाक्षायणा नृप पित्रा प्रोक्ताः प्रजासर्गे प्रतीचीं प्रययुर्दिशम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-003",
    "skandha": 6,
    "chapter": 5,
    "sloka": 3,
    "sanskrit": "तत्र नारायणसरस्तीर्थं सिन्धुसमुद्रयोः सङ्गमो यत्र सुमहन्मुनिसिद्धनिषेवितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-004",
    "skandha": 6,
    "chapter": 5,
    "sloka": 4,
    "sanskrit": "तदुपस्पर्शनादेव विनिर्धूतमलाशयाः धर्मे पारमहंस्ये च प्रोत्पन्नमतयोऽप्युत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-005",
    "skandha": 6,
    "chapter": 5,
    "sloka": 5,
    "sanskrit": "तेपिरे तप एवोग्रं पित्रादेशेन यन्त्रिताः प्रजाविवृद्धये यत्तान्देवर्षिस्तान्ददर्श ह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-006",
    "skandha": 6,
    "chapter": 5,
    "sloka": 6,
    "sanskrit": "उवाच चाथ हर्यश्वाः कथं स्रक्ष्यथ वै प्रजाः अदृष्ट्वान्तं भुवो यूयं बालिशा बत पालकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-007",
    "skandha": 6,
    "chapter": 5,
    "sloka": 7,
    "sanskrit": "तथैकपुरुषं राष्ट्रं बिलं चादृष्टनिर्गमम् बहुरूपां स्त्रियं चापि पुमांसं पुंश्चलीपतिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-008",
    "skandha": 6,
    "chapter": 5,
    "sloka": 8,
    "sanskrit": "नदीमुभयतो वाहां पञ्चपञ्चाद्भुतं गृहम् क्वचिद्धंसं चित्रकथं क्षौरपव्यं स्वयं भ्रमि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-009",
    "skandha": 6,
    "chapter": 5,
    "sloka": 9,
    "sanskrit": "कथं स्वपितुरादेशमविद्वांसो विपश्चितः अनुरूपमविज्ञाय अहो सर्गं करिष्यथ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-010",
    "skandha": 6,
    "chapter": 5,
    "sloka": 10,
    "sanskrit": "तन्निशम्याथ हर्यश्वा औत्पत्तिकमनीषया वाचः कूटं तु देवर्षेः स्वयं विममृशुर्धिया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-06-chapter-05-sloka-011",
    "skandha": 6,
    "chapter": 5,
    "sloka": 11,
    "sanskrit": "भूः क्षेत्रं जीवसंज्ञं यदनादि निजबन्धनम् अदृष्ट्वा तस्य निर्वाणं किमसत्कर्मभिर्भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-012",
    "skandha": 6,
    "chapter": 5,
    "sloka": 12,
    "sanskrit": "एक एवेश्वरस्तुर्यो भगवान्स्वाश्रयः परः तमदृष्ट्वाभवं पुंसः किमसत्कर्मभिर्भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-013",
    "skandha": 6,
    "chapter": 5,
    "sloka": 13,
    "sanskrit": "पुमान्नैवैति यद्गत्वा बिलस्वर्गं गतो यथा प्रत्यग्धामाविद इह किमसत्कर्मभिर्भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-014",
    "skandha": 6,
    "chapter": 5,
    "sloka": 14,
    "sanskrit": "नानारूपात्मनो बुद्धिः स्वैरिणीव गुणान्विता तन्निष्ठामगतस्येह किमसत्कर्मभिर्भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-015",
    "skandha": 6,
    "chapter": 5,
    "sloka": 15,
    "sanskrit": "तत्सङ्गभ्रंशितैश्वर्यं संसरन्तं कुभार्यवत् तद्गतीरबुधस्येह किमसत्कर्मभिर्भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-016",
    "skandha": 6,
    "chapter": 5,
    "sloka": 16,
    "sanskrit": "सृष्ट्यप्ययकरीं मायां वेलाकूलान्तवेगिताम् मत्तस्य तामविज्ञस्य किमसत्कर्मभिर्भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-017",
    "skandha": 6,
    "chapter": 5,
    "sloka": 17,
    "sanskrit": "पञ्चविंशतितत्त्वानां पुरुषोऽद्भुतदर्पणः अध्यात्ममबुधस्येह किमसत्कर्मभिर्भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-018",
    "skandha": 6,
    "chapter": 5,
    "sloka": 18,
    "sanskrit": "ऐश्वरं शास्त्रमुत्सृज्य बन्धमोक्षानुदर्शनम् विविक्तपदमज्ञाय किमसत्कर्मभिर्भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-019",
    "skandha": 6,
    "chapter": 5,
    "sloka": 19,
    "sanskrit": "कालचक्रं भ्रमि तीक्ष्णं सर्वं निष्कर्षयज्जगत् स्वतन्त्रमबुधस्येह किमसत्कर्मभिर्भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-020",
    "skandha": 6,
    "chapter": 5,
    "sloka": 20,
    "sanskrit": "शास्त्रस्य पितुरादेशं यो न वेद निवर्तकम् कथं तदनुरूपाय गुणविस्रम्भ्युपक्रमेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-021",
    "skandha": 6,
    "chapter": 5,
    "sloka": 21,
    "sanskrit": "इति व्यवसिता राजन्हर्यश्वा एकचेतसः प्रययुस्तं परिक्रम्य पन्थानमनिवर्तनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-022",
    "skandha": 6,
    "chapter": 5,
    "sloka": 22,
    "sanskrit": "स्वरब्रह्मणि निर्भात हृषीकेशपदाम्बुजे अखण्डं चित्तमावेश्य लोकाननुचरन्मुनिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-023",
    "skandha": 6,
    "chapter": 5,
    "sloka": 23,
    "sanskrit": "नाशं निशम्य पुत्राणां नारदाच्छीलशालिनाम् अन्वतप्यत कः शोचन्सुप्रजस्त्वं शुचां पदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-024",
    "skandha": 6,
    "chapter": 5,
    "sloka": 24,
    "sanskrit": "स भूयः पाञ्चजन्यायामजेन परिसान्त्वितः पुत्रानजनयद्दक्षः सवलाश्वान्सहस्रिणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-025",
    "skandha": 6,
    "chapter": 5,
    "sloka": 25,
    "sanskrit": "ते च पित्रा समादिष्टाः प्रजासर्गे धृतव्रताः नारायणसरो जग्मुर्यत्र सिद्धाः स्वपूर्वजाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-026",
    "skandha": 6,
    "chapter": 5,
    "sloka": 26,
    "sanskrit": "तदुपस्पर्शनादेव विनिर्धूतमलाशयाः जपन्तो ब्रह्म परमं तेपुस्तत्र महत्तपः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-027",
    "skandha": 6,
    "chapter": 5,
    "sloka": 27,
    "sanskrit": "अब्भक्षाः कतिचिन्मासान्कतिचिद्वायुभोजनाः आराधयन्मन्त्रमिममभ्यस्यन्त इडस्पतिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-028",
    "skandha": 6,
    "chapter": 5,
    "sloka": 28,
    "sanskrit": "ओं नमो नारायणाय पुरुषाय महात्मने विशुद्धसत्त्वधिष्ण्याय महाहंसाय धीमहि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-029",
    "skandha": 6,
    "chapter": 5,
    "sloka": 29,
    "sanskrit": "इति तानपि राजेन्द्र प्रजासर्गधियो मुनिः उपेत्य नारदः प्राह वाचः कूटानि पूर्ववत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-030",
    "skandha": 6,
    "chapter": 5,
    "sloka": 30,
    "sanskrit": "दाक्षायणाः संशृणुत गदतो निगमं मम अन्विच्छतानुपदवीं भ्रातॄणां भ्रातृवत्सलाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-031",
    "skandha": 6,
    "chapter": 5,
    "sloka": 31,
    "sanskrit": "भ्रातॄणां प्रायणं भ्राता योऽनुतिष्ठति धर्मवित् स पुण्यबन्धुः पुरुषो मरुद्भिः सह मोदते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-032",
    "skandha": 6,
    "chapter": 5,
    "sloka": 32,
    "sanskrit": "एतावदुक्त्वा प्रययौ नारदोऽमोघदर्शनः तेऽपि चान्वगमन्मार्गं भ्रातॄणामेव मारिष",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-033",
    "skandha": 6,
    "chapter": 5,
    "sloka": 33,
    "sanskrit": "सध्रीचीनं प्रतीचीनं परस्यानुपथं गताः नाद्यापि ते निवर्तन्ते पश्चिमा यामिनीरिव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-034",
    "skandha": 6,
    "chapter": 5,
    "sloka": 34,
    "sanskrit": "एतस्मिन्काल उत्पातान्बहून्पश्यन्प्रजापतिः पूर्ववन्नारदकृतं पुत्रनाशमुपाशृणोत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-035",
    "skandha": 6,
    "chapter": 5,
    "sloka": 35,
    "sanskrit": "चुक्रोध नारदायासौ पुत्रशोकविमूर्च्छितः देवर्षिमुपलभ्याह रोषाद्विस्फुरिताधरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-036",
    "skandha": 6,
    "chapter": 5,
    "sloka": 36,
    "sanskrit": "अहो असाधो साधूनां साधुलिङ्गेन नस्त्वया असाध्वकार्यर्भकाणां भिक्षोर्मार्गः प्रदर्शितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीदक्ष उवाच ।"
  },
  {
    "id": "skandha-06-chapter-05-sloka-037",
    "skandha": 6,
    "chapter": 5,
    "sloka": 37,
    "sanskrit": "ऋणैस्त्रिभिरमुक्तानाममीमांसितकर्मणाम् विघातः श्रेयसः पाप लोकयोरुभयोः कृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-038",
    "skandha": 6,
    "chapter": 5,
    "sloka": 38,
    "sanskrit": "एवं त्वं निरनुक्रोशो बालानां मतिभिद्धरेः पार्षदमध्ये चरसि यशोहा निरपत्रपः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-039",
    "skandha": 6,
    "chapter": 5,
    "sloka": 39,
    "sanskrit": "ननु भागवता नित्यं भूतानुग्रहकातराः ऋते त्वां सौहृदघ्नं वै वैरङ्करमवैरिणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-040",
    "skandha": 6,
    "chapter": 5,
    "sloka": 40,
    "sanskrit": "नेत्थं पुंसां विरागः स्यात्त्वया केवलिना मृषा मन्यसे यद्युपशमं स्नेहपाशनिकृन्तनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-041",
    "skandha": 6,
    "chapter": 5,
    "sloka": 41,
    "sanskrit": "नानुभूय न जानाति पुमान्विषयतीक्ष्णताम् निर्विद्यते स्वयं तस्मान्न तथा भिन्नधीः परैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-042",
    "skandha": 6,
    "chapter": 5,
    "sloka": 42,
    "sanskrit": "यन्नस्त्वं कर्मसन्धानां साधूनां गृहमेधिनाम् कृतवानसि दुर्मर्षं विप्रियं तव मर्षितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-043",
    "skandha": 6,
    "chapter": 5,
    "sloka": 43,
    "sanskrit": "तन्तुकृन्तन यन्नस्त्वमभद्रमचरः पुनः तस्माल्लोकेषु ते मूढ न भवेद्भ्रमतः पदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-05-sloka-044",
    "skandha": 6,
    "chapter": 5,
    "sloka": 44,
    "sanskrit": "प्रतिजग्राह तद्बाढं नारदः साधुसम्मतः एतावान्साधुवादो हि तितिक्षेतेश्वरः स्वयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  }
]