[
  {
    "id": "skandha-06-chapter-15-sloka-001",
    "skandha": 6,
    "chapter": 15,
    "sloka": 1,
    "sanskrit": "ऊचतुर्मृतकोपान्ते पतितं मृतकोपमम् शोकाभिभूतं राजानं बोधयन्तौ सदुक्तिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-06-chapter-15-sloka-002",
    "skandha": 6,
    "chapter": 15,
    "sloka": 2,
    "sanskrit": "कोऽयं स्यात्तव राजेन्द्र भवान्यमनुशोचति त्वं चास्य कतमः सृष्टौ पुरेदानीमतः परम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-003",
    "skandha": 6,
    "chapter": 15,
    "sloka": 3,
    "sanskrit": "यथा प्रयान्ति संयान्ति स्रोतोवेगेन बालुकाः संयुज्यन्ते वियुज्यन्ते तथा कालेन देहिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-004",
    "skandha": 6,
    "chapter": 15,
    "sloka": 4,
    "sanskrit": "यथा धानासु वै धाना भवन्ति न भवन्ति च एवं भूतानि भूतेषु चोदितानीशमायया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-005",
    "skandha": 6,
    "chapter": 15,
    "sloka": 5,
    "sanskrit": "वयं च त्वं च ये चेमे तुल्यकालाश्चराचराः जन्ममृत्योर्यथा पश्चात्प्राङ्नैवमधुनापि भोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-006",
    "skandha": 6,
    "chapter": 15,
    "sloka": 6,
    "sanskrit": "भूतैर्भूतानि भूतेशः सृजत्यवति हन्ति च आत्मसृष्टैरस्वतन्त्रैरनपेक्षोऽपि बालवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-007",
    "skandha": 6,
    "chapter": 15,
    "sloka": 7,
    "sanskrit": "देहेन देहिनो राजन्देहाद्देहोऽभिजायते बीजादेव यथा बीजं देह्यर्थ इव शाश्वतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-008",
    "skandha": 6,
    "chapter": 15,
    "sloka": 8,
    "sanskrit": "देहदेहिविभागोऽयमविवेककृतः पुरा जातिव्यक्तिविभागोऽयं यथा वस्तुनि कल्पितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-009",
    "skandha": 6,
    "chapter": 15,
    "sloka": 9,
    "sanskrit": "एवमाश्वासितो राजा चित्रकेतुर्द्विजोक्तिभिः विमृज्य पाणिना वक्त्रमाधिम्लानमभाषत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-06-chapter-15-sloka-010",
    "skandha": 6,
    "chapter": 15,
    "sloka": 10,
    "sanskrit": "कौ युवां ज्ञानसम्पन्नौ महिष्ठौ च महीयसाम् अवधूतेन वेषेण गूढाविह समागतौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीराजोवाच ।"
  },
  {
    "id": "skandha-06-chapter-15-sloka-011",
    "skandha": 6,
    "chapter": 15,
    "sloka": 11,
    "sanskrit": "चरन्ति ह्यवनौ कामं ब्राह्मणा भगवत्प्रियाः मादृशां ग्राम्यबुद्धीनां बोधायोन्मत्तलिङ्गिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-012",
    "skandha": 6,
    "chapter": 15,
    "sloka": 12,
    "sanskrit": "कुमारो नारद ऋभुरङ्गिरा देवलोऽसितः अपान्तरतमा व्यासो मार्कण्डेयोऽथ गौतमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-013",
    "skandha": 6,
    "chapter": 15,
    "sloka": 13,
    "sanskrit": "वसिष्ठो भगवान्रामः कपिलो बादरायणिः दुर्वासा याज्ञवल्क्यश्च जातुकर्णस्तथारुणिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-014",
    "skandha": 6,
    "chapter": 15,
    "sloka": 14,
    "sanskrit": "रोमशश्च्यवनो दत्त आसुरिः सपतञ्जलिः ऋषिर्वेदशिरा धौम्यो मुनिः पञ्चशिखस्तथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-015",
    "skandha": 6,
    "chapter": 15,
    "sloka": 15,
    "sanskrit": "हिरण्यनाभः कौशल्यः श्रुतदेव ऋतध्वजः एते परे च सिद्धेशाश्चरन्ति ज्ञानहेतवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-016",
    "skandha": 6,
    "chapter": 15,
    "sloka": 16,
    "sanskrit": "तस्माद्युवां ग्राम्यपशोर्मम मूढधियः प्रभू अन्धे तमसि मग्नस्य ज्ञानदीप उदीर्यताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-017",
    "skandha": 6,
    "chapter": 15,
    "sloka": 17,
    "sanskrit": "अहं ते पुत्रकामस्य पुत्रदोऽस्म्यङ्गिरा नृप एष ब्रह्मसुतः साक्षान्नारदो भगवानृषिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीअङ्गिरा उवाच ।"
  },
  {
    "id": "skandha-06-chapter-15-sloka-018",
    "skandha": 6,
    "chapter": 15,
    "sloka": 18,
    "sanskrit": "इत्थं त्वां पुत्रशोकेन मग्नं तमसि दुस्तरे अतदर्हमनुस्मृत्य महापुरुषगोचरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-019",
    "skandha": 6,
    "chapter": 15,
    "sloka": 19,
    "sanskrit": "अनुग्रहाय भवतः प्राप्तावावामिह प्रभो ब्रह्मण्यो भगवद्भक्तो नावासादितुमर्हसि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-020",
    "skandha": 6,
    "chapter": 15,
    "sloka": 20,
    "sanskrit": "तदैव ते परं ज्ञानं ददामि गृहमागतः ज्ञात्वान्याभिनिवेशं ते पुत्रमेव ददाम्यहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-021",
    "skandha": 6,
    "chapter": 15,
    "sloka": 21,
    "sanskrit": "अधुना पुत्रिणां तापो भवतैवानुभूयते एवं दारा गृहा रायो विविधैश्वर्यसम्पदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-022",
    "skandha": 6,
    "chapter": 15,
    "sloka": 22,
    "sanskrit": "शब्दादयश्च विषयाश्चला राज्यविभूतयः मही राज्यं बलं कोषो भृत्यामात्यसुहृज्जनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-023",
    "skandha": 6,
    "chapter": 15,
    "sloka": 23,
    "sanskrit": "सर्वेऽपि शूरसेनेमे शोकमोहभयार्तिदाः गन्धर्वनगरप्रख्याः स्वप्नमायामनोरथाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-024",
    "skandha": 6,
    "chapter": 15,
    "sloka": 24,
    "sanskrit": "दृश्यमाना विनार्थेन न दृश्यन्ते मनोभवाः कर्मभिर्ध्यायतो नाना कर्माणि मनसोऽभवन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-025",
    "skandha": 6,
    "chapter": 15,
    "sloka": 25,
    "sanskrit": "अयं हि देहिनो देहो द्रव्यज्ञानक्रियात्मकः देहिनो विविधक्लेश सन्तापकृदुदाहृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-026",
    "skandha": 6,
    "chapter": 15,
    "sloka": 26,
    "sanskrit": "तस्मात्स्वस्थेन मनसा विमृश्य गतिमात्मनः द्वैते ध्रुवार्थविश्रम्भं त्यजोपशममाविश",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-15-sloka-027",
    "skandha": 6,
    "chapter": 15,
    "sloka": 27,
    "sanskrit": "एतां मन्त्रोपनिषदं प्रतीच्छ प्रयतो मम यां धारयन्सप्तरात्राद्द्रष्टा सङ्कर्षणं विभुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीनारद उवाच ।"
  },
  {
    "id": "skandha-06-chapter-15-sloka-028",
    "skandha": 6,
    "chapter": 15,
    "sloka": 28,
    "sanskrit": "यत्पादमूलमुपसृत्य नरेन्द्र पूर्वे शर्वादयो भ्रममिमं द्वितयं विसृज्य सद्यस्तदीयमतुलानधिकं महित्वं प्रापुर्भवानपि परं न चिरादुपैति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]