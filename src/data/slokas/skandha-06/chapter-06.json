[
  {
    "id": "skandha-06-chapter-06-sloka-001",
    "skandha": 6,
    "chapter": 6,
    "sloka": 1,
    "sanskrit": "ततः प्राचेतसोऽसिक्न्यामनुनीतः स्वयम्भुवा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-06-chapter-06-sloka-002",
    "skandha": 6,
    "chapter": 6,
    "sloka": 2,
    "sanskrit": "षष्टिं सञ्जनयामास दुहितॄः पितृवत्सलाः दश धर्माय कायादाद्द्विषट्त्रिणव चेन्दवे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-003",
    "skandha": 6,
    "chapter": 6,
    "sloka": 3,
    "sanskrit": "भूताङ्गिरःकृशाश्वेभ्यो द्वे द्वे तार्क्ष्याय चापराः नामधेयान्यमूषां त्वं सापत्यानां च मे शृणु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-004",
    "skandha": 6,
    "chapter": 6,
    "sloka": 4,
    "sanskrit": "यासां प्रसूतिप्रसवैर्लोका आपूरितास्त्रयः भानुर्लम्बा ककुद्यामिर्विश्वा साध्या मरुत्वती",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-005",
    "skandha": 6,
    "chapter": 6,
    "sloka": 5,
    "sanskrit": "वसुर्मुहूर्ता सङ्कल्पा धर्मपत्न्यः सुताञ्शृणु भानोस्तु देवऋषभ इन्द्रसेनस्ततो नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-006",
    "skandha": 6,
    "chapter": 6,
    "sloka": 6,
    "sanskrit": "विद्योत आसील्लम्बायास्ततश्च स्तनयित्नवः ककुदः सङ्कटस्तस्य कीकटस्तनयो यतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-007",
    "skandha": 6,
    "chapter": 6,
    "sloka": 7,
    "sanskrit": "भुवो दुर्गाणि यामेयः स्वर्गो नन्दिस्ततोऽभवत् विश्वेदेवास्तु विश्वाया अप्रजांस्तान्प्रचक्षते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-008",
    "skandha": 6,
    "chapter": 6,
    "sloka": 8,
    "sanskrit": "साध्योगणश्च साध्याया अर्थसिद्धिस्तु तत्सुतः मरुत्वांश्च जयन्तश्च मरुत्वत्या बभूवतुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-009",
    "skandha": 6,
    "chapter": 6,
    "sloka": 9,
    "sanskrit": "जयन्तो वासुदेवांश उपेन्द्र इति यं विदुः मौहूर्तिका देवगणा मुहूर्तायाश्च जज्ञिरे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-010",
    "skandha": 6,
    "chapter": 6,
    "sloka": 10,
    "sanskrit": "ये वै फलं प्रयच्छन्ति भूतानां स्वस्वकालजम् सङ्कल्पायास्तु सङ्कल्पः कामः सङ्कल्पजः स्मृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-011",
    "skandha": 6,
    "chapter": 6,
    "sloka": 11,
    "sanskrit": "वसवोऽष्टौ वसोः पुत्रास्तेषां नामानि मे शृणु द्रोणः प्राणो ध्रुवोऽर्कोऽग्निर्दोषो वास्तुर्विभावसुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-012",
    "skandha": 6,
    "chapter": 6,
    "sloka": 12,
    "sanskrit": "द्रोणस्याभिमतेः पत्न्या हर्षशोकभयादयः प्राणस्योर्जस्वती भार्या सह आयुः पुरोजवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-013",
    "skandha": 6,
    "chapter": 6,
    "sloka": 13,
    "sanskrit": "ध्रुवस्य भार्या धरणिरसूत विविधाः पुरः अर्कस्य वासना भार्या पुत्रास्तर्षादयः स्मृताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-014",
    "skandha": 6,
    "chapter": 6,
    "sloka": 14,
    "sanskrit": "अग्नेर्भार्या वसोर्धारा पुत्रा द्रविणकादयः स्कन्दश्च कृत्तिकापुत्रो ये विशाखादयस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-015",
    "skandha": 6,
    "chapter": 6,
    "sloka": 15,
    "sanskrit": "दोषस्य शर्वरीपुत्रः शिशुमारो हरेः कला वास्तोराङ्गिरसीपुत्रो विश्वकर्माकृतीपतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-016",
    "skandha": 6,
    "chapter": 6,
    "sloka": 16,
    "sanskrit": "ततो मनुश्चाक्षुषोऽभूद्विश्वे साध्या मनोः सुताः विभावसोरसूतोषा व्युष्टं रोचिषमातपम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-017",
    "skandha": 6,
    "chapter": 6,
    "sloka": 17,
    "sanskrit": "पञ्चयामोऽथ भूतानि येन जाग्रति कर्मसु सरूपासूत भूतस्य भार्या रुद्रांश्च कोटिशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-018",
    "skandha": 6,
    "chapter": 6,
    "sloka": 18,
    "sanskrit": "रैवतोऽजो भवो भीमो वाम उग्रो वृषाकपिः अजैकपादहिर्ब्रध्नो बहुरूपो महानिति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-019",
    "skandha": 6,
    "chapter": 6,
    "sloka": 19,
    "sanskrit": "रुद्रस्य पार्षदाश्चान्ये घोराः प्रेतविनायकाः प्रजापतेरङ्गिरसः स्वधा पत्नी पितॄनथ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-020",
    "skandha": 6,
    "chapter": 6,
    "sloka": 20,
    "sanskrit": "अथर्वाङ्गिरसं वेदं पुत्रत्वे चाकरोत्सती कृशाश्वोऽर्चिषि भार्यायां धूमकेतुमजीजनत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-021",
    "skandha": 6,
    "chapter": 6,
    "sloka": 21,
    "sanskrit": "धिषणायां वेदशिरो देवलं वयुनं मनुम् तार्क्ष्यस्य विनता कद्रूः पतङ्गी यामिनीति च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-022",
    "skandha": 6,
    "chapter": 6,
    "sloka": 22,
    "sanskrit": "पतङ्ग्यसूत पतगान्यामिनी शलभानथ सुपर्णासूत गरुडं साक्षाद्यज्ञेशवाहनम् सूर्यसूतमनूरुं च कद्रूर्नागाननेकशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-023",
    "skandha": 6,
    "chapter": 6,
    "sloka": 23,
    "sanskrit": "कृत्तिकादीनि नक्षत्राणीन्दोः पत्न्यस्तु भारत दक्षशापात्सोऽनपत्यस्तासु यक्ष्मग्रहार्दितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-024",
    "skandha": 6,
    "chapter": 6,
    "sloka": 24,
    "sanskrit": "पुनः प्रसाद्य तं सोमः कला लेभे क्षये दिताः शृणु नामानि लोकानां मातॄणां शङ्कराणि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-025",
    "skandha": 6,
    "chapter": 6,
    "sloka": 25,
    "sanskrit": "अथ कश्यपपत्नीनां यत्प्रसूतमिदं जगत् अदितिर्दितिर्दनुः काष्ठा अरिष्टा सुरसा इला",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-026",
    "skandha": 6,
    "chapter": 6,
    "sloka": 26,
    "sanskrit": "मुनिः क्रोधवशा ताम्रा सुरभिः सरमा तिमिः तिमेर्यादोगणा आसन्श्वापदाः सरमासुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-027",
    "skandha": 6,
    "chapter": 6,
    "sloka": 27,
    "sanskrit": "सुरभेर्महिषा गावो ये चान्ये द्विशफा नृप ताम्रायाः श्येनगृध्राद्या मुनेरप्सरसां गणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-028",
    "skandha": 6,
    "chapter": 6,
    "sloka": 28,
    "sanskrit": "दन्दशूकादयः सर्पा राजन्क्रोधवशात्मजाः इलाया भूरुहाः सर्वे यातुधानाश्च सौरसाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-029",
    "skandha": 6,
    "chapter": 6,
    "sloka": 29,
    "sanskrit": "अरिष्टायास्तु गन्धर्वाः काष्ठाया द्विशफेतराः सुता दनोरेकषष्टिस्तेषां प्राधानिकाञ्शृणु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-030",
    "skandha": 6,
    "chapter": 6,
    "sloka": 30,
    "sanskrit": "द्विमूर्धा शम्बरोऽरिष्टो हयग्रीवो विभावसुः अयोमुखः शङ्कुशिराः स्वर्भानुः कपिलोऽरुणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-031",
    "skandha": 6,
    "chapter": 6,
    "sloka": 31,
    "sanskrit": "पुलोमा वृषपर्वा च एकचक्रोऽनुतापनः धूम्रकेशो विरूपाक्षो विप्रचित्तिश्च दुर्जयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-032",
    "skandha": 6,
    "chapter": 6,
    "sloka": 32,
    "sanskrit": "स्वर्भानोः सुप्रभां कन्यामुवाह नमुचिः किल वृषपर्वणस्तु शर्मिष्ठां ययातिर्नाहुषो बली",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-033",
    "skandha": 6,
    "chapter": 6,
    "sloka": 33,
    "sanskrit": "वैश्वानरसुता याश्च चतस्रश्चारुदर्शनाः उपदानवी हयशिरा पुलोमा कालका तथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-034",
    "skandha": 6,
    "chapter": 6,
    "sloka": 34,
    "sanskrit": "उपदानवीं हिरण्याक्षः क्रतुर्हयशिरां नृप पुलोमां कालकां च द्वे वैश्वानरसुते तु कः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-035",
    "skandha": 6,
    "chapter": 6,
    "sloka": 35,
    "sanskrit": "उपयेमेऽथ भगवान्कश्यपो ब्रह्मचोदितः पौलोमाः कालकेयाश्च दानवा युद्धशालिनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-036",
    "skandha": 6,
    "chapter": 6,
    "sloka": 36,
    "sanskrit": "तयोः षष्टिसहस्राणि यज्ञघ्नांस्ते पितुः पिता जघान स्वर्गतो राजन्नेक इन्द्रप्रियङ्करः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-037",
    "skandha": 6,
    "chapter": 6,
    "sloka": 37,
    "sanskrit": "विप्रचित्तिः सिंहिकायां शतं चैकमजीजनत् राहुज्येष्ठं केतुशतं ग्रहत्वं य उपागताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-038",
    "skandha": 6,
    "chapter": 6,
    "sloka": 38,
    "sanskrit": "अथातः श्रूयतां वंशो योऽदितेरनुपूर्वशः यत्र नारायणो देवः स्वांशेनावातरद्विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-039",
    "skandha": 6,
    "chapter": 6,
    "sloka": 39,
    "sanskrit": "विवस्वानर्यमा पूषा त्वष्टाथ सविता भगः धाता विधाता वरुणो मित्रः शत्रु उरुक्रमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-040",
    "skandha": 6,
    "chapter": 6,
    "sloka": 40,
    "sanskrit": "विवस्वतः श्राद्धदेवं संज्ञासूयत वै मनुम् मिथुनं च महाभागा यमं देवं यमीं तथा सैव भूत्वाथ वडवा नासत्यौ सुषुवे भुवि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-041",
    "skandha": 6,
    "chapter": 6,
    "sloka": 41,
    "sanskrit": "छाया शनैश्चरं लेभे सावर्णिं च मनुं ततः कन्यां च तपतीं या वै वव्रे संवरणं पतिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-042",
    "skandha": 6,
    "chapter": 6,
    "sloka": 42,
    "sanskrit": "अर्यम्णो मातृका पत्नी तयोश्चर्षणयः सुताः यत्र वै मानुषी जातिर्ब्रह्मणा चोपकल्पिता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-043",
    "skandha": 6,
    "chapter": 6,
    "sloka": 43,
    "sanskrit": "पूषानपत्यः पिष्टादो भग्नदन्तोऽभवत्पुरा योऽसौ दक्षाय कुपितं जहास विवृतद्विजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-044",
    "skandha": 6,
    "chapter": 6,
    "sloka": 44,
    "sanskrit": "त्वष्टुर्दैत्यात्मजा भार्या रचना नाम कन्यका सन्निवेशस्तयोर्जज्ञे विश्वरूपश्च वीर्यवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-06-chapter-06-sloka-045",
    "skandha": 6,
