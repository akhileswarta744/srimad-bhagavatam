[
  {
    "id": "skandha-02-chapter-03-sloka-001",
    "skandha": 2,
    "chapter": 3,
    "sloka": 1,
    "malayalamMeaning": "ബ്രഹ്മതേജസ്സ് ആഗ്രഹിക്കുന്നവർ ബ്രഹ്മാവിനെയും, ഇന്ദ്രിയശക്തി ആഗ്രഹിക്കുന്നവർ ഇന്ദ്രനെയും, സന്താനത്തെ ആഗ്രഹിക്കുന്നവർ പ്രജാപതികളെയും ഉപാസിക്കുന്നു.",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "ശ്രീശുകൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-02-chapter-03-sloka-002",
    "skandha": 2,
    "chapter": 3,
    "sloka": 2,
    "malayalamMeaning": "'എന്നാൽ യാതൊരു കാമനകളുമില്ലാത്തവനോ (അകാമൻ), സർവ്വകാമനകളോടും കൂടിയവനോ (സർവ്വകാമൻ), മോക്ഷം കാംക്ഷിക്കുന്നവനോ (മോക്ഷകാമൻ) ആരായാലും ശരി, അവർ ഉദാരബുദ്ധിയോടെ പരമപുരുഷനായ ഭഗവാൻ ശ്രീകൃഷ്ണനെ മാത്രം തീവ്രമായ ഭക്തിയോഗത്താൽ ഉപാസിക്കണം.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-03-sloka-003",
    "skandha": 2,
    "chapter": 3,
    "sloka": 3,
    "malayalamMeaning": "സൂര്യൻ ഓരോ ദിവസവും ഉദിച്ചുയർന്ന് അസ്തമിക്കുമ്പോൾ മനുഷ്യരുടെ ആയുസ്സിനെ കവർന്നെടുക്കുന്നു; എന്നാൽ ഭഗവത്കഥകൾ ശ്രവിക്കുന്നതിലും ചിന്തിക്കുന്നതിലും ചെലവഴിക്കുന്ന നിമിഷങ്ങൾ മരണമില്ലാത്ത അമൃതമായി അവശേഷിക്കുന്നു.",
    "source": "Sanskrit Documents / Gitapress"
  },
