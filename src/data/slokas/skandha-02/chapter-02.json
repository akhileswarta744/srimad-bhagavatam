[
  {
    "id": "skandha-02-chapter-02-sloka-001",
    "skandha": 2,
    "chapter": 2,
    "sloka": 1,
    "malayalamMeaning": "ശുകദേവൻ പറഞ്ഞു: 'ഭൂമിയിൽ ആവശ്യത്തിന് ജലവും, ഉടുക്കാൻ മരത്തോലും, കിടക്കാൻ മണ്ണും, കഴിക്കാൻ വൃക്ഷങ്ങളിൽ ഫലങ്ങളും ഉള്ളപ്പോൾ ധനികന്മാരായ മൂഢന്മാരെ യാചിക്കാൻ ആര് പോകും?'",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "ശ്രീശുകൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-02-chapter-02-sloka-002",
    "skandha": 2,
    "chapter": 2,
    "sloka": 2,
    "malayalamMeaning": "'തന്റെ ഹൃദയകമലത്തിൽ ചതുർഭുജനായി, ശംഖചക്രഗദാപദ്മങ്ങളേന്തി വിളങ്ങുന്ന ഭഗവത്സ്വരൂപത്തിൽ മനസ്സ് ഏകാഗ്രമായി ഉറപ്പിക്കണം. ആ ഭഗവാന്റെ പുഞ്ചിരി തൂകുന്ന വദനം ധ്യാനിക്കുന്നതോടെ ജീവന് മുക്തി ലഭിക്കുന്നു.'",
    "source": "Sanskrit Documents / Gitapress"
  },
