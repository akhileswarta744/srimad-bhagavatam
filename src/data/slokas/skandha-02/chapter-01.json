[
  {
    "id": "skandha-02-chapter-01-sloka-001",
    "skandha": 2,
    "chapter": 1,
    "sloka": 1,
    "malayalamMeaning": "ശ്രീ ശുകദേവൻ പറഞ്ഞു: 'ഹേ രാജാവേ! അങ്ങയുടെ ചോദ്യം ലോകനന്മയ്ക്കായി ഉതകുന്നതാണ്. ഗൃഹസ്ഥന്മാരായ മനുഷ്യർ രാപ്പകൽ നിദ്രയിലും ഇന്ദ്രിയസുഖങ്ങളിലും ധനസമ്പാദനത്തിലും മുഴുകി ആത്മതത്ത്വം അറിയാതെ ജീവിതം പാഴാക്കുന്നു.'",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "ശ്രീശുകൻ പറഞ്ഞു"
  },
  {
    "id": "skandha-02-chapter-01-sloka-002",
    "skandha": 2,
    "chapter": 1,
    "sloka": 2,
    "malayalamMeaning": "'മരണഭയത്തിൽ നിന്ന് മുക്തി നേടാൻ ആഗ്രഹിക്കുന്നവർ സർവ്വഭൂതങ്ങളുടെയും അന്തരാത്മാവായ ശ്രീഹരിയെ സദാ ശ്രവിക്കുകയും കീർത്തിക്കുകയും സ്മരിക്കുകയും വേണം.'",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-01-sloka-003",
    "skandha": 2,
    "chapter": 1,
    "sloka": 3,
    "malayalamMeaning": "'ആദ്യം പ്രാണായാമം കൊണ്ട് മനസ്സിനെ വശത്താക്കി, ഇന്ദ്രിയങ്ങളെ അടക്കി, സമസ്ത പ്രപഞ്ചവും ഭഗവാന്റെ വിരാട് ശരീരമാണെന്ന് സങ്കല്പിച്ച് ധ്യാനിക്കണം. പാതാളം ഭഗവാന്റെ പാദങ്ങളും, ഭൂമി അരക്കെട്ടും, ആകാശം നാഭിയും, സ്വർഗ്ഗം മാറിടവുമാകുന്നു.'",
    "source": "Sanskrit Documents / Gitapress"
  },
