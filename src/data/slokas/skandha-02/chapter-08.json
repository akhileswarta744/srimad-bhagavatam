[
  {
    "id": "skandha-02-chapter-08-sloka-001",
    "skandha": 2,
    "chapter": 8,
    "sloka": 1,
    "sanskrit": "ब्रह्मणा चोदितो ब्रह्मन्गुणाख्यानेऽगुणस्य च यस्मै यस्मै यथा प्राह नारदो देवदर्शनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "राजोवाच ।"
  },
  {
    "id": "skandha-02-chapter-08-sloka-002",
    "skandha": 2,
    "chapter": 8,
    "sloka": 2,
    "sanskrit": "एतद्वेदितुमिच्छामि तत्त्वं तत्त्वविदां वर हरेरद्भुतवीर्यस्य कथा लोकसुमङ्गलाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-003",
    "skandha": 2,
    "chapter": 8,
    "sloka": 3,
    "sanskrit": "कथयस्व महाभाग यथाहमखिलात्मनि कृष्णे निवेश्य निःसङ्गं मनस्त्यक्ष्ये कलेवरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-004",
    "skandha": 2,
    "chapter": 8,
    "sloka": 4,
    "sanskrit": "शृण्वतः श्रद्धया नित्यं गृणतश्च स्वचेष्टितम् कालेन नातिदीर्घेण भगवान्विशते हृदि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-005",
    "skandha": 2,
    "chapter": 8,
    "sloka": 5,
    "sanskrit": "प्रविष्टः कर्णरन्ध्रेण स्वानां भावसरोरुहम् धुनोति शमलं कृष्णः सलिलस्य यथा शरत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-006",
    "skandha": 2,
    "chapter": 8,
    "sloka": 6,
    "sanskrit": "धौतात्मा पुरुषः कृष्ण पादमूलं न मुञ्चति मुक्तसर्वपरिक्लेशः पान्थः स्वशरणं यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-007",
    "skandha": 2,
    "chapter": 8,
    "sloka": 7,
    "sanskrit": "यदधातुमतो ब्रह्मन्देहारम्भोऽस्य धातुभिः यदृच्छया हेतुना वा भवन्तो जानते यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-008",
    "skandha": 2,
    "chapter": 8,
    "sloka": 8,
    "sanskrit": "आसीद्यदुदरात्पद्मं लोकसंस्थानलक्षणम् यावानयं वै पुरुष इयत्तावयवैः पृथक् तावानसाविति प्रोक्तः संस्थावयववानिव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-009",
    "skandha": 2,
    "chapter": 8,
    "sloka": 9,
    "sanskrit": "अजः सृजति भूतानि भूतात्मा यदनुग्रहात् ददृशे येन तद्रूपं नाभिपद्मसमुद्भवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-010",
    "skandha": 2,
    "chapter": 8,
    "sloka": 10,
    "sanskrit": "स चापि यत्र पुरुषो विश्वस्थित्युद्भवाप्ययः मुक्त्वात्ममायां मायेशः शेते सर्वगुहाशयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-011",
    "skandha": 2,
    "chapter": 8,
    "sloka": 11,
    "sanskrit": "पुरुषावयवैर्लोकाः सपालाः पूर्वकल्पिताः लोकैरमुष्यावयवाः सपालैरिति शुश्रुम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-012",
    "skandha": 2,
    "chapter": 8,
    "sloka": 12,
    "sanskrit": "यावान्कल्पो विकल्पो वा यथा कालोऽनुमीयते भूतभव्यभवच्छब्द आयुर्मानं च यत्सतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-013",
    "skandha": 2,
    "chapter": 8,
    "sloka": 13,
    "sanskrit": "कालस्यानुगतिर्या तु लक्ष्यतेऽण्वी बृहत्यपि यावत्यः कर्मगतयो यादृशीर्द्विजसत्तम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-014",
    "skandha": 2,
    "chapter": 8,
    "sloka": 14,
    "sanskrit": "यस्मिन्कर्मसमावायो यथा येनोपगृह्यते गुणानां गुणिनां चैव परिणाममभीप्सताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-015",
    "skandha": 2,
    "chapter": 8,
    "sloka": 15,
    "sanskrit": "भूपातालककुब्व्योम ग्रहनक्षत्रभूभृताम् सरित्समुद्रद्वीपानां सम्भवश्चैतदोकसाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-016",
    "skandha": 2,
    "chapter": 8,
    "sloka": 16,
    "sanskrit": "प्रमाणमण्डकोशस्य बाह्याभ्यन्तरभेदतः महतां चानुचरितं वर्णाश्रमविनिश्चयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-017",
    "skandha": 2,
    "chapter": 8,
    "sloka": 17,
    "sanskrit": "युगानि युगमानं च धर्मो यश्च युगे युगे अवतारानुचरितं यदाश्चर्यतमं हरेः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-018",
    "skandha": 2,
    "chapter": 8,
    "sloka": 18,
    "sanskrit": "नृणां साधारणो धर्मः सविशेषश्च यादृशः श्रेणीनां राजर्षीणां च धर्मः कृच्छ्रेषु जीवताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-019",
    "skandha": 2,
    "chapter": 8,
    "sloka": 19,
    "sanskrit": "तत्त्वानां परिसङ्ख्यानं लक्षणं हेतुलक्षणम् पुरुषाराधनविधिर्योगस्याध्यात्मिकस्य च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-020",
    "skandha": 2,
    "chapter": 8,
    "sloka": 20,
    "sanskrit": "योगेश्वरैश्वर्यगतिर्लिङ्गभङ्गस्तु योगिनाम् वेदोपवेदधर्माणामितिहासपुराणयोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-021",
    "skandha": 2,
    "chapter": 8,
    "sloka": 21,
    "sanskrit": "सम्प्लवः सर्वभूतानां विक्रमः प्रतिसङ्क्रमः इष्टापूर्तस्य काम्यानां त्रिवर्गस्य च यो विधिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-022",
    "skandha": 2,
    "chapter": 8,
    "sloka": 22,
    "sanskrit": "यो वानुशायिनां सर्गः पाषण्डस्य च सम्भवः आत्मनो बन्धमोक्षौ च व्यवस्थानं स्वरूपतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-023",
    "skandha": 2,
    "chapter": 8,
    "sloka": 23,
    "sanskrit": "यथात्मतन्त्रो भगवान्विक्रीडत्यात्ममायया विसृज्य वा यथा मायामुदास्ते साक्षिवद्विभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-024",
    "skandha": 2,
    "chapter": 8,
    "sloka": 24,
    "sanskrit": "सर्वमेतच्च भगवन्पृच्छतो मेऽनुपूर्वशः तत्त्वतोऽर्हस्युदाहर्तुं प्रपन्नाय महामुने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-025",
    "skandha": 2,
    "chapter": 8,
    "sloka": 25,
    "sanskrit": "अत्र प्रमाणं हि भवान्परमेष्ठी यथात्मभूः अपरे चानुतिष्ठन्ति पूर्वेषां पूर्वजैः कृतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-026",
    "skandha": 2,
    "chapter": 8,
    "sloka": 26,
    "sanskrit": "न मेऽसवः परायन्ति ब्रह्मन्ननशनादमी पिबतो ञ्च्युतपीयूषम्तद्वाक्याब्धिविनिःसृतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-027",
    "skandha": 2,
    "chapter": 8,
    "sloka": 27,
    "sanskrit": "स उपामन्त्रितो राज्ञा कथायामिति सत्पतेः ब्रह्मरातो भृशं प्रीतो विष्णुरातेन संसदि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "सूत उवाच ।"
  },
  {
    "id": "skandha-02-chapter-08-sloka-028",
    "skandha": 2,
    "chapter": 8,
    "sloka": 28,
    "sanskrit": "प्राह भागवतं नाम पुराणं ब्रह्मसम्मितम् ब्रह्मणे भगवत्प्रोक्तं ब्रह्मकल्प उपागते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-08-sloka-029",
    "skandha": 2,
    "chapter": 8,
    "sloka": 29,
    "sanskrit": "यद्यत्परीक्षिदृषभः पाण्डूनामनुपृच्छति आनुपूर्व्येण तत्सर्वमाख्यातुमुपचक्रमे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]