[
  {
    "id": "skandha-02-chapter-05-sloka-001",
    "skandha": 2,
    "chapter": 5,
    "sloka": 1,
    "sanskrit": "देवदेव नमस्तेऽस्तु भूतभावन पूर्वज तद्विजानीहि यज्ज्ञानमात्मतत्त्वनिदर्शनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "नारद उवाच ।"
  },
  {
    "id": "skandha-02-chapter-05-sloka-002",
    "skandha": 2,
    "chapter": 5,
    "sloka": 2,
    "sanskrit": "यद्रूपं यदधिष्ठानं यतः सृष्टमिदं प्रभो यत्संस्थं यत्परं यच्च तत्तत्त्वं वद तत्त्वतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-003",
    "skandha": 2,
    "chapter": 5,
    "sloka": 3,
    "sanskrit": "सर्वं ह्येतद्भवान्वेद भूतभव्यभवत्प्रभुः करामलकवद्विश्वं विज्ञानावसितं तव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-004",
    "skandha": 2,
    "chapter": 5,
    "sloka": 4,
    "sanskrit": "यद्विज्ञानो यदाधारो यत्परस्त्वं यदात्मकः एकः सृजसि भूतानि भूतैरेवात्ममायया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-005",
    "skandha": 2,
    "chapter": 5,
    "sloka": 5,
    "sanskrit": "आत्मन्भावयसे तानि न पराभावयन्स्वयम् आत्मशक्तिमवष्टभ्य ऊर्णनाभिरिवाक्लमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-006",
    "skandha": 2,
    "chapter": 5,
    "sloka": 6,
    "sanskrit": "नाहं वेद परं ह्यस्मिन्नापरं न समं विभो नामरूपगुणैर्भाव्यं सदसत्किञ्चिदन्यतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-007",
    "skandha": 2,
    "chapter": 5,
    "sloka": 7,
    "sanskrit": "स भवानचरद्घोरं यत्तपः सुसमाहितः तेन खेदयसे नस्त्वं पराशङ्कां च यच्छसि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-008",
    "skandha": 2,
    "chapter": 5,
    "sloka": 8,
    "sanskrit": "एतन्मे पृच्छतः सर्वं सर्वज्ञ सकलेश्वर विजानीहि यथैवेदमहं बुध्येऽनुशासितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-009",
    "skandha": 2,
    "chapter": 5,
    "sloka": 9,
    "sanskrit": "सम्यक्कारुणिकस्येदं वत्स ते विचिकित्सितम् यदहं चोदितः सौम्य भगवद्वीर्यदर्शने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "ब्रह्मोवाच ।"
  },
  {
    "id": "skandha-02-chapter-05-sloka-010",
    "skandha": 2,
    "chapter": 5,
    "sloka": 10,
    "sanskrit": "नानृतं तव तच्चापि यथा मां प्रब्रवीषि भोः अविज्ञाय परं मत्त एतावत्त्वं यतो हि मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-011",
    "skandha": 2,
    "chapter": 5,
    "sloka": 11,
    "sanskrit": "येन स्वरोचिषा विश्वं रोचितं रोचयाम्यहम् यथार्कोऽग्निर्यथा सोमो यथर्क्षग्रहतारकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-012",
    "skandha": 2,
    "chapter": 5,
    "sloka": 12,
    "sanskrit": "तस्मै नमो भगवते वासुदेवाय धीमहि यन्मायया दुर्जयया मां वदन्ति जगद्गुरुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-013",
    "skandha": 2,
    "chapter": 5,
    "sloka": 13,
    "sanskrit": "विलज्जमानया यस्य स्थातुमीक्षापथेऽमुया विमोहिता विकत्थन्ते ममाहमिति दुर्धियः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-014",
    "skandha": 2,
    "chapter": 5,
    "sloka": 14,
    "sanskrit": "द्रव्यं कर्म च कालश्च स्वभावो जीव एव च वासुदेवात्परो ब्रह्मन्न चान्योऽर्थोऽस्ति तत्त्वतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-015",
    "skandha": 2,
    "chapter": 5,
    "sloka": 15,
    "sanskrit": "नारायणपरा वेदा देवा नारायणाङ्गजाः नारायणपरा लोका नारायणपरा मखाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-016",
    "skandha": 2,
    "chapter": 5,
    "sloka": 16,
    "sanskrit": "नारायणपरो योगो नारायणपरं तपः नारायणपरं ज्ञानं नारायणपरा गतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-017",
    "skandha": 2,
    "chapter": 5,
    "sloka": 17,
    "sanskrit": "तस्यापि द्रष्टुरीशस्य कूटस्थस्याखिलात्मनः सृज्यं सृजामि सृष्टोऽहमीक्षयैवाभिचोदितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-018",
    "skandha": 2,
    "chapter": 5,
    "sloka": 18,
    "sanskrit": "सत्त्वं रजस्तम इति निर्गुणस्य गुणास्त्रयः स्थितिसर्गनिरोधेषु गृहीता मायया विभोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-019",
    "skandha": 2,
    "chapter": 5,
    "sloka": 19,
    "sanskrit": "कार्यकारणकर्तृत्वे द्रव्यज्ञानक्रियाश्रयाः बध्नन्ति नित्यदा मुक्तं मायिनं पुरुषं गुणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-020",
    "skandha": 2,
    "chapter": 5,
    "sloka": 20,
    "sanskrit": "स एष भगवांल्लिङ्गैस्त्रिभिरेतैरधोक्षजः स्वलक्षितगतिर्ब्रह्मन्सर्वेषां मम चेश्वरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-021",
    "skandha": 2,
    "chapter": 5,
    "sloka": 21,
    "sanskrit": "कालं कर्म स्वभावं च मायेशो मायया स्वया आत्मन्यदृच्छया प्राप्तं विबुभूषुरुपाददे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-022",
    "skandha": 2,
    "chapter": 5,
    "sloka": 22,
    "sanskrit": "कालाद्गुणव्यतिकरः परिणामः स्वभावतः कर्मणो जन्म महतः पुरुषाधिष्ठितादभूत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-023",
    "skandha": 2,
    "chapter": 5,
    "sloka": 23,
    "sanskrit": "महतस्तु विकुर्वाणाद्रजःसत्त्वोपबृंहितात् तमःप्रधानस्त्वभवद्द्रव्यज्ञानक्रियात्मकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-024",
    "skandha": 2,
    "chapter": 5,
    "sloka": 24,
    "sanskrit": "सोऽहङ्कार इति प्रोक्तो विकुर्वन्समभूत्त्रिधा वैकारिकस्तैजसश्च तामसश्चेति यद्भिदा द्रव्यशक्तिः क्रियाशक्तिर्ज्ञानशक्तिरिति प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-025",
    "skandha": 2,
    "chapter": 5,
    "sloka": 25,
    "sanskrit": "तामसादपि भूतादेर्विकुर्वाणादभून्नभः तस्य मात्रा गुणः शब्दो लिङ्गं यद्द्रष्टृदृश्ययोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-026",
    "skandha": 2,
    "chapter": 5,
    "sloka": 26,
    "sanskrit": "नभसोऽथ विकुर्वाणादभूत्स्पर्शगुणोऽनिलः परान्वयाच्छब्दवांश्च प्राण ओजः सहो बलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-027",
    "skandha": 2,
    "chapter": 5,
    "sloka": 27,
    "sanskrit": "वायोरपि विकुर्वाणात्कालकर्मस्वभावतः उदपद्यत तेजो वै रूपवत्स्पर्शशब्दवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-028",
    "skandha": 2,
    "chapter": 5,
    "sloka": 28,
    "sanskrit": "तेजसस्तु विकुर्वाणादासीदम्भो रसात्मकम् रूपवत्स्पर्शवच्चाम्भो घोषवच्च परान्वयात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-029",
    "skandha": 2,
    "chapter": 5,
    "sloka": 29,
    "sanskrit": "विशेषस्तु विकुर्वाणादम्भसो गन्धवानभूत् परान्वयाद्रसस्पर्श शब्दरूपगुणान्वितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-030",
    "skandha": 2,
    "chapter": 5,
    "sloka": 30,
    "sanskrit": "वैकारिकान्मनो जज्ञे देवा वैकारिका दश दिग्वातार्कप्रचेतोऽश्वि वह्नीन्द्रोपेन्द्रमित्रकाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-031",
    "skandha": 2,
    "chapter": 5,
    "sloka": 31,
    "sanskrit": "तैजसात्तु विकुर्वाणादिन्द्रियाणि दशाभवन् ज्ञानशक्तिः क्रियाशक्तिर्बुद्धिः प्राणश्च तैजसौ श्रोत्रं त्वग्घ्राणदृग्जिह्वा वाग्दोर्मेढ्राङ्घ्रिपायवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-032",
    "skandha": 2,
    "chapter": 5,
    "sloka": 32,
    "sanskrit": "यदैतेऽसङ्गता भावा भूतेन्द्रियमनोगुणाः यदायतननिर्माणे न शेकुर्ब्रह्मवित्तम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-033",
    "skandha": 2,
    "chapter": 5,
    "sloka": 33,
    "sanskrit": "तदा संहत्य चान्योन्यं भगवच्छक्तिचोदिताः सदसत्त्वमुपादाय चोभयं ससृजुर्ह्यदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-034",
    "skandha": 2,
    "chapter": 5,
    "sloka": 34,
    "sanskrit": "वर्षपूगसहस्रान्ते तदण्डमुदके शयम् कालकर्मस्वभावस्थो जीवो ञ्जीवमजीवयत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-035",
    "skandha": 2,
    "chapter": 5,
    "sloka": 35,
    "sanskrit": "स एव पुरुषस्तस्मादण्डं निर्भिद्य निर्गतः सहस्रोर्वङ्घ्रिबाह्वक्षः सहस्राननशीर्षवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-036",
    "skandha": 2,
    "chapter": 5,
    "sloka": 36,
    "sanskrit": "यस्येहावयवैर्लोकान्कल्पयन्ति मनीषिणः कट्यादिभिरधः सप्त सप्तोर्ध्वं जघनादिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-037",
    "skandha": 2,
    "chapter": 5,
    "sloka": 37,
    "sanskrit": "पुरुषस्य मुखं ब्रह्म क्षत्रमेतस्य बाहवः ऊर्वोर्वैश्यो भगवतः पद्भ्यां शूद्रो व्यजायत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-038",
    "skandha": 2,
    "chapter": 5,
    "sloka": 38,
    "sanskrit": "भूर्लोकः कल्पितः पद्भ्यां भुवर्लोकोऽस्य नाभितः हृदा स्वर्लोक उरसा महर्लोको महात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-039",
    "skandha": 2,
    "chapter": 5,
    "sloka": 39,
    "sanskrit": "ग्रीवायां जनलोकोऽस्य तपोलोकः स्तनद्वयात् मूर्धभिः सत्यलोकस्तु ब्रह्मलोकः सनातनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-040",
    "skandha": 2,
    "chapter": 5,
    "sloka": 40,
    "sanskrit": "तत्कट्यां चातलं कॢप्तमूरुभ्यां वितलं विभोः जानुभ्यां सुतलं शुद्धं जङ्घाभ्यां तु तलातलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-041",
    "skandha": 2,
    "chapter": 5,
    "sloka": 41,
    "sanskrit": "महातलं तु गुल्फाभ्यां प्रपदाभ्यां रसातलम् पातालं पादतलत इति लोकमयः पुमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-05-sloka-042",
    "skandha": 2,
    "chapter": 5,
    "sloka": 42,
    "sanskrit": "भूर्लोकः कल्पितः पद्भ्यां भुवर्लोकोऽस्य नाभितः स्वर्लोकः कल्पितो मूर्ध्ना इति वा लोककल्पना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]