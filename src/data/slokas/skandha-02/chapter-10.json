[
  {
    "id": "skandha-02-chapter-10-sloka-001",
    "skandha": 2,
    "chapter": 10,
    "sloka": 1,
    "sanskrit": "अत्र सर्गो विसर्गश्च स्थानं पोषणमूतयः मन्वन्तरेशानुकथा निरोधो मुक्तिराश्रयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-02-chapter-10-sloka-002",
    "skandha": 2,
    "chapter": 10,
    "sloka": 2,
    "sanskrit": "दशमस्य विशुद्ध्यर्थं नवानामिह लक्षणम् वर्णयन्ति महात्मानः श्रुतेनार्थेन चाञ्जसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-003",
    "skandha": 2,
    "chapter": 10,
    "sloka": 3,
    "sanskrit": "भूतमात्रेन्द्रियधियां जन्म सर्ग उदाहृतः ब्रह्मणो गुणवैषम्याद्विसर्गः पौरुषः स्मृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-004",
    "skandha": 2,
    "chapter": 10,
    "sloka": 4,
    "sanskrit": "स्थितिर्वैकुण्ठविजयः पोषणं तदनुग्रहः मन्वन्तराणि सद्धर्म ऊतयः कर्मवासनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-005",
    "skandha": 2,
    "chapter": 10,
    "sloka": 5,
    "sanskrit": "अवतारानुचरितं हरेश्चास्यानुवर्तिनाम् पुंसामीशकथाः प्रोक्ता नानाख्यानोपबृंहिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-006",
    "skandha": 2,
    "chapter": 10,
    "sloka": 6,
    "sanskrit": "निरोधोऽस्यानुशयनमात्मनः सह शक्तिभिः मुक्तिर्हित्वान्यथा रूपं स्वरूपेण व्यवस्थितिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-007",
    "skandha": 2,
    "chapter": 10,
    "sloka": 7,
    "sanskrit": "आभासश्च निरोधश्च यतोऽस्त्यध्यवसीयते स आश्रयः परं ब्रह्म परमात्मेति शब्द्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-008",
    "skandha": 2,
    "chapter": 10,
    "sloka": 8,
    "sanskrit": "योऽध्यात्मिकोऽयं पुरुषः सोऽसावेवाधिदैविकः यस्तत्रोभयविच्छेदः पुरुषो ह्याधिभौतिकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-009",
    "skandha": 2,
    "chapter": 10,
    "sloka": 9,
    "sanskrit": "एकमेकतराभावे यदा नोपलभामहे त्रितयं तत्र यो वेद स आत्मा स्वाश्रयाश्रयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-010",
    "skandha": 2,
    "chapter": 10,
    "sloka": 10,
    "sanskrit": "पुरुषोऽण्डं विनिर्भिद्य यदासौ स विनिर्गतः आत्मनोऽयनमन्विच्छन्नपोऽस्राक्षीच्छुचिः शुचीः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-011",
    "skandha": 2,
    "chapter": 10,
    "sloka": 11,
    "sanskrit": "तास्ववात्सीत्स्वसृष्टासु सहस्रं परिवत्सरान् तेन नारायणो नाम यदापः पुरुषोद्भवाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-012",
    "skandha": 2,
    "chapter": 10,
    "sloka": 12,
    "sanskrit": "द्रव्यं कर्म च कालश्च स्वभावो जीव एव च यदनुग्रहतः सन्ति न सन्ति यदुपेक्षया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-013",
    "skandha": 2,
    "chapter": 10,
    "sloka": 13,
    "sanskrit": "एको नानात्वमन्विच्छन्योगतल्पात्समुत्थितः वीर्यं हिरण्मयं देवो मायया व्यसृजत्त्रिधा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-014",
    "skandha": 2,
    "chapter": 10,
    "sloka": 14,
    "sanskrit": "अधिदैवमथाध्यात्ममधिभूतमिति प्रभुः अथैकं पौरुषं वीर्यं त्रिधाभिद्यत तच्छृणु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-015",
    "skandha": 2,
    "chapter": 10,
    "sloka": 15,
    "sanskrit": "अन्तः शरीर आकाशात्पुरुषस्य विचेष्टतः ओजः सहो बलं जज्ञे ततः प्राणो महानसुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-016",
    "skandha": 2,
    "chapter": 10,
    "sloka": 16,
    "sanskrit": "अनुप्राणन्ति यं प्राणाः प्राणन्तं सर्वजन्तुषु अपानन्तमपानन्ति नरदेवमिवानुगाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-017",
    "skandha": 2,
    "chapter": 10,
    "sloka": 17,
    "sanskrit": "प्राणेनाक्षिपता क्षुत्तृडन्तरा जायते विभोः पिपासतो जक्षतश्च प्राङ्मुखं निरभिद्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-018",
    "skandha": 2,
    "chapter": 10,
    "sloka": 18,
    "sanskrit": "मुखतस्तालु निर्भिन्नंजिह्वा तत्रोपजायते ततो नानारसो जज्ञे जिह्वया योऽधिगम्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-019",
    "skandha": 2,
    "chapter": 10,
    "sloka": 19,
    "sanskrit": "विवक्षोर्मुखतो भूम्नो वह्निर्वाग्व्याहृतं तयोः जले चैतस्य सुचिरं निरोधः समजायत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-020",
    "skandha": 2,
    "chapter": 10,
    "sloka": 20,
    "sanskrit": "नासिके निरभिद्येतां दोधूयति नभस्वति तत्र वायुर्गन्धवहो घ्राणो नसि जिघृक्षतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-021",
    "skandha": 2,
    "chapter": 10,
    "sloka": 21,
    "sanskrit": "यदात्मनि निरालोकमात्मानं च दिदृक्षतः निर्भिन्ने ह्यक्षिणी तस्य ज्योतिश्चक्षुर्गुणग्रहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-022",
    "skandha": 2,
    "chapter": 10,
    "sloka": 22,
    "sanskrit": "बोध्यमानस्य ऋषिभिरात्मनस्तज्जिघृक्षतः कर्णौ च निरभिद्येतां दिशः श्रोत्रं गुणग्रहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-023",
    "skandha": 2,
    "chapter": 10,
    "sloka": 23,
    "sanskrit": "वस्तुनो मृदुकाठिन्य लघुगुर्वोष्णशीतताम् जिघृक्षतस्त्वङ्निर्भिन्ना तस्यां रोममहीरुहाः तत्र चान्तर्बहिर्वातस्त्वचा लब्धगुणो वृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-024",
    "skandha": 2,
    "chapter": 10,
    "sloka": 24,
    "sanskrit": "हस्तौ रुरुहतुस्तस्य नानाकर्मचिकीर्षया तयोस्तु बलवानिन्द्र आदानमुभयाश्रयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-025",
    "skandha": 2,
    "chapter": 10,
    "sloka": 25,
    "sanskrit": "गतिं जिगीषतः पादौ रुरुहातेऽभिकामिकाम् पद्भ्यां यज्ञः स्वयं हव्यं कर्मभिः क्रियते नृभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-026",
    "skandha": 2,
    "chapter": 10,
    "sloka": 26,
    "sanskrit": "निरभिद्यत शिश्नो वै प्रजानन्दामृतार्थिनः उपस्थ आसीत्कामानां प्रियं तदुभयाश्रयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-027",
    "skandha": 2,
    "chapter": 10,
    "sloka": 27,
    "sanskrit": "उत्सिसृक्षोर्धातुमलं निरभिद्यत वै गुदम् ततः पायुस्ततो मित्र उत्सर्ग उभयाश्रयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-028",
    "skandha": 2,
    "chapter": 10,
    "sloka": 28,
    "sanskrit": "आसिसृप्सोः पुरः पुर्या नाभिद्वारमपानतः तत्रापानस्ततो मृत्युः पृथक्त्वमुभयाश्रयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-029",
    "skandha": 2,
    "chapter": 10,
    "sloka": 29,
    "sanskrit": "आदित्सोरन्नपानानामासन्कुक्ष्यन्त्रनाडयः नद्यः समुद्राश्च तयोस्तुष्टिः पुष्टिस्तदाश्रये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-030",
    "skandha": 2,
    "chapter": 10,
    "sloka": 30,
    "sanskrit": "निदिध्यासोरात्ममायां हृदयं निरभिद्यत ततो मनश्चन्द्र इति सङ्कल्पः काम एव च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-031",
    "skandha": 2,
    "chapter": 10,
    "sloka": 31,
    "sanskrit": "त्वक्चर्ममांसरुधिर मेदोमज्जास्थिधातवः भूम्यप्तेजोमयाः सप्त प्राणो व्योमाम्बुवायुभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-032",
    "skandha": 2,
    "chapter": 10,
    "sloka": 32,
    "sanskrit": "गुणात्मकानीन्द्रियाणि भूतादिप्रभवा गुणाः मनः सर्वविकारात्मा बुद्धिर्विज्ञानरूपिणी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-033",
    "skandha": 2,
    "chapter": 10,
    "sloka": 33,
    "sanskrit": "एतद्भगवतो रूपं स्थूलं ते व्याहृतं मया मह्यादिभिश्चावरणैरष्टभिर्बहिरावृतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-034",
    "skandha": 2,
    "chapter": 10,
    "sloka": 34,
    "sanskrit": "अतः परं सूक्ष्मतममव्यक्तं निर्विशेषणम् अनादिमध्यनिधनं नित्यं वाङ्मनसः परम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-035",
    "skandha": 2,
    "chapter": 10,
    "sloka": 35,
    "sanskrit": "अमुनी भगवद्रूपे मया ते ह्यनुवर्णिते उभे अपि न गृह्णन्ति मायासृष्टे विपश्चितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-036",
    "skandha": 2,
    "chapter": 10,
    "sloka": 36,
    "sanskrit": "स वाच्यवाचकतया भगवान्ब्रह्मरूपधृक् नामरूपक्रिया धत्ते सकर्माकर्मकः परः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-037",
    "skandha": 2,
    "chapter": 10,
    "sloka": 37,
    "sanskrit": "प्रजापतीन्मनून्देवानृषीन्पितृगणान्पृथक् सिद्धचारणगन्धर्वान्विद्याध्रासुरगुह्यकान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-038",
    "skandha": 2,
    "chapter": 10,
    "sloka": 38,
    "sanskrit": "किन्नराप्सरसो नागान्सर्पान्किम्पुरुषान्नरान् मात्रक्षःपिशाचांश्च प्रेतभूतविनायकान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-039",
    "skandha": 2,
    "chapter": 10,
    "sloka": 39,
    "sanskrit": "कूष्माण्डोन्मादवेतालान्यातुधानान्ग्रहानपि खगान्मृगान्पशून्वृक्षान्गिरीन्नृप सरीसृपान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-040",
    "skandha": 2,
    "chapter": 10,
    "sloka": 40,
    "sanskrit": "द्विविधाश्चतुर्विधा येऽन्ये जलस्थलनभौकसः कुशलाकुशला मिश्राः कर्मणां गतयस्त्विमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-041",
    "skandha": 2,
    "chapter": 10,
    "sloka": 41,
    "sanskrit": "सत्त्वं रजस्तम इति तिस्रः सुरनृनारकाः तत्राप्येकैकशो राजन्भिद्यन्ते गतयस्त्रिधा यदैकैकतरोऽन्याभ्यां स्वभाव उपहन्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-042",
    "skandha": 2,
    "chapter": 10,
    "sloka": 42,
    "sanskrit": "स एवेदं जगद्धाता भगवान्धर्मरूपधृक् पुष्णाति स्थापयन्विश्वं तिर्यङ्नरसुरादिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-043",
    "skandha": 2,
    "chapter": 10,
    "sloka": 43,
    "sanskrit": "ततः कालाग्निरुद्रात्मा यत्सृष्टमिदमात्मनः सन्नियच्छति तत्काले घनानीकमिवानिलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-044",
    "skandha": 2,
    "chapter": 10,
    "sloka": 44,
    "sanskrit": "इत्थम्भावेन कथितो भगवान्भगवत्तमः नेत्थम्भावेन हि परं द्रष्टुमर्हन्ति सूरयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-02-chapter-10-sloka-045",
    "skandha": 2,
    "chapter": 10,
    "sloka": 45,
