[
  {
    "id": "skandha-11-chapter-27-sloka-001",
    "skandha": 11,
    "chapter": 27,
    "sloka": 1,
    "sanskrit": "क्रियायोगं समाचक्ष्व भवदाराधनं प्रभो यस्मात्त्वां ये यथार्चन्ति सात्वताः सात्वतर्षभ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीउद्धव उवाच ।"
  },
  {
    "id": "skandha-11-chapter-27-sloka-002",
    "skandha": 11,
    "chapter": 27,
    "sloka": 2,
    "sanskrit": "एतद्वदन्ति मुनयो मुहुर्निःश्रेयसं नृणाम् नारदो भगवान्व्यास आचार्योऽङ्गिरसः सुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-003",
    "skandha": 11,
    "chapter": 27,
    "sloka": 3,
    "sanskrit": "निःसृतं ते मुखाम्भोजाद्यदाह भगवानजः पुत्रेभ्यो भृगुमुख्येभ्यो देव्यै च भगवान्भवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-004",
    "skandha": 11,
    "chapter": 27,
    "sloka": 4,
    "sanskrit": "एतद्वै सर्ववर्णानामाश्रमाणां च सम्मतम् श्रेयसामुत्तमं मन्ये स्त्रीशूद्राणां च मानद",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-005",
    "skandha": 11,
    "chapter": 27,
    "sloka": 5,
    "sanskrit": "एतत्कमलपत्राक्ष कर्मबन्धविमोचनम् भक्ताय चानुरक्ताय ब्रूहि विश्वेश्वरेश्वर",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-006",
    "skandha": 11,
    "chapter": 27,
    "sloka": 6,
    "sanskrit": "न ह्यन्तोऽनन्तपारस्य कर्मकाण्डस्य चोद्धव सङ्क्षिप्तं वर्णयिष्यामि यथावदनुपूर्वशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-11-chapter-27-sloka-007",
    "skandha": 11,
    "chapter": 27,
    "sloka": 7,
    "sanskrit": "वैदिकस्तान्त्रिको मिश्र इति मे त्रिविधो मखः त्रयाणामीप्सितेनैव विधिना मां समर्चरेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-008",
    "skandha": 11,
    "chapter": 27,
    "sloka": 8,
    "sanskrit": "यदा स्वनिगमेनोक्तं द्विजत्वं प्राप्य पूरुषः यथा यजेत मां भक्त्या श्रद्धया तन्निबोध मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-009",
    "skandha": 11,
    "chapter": 27,
    "sloka": 9,
    "sanskrit": "अर्चायां स्थण्डिलेऽग्नौ वा सूर्ये वाप्सु हृदि द्विजः द्रव्येण भक्तियुक्तोऽर्चेत्स्वगुरुं माममायया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-010",
    "skandha": 11,
    "chapter": 27,
    "sloka": 10,
    "sanskrit": "पूर्वं स्नानं प्रकुर्वीत धौतदन्तोऽङ्गशुद्धये उभयैरपि च स्नानं मन्त्रैर्मृद्ग्रहणादिना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-011",
    "skandha": 11,
    "chapter": 27,
    "sloka": 11,
    "sanskrit": "सन्ध्योपास्त्यादिकर्माणि वेदेनाचोदितानि मे पूजां तैः कल्पयेत्सम्यक् सङ्कल्पः कर्मपावनीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-012",
    "skandha": 11,
    "chapter": 27,
    "sloka": 12,
    "sanskrit": "शैली दारुमयी लौही लेप्या लेख्या च सैकती मनोमयी मणिमयी प्रतिमाष्टविधा स्मृता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-013",
    "skandha": 11,
    "chapter": 27,
    "sloka": 13,
    "sanskrit": "चलाचलेति द्विविधा प्रतिष्ठा जीवमन्दिरम् उद्वासावाहने न स्तः स्थिरायामुद्धवार्चने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-014",
    "skandha": 11,
    "chapter": 27,
    "sloka": 14,
    "sanskrit": "अस्थिरायां विकल्पः स्यात्स्थण्डिले तु भवेद्द्वयम् स्नपनं त्वविलेप्यायामन्यत्र परिमार्जनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-015",
    "skandha": 11,
    "chapter": 27,
    "sloka": 15,
    "sanskrit": "द्रव्यैः प्रसिद्धैर्मद्यागः प्रतिमादिष्वमायिनः भक्तस्य च यथालब्धैर्हृदि भावेन चैव हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-016",
    "skandha": 11,
    "chapter": 27,
    "sloka": 16,
    "sanskrit": "स्नानालङ्करणं प्रेष्ठमर्चायामेव तूद्धव स्थण्डिले तत्त्वविन्यासो वह्नावाज्यप्लुतं हविः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-017",
    "skandha": 11,
    "chapter": 27,
    "sloka": 17,
    "sanskrit": "सूर्ये चाभ्यर्हणं प्रेष्ठं सलिले सलिलादिभिः श्रद्धयोपाहृतं प्रेष्ठं भक्तेन मम वार्यपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-018",
    "skandha": 11,
    "chapter": 27,
    "sloka": 18,
    "sanskrit": "भूर्यप्यभक्तोपाहृतं न मे तोषाय कल्पते गन्धो धूपः सुमनसो दीपोऽन्नाद्यं च किं पुनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-019",
    "skandha": 11,
    "chapter": 27,
    "sloka": 19,
    "sanskrit": "शुचिः सम्भृतसम्भारः प्राग्दर्भैः कल्पितासनः आसीनः प्रागुदग्वार्चेदर्चायां त्वथ सम्मुखः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-020",
    "skandha": 11,
    "chapter": 27,
    "sloka": 20,
    "sanskrit": "कृतन्यासः कृतन्यासां मदर्चां पाणिनामृजेत् कलशं प्रोक्षणीयं च यथावदुपसाधयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-021",
    "skandha": 11,
    "chapter": 27,
    "sloka": 21,
    "sanskrit": "तदद्भिर्देवयजनं द्रव्याण्यात्मानमेव च प्रोक्ष्य पात्राणि त्रीण्यद्भिस्तैस्तैर्द्रव्यैश्च साधयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-022",
    "skandha": 11,
    "chapter": 27,
    "sloka": 22,
    "sanskrit": "पाद्यार्घ्याचमनीयार्थं त्रीणि पात्राणि देशिकः हृदा शीर्ष्णाथ शिखया गायत्र्या चाभिमन्त्रयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-023",
    "skandha": 11,
    "chapter": 27,
    "sloka": 23,
    "sanskrit": "पिण्डे वाय्वग्निसंशुद्धे हृत्पद्मस्थां परां मम अण्वीं जीवकलां ध्यायेन्नादान्ते सिद्धभाविताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-024",
    "skandha": 11,
    "chapter": 27,
    "sloka": 24,
    "sanskrit": "तयात्मभूतया पिण्डे व्याप्ते सम्पूज्य तन्मयः आवाह्यार्चादिषु स्थाप्य न्यस्ताङ्गं मां प्रपूजयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-025",
    "skandha": 11,
    "chapter": 27,
    "sloka": 25,
    "sanskrit": "पाद्योपस्पर्शार्हणादीनुपचारान्प्रकल्पयेत् धर्मादिभिश्च नवभिः कल्पयित्वासनं मम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-026",
    "skandha": 11,
    "chapter": 27,
    "sloka": 26,
    "sanskrit": "पद्ममष्टदलं तत्र कर्णिकाकेसरोज्ज्वलम् उभाभ्यां वेदतन्त्राभ्यां मह्यं तूभयसिद्धये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-027",
    "skandha": 11,
    "chapter": 27,
    "sloka": 27,
    "sanskrit": "सुदर्शनं पाञ्चजन्यं गदासीषुधनुर्हलान् मुषलं कौस्तुभं मालां श्रीवत्सं चानुपूजयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-028",
    "skandha": 11,
    "chapter": 27,
    "sloka": 28,
    "sanskrit": "नन्दं सुनन्दं गरुडं प्रचण्डं चण्डं एव च महाबलं बलं चैव कुमुदं कमुदेक्षणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-029",
    "skandha": 11,
    "chapter": 27,
    "sloka": 29,
    "sanskrit": "दुर्गां विनायकं व्यासं विष्वक्षेनं गुरून्सुरान् स्वे स्वे स्थाने त्वभिमुखान्पूजयेत्प्रोक्षणादिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-030",
    "skandha": 11,
    "chapter": 27,
    "sloka": 30,
    "sanskrit": "चन्दनोशीरकर्पूर कुङ्कुमागुरुवासितैः सलिलैः स्नापयेन्मन्त्रैर्नित्यदा विभवे सति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-031",
    "skandha": 11,
    "chapter": 27,
    "sloka": 31,
    "sanskrit": "स्वर्णघर्मानुवाकेन महापुरुषविद्यया पौरुषेणापि सूक्तेन सामभी राजनादिभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-032",
    "skandha": 11,
    "chapter": 27,
    "sloka": 32,
    "sanskrit": "वस्त्रोपवीताभरण पत्रस्रग्गन्धलेपनैः अलङ्कुर्वीत सप्रेम मद्भक्तो मां यथोचितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-033",
    "skandha": 11,
    "chapter": 27,
    "sloka": 33,
    "sanskrit": "पाद्यमाचमनीयं च गन्धं सुमनसोऽक्षतान् धूपदीपोपहार्याणि दद्यान्मे श्रद्धयार्चकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-034",
    "skandha": 11,
    "chapter": 27,
    "sloka": 34,
    "sanskrit": "गुडपायससर्पींषि शष्कुल्यापूपमोदकान् संयावदधिसूपांश्च नैवेद्यं सति कल्पयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-035",
    "skandha": 11,
    "chapter": 27,
    "sloka": 35,
    "sanskrit": "अभ्यङ्गोन्मर्दनादर्श दन्तधावाभिषेचनम् अन्नाद्यगीतनृत्यानि पर्वणि स्युरुतान्वहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-036",
    "skandha": 11,
    "chapter": 27,
    "sloka": 36,
    "sanskrit": "विधिना विहिते कुण्डे मेखलागर्तवेदिभिः अग्निमाधाय परितः समूहेत्पाणिनोदितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-037",
    "skandha": 11,
    "chapter": 27,
    "sloka": 37,
    "sanskrit": "परिस्तीर्याथ पर्युक्षेदन्वाधाय यथाविधि प्रोक्षण्यासाद्य द्रव्याणि प्रोक्ष्याग्नौ भावयेत माम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-038",
    "skandha": 11,
    "chapter": 27,
    "sloka": 38,
    "sanskrit": "तप्तजाम्बूनदप्रख्यं शङ्खचक्रगदाम्बुजैः लसच्चतुर्भुजं शान्तं पद्मकिञ्जल्कवाससम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-039",
    "skandha": 11,
    "chapter": 27,
    "sloka": 39,
    "sanskrit": "स्फुरत्किरीटकटक कटिसूत्रवराङ्गदम् श्रीवत्सवक्षसं भ्राजत् कौस्तुभं वनमालिनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-040",
    "skandha": 11,
    "chapter": 27,
    "sloka": 40,
    "sanskrit": "ध्यायन्नभ्यर्च्य दारूणि हविषाभिघृतानि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-041",
    "skandha": 11,
    "chapter": 27,
    "sloka": 41,
    "sanskrit": "जुहुयान्मूलमन्त्रेण षोडशर्चावदानतः प्रास्याज्यभागावाघारौ दत्त्वा चाज्यप्लुतं हविः धर्मादिभ्यो यथान्यायं मन्त्रैः स्विष्टिकृतं बुधः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-042",
    "skandha": 11,
    "chapter": 27,
    "sloka": 42,
    "sanskrit": "अभ्यर्च्याथ नमस्कृत्य पार्षदेभ्यो बलिं हरेत् मूलमन्त्रं जपेद्ब्रह्म स्मरन्नारायणात्मकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-043",
    "skandha": 11,
    "chapter": 27,
    "sloka": 43,
    "sanskrit": "दत्त्वाचमनमुच्छेषं विष्वक्षेनाय कल्पयेत् मुखवासं सुरभिमत्ताम्बूलाद्यमथार्हयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-044",
    "skandha": 11,
    "chapter": 27,
    "sloka": 44,
    "sanskrit": "उपगायन्गृणन्नृत्यन्कर्माण्यभिनयन्मम मत्कथाः श्रावयन्शृण्वन्मुहूर्तं क्षणिको भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-27-sloka-045",
    "skandha": 11,
    "chapter": 27,
    "sloka": 45,
