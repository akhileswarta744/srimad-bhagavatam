[
  {
    "id": "skandha-11-chapter-24-sloka-001",
    "skandha": 11,
    "chapter": 24,
    "sloka": 1,
    "sanskrit": "अथ ते सम्प्रवक्ष्यामि साङ्ख्यं पूर्वैर्विनिश्चितम् यद्विज्ञाय पुमान्सद्यो जह्याद्वैकल्पिकं भ्रमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-11-chapter-24-sloka-002",
    "skandha": 11,
    "chapter": 24,
    "sloka": 2,
    "sanskrit": "आसीज्ज्ञानमथो अर्थ एकमेवाविकल्पितम् यदा विवेकनिपुणा आदौ कृतयुगेऽयुगे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-003",
    "skandha": 11,
    "chapter": 24,
    "sloka": 3,
    "sanskrit": "तन्मायाफलरूपेण केवलं निर्विकल्पितम् वाङ्मनोऽगोचरं सत्यं द्विधा समभवद्बृहत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-004",
    "skandha": 11,
    "chapter": 24,
    "sloka": 4,
    "sanskrit": "तयोरेकतरो ह्यर्थः प्रकृतिः सोभयात्मिका ज्ञानं त्वन्यतमो भावः पुरुषः सोऽभिधीयते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-005",
    "skandha": 11,
    "chapter": 24,
    "sloka": 5,
    "sanskrit": "तमो रजः सत्त्वमिति प्रकृतेरभवन्गुणाः मया प्रक्षोभ्यमाणायाः पुरुषानुमतेन च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-006",
    "skandha": 11,
    "chapter": 24,
    "sloka": 6,
    "sanskrit": "तेभ्यः समभवत्सूत्रं महान्सूत्रेण संयुतः ततो विकुर्वतो जातो योऽहङ्कारो विमोहनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-007",
    "skandha": 11,
    "chapter": 24,
    "sloka": 7,
    "sanskrit": "वैकारिकस्तैजसश्च तामसश्चेत्यहं त्रिवृत् तन्मात्रेन्द्रियमनसां कारणं चिदचिन्मयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-008",
    "skandha": 11,
    "chapter": 24,
    "sloka": 8,
    "sanskrit": "अर्थस्तन्मात्रिकाज्जज्ञे तामसादिन्द्रियाणि च तैजसाद्देवता आसन्नेकादश च वैकृतात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-009",
    "skandha": 11,
    "chapter": 24,
    "sloka": 9,
    "sanskrit": "मया सञ्चोदिता भावाः सर्वे संहत्यकारिणः अण्डमुत्पादयामासुर्ममायतनमुत्तमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-010",
    "skandha": 11,
    "chapter": 24,
    "sloka": 10,
    "sanskrit": "तस्मिन्नहं समभवमण्डे सलिलसंस्थितौ मम नाभ्यामभूत्पद्मं विश्वाख्यं तत्र चात्मभूः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-011",
    "skandha": 11,
    "chapter": 24,
    "sloka": 11,
    "sanskrit": "सोऽसृजत्तपसा युक्तो रजसा मदनुग्रहात् लोकान्सपालान्विश्वात्मा भूर्भुवः स्वरिति त्रिधा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-012",
    "skandha": 11,
    "chapter": 24,
    "sloka": 12,
    "sanskrit": "देवानामोक आसीत्स्वर्भूतानां च भुवः पदम् मर्त्यादीनां च भूर्लोकः सिद्धानां त्रितयात्परम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-013",
    "skandha": 11,
    "chapter": 24,
    "sloka": 13,
    "sanskrit": "अधोऽसुराणां नागानां भूमेरोकोऽसृजत्प्रभुः त्रिलोक्यां गतयः सर्वाः कर्मणां त्रिगुणात्मनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-014",
    "skandha": 11,
    "chapter": 24,
    "sloka": 14,
    "sanskrit": "योगस्य तपसश्चैव न्यासस्य गतयोऽमलाः महर्जनस्तपः सत्यं भक्तियोगस्य मद्गतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-015",
    "skandha": 11,
    "chapter": 24,
    "sloka": 15,
    "sanskrit": "मया कालात्मना धात्रा कर्मयुक्तमिदं जगत् गुणप्रवाह एतस्मिन्नुन्मज्जति निमज्जति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-016",
    "skandha": 11,
    "chapter": 24,
    "sloka": 16,
    "sanskrit": "अणुर्बृहत्कृशः स्थूलो यो यो भावः प्रसिध्यति सर्वोऽप्युभयसंयुक्तः प्रकृत्या पुरुषेण च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-017",
    "skandha": 11,
    "chapter": 24,
    "sloka": 17,
    "sanskrit": "यस्तु यस्यादिरन्तश्च स वै मध्यं च तस्य सन् विकारो व्यवहारार्थो यथा तैजसपार्थिवाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-018",
    "skandha": 11,
    "chapter": 24,
    "sloka": 18,
    "sanskrit": "यदुपादाय पूर्वस्तु भावो विकुरुतेऽपरम् आदिरन्तो यदा यस्य तत्सत्यमभिधीयते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-019",
    "skandha": 11,
    "chapter": 24,
    "sloka": 19,
    "sanskrit": "प्रकृतिर्यस्योपादानमाधारः पुरुषः परः सतोऽभिव्यञ्जकः कालो ब्रह्म तत्त्रितयं त्वहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-020",
    "skandha": 11,
    "chapter": 24,
    "sloka": 20,
    "sanskrit": "सर्गः प्रवर्तते तावत्पौर्वापर्येण नित्यशः महान्गुणविसर्गार्थः स्थित्यन्तो यावदीक्षणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-021",
    "skandha": 11,
    "chapter": 24,
    "sloka": 21,
    "sanskrit": "विराण्मयासाद्यमानो लोककल्पविकल्पकः पञ्चत्वाय विशेषाय कल्पते भुवनैः सह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-022",
    "skandha": 11,
    "chapter": 24,
    "sloka": 22,
    "sanskrit": "अन्ने प्रलीयते मर्त्यमन्नं धानासु लीयते धाना भूमौ प्रलीयन्ते भूमिर्गन्धे प्रलीयते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-023",
    "skandha": 11,
    "chapter": 24,
    "sloka": 23,
    "sanskrit": "अप्सु प्रलीयते गन्ध आपश्च स्वगुणे रसे लीयते ज्योतिषि रसो ज्योती रूपे प्रलीयते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-024",
    "skandha": 11,
    "chapter": 24,
    "sloka": 24,
    "sanskrit": "रूपं वायौ स च स्पर्शे लीयते सोऽपि चाम्बरे अम्बरं शब्दतन्मात्र इन्द्रियाणि स्वयोनिषु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-025",
    "skandha": 11,
    "chapter": 24,
    "sloka": 25,
    "sanskrit": "योनिर्वैकारिके सौम्य लीयते मनसीश्वरे शब्दो भूतादिमप्येति भूतादिर्महति प्रभुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-026",
    "skandha": 11,
    "chapter": 24,
    "sloka": 26,
    "sanskrit": "स लीयते महान्स्वेषु गुणेसु गुणवत्तमः तेऽव्यक्ते सम्प्रलीयन्ते तत्काले लीयतेऽव्यये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-027",
    "skandha": 11,
    "chapter": 24,
    "sloka": 27,
    "sanskrit": "कालो मायामये जीवे जीव आत्मनि मय्यजे आत्मा केवल आत्मस्थो विकल्पापायलक्षणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-028",
    "skandha": 11,
    "chapter": 24,
    "sloka": 28,
    "sanskrit": "एवमन्वीक्षमाणस्य कथं वैकल्पिको भ्रमः मनसो हृदि तिष्ठेत व्योम्नीवार्कोदये तमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-24-sloka-029",
    "skandha": 11,
    "chapter": 24,
    "sloka": 29,
    "sanskrit": "एष साङ्ख्यविधिः प्रोक्तः संशयग्रन्थिभेदनः प्रतिलोमानुलोमाभ्यां परावरदृश मया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]