[
  {
    "id": "skandha-11-chapter-15-sloka-001",
    "skandha": 11,
    "chapter": 15,
    "sloka": 1,
    "sanskrit": "जितेन्द्रियस्य युक्तस्य जितश्वासस्य योगिनः मयि धारयतश्चेत उपतिष्ठन्ति सिद्धयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-11-chapter-15-sloka-002",
    "skandha": 11,
    "chapter": 15,
    "sloka": 2,
    "sanskrit": "कया धारणया का स्वित्कथं वा सिद्धिरच्युत कति वा सिद्धयो ब्रूहि योगिनां सिद्धिदो भवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीउद्धव उवाच ।"
  },
  {
    "id": "skandha-11-chapter-15-sloka-003",
    "skandha": 11,
    "chapter": 15,
    "sloka": 3,
    "sanskrit": "सिद्धयोऽष्टादश प्रोक्ता धारणा योगपारगैः तासामष्टौ मत्प्रधाना दशैव गुणहेतवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-11-chapter-15-sloka-004",
    "skandha": 11,
    "chapter": 15,
    "sloka": 4,
    "sanskrit": "अणिमा महिमा मूर्तेर्लघिमा प्राप्तिरिन्द्रियैः प्राकाम्यं श्रुतदृष्टेषु शक्तिप्रेरणमीशिता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-005",
    "skandha": 11,
    "chapter": 15,
    "sloka": 5,
    "sanskrit": "गुणेष्वसङ्गो वशिता यत्कामस्तदवस्यति एता मे सिद्धयः सौम्य अष्टावौत्पत्तिका मताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-006",
    "skandha": 11,
    "chapter": 15,
    "sloka": 6,
    "sanskrit": "अनूर्मिमत्त्वं देहेऽस्मिन्दूरश्रवणदर्शनम् मनोजवः कामरूपं परकायप्रवेशनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-007",
    "skandha": 11,
    "chapter": 15,
    "sloka": 7,
    "sanskrit": "स्वच्छन्दमृत्युर्देवानां सहक्रीडानुदर्शनम् यथासङ्कल्पसंसिद्धिराज्ञाप्रतिहता गतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-008",
    "skandha": 11,
    "chapter": 15,
    "sloka": 8,
    "sanskrit": "त्रिकालज्ञत्वमद्वन्द्वं परचित्ताद्यभिज्ञता अग्न्यर्काम्बुविषादीनां प्रतिष्टम्भोऽपराजयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-009",
    "skandha": 11,
    "chapter": 15,
    "sloka": 9,
    "sanskrit": "एताश्चोद्देशतः प्रोक्ता योगधारणसिद्धयः यया धारणया या स्याद्यथा वा स्यान्निबोध मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-010",
    "skandha": 11,
    "chapter": 15,
    "sloka": 10,
    "sanskrit": "भूतसूक्ष्मात्मनि मयि तन्मात्रं धारयेन्मनः अणिमानमवाप्नोति तन्मात्रोपासको मम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-011",
    "skandha": 11,
    "chapter": 15,
    "sloka": 11,
    "sanskrit": "महत्तत्त्वात्मनि मयि यथासंस्थं मनो दधत् महिमानमवाप्नोति भूतानां च पृथक्पृथक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-012",
    "skandha": 11,
    "chapter": 15,
    "sloka": 12,
    "sanskrit": "परमाणुमये चित्तं भूतानां मयि रञ्जयन् कालसूक्ष्मार्थतां योगी लघिमानमवाप्नुयात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-013",
    "skandha": 11,
    "chapter": 15,
    "sloka": 13,
    "sanskrit": "धारयन्मय्यहंतत्त्वे मनो वैकारिकेऽखिलम् सर्वेन्द्रियाणामात्मत्वं प्राप्तिं प्राप्नोति मन्मनाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-014",
    "skandha": 11,
    "chapter": 15,
    "sloka": 14,
    "sanskrit": "महत्यात्मनि यः सूत्रे धारयेन्मयि मानसम् प्राकाम्यं पारमेष्ठ्यं मे विन्दतेऽव्यक्तजन्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-015",
    "skandha": 11,
    "chapter": 15,
    "sloka": 15,
    "sanskrit": "विष्णौ त्र्यधीश्वरे चित्तं धारयेत्कालविग्रहे स ईशित्वमवाप्नोति क्षेत्रज्ञक्षेत्रचोदनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-016",
    "skandha": 11,
    "chapter": 15,
    "sloka": 16,
    "sanskrit": "नारायणे तुरीयाख्ये भगवच्छब्दशब्दिते मनो मय्यादधद्योगी मद्धर्मा वशितामियात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-017",
    "skandha": 11,
    "chapter": 15,
    "sloka": 17,
    "sanskrit": "निर्गुणे ब्रह्मणि मयि धारयन्विशदं मनः परमानन्दमाप्नोति यत्र कामोऽवसीयते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-018",
    "skandha": 11,
    "chapter": 15,
    "sloka": 18,
    "sanskrit": "श्वेतद्वीपपतौ चित्तं शुद्धे धर्ममये मयि धारयञ्छ्वेततां याति षडूर्मिरहितो नरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-019",
    "skandha": 11,
    "chapter": 15,
    "sloka": 19,
    "sanskrit": "मय्याकाशात्मनि प्राणे मनसा घोषमुद्वहन् तत्रोपलब्धा भूतानां हंसो वाचः शृणोत्यसौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-020",
    "skandha": 11,
    "chapter": 15,
    "sloka": 20,
    "sanskrit": "चक्षुस्त्वष्टरि संयोज्य त्वष्टारमपि चक्षुषि मां तत्र मनसा ध्यायन्विश्वं पश्यति दूरतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-021",
    "skandha": 11,
    "chapter": 15,
    "sloka": 21,
    "sanskrit": "मनो मयि सुसंयोज्य देहं तदनुवायुना मद्धारणानुभावेन तत्रात्मा यत्र वै मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-022",
    "skandha": 11,
    "chapter": 15,
    "sloka": 22,
    "sanskrit": "यदा मन उपादाय यद्यद्रूपं बुभूषति तत्तद्भवेन्मनोरूपं मद्योगबलमाश्रयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-023",
    "skandha": 11,
    "chapter": 15,
    "sloka": 23,
    "sanskrit": "परकायं विशन्सिद्ध आत्मानं तत्र भावयेत् पिण्डं हित्वा विशेत्प्राणो वायुभूतः षडङ्घ्रिवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-024",
    "skandha": 11,
    "chapter": 15,
    "sloka": 24,
    "sanskrit": "पार्ष्ण्यापीड्य गुदं प्राणं हृदुरःकण्ठमूर्धसु आरोप्य ब्रह्मरन्ध्रेण ब्रह्म नीत्वोत्सृजेत्तनुम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-025",
    "skandha": 11,
    "chapter": 15,
    "sloka": 25,
    "sanskrit": "विहरिष्यन्सुराक्रीडे मत्स्थं सत्त्वं विभावयेत् विमानेनोपतिष्ठन्ति सत्त्ववृत्तीः सुरस्त्रियः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-026",
    "skandha": 11,
    "chapter": 15,
    "sloka": 26,
    "sanskrit": "यथा सङ्कल्पयेद्बुद्ध्या यदा वा मत्परः पुमान् मयि सत्ये मनो युञ्जंस्तथा तत्समुपाश्नुते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-027",
    "skandha": 11,
    "chapter": 15,
    "sloka": 27,
    "sanskrit": "यो वै मद्भावमापन्न ईशितुर्वशितुः पुमान् कुतश्चिन्न विहन्येत तस्य चाज्ञा यथा मम",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-028",
    "skandha": 11,
    "chapter": 15,
    "sloka": 28,
    "sanskrit": "मद्भक्त्या शुद्धसत्त्वस्य योगिनो धारणाविदः तस्य त्रैकालिकी बुद्धिर्जन्ममृत्यूपबृंहिता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-029",
    "skandha": 11,
    "chapter": 15,
    "sloka": 29,
    "sanskrit": "अग्न्यादिभिर्न हन्येत मुनेर्योगमयं वपुः मद्योगशान्तचित्तस्य यादसामुदकं यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-030",
    "skandha": 11,
    "chapter": 15,
    "sloka": 30,
    "sanskrit": "मद्विभूतीरभिध्यायन्श्रीवत्सास्त्रविभूषिताः ध्वजातपत्रव्यजनैः स भवेदपराजितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-031",
    "skandha": 11,
    "chapter": 15,
    "sloka": 31,
    "sanskrit": "उपासकस्य मामेवं योगधारणया मुनेः सिद्धयः पूर्वकथिता उपतिष्ठन्त्यशेषतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-032",
    "skandha": 11,
    "chapter": 15,
    "sloka": 32,
    "sanskrit": "जितेन्द्रियस्य दान्तस्य जितश्वासात्मनो मुनेः मद्धारणां धारयतः का सा सिद्धिः सुदुर्लभा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-033",
    "skandha": 11,
    "chapter": 15,
    "sloka": 33,
    "sanskrit": "अन्तरायान्वदन्त्येता युञ्जतो योगमुत्तमम् मया सम्पद्यमानस्य कालक्षपणहेतवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-034",
    "skandha": 11,
    "chapter": 15,
    "sloka": 34,
    "sanskrit": "जन्मौषधितपोमन्त्रैर्यावतीरिह सिद्धयः योगेनाप्नोति ताः सर्वा नान्यैर्योगगतिं व्रजेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-035",
    "skandha": 11,
    "chapter": 15,
    "sloka": 35,
    "sanskrit": "सर्वासामपि सिद्धीनां हेतुः पतिरहं प्रभुः अहं योगस्य साङ्ख्यस्य धर्मस्य ब्रह्मवादिनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-15-sloka-036",
    "skandha": 11,
    "chapter": 15,
    "sloka": 36,
    "sanskrit": "अहमात्मान्तरो बाह्योऽनावृतः सर्वदेहिनाम् यथा भूतानि भूतेषु बहिरन्तः स्वयं तथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]