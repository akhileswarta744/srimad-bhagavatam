[
  {
    "id": "skandha-11-chapter-08-sloka-001",
    "skandha": 11,
    "chapter": 8,
    "sloka": 1,
    "sanskrit": "सुखमैन्द्रियकं राजन्स्वर्गे नरक एव च देहिनां यद्यथा दुःखं तस्मान्नेच्छेत तद्बुधः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीब्राह्मण उवाच ।"
  },
  {
    "id": "skandha-11-chapter-08-sloka-002",
    "skandha": 11,
    "chapter": 8,
    "sloka": 2,
    "sanskrit": "ग्रासं सुमृष्टं विरसं महान्तं स्तोकमेव वा यदृच्छयैवापतितं ग्रसेदाजगरोऽक्रियः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-003",
    "skandha": 11,
    "chapter": 8,
    "sloka": 3,
    "sanskrit": "शयीताहानि भूरीणि निराहारोऽनुपक्रमः यदि नोपनयेद्ग्रासो महाहिरिव दिष्टभुक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-004",
    "skandha": 11,
    "chapter": 8,
    "sloka": 4,
    "sanskrit": "ओजःसहोबलयुतं बिभ्रद्देहमकर्मकम् शयानो वीतनिद्रश्च नेहेतेन्द्रियवानपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-005",
    "skandha": 11,
    "chapter": 8,
    "sloka": 5,
    "sanskrit": "मुनिः प्रसन्नगम्भीरो दुर्विगाह्यो दुरत्ययः अनन्तपारो ह्यक्षोभ्यः स्तिमितोद इवार्णवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-006",
    "skandha": 11,
    "chapter": 8,
    "sloka": 6,
    "sanskrit": "समृद्धकामो हीनो वा नारायणपरो मुनिः नोत्सर्पेत न शुष्येत सरिद्भिरिव सागरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-007",
    "skandha": 11,
    "chapter": 8,
    "sloka": 7,
    "sanskrit": "दृष्ट्वा स्त्रियं देवमायां तद्भावैरजितेन्द्रियः प्रलोभितः पतत्यन्धे तमस्यग्नौ पतङ्गवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-008",
    "skandha": 11,
    "chapter": 8,
    "sloka": 8,
    "sanskrit": "योषिद्धिरण्याभरणाम्बरादि द्रव्येषु मायारचितेषु मूढः प्रलोभितात्मा ह्युपभोगबुद्ध्या पतङ्गवन्नश्यति नष्टदृष्टिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-009",
    "skandha": 11,
    "chapter": 8,
    "sloka": 9,
    "sanskrit": "स्तोकं स्तोकं ग्रसेद्ग्रासं देहो वर्तेत यावता गृहानहिंसन्नातिष्ठेद्वृत्तिं माधुकरीं मुनिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-010",
    "skandha": 11,
    "chapter": 8,
    "sloka": 10,
    "sanskrit": "अणुभ्यश्च महद्भ्यश्च शास्त्रेभ्यः कुशलो नरः सर्वतः सारमादद्यात्पुष्पेभ्य इव षट्पदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-011",
    "skandha": 11,
    "chapter": 8,
    "sloka": 11,
    "sanskrit": "सायन्तनं श्वस्तनं वा न सङ्गृह्णीत भिक्षितम् पाणिपात्रोदरामत्रो मक्षिकेव न सङ्ग्रही",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-012",
    "skandha": 11,
    "chapter": 8,
    "sloka": 12,
    "sanskrit": "सायन्तनं श्वस्तनं वा न सङ्गृह्णीत भिक्षुकः मक्षिका इव सङ्गृह्णन्सह तेन विनश्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-013",
    "skandha": 11,
    "chapter": 8,
    "sloka": 13,
    "sanskrit": "पदापि युवतीं भिक्षुर्न स्पृशेद्दारवीमपि स्पृशन्करीव बध्येत करिण्या अङ्गसङ्गतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-014",
    "skandha": 11,
    "chapter": 8,
    "sloka": 14,
    "sanskrit": "नाधिगच्छेत्स्त्रियं प्राज्ञः कर्हिचिन्मृत्युमात्मनः बलाधिकैः स हन्येत गजैरन्यैर्गजो यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-015",
    "skandha": 11,
    "chapter": 8,
    "sloka": 15,
    "sanskrit": "न देयं नोपभोग्यं च लुब्धैर्यद्दुःखसञ्चितम् भुङ्क्ते तदपि तच्चान्यो मधुहेवार्थविन्मधु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-016",
    "skandha": 11,
    "chapter": 8,
    "sloka": 16,
    "sanskrit": "सुदुःखोपार्जितैर्वित्तैराशासानां गृहाशिषः मधुहेवाग्रतो भुङ्क्ते यतिर्वै गृहमेधिनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-017",
    "skandha": 11,
    "chapter": 8,
    "sloka": 17,
    "sanskrit": "ग्राम्यगीतं न शृणुयाद्यतिर्वनचरः क्वचित् शिक्षेत हरिणाद्बद्धान्मृगयोर्गीतमोहितात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-018",
    "skandha": 11,
    "chapter": 8,
    "sloka": 18,
    "sanskrit": "नृत्यवादित्रगीतानि जुषन्ग्राम्याणि योषिताम् आसां क्रीडनको वश्य ऋष्यशृङ्गो मृगीसुतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-019",
    "skandha": 11,
    "chapter": 8,
    "sloka": 19,
    "sanskrit": "जिह्वयातिप्रमाथिन्या जनो रसविमोहितः मृत्युमृच्छत्यसद्बुद्धिर्मीनस्तु बडिशैर्यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-020",
    "skandha": 11,
    "chapter": 8,
    "sloka": 20,
    "sanskrit": "इन्द्रियाणि जयन्त्याशु निराहारा मनीषिणः वर्जयित्वा तु रसनं तन्निरन्नस्य वर्धते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-021",
    "skandha": 11,
    "chapter": 8,
    "sloka": 21,
    "sanskrit": "तावज्जितेन्द्रियो न स्याद्विजितान्येन्द्रियः पुमान् न जयेद्रसनं यावज्जितं सर्वं जिते रसे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-022",
    "skandha": 11,
    "chapter": 8,
    "sloka": 22,
    "sanskrit": "पिङ्गला नाम वेश्यासीद्विदेहनगरे पुरा तस्या मे शिक्षितं किञ्चिन्निबोध नृपनन्दन",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-023",
    "skandha": 11,
    "chapter": 8,
    "sloka": 23,
    "sanskrit": "सा स्वैरिण्येकदा कान्तं सङ्केत उपनेष्यती अभूत्काले बहिर्द्वारे बिभ्रती रूपमुत्तमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-024",
    "skandha": 11,
    "chapter": 8,
    "sloka": 24,
    "sanskrit": "मार्ग आगच्छतो वीक्ष्य पुरुषान्पुरुषर्षभ तान्शुल्कदान्वित्तवतः कान्तान्मेनेऽर्थकामुकी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-025",
    "skandha": 11,
    "chapter": 8,
    "sloka": 25,
    "sanskrit": "आगतेष्वपयातेषु सा सङ्केतोपजीविनी अप्यन्यो वित्तवान्कोऽपि मामुपैष्यति भूरिदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-026",
    "skandha": 11,
    "chapter": 8,
    "sloka": 26,
    "sanskrit": "एवं दुराशया ध्वस्त निद्रा द्वार्यवलम्बती निर्गच्छन्ती प्रविशती निशीथं समपद्यत",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-027",
    "skandha": 11,
    "chapter": 8,
    "sloka": 27,
    "sanskrit": "तस्या वित्ताशया शुष्यद् वक्त्राया दीनचेतसः निर्वेदः परमो जज्ञे चिन्ताहेतुः सुखावहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-028",
    "skandha": 11,
    "chapter": 8,
    "sloka": 28,
    "sanskrit": "तस्या निर्विण्णचित्ताया गीतं शृणु यथा मम निर्वेद आशापाशानां पुरुषस्य यथा ह्यसिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-029",
    "skandha": 11,
    "chapter": 8,
    "sloka": 29,
    "sanskrit": "न ह्यङ्गाजातनिर्वेदो देहबन्धं जिहासति यथा विज्ञानरहितो मनुजो ममतां नृप",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-030",
    "skandha": 11,
    "chapter": 8,
    "sloka": 30,
    "sanskrit": "अहो मे मोहविततिं पश्यताविजितात्मनः या कान्तादसतः कामं कामये येन बालिशा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "पिङ्गलोवाच ।"
  },
  {
    "id": "skandha-11-chapter-08-sloka-031",
    "skandha": 11,
    "chapter": 8,
    "sloka": 31,
    "sanskrit": "सन्तं समीपे रमणं रतिप्रदं वित्तप्रदं नित्यमिमं विहाय अकामदं दुःखभयाधिशोक मोहप्रदं तुच्छमहं भजेऽज्ञा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-032",
    "skandha": 11,
    "chapter": 8,
    "sloka": 32,
    "sanskrit": "अहो मयात्मा परितापितो वृथा साङ्केत्यवृत्त्यातिविगर्ह्यवार्तया स्त्रैणान्नराद्यार्थतृषोऽनुशोच्यात्क्रीतेन वित्तं रतिमात्मनेच्छती",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-033",
    "skandha": 11,
    "chapter": 8,
    "sloka": 33,
    "sanskrit": "यदस्थिभिर्निर्मितवंशवंस्य स्थूणं त्वचा रोमनखैः पिनद्धम् क्षरन्नवद्वारमगारमेतद् विण्मूत्रपूर्णं मदुपैति कान्या",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-034",
    "skandha": 11,
    "chapter": 8,
    "sloka": 34,
    "sanskrit": "विदेहानां पुरे ह्यस्मिन्नहमेकैव मूढधीः यान्यमिच्छन्त्यसत्यस्मादात्मदात्काममच्युतात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-035",
    "skandha": 11,
    "chapter": 8,
    "sloka": 35,
    "sanskrit": "सुहृत्प्रेष्ठतमो नाथ आत्मा चायं शरीरिणाम् तं विक्रीयात्मनैवाहं रमेऽनेन यथा रमा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-036",
    "skandha": 11,
    "chapter": 8,
    "sloka": 36,
    "sanskrit": "कियत्प्रियं ते व्यभजन्कामा ये कामदा नराः आद्यन्तवन्तो भार्याया देवा वा कालविद्रुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-037",
    "skandha": 11,
    "chapter": 8,
    "sloka": 37,
    "sanskrit": "नूनं मे भगवान्प्रीतो विष्णुः केनापि कर्मणा निर्वेदोऽयं दुराशाया यन्मे जातः सुखावहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-038",
    "skandha": 11,
    "chapter": 8,
    "sloka": 38,
    "sanskrit": "मैवं स्युर्मन्दभाग्यायाः क्लेशा निर्वेदहेतवः येनानुबन्धं निर्हृत्य पुरुषः शममृच्छति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-039",
    "skandha": 11,
    "chapter": 8,
    "sloka": 39,
    "sanskrit": "तेनोपकृतमादाय शिरसा ग्राम्यसङ्गताः त्यक्त्वा दुराशाः शरणं व्रजामि तमधीश्वरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-040",
    "skandha": 11,
    "chapter": 8,
    "sloka": 40,
    "sanskrit": "सन्तुष्टा श्रद्दधत्येतद्यथालाभेन जीवती विहराम्यमुनैवाहमात्मना रमणेन वै",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-041",
    "skandha": 11,
    "chapter": 8,
    "sloka": 41,
    "sanskrit": "संसारकूपे पतितं विषयैर्मुषितेक्षणम् ग्रस्तं कालाहिनात्मानं कोऽन्यस्त्रातुमधीश्वरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-042",
    "skandha": 11,
    "chapter": 8,
    "sloka": 42,
    "sanskrit": "आत्मैव ह्यात्मनो गोप्ता निर्विद्येत यदाखिलात् अप्रमत्त इदं पश्येद्ग्रस्तं कालाहिना जगत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-08-sloka-043",
    "skandha": 11,
    "chapter": 8,
    "sloka": 43,
    "sanskrit": "एवं व्यवसितमतिर्दुराशां कान्ततर्षजाम् छित्त्वोपशममास्थाय शय्यामुपविवेश सा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीब्राह्मण उवाच ।"
  },
  {
    "id": "skandha-11-chapter-08-sloka-044",
    "skandha": 11,
    "chapter": 8,
    "sloka": 44,
    "sanskrit": "आशा हि परमं दुःखं नैराश्यं परमं सुखम् यथा सञ्छिद्य कान्ताशां सुखं सुष्वाप पिङ्गला",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]