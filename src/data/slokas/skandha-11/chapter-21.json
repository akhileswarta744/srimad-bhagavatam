[
  {
    "id": "skandha-11-chapter-21-sloka-001",
    "skandha": 11,
    "chapter": 21,
    "sloka": 1,
    "sanskrit": "य एतान्मत्पथो हित्वा भक्तिज्ञानक्रियात्मकान् क्षुद्रान्कामांश्चलैः प्राणैर्जुषन्तः संसरन्ति ते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-11-chapter-21-sloka-002",
    "skandha": 11,
    "chapter": 21,
    "sloka": 2,
    "sanskrit": "स्वे स्वेऽधिकारे या निष्ठा स गुणः परिकीर्तितः विपर्ययस्तु दोषः स्यादुभयोरेष निश्चयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-003",
    "skandha": 11,
    "chapter": 21,
    "sloka": 3,
    "sanskrit": "शुद्ध्यशुद्धी विधीयेते समानेष्वपि वस्तुषु द्रव्यस्य विचिकित्सार्थं गुणदोषौ शुभाशुभौ धर्मार्थं व्यवहारार्थं यात्रार्थमिति चानघ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-004",
    "skandha": 11,
    "chapter": 21,
    "sloka": 4,
    "sanskrit": "दर्शितोऽयं मयाचारो धर्ममुद्वहतां धुरम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-005",
    "skandha": 11,
    "chapter": 21,
    "sloka": 5,
    "sanskrit": "भूम्यम्ब्वग्न्यनिलाकाशा भूतानां पञ्चधातवः आब्रह्मस्थावरादीनां शारीरा आत्मसंयुताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-006",
    "skandha": 11,
    "chapter": 21,
    "sloka": 6,
    "sanskrit": "वेदेन नामरूपाणि विषमाणि समेष्वपि धातुषूद्धव कल्प्यन्त एतेषां स्वार्थसिद्धये",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-007",
    "skandha": 11,
    "chapter": 21,
    "sloka": 7,
    "sanskrit": "देशकालादिभावानां वस्तूनां मम सत्तम गुणदोषौ विधीयेते नियमार्थं हि कर्मणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-008",
    "skandha": 11,
    "chapter": 21,
    "sloka": 8,
    "sanskrit": "अकृष्णसारो देशानामब्रह्मण्योऽसुचिर्भवेत् कृष्णसारोऽप्यसौवीर कीकटासंस्कृतेरिणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-009",
    "skandha": 11,
    "chapter": 21,
    "sloka": 9,
    "sanskrit": "कर्मण्यो गुणवान्कालो द्रव्यतः स्वत एव वा यतो निवर्तते कर्म स दोषोऽकर्मकः स्मृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-010",
    "skandha": 11,
    "chapter": 21,
    "sloka": 10,
    "sanskrit": "द्रव्यस्य शुद्ध्यशुद्धी च द्रव्येण वचनेन च संस्कारेणाथ कालेन महत्वाल्पतयाथ वा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-011",
    "skandha": 11,
    "chapter": 21,
    "sloka": 11,
    "sanskrit": "शक्त्याशक्त्याथ वा बुद्ध्या समृद्ध्या च यदात्मने अघं कुर्वन्ति हि यथा देशावस्थानुसारतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-012",
    "skandha": 11,
    "chapter": 21,
    "sloka": 12,
    "sanskrit": "धान्यदार्वस्थितन्तूनां रसतैजसचर्मणाम् कालवाय्वग्निमृत्तोयैः पार्थिवानां युतायुतैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-013",
    "skandha": 11,
    "chapter": 21,
    "sloka": 13,
    "sanskrit": "अमेध्यलिप्तं यद्येन गन्धलेपं व्यपोहति भजते प्रकृतिं तस्य तच्छौचं तावदिष्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-014",
    "skandha": 11,
    "chapter": 21,
    "sloka": 14,
    "sanskrit": "स्नानदानतपोऽवस्था वीर्यसंस्कारकर्मभिः मत्स्मृत्या चात्मनः शौचं शुद्धः कर्माचरेद्द्विजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-015",
    "skandha": 11,
    "chapter": 21,
    "sloka": 15,
    "sanskrit": "मन्त्रस्य च परिज्ञानं कर्मशुद्धिर्मदर्पणम् धर्मः सम्पद्यते षड्भिरधर्मस्तु विपर्ययः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-016",
    "skandha": 11,
    "chapter": 21,
    "sloka": 16,
    "sanskrit": "क्वचिद्गुणोऽपि दोषः स्याद्दोषोऽपि विधिना गुणः गुणदोषार्थनियमस्तद्भिदामेव बाधते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-017",
    "skandha": 11,
    "chapter": 21,
    "sloka": 17,
    "sanskrit": "समानकर्माचरणं पतितानां न पातकम् औत्पत्तिको गुणः सङ्गो न शयानः पतत्यधः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-018",
    "skandha": 11,
    "chapter": 21,
    "sloka": 18,
    "sanskrit": "यतो यतो निवर्तेत विमुच्येत ततस्ततः एष धर्मो नृणां क्षेमः शोकमोहभयापहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-019",
    "skandha": 11,
    "chapter": 21,
    "sloka": 19,
    "sanskrit": "विषयेषु गुणाध्यासात्पुंसः सङ्गस्ततो भवेत् सङ्गात्तत्र भवेत्कामः कामादेव कलिर्नृणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-020",
    "skandha": 11,
    "chapter": 21,
    "sloka": 20,
    "sanskrit": "कलेर्दुर्विषहः क्रोधस्तमस्तमनुवर्तते तमसा ग्रस्यते पुंसश्चेतना व्यापिनी द्रुतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-021",
    "skandha": 11,
    "chapter": 21,
    "sloka": 21,
    "sanskrit": "तया विरहितः साधो जन्तुः शून्याय कल्पते ततोऽस्य स्वार्थविभ्रंशो मूर्च्छितस्य मृतस्य च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-022",
    "skandha": 11,
    "chapter": 21,
    "sloka": 22,
    "sanskrit": "विषयाभिनिवेशेन नात्मानं वेद नापरम् वृक्ष जीविकया जीवन्व्यर्थं भस्त्रेव यः श्वसन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-023",
    "skandha": 11,
    "chapter": 21,
    "sloka": 23,
    "sanskrit": "फलश्रुतिरियं नॄणां न श्रेयो रोचनं परम् श्रेयोविवक्षया प्रोक्तं यथा भैषज्यरोचनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-024",
    "skandha": 11,
    "chapter": 21,
    "sloka": 24,
    "sanskrit": "उत्पत्त्यैव हि कामेषु प्राणेषु स्वजनेषु च आसक्तमनसो मर्त्या आत्मनोऽनर्थहेतुषु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-025",
    "skandha": 11,
    "chapter": 21,
    "sloka": 25,
    "sanskrit": "नतानविदुषः स्वार्थं भ्राम्यतो वृजिनाध्वनि कथं युञ्ज्यात्पुनस्तेषु तांस्तमो विशतो बुधः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-026",
    "skandha": 11,
    "chapter": 21,
    "sloka": 26,
    "sanskrit": "एवं व्यवसितं केचिदविज्ञाय कुबुद्धयः फलश्रुतिं कुसुमितां न वेदज्ञा वदन्ति हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-027",
    "skandha": 11,
    "chapter": 21,
    "sloka": 27,
    "sanskrit": "कामिनः कृपणा लुब्धाः पुष्पेषु फलबुद्धयः अग्निमुग्धा धूमतान्ताः स्वं लोकं न विदन्ति ते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-028",
    "skandha": 11,
    "chapter": 21,
    "sloka": 28,
    "sanskrit": "न ते मामङ्ग जानन्ति हृदिस्थं य इदं यतः उक्थशस्त्रा ह्यसुतृपो यथा नीहारचक्षुषः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-029",
    "skandha": 11,
    "chapter": 21,
    "sloka": 29,
    "sanskrit": "ते मे मतमविज्ञाय परोक्षं विषयात्मकाः हिंसायां यदि रागः स्याद्यज्ञ एव न चोदना",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-030",
    "skandha": 11,
    "chapter": 21,
    "sloka": 30,
    "sanskrit": "हिंसाविहारा ह्यालब्धैः पशुभिः स्वसुखेच्छया यजन्ते देवता यज्ञैः पितृभूतपतीन्खलाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-031",
    "skandha": 11,
    "chapter": 21,
    "sloka": 31,
    "sanskrit": "स्वप्नोपमममुं लोकमसन्तं श्रवणप्रियम् आशिषो हृदि सङ्कल्प्य त्यजन्त्यर्थान्यथा वणिक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-032",
    "skandha": 11,
    "chapter": 21,
    "sloka": 32,
    "sanskrit": "रजःसत्त्वतमोनिष्ठा रजःसत्त्वतमोजुषः उपासत इन्द्रमुख्यान्देवादीन्न यथैव माम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-033",
    "skandha": 11,
    "chapter": 21,
    "sloka": 33,
    "sanskrit": "इष्ट्वेह देवता यज्ञैर्गत्वा रंस्यामहे दिवि तस्यान्त इह भूयास्म महाशाला महाकुलाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-034",
    "skandha": 11,
    "chapter": 21,
    "sloka": 34,
    "sanskrit": "एवं पुष्पितया वाचा व्याक्षिप्तमनसां नृणाम् मानिनां चातिलुब्धानां मद्वार्तापि न रोचते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-035",
    "skandha": 11,
    "chapter": 21,
    "sloka": 35,
    "sanskrit": "वेदा ब्रह्मात्मविषयास्त्रिकाण्डविषया इमे परोक्षवादा ऋषयः परोक्षं मम च प्रियम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-036",
    "skandha": 11,
    "chapter": 21,
    "sloka": 36,
    "sanskrit": "शब्दब्रह्म सुदुर्बोधं प्राणेन्द्रियमनोमयम् अनन्तपारं गम्भीरं दुर्विगाह्यं समुद्रवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-037",
    "skandha": 11,
    "chapter": 21,
    "sloka": 37,
    "sanskrit": "मयोपबृंहितं भूम्ना ब्रह्मणानन्तशक्तिना भूतेषु घोषरूपेण विसेषूर्णेव लक्ष्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-038",
    "skandha": 11,
    "chapter": 21,
    "sloka": 38,
    "sanskrit": "यथोर्णनाभिर्हृदयादूर्णामुद्वमते मुखात् आकाशाद्घोषवान्प्राणो मनसा स्पर्शरूपिणा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-039",
    "skandha": 11,
    "chapter": 21,
    "sloka": 39,
    "sanskrit": "छन्दोमयोऽमृतमयः सहस्रपदवीं प्रभुः ओंकाराद्व्यञ्जितस्पर्श स्वरोष्मान्तस्थभूषिताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-040",
    "skandha": 11,
    "chapter": 21,
    "sloka": 40,
    "sanskrit": "विचित्रभाषाविततां छन्दोभिश्चतुरुत्तरैः अनन्तपारां बृहतीं सृजत्याक्षिपते स्वयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-041",
    "skandha": 11,
    "chapter": 21,
    "sloka": 41,
    "sanskrit": "गायत्र्युष्णिगनुष्टुप्च बृहती पङ्क्तिरेव च त्रिष्टुब्जगत्यतिच्छन्दो ह्यत्यष्ट्यतिजगद्विराट्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-042",
    "skandha": 11,
    "chapter": 21,
    "sloka": 42,
    "sanskrit": "किं विधत्ते किमाचष्टे किमनूद्य विकल्पयेत् इत्यस्या हृदयं लोके नान्यो मद्वेद कश्चन",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-21-sloka-043",
    "skandha": 11,
    "chapter": 21,
    "sloka": 43,
    "sanskrit": "मां विधत्तेऽभिधत्ते मां विकल्प्यापोह्यते त्वहम् एतावान्सर्ववेदार्थः शब्द आस्थाय मां भिदाम् मायामात्रमनूद्यान्ते प्रतिषिध्य प्रसीदति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]