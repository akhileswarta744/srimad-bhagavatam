[
  {
    "id": "skandha-11-chapter-10-sloka-001",
    "skandha": 11,
    "chapter": 10,
    "sloka": 1,
    "sanskrit": "मयोदितेष्ववहितः स्वधर्मेषु मदाश्रयः वर्णाश्रमकुलाचारमकामात्मा समाचरेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-11-chapter-10-sloka-002",
    "skandha": 11,
    "chapter": 10,
    "sloka": 2,
    "sanskrit": "अन्वीक्षेत विशुद्धात्मा देहिनां विषयात्मनाम् गुणेषु तत्त्वध्यानेन सर्वारम्भविपर्ययम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-003",
    "skandha": 11,
    "chapter": 10,
    "sloka": 3,
    "sanskrit": "सुप्तस्य विषयालोको ध्यायतो वा मनोरथः नानात्मकत्वाद्विफलस्तथा भेदात्मधीर्गुणैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-004",
    "skandha": 11,
    "chapter": 10,
    "sloka": 4,
    "sanskrit": "निवृत्तं कर्म सेवेत प्रवृत्तं मत्परस्त्यजेत् जिज्ञासायां सम्प्रवृत्तो नाद्रियेत्कर्मचोदनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-005",
    "skandha": 11,
    "chapter": 10,
    "sloka": 5,
    "sanskrit": "यमानभीक्ष्णं सेवेत नियमान्मत्परः क्वचित् मदभिज्ञं गुरुं शान्तमुपासीत मदात्मकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-006",
    "skandha": 11,
    "chapter": 10,
    "sloka": 6,
    "sanskrit": "अमान्यमत्सरो दक्षो निर्ममो दृढसौहृदः असत्वरोऽर्थजिज्ञासुरनसूयुरमोघवाक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-007",
    "skandha": 11,
    "chapter": 10,
    "sloka": 7,
    "sanskrit": "जायापत्यगृहक्षेत्र स्वजनद्रविणादिषु उदासीनः समं पश्यन्सर्वेष्वर्थमिवात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-008",
    "skandha": 11,
    "chapter": 10,
    "sloka": 8,
    "sanskrit": "विलक्षणः स्थूलसूक्ष्माद्देहादात्मेक्षिता स्वदृक् यथाग्निर्दारुणो दाह्याद्दाहकोऽन्यः प्रकाशकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-009",
    "skandha": 11,
    "chapter": 10,
    "sloka": 9,
    "sanskrit": "निरोधोत्पत्त्यणुबृहन् नानात्वं तत्कृतान्गुणान् अन्तः प्रविष्ट आधत्त एवं देहगुणान्परः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-010",
    "skandha": 11,
    "chapter": 10,
    "sloka": 10,
    "sanskrit": "योऽसौ गुणैर्विरचितो देहोऽयं पुरुषस्य हि संसारस्तन्निबन्धोऽयं पुंसो विद्या च्छिदात्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-011",
    "skandha": 11,
    "chapter": 10,
    "sloka": 11,
    "sanskrit": "तस्माज्जिज्ञासयात्मानमात्मस्थं केवलं परम् सङ्गम्य निरसेदेतद्वस्तुबुद्धिं यथाक्रमम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-012",
    "skandha": 11,
    "chapter": 10,
    "sloka": 12,
    "sanskrit": "आचार्योऽरणिराद्यः स्यादन्तेवास्युत्तरारणिः तत्सन्धानं प्रवचनं विद्यासन्धिः सुखावहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-013",
    "skandha": 11,
    "chapter": 10,
    "sloka": 13,
    "sanskrit": "वैशारदी सातिविशुद्धबुद्धिर्धुनोति मायां गुणसम्प्रसूताम् गुनांश्च सन्दह्य यदात्ममेतत्स्वयं च शांयत्यसमिद्यथाग्निः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-014",
    "skandha": 11,
    "chapter": 10,
    "sloka": 14,
    "sanskrit": "अथैषाम्कर्मकर्तॄणां भोक्तॄणां सुखदुःखयोः नानात्वमथ नित्यत्वं लोककालागमात्मनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-015",
    "skandha": 11,
    "chapter": 10,
    "sloka": 15,
    "sanskrit": "मन्यसे सर्वभावानां संस्था ह्यौत्पत्तिकी यथा तत्तदाकृतिभेदेन जायते भिद्यते च धीः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-016",
    "skandha": 11,
    "chapter": 10,
    "sloka": 16,
    "sanskrit": "एवमप्यङ्ग सर्वेषां देहिनां देहयोगतः कालावयवतः सन्ति भावा जन्मादयोऽसकृत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-017",
    "skandha": 11,
    "chapter": 10,
    "sloka": 17,
    "sanskrit": "तत्रापि कर्मणां कर्तुरस्वातन्त्र्यं च लक्ष्यते भोक्तुश्च दुःखसुखयोः को न्वर्थो विवशं भजेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-018",
    "skandha": 11,
    "chapter": 10,
    "sloka": 18,
    "sanskrit": "न देहिनां सुखं किञ्चिद्विद्यते विदुषामपि तथा च दुःखं मूढानां वृथाहङ्करणं परम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-019",
    "skandha": 11,
    "chapter": 10,
    "sloka": 19,
    "sanskrit": "यदि प्राप्तिं विघातं च जानन्ति सुखदुःखयोः तेऽप्यद्धा न विदुर्योगं मृत्युर्न प्रभवेद्यथा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-020",
    "skandha": 11,
    "chapter": 10,
    "sloka": 20,
    "sanskrit": "कोऽन्वर्थः सुखयत्येनं कामो वा मृत्युरन्तिके आघातं नीयमानस्य वध्यस्येव न तुष्टिदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-021",
    "skandha": 11,
    "chapter": 10,
    "sloka": 21,
    "sanskrit": "श्रुतं च दृष्टवद्दुष्टं स्पर्धासूयात्ययव्ययैः बह्वन्तरायकामत्वात्कृषिवच्चापि निष्फलम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-022",
    "skandha": 11,
    "chapter": 10,
    "sloka": 22,
    "sanskrit": "अन्तरायैरविहितो यदि धर्मः स्वनुष्ठितः तेनापि निर्जितं स्थानं यथा गच्छति तच्छृणु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-023",
    "skandha": 11,
    "chapter": 10,
    "sloka": 23,
    "sanskrit": "इष्ट्वेह देवता यज्ञैः स्वर्लोकं याति याज्ञिकः भुञ्जीत देववत्तत्र भोगान्दिव्यान्निजार्जितान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-024",
    "skandha": 11,
    "chapter": 10,
    "sloka": 24,
    "sanskrit": "स्वपुण्योपचिते शुभ्रे विमान उपगीयते गन्धर्वैर्विहरन्मध्ये देवीनां हृद्यवेषधृक्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-025",
    "skandha": 11,
    "chapter": 10,
    "sloka": 25,
    "sanskrit": "स्त्रीभिः कामगयानेन किङ्किनीजालमालिना क्रीडन्न वेदात्मपातं सुराक्रीडेषु निर्वृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-026",
    "skandha": 11,
    "chapter": 10,
    "sloka": 26,
    "sanskrit": "तावत्स मोदते स्वर्गे यावत्पुण्यं समाप्यते क्षीणपुन्यः पतत्यर्वागनिच्छन्कालचालितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-027",
    "skandha": 11,
    "chapter": 10,
    "sloka": 27,
    "sanskrit": "यद्यधर्मरतः सङ्गादसतां वाजितेन्द्रियः कामात्मा कृपणो लुब्धः स्त्रैणो भूतविहिंसकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-028",
    "skandha": 11,
    "chapter": 10,
    "sloka": 28,
    "sanskrit": "पशूनविधिनालभ्य प्रेतभूतगणान्यजन् नरकानवशो जन्तुर्गत्वा यात्युल्बणं तमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-029",
    "skandha": 11,
    "chapter": 10,
    "sloka": 29,
    "sanskrit": "कर्माणि दुःखोदर्काणि कुर्वन्देहेन तैः पुनः देहमाभजते तत्र किं सुखं मर्त्यधर्मिणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-030",
    "skandha": 11,
    "chapter": 10,
    "sloka": 30,
    "sanskrit": "लोकानां लोकपालानां मद्भयं कल्पजीविनाम् ब्रह्मणोऽपि भयं मत्तो द्विपरार्धपरायुषः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-031",
    "skandha": 11,
    "chapter": 10,
    "sloka": 31,
    "sanskrit": "गुणाः सृजन्ति कर्माणि गुणोऽनुसृजते गुणान् जीवस्तु गुणसंयुक्तो भुङ्क्ते कर्मफलान्यसौ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-032",
    "skandha": 11,
    "chapter": 10,
    "sloka": 32,
    "sanskrit": "यावत्स्याद्गुणवैषम्यं तावन्नानात्वमात्मनः नानात्वमात्मनो यावत्पारतन्त्र्यं तदैव हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-033",
    "skandha": 11,
    "chapter": 10,
    "sloka": 33,
    "sanskrit": "यावदस्यास्वतन्त्रत्वं तावदीश्वरतो भयम् य एतत्समुपासीरंस्ते मुह्यन्ति शुचार्पिताः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-034",
    "skandha": 11,
    "chapter": 10,
    "sloka": 34,
    "sanskrit": "काल आत्मागमो लोकः स्वभावो धर्म एव च इति मां बहुधा प्राहुर्गुणव्यतिकरे सति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-035",
    "skandha": 11,
    "chapter": 10,
    "sloka": 35,
    "sanskrit": "गुणेषु वर्तमानोऽपि देहजेष्वनपावृतः गुणैर्न बध्यते देही बध्यते वा कथं विभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीउद्धव उवाच ।"
  },
  {
    "id": "skandha-11-chapter-10-sloka-036",
    "skandha": 11,
    "chapter": 10,
    "sloka": 36,
    "sanskrit": "कथं वर्तेत विहरेत्कैर्वा ज्ञायेत लक्षणैः किं भुञ्जीतोत विसृजेच्छयीतासीत याति वा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-10-sloka-037",
    "skandha": 11,
    "chapter": 10,
    "sloka": 37,
    "sanskrit": "एतदच्युत मे ब्रूहि प्रश्नं प्रश्नविदां वर नित्यबद्धो नित्यमुक्त एक एवेति मे भ्रमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]