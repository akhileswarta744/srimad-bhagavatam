[
  {
    "id": "skandha-11-chapter-18-sloka-001",
    "skandha": 11,
    "chapter": 18,
    "sloka": 1,
    "sanskrit": "वनं विविक्षुः पुत्रेषु भार्यां न्यस्य सहैव वा वन एव वसेच्छान्तस्तृतीयं भागमायुषः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-11-chapter-18-sloka-002",
    "skandha": 11,
    "chapter": 18,
    "sloka": 2,
    "sanskrit": "कन्दमूलफलैर्वन्यैर्मेध्यैर्वृत्तिं प्रकल्पयेत् वसीत वल्कलं वासस्तृणपर्णाजिनानि वा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-003",
    "skandha": 11,
    "chapter": 18,
    "sloka": 3,
    "sanskrit": "केशरोमनखश्मश्रु मलानि बिभृयाद्दतः न धावेदप्सु मज्जेत त्रि कालं स्थण्डिलेशयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-004",
    "skandha": 11,
    "chapter": 18,
    "sloka": 4,
    "sanskrit": "ग्रीष्मे तप्येत पञ्चाग्नीन्वर्षास्वासारषाड्जले आकण्थमग्नः शिशिर एवं वृत्तस्तपश्चरेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-005",
    "skandha": 11,
    "chapter": 18,
    "sloka": 5,
    "sanskrit": "अग्निपक्वं समश्नीयात्कालपक्वमथापि वा उलूखलाश्मकुट्टो वा दन्तोलूखल एव वा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-006",
    "skandha": 11,
    "chapter": 18,
    "sloka": 6,
    "sanskrit": "स्वयं सञ्चिनुयात्सर्वमात्मनो वृत्तिकारणम् देशकालबलाभिज्ञो नाददीतान्यदाहृतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-007",
    "skandha": 11,
    "chapter": 18,
    "sloka": 7,
    "sanskrit": "वन्यैश्चरुपुरोडाशैर्निर्वपेत्कालचोदितान् न तु श्रौतेन पशुना मां यजेत वनाश्रमी",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-008",
    "skandha": 11,
    "chapter": 18,
    "sloka": 8,
    "sanskrit": "अग्निहोत्रं च दर्शश्च पौर्णमासश्च पूर्ववत् चातुर्मास्यानि च मुनेराम्नातानि च नैगमैः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-009",
    "skandha": 11,
    "chapter": 18,
    "sloka": 9,
    "sanskrit": "एवं चीर्णेन तपसा मुनिर्धमनिसन्ततः मां तपोमयमाराध्य ऋषिलोकादुपैति माम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-010",
    "skandha": 11,
    "chapter": 18,
    "sloka": 10,
    "sanskrit": "यस्त्वेतत्कृच्छ्रतश्चीर्णं तपो निःश्रेयसं महत् कामायाल्पीयसे युञ्ज्याद्बालिशः कोऽपरस्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-011",
    "skandha": 11,
    "chapter": 18,
    "sloka": 11,
    "sanskrit": "यदासौ नियमेऽकल्पो जरया जातवेपथुः आत्मन्यग्नीन्समारोप्य मच्चित्तोऽग्निं समाविशेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-012",
    "skandha": 11,
    "chapter": 18,
    "sloka": 12,
    "sanskrit": "यदा कर्मविपाकेषु लोकेषु निरयात्मसु विरागो जायते सम्यङ्न्यस्ताग्निः प्रव्रजेत्ततः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-013",
    "skandha": 11,
    "chapter": 18,
    "sloka": 13,
    "sanskrit": "इष्ट्वा यथोपदेशं मां दत्त्वा सर्वस्वमृत्विजे अग्नीन्स्वप्राण आवेश्य निरपेक्षः परिव्रजेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-014",
    "skandha": 11,
    "chapter": 18,
    "sloka": 14,
    "sanskrit": "विप्रस्य वै सन्न्यसतो देवा दारादिरूपिणः विघ्नान्कुर्वन्त्ययं ह्यस्मानाक्रम्य समियात्परम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-015",
    "skandha": 11,
    "chapter": 18,
    "sloka": 15,
    "sanskrit": "बिभृयाच्चेन्मुनिर्वासः कौपीनाच्छादनं परम् त्यक्तं न दण्डपात्राभ्यामन्यत्किञ्चिदनापदि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-016",
    "skandha": 11,
    "chapter": 18,
    "sloka": 16,
    "sanskrit": "दृष्टिपूतं न्यसेत्पादं वस्त्रपूतं पिबेज्जलम् सत्यपूतां वदेद्वाचं मनःपूतं समाचरेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-017",
    "skandha": 11,
    "chapter": 18,
    "sloka": 17,
    "sanskrit": "मौनानीहानिलायामा दण्डा वाग्देहचेतसाम् न ह्येते यस्य सन्त्यङ्ग वेणुभिर्न भवेद्यतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-018",
    "skandha": 11,
    "chapter": 18,
    "sloka": 18,
    "sanskrit": "भिक्षां चतुर्षु वर्णेषु विगर्ह्यान्वर्जयंश्चरेत् सप्तागारानसङ्कॢप्तांस्तुष्येल्लब्धेन तावता",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-019",
    "skandha": 11,
    "chapter": 18,
    "sloka": 19,
    "sanskrit": "बहिर्जलाशयं गत्वा तत्रोपस्पृश्य वाग्यतः विभज्य पावितं शेषं भुञ्जीताशेषमाहृतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-020",
    "skandha": 11,
    "chapter": 18,
    "sloka": 20,
    "sanskrit": "एकश्चरेन्महीमेतां निःसङ्गः संयतेन्द्रियः आत्मक्रीड आत्मरत आत्मवान्समदर्शनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-021",
    "skandha": 11,
    "chapter": 18,
    "sloka": 21,
    "sanskrit": "विविक्तक्षेमशरणो मद्भावविमलाशयः आत्मानं चिन्तयेदेकमभेदेन मया मुनिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-022",
    "skandha": 11,
    "chapter": 18,
    "sloka": 22,
    "sanskrit": "अन्वीक्षेतात्मनो बन्धं मोक्षं च ज्ञाननिष्ठया बन्ध इन्द्रियविक्षेपो मोक्ष एषां च संयमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-023",
    "skandha": 11,
    "chapter": 18,
    "sloka": 23,
    "sanskrit": "तस्मान्नियम्य षड्वर्गं मद्भावेन चरेन्मुनिः विरक्तः क्षुद्रकामेभ्यो लब्ध्वात्मनि सुखं महत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-024",
    "skandha": 11,
    "chapter": 18,
    "sloka": 24,
    "sanskrit": "पुरग्रामव्रजान्सार्थान्भिक्षार्थं प्रविशंश्चरेत् पुण्यदेशसरिच्छैल वनाश्रमवतीं महीम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-025",
    "skandha": 11,
    "chapter": 18,
    "sloka": 25,
    "sanskrit": "वानप्रस्थाश्रमपदेष्वभीक्ष्णं भैक्ष्यमाचरेत् संसिध्यत्याश्वसम्मोहः शुद्धसत्त्वः शिलान्धसा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-026",
    "skandha": 11,
    "chapter": 18,
    "sloka": 26,
    "sanskrit": "नैतद्वस्तुतया पश्येद्दृश्यमानं विनश्यति असक्तचित्तो विरमेदिहामुत्रचिकीर्षितात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-027",
    "skandha": 11,
    "chapter": 18,
    "sloka": 27,
    "sanskrit": "यदेतदात्मनि जगन्मनोवाक्प्राणसंहतम् सर्वं मायेति तर्केण स्वस्थस्त्यक्त्वा न तत्स्मरेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-028",
    "skandha": 11,
    "chapter": 18,
    "sloka": 28,
    "sanskrit": "ज्ञाननिष्ठो विरक्तो वा मद्भक्तो वानपेक्षकः सलिङ्गानाश्रमांस्त्यक्त्वा चरेदविधिगोचरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-029",
    "skandha": 11,
    "chapter": 18,
    "sloka": 29,
    "sanskrit": "बुधो बालकवत्क्रीडेत्कुशलो जडवच्चरेत् वदेदुन्मत्तवद्विद्वान्गोचर्यां नैगमश्चरेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-030",
    "skandha": 11,
    "chapter": 18,
    "sloka": 30,
    "sanskrit": "वेदवादरतो न स्यान्न पाषण्डी न हैतुकः शुष्कवादविवादे न कञ्चित्पक्षं समाश्रयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-031",
    "skandha": 11,
    "chapter": 18,
    "sloka": 31,
    "sanskrit": "नोद्विजेत जनाद्धीरो जनं चोद्वेजयेन्न तु अतिवादांस्तितिक्षेत नावमन्येत कञ्चन देहमुद्दिश्य पशुवद्वैरं कुर्यान्न केनचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-032",
    "skandha": 11,
    "chapter": 18,
    "sloka": 32,
    "sanskrit": "एक एव परो ह्यात्मा भूतेष्वात्मन्यवस्थितः यथेन्दुरुदपात्रेषु भूतान्येकात्मकानि च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-033",
    "skandha": 11,
    "chapter": 18,
    "sloka": 33,
    "sanskrit": "अलब्ध्वा न विषीदेत काले कालेऽशनं क्वचित् लब्ध्वा न हृष्येद्धृतिमानुभयं दैवतन्त्रितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-034",
    "skandha": 11,
    "chapter": 18,
    "sloka": 34,
    "sanskrit": "आहारार्थं समीहेत युक्तं तत्प्राणधारणम् तत्त्वं विमृश्यते तेन तद्विज्ञाय विमुच्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-035",
    "skandha": 11,
    "chapter": 18,
    "sloka": 35,
    "sanskrit": "यदृच्छयोपपन्नान्नमद्याच्छ्रेष्ठमुतापरम् तथा वासस्तथा शय्यां प्राप्तं प्राप्तं भजेन्मुनिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-036",
    "skandha": 11,
    "chapter": 18,
    "sloka": 36,
    "sanskrit": "शौचमाचमनं स्नानं न तु चोदनया चरेत् अन्यांश्च नियमाञ्ज्ञानी यथाहं लीलयेश्वरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-037",
    "skandha": 11,
    "chapter": 18,
    "sloka": 37,
    "sanskrit": "न हि तस्य विकल्पाख्या या च मद्वीक्षया हता आदेहान्तात्क्वचित्ख्यातिस्ततः सम्पद्यते मया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-038",
    "skandha": 11,
    "chapter": 18,
    "sloka": 38,
    "sanskrit": "दुःखोदर्केषु कामेषु जातनिर्वेद आत्मवान् अज्ज्ञासितमद्धर्मो मुनिं गुरुमुपव्रजेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-039",
    "skandha": 11,
    "chapter": 18,
    "sloka": 39,
    "sanskrit": "तावत्परिचरेद्भक्तः श्रद्धावाननसूयकः यावद्ब्रह्म विजानीयान्मामेव गुरुमादृतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-040",
    "skandha": 11,
    "chapter": 18,
    "sloka": 40,
    "sanskrit": "यस्त्वसंयतषड्वर्गः प्रचण्डेन्द्रियसारथिः ज्ञानवैराग्यरहितस्त्रिदण्डमुपजीवति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-041",
    "skandha": 11,
    "chapter": 18,
    "sloka": 41,
    "sanskrit": "सुरानात्मानमात्मस्थं निह्नुते मां च धर्महा अविपक्वकषायोऽस्मादमुष्माच्च विहीयते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-042",
    "skandha": 11,
    "chapter": 18,
    "sloka": 42,
    "sanskrit": "भिक्षोर्धर्मः शमोऽहिंसा तप ईक्षा वनौकसः गृहिणो भूतरक्षेज्या द्विजस्याचार्यसेवनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-043",
    "skandha": 11,
    "chapter": 18,
    "sloka": 43,
    "sanskrit": "ब्रह्मचर्यं तपः शौचं सन्तोषो भूतसौहृदम् गृहस्थस्याप्यृतौ गन्तुः सर्वेषां मदुपासनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-044",
    "skandha": 11,
    "chapter": 18,
    "sloka": 44,
    "sanskrit": "इति मां यः स्वधर्मेण भजेन्नित्यमनन्यभाक् सर्वभूतेषु मद्भावो मद्भक्तिं विन्दते दृढाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-18-sloka-045",
    "skandha": 11,
