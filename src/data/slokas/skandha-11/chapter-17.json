[
  {
    "id": "skandha-11-chapter-17-sloka-001",
    "skandha": 11,
    "chapter": 17,
    "sloka": 1,
    "sanskrit": "यस्त्वयाभिहितः पूर्वं धर्मस्त्वद्भक्तिलक्षणः वर्णाशमाचारवतां सर्वेषां द्विपदामपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीउद्धव उवाच ।"
  },
  {
    "id": "skandha-11-chapter-17-sloka-002",
    "skandha": 11,
    "chapter": 17,
    "sloka": 2,
    "sanskrit": "यथानुष्ठीयमानेन त्वयि भक्तिर्नृणां भवेत् स्वधर्मेणारविन्दाक्ष तन्ममाख्यातुमर्हसि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-003",
    "skandha": 11,
    "chapter": 17,
    "sloka": 3,
    "sanskrit": "पुरा किल महाबाहो धर्मं परमकं प्रभो यत्तेन हंसरूपेण ब्रह्मणेऽभ्यात्थ माधव",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-004",
    "skandha": 11,
    "chapter": 17,
    "sloka": 4,
    "sanskrit": "स इदानीं सुमहता कालेनामित्रकर्शन न प्रायो भविता मर्त्य लोके प्रागनुशासितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-005",
    "skandha": 11,
    "chapter": 17,
    "sloka": 5,
    "sanskrit": "वक्ता कर्ताविता नान्यो धर्मस्याच्युत ते भुवि सभायामपि वैरिञ्च्यां यत्र मूर्तिधराः कलाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-006",
    "skandha": 11,
    "chapter": 17,
    "sloka": 6,
    "sanskrit": "कर्त्रावित्रा प्रवक्त्रा च भवता मधुसूदन त्यक्ते महीतले देव विनष्टं कः प्रवक्ष्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-007",
    "skandha": 11,
    "chapter": 17,
    "sloka": 7,
    "sanskrit": "तत्त्वं नः सर्वधर्मज्ञ धर्मस्त्वद्भक्तिलक्षणः यथा यस्य विधीयेत तथा वर्णय मे प्रभो",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-008",
    "skandha": 11,
    "chapter": 17,
    "sloka": 8,
    "sanskrit": "इत्थं स्वभृत्यमुख्येन पृष्टः स भगवान्हरिः प्रीतः क्षेमाय मर्त्यानां धर्मानाह सनातनान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीशुक उवाच ।"
  },
  {
    "id": "skandha-11-chapter-17-sloka-009",
    "skandha": 11,
    "chapter": 17,
    "sloka": 9,
    "sanskrit": "धर्म्य एष तव प्रश्नो नैःश्रेयसकरो नृणाम् वर्णाश्रमाचारवतां तमुद्धव निबोध मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-11-chapter-17-sloka-010",
    "skandha": 11,
    "chapter": 17,
    "sloka": 10,
    "sanskrit": "आदौ कृतयुगे वर्णो नृणां हंस इति स्मृतः कृतकृत्याः प्रजा जात्या तस्मात्कृतयुगं विदुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-011",
    "skandha": 11,
    "chapter": 17,
    "sloka": 11,
    "sanskrit": "वेदः प्रणव एवाग्रे धर्मोऽहं वृषरूपधृक् उपासते तपोनिष्ठा हंसं मां मुक्तकिल्बिषाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-012",
    "skandha": 11,
    "chapter": 17,
    "sloka": 12,
    "sanskrit": "त्रेतामुखे महाभाग प्राणान्मे हृदयात्त्रयी विद्या प्रादुरभूत्तस्या अहमासं त्रिवृन्मखः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-013",
    "skandha": 11,
    "chapter": 17,
    "sloka": 13,
    "sanskrit": "विप्रक्षत्रियविट्शूद्रा मुखबाहूरुपादजाः वैराजात्पुरुषाज्जाता य आत्माचारलक्षणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-014",
    "skandha": 11,
    "chapter": 17,
    "sloka": 14,
    "sanskrit": "गृहाश्रमो जघनतो ब्रह्मचर्यं हृदो मम वक्षःस्थलाद्वनेवासः सन्न्यासः शिरसि स्थितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-015",
    "skandha": 11,
    "chapter": 17,
    "sloka": 15,
    "sanskrit": "वर्णानामाश्रमाणां च जन्मभूम्यनुसारिणीः आसन्प्रकृतयो नॄनां नीचैर्नीचोत्तमोत्तमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-016",
    "skandha": 11,
    "chapter": 17,
    "sloka": 16,
    "sanskrit": "शमो दमस्तपः शौचं सन्तोषः क्षान्तिरार्जवम् मद्भक्तिश्च दया सत्यं ब्रह्मप्रकृतयस्त्विमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-017",
    "skandha": 11,
    "chapter": 17,
    "sloka": 17,
    "sanskrit": "तेजो बलं धृतिः शौर्यं तितिक्षौदार्यमुद्यमः स्थैर्यं ब्रह्मन्यमैश्वर्यं क्षत्रप्रकृतयस्त्विमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-018",
    "skandha": 11,
    "chapter": 17,
    "sloka": 18,
    "sanskrit": "आस्तिक्यं दाननिष्ठा च अदम्भो ब्रह्मसेवनम् अतुष्टिरर्थोपचयैर्वैश्यप्रकृतयस्त्विमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-019",
    "skandha": 11,
    "chapter": 17,
    "sloka": 19,
    "sanskrit": "शुश्रूषणं द्विजगवां देवानां चाप्यमायया तत्र लब्धेन सन्तोषः शूद्रप्रकृतयस्त्विमाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-020",
    "skandha": 11,
    "chapter": 17,
    "sloka": 20,
    "sanskrit": "अशौचमनृतं स्तेयं नास्तिक्यं शुष्कविग्रहः कामः क्रोधश्च तर्षश्च स भावोऽन्त्यावसायिनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-021",
    "skandha": 11,
    "chapter": 17,
    "sloka": 21,
    "sanskrit": "अहिंसा सत्यमस्तेयमकामक्रोधलोभता भूतप्रियहितेहा च धर्मोऽयं सार्ववर्णिकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-022",
    "skandha": 11,
    "chapter": 17,
    "sloka": 22,
    "sanskrit": "द्वितीयं प्राप्यानुपूर्व्याज्जन्मोपनयनं द्विजः वसन्गुरुकुले दान्तो ब्रह्माधीयीत चाहूतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-023",
    "skandha": 11,
    "chapter": 17,
    "sloka": 23,
    "sanskrit": "मेखलाजिनदण्डाक्ष ब्रह्मसूत्रकमण्डलून् जटिलोऽधौतदद्वासोऽरक्तपीठः कुशान्दधत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-024",
    "skandha": 11,
    "chapter": 17,
    "sloka": 24,
    "sanskrit": "स्नानभोजनहोमेषु जपोच्चारे च वाग्यतः न च्छिन्द्यान्नखरोमाणि कक्षोपस्थगतान्यपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-025",
    "skandha": 11,
    "chapter": 17,
    "sloka": 25,
    "sanskrit": "रेतो नावकिरेज्जातु ब्रह्मव्रतधरः स्वयम् अवकीर्णेऽवगाह्याप्सु यतासुस्त्रिपदां जपेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-026",
    "skandha": 11,
    "chapter": 17,
    "sloka": 26,
    "sanskrit": "अग्न्यर्काचार्यगोविप्र गुरुवृद्धसुराञ्शुचिः समाहित उपासीत सन्ध्ये द्वे यतवाग्जपन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-027",
    "skandha": 11,
    "chapter": 17,
    "sloka": 27,
    "sanskrit": "आचार्यं मां विजानीयान्नावन्मन्येत कर्हिचित् न मर्त्यबुद्ध्यासूयेत सर्वदेवमयो गुरुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-028",
    "skandha": 11,
    "chapter": 17,
    "sloka": 28,
    "sanskrit": "सायं प्रातरुपानीय भैक्ष्यं तस्मै निवेदयेत् यच्चान्यदप्यनुज्ञातमुपयुञ्जीत संयतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-029",
    "skandha": 11,
    "chapter": 17,
    "sloka": 29,
    "sanskrit": "शुश्रूषमाण आचार्यं सदोपासीत नीचवत् यानशय्यासनस्थानैर्नातिदूरे कृताञ्जलिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-030",
    "skandha": 11,
    "chapter": 17,
    "sloka": 30,
    "sanskrit": "एवंवृत्तो गुरुकुले वसेद्भोगविवर्जितः विद्या समाप्यते यावद्बिभ्रद्व्रतमखण्डितम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-031",
    "skandha": 11,
    "chapter": 17,
    "sloka": 31,
    "sanskrit": "यद्यसौ छन्दसां लोकमारोक्ष्यन्ब्रह्मविष्टपम् गुरवे विन्यसेद्देहं स्वाध्यायार्थं बृहद्व्रतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-032",
    "skandha": 11,
    "chapter": 17,
    "sloka": 32,
    "sanskrit": "अग्नौ गुरावात्मनि च सर्वभूतेषु मां परम् अपृथग्धीरुपसीत ब्रह्मवर्चस्व्यकल्मषः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-033",
    "skandha": 11,
    "chapter": 17,
    "sloka": 33,
    "sanskrit": "स्त्रीणां निरीक्षणस्पर्श संलापक्ष्वेलनादिकम् प्राणिनो मिथुनीभूतानगृहस्थोऽग्रतस्त्यजेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-034",
    "skandha": 11,
    "chapter": 17,
    "sloka": 34,
    "sanskrit": "शौचमाचमनं स्नानं सन्ध्योपास्तिर्ममार्चनम् तीर्थसेवा जपोऽस्पृश्या भक्ष्यासम्भाष्यवर्जनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-035",
    "skandha": 11,
    "chapter": 17,
    "sloka": 35,
    "sanskrit": "सर्वाश्रमप्रयुक्तोऽयं नियमः कुलनन्दन मद्भावः सर्वभूतेषु मनोवाक्कायसंयमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-036",
    "skandha": 11,
    "chapter": 17,
    "sloka": 36,
    "sanskrit": "एवं बृहद्व्रतधरो ब्राह्मणोऽग्निरिव ज्वलन् मद्भक्तस्तीव्रतपसा दग्धकर्माशयोऽमलः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-037",
    "skandha": 11,
    "chapter": 17,
    "sloka": 37,
    "sanskrit": "अथानन्तरमावेक्ष्यन्यथाजिज्ञासितागमः गुरवे दक्षिणां दत्त्वा स्नायाद्गुर्वनुमोदितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-038",
    "skandha": 11,
    "chapter": 17,
    "sloka": 38,
    "sanskrit": "गृहं वनं वोपविशेत्प्रव्रजेद्वा द्विजोत्तमः आश्रमादाश्रमं गच्छेन्नान्यथामत्परश्चरेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-039",
    "skandha": 11,
    "chapter": 17,
    "sloka": 39,
    "sanskrit": "गृहार्थी सदृशीं भार्यामुद्वहेदजुगुप्सिताम् यवीयसीं तु वयसा यं सवर्णामनु क्रमात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-040",
    "skandha": 11,
    "chapter": 17,
    "sloka": 40,
    "sanskrit": "इज्याध्ययनदानानि सर्वेषां च द्विजन्मनाम् प्रतिग्रहोऽध्यापनं च ब्राह्मणस्यैव याजनम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-041",
    "skandha": 11,
    "chapter": 17,
    "sloka": 41,
    "sanskrit": "प्रतिग्रहं मन्यमानस्तपस्तेजोयशोनुदम् अन्याभ्यामेव जीवेत शिलैर्वा दोषदृक्तयोः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-042",
    "skandha": 11,
    "chapter": 17,
    "sloka": 42,
    "sanskrit": "ब्राह्मणस्य हि देहोऽयं क्षुद्रकामाय नेष्यते कृच्छ्राय तपसे चेह प्रेत्यानन्तसुखाय च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-043",
    "skandha": 11,
    "chapter": 17,
    "sloka": 43,
    "sanskrit": "शिलोञ्छवृत्त्या परितुष्टचित्तो धर्मं महान्तं विरजं जुषाणः मय्यर्पितात्मा गृह एव तिष्ठन्नातिप्रसक्तः समुपैति शान्तिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-044",
    "skandha": 11,
    "chapter": 17,
    "sloka": 44,
    "sanskrit": "समुद्धरन्ति ये विप्रं सीदन्तं मत्परायणम् तानुद्धरिष्ये न चिरादापद्भ्यो नौरिवार्णवात्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-17-sloka-045",
    "skandha": 11,
    "chapter": 17,
