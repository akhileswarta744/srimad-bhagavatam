[
  {
    "id": "skandha-11-chapter-16-sloka-001",
    "skandha": 11,
    "chapter": 16,
    "sloka": 1,
    "sanskrit": "त्वं ब्रह्म परमं साक्षादनाद्यन्तमपावृतम् सर्वेषामपि भावानां त्राणस्थित्यप्ययोद्भवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीउद्धव उवाच ।"
  },
  {
    "id": "skandha-11-chapter-16-sloka-002",
    "skandha": 11,
    "chapter": 16,
    "sloka": 2,
    "sanskrit": "उच्चावचेषु भूतेषु दुर्ज्ञेयमकृतात्मभिः उपासते त्वां भगवन्याथातथ्येन ब्राह्मणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-003",
    "skandha": 11,
    "chapter": 16,
    "sloka": 3,
    "sanskrit": "येषु येषु च भूतेषु भक्त्या त्वां परमर्षयः उपासीनाः प्रपद्यन्ते संसिद्धिं तद्वदस्व मे",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-004",
    "skandha": 11,
    "chapter": 16,
    "sloka": 4,
    "sanskrit": "गूढश्चरसि भूतात्मा भूतानां भूतभावन न त्वां पश्यन्ति भूतानि पश्यन्तं मोहितानि ते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-005",
    "skandha": 11,
    "chapter": 16,
    "sloka": 5,
    "sanskrit": "याः काश्च भूमौ दिवि वै रसायां विभूतयो दिक्षु महाविभूते ता मह्यमाख्याह्यनुभावितास्ते नमामि ते तीर्थपदाङ्घ्रिपद्मम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-006",
    "skandha": 11,
    "chapter": 16,
    "sloka": 6,
    "sanskrit": "एवमेतदहं पृष्टः प्रश्नं प्रश्नविदां वर युयुत्सुना विनशने सपत्नैरर्जुनेन वै",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-11-chapter-16-sloka-007",
    "skandha": 11,
    "chapter": 16,
    "sloka": 7,
    "sanskrit": "ज्ञात्वा ज्ञातिवधं गर्ह्यमधर्मं राज्यहेतुकम् ततो निवृत्तो हन्ताहं हतोऽयमिति लौकिकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-008",
    "skandha": 11,
    "chapter": 16,
    "sloka": 8,
    "sanskrit": "स तदा पुरुषव्याघ्रो युक्त्या मे प्रतिबोधितः अभ्यभाषत मामेवं यथा त्वं रणमूर्धनि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-009",
    "skandha": 11,
    "chapter": 16,
    "sloka": 9,
    "sanskrit": "अहमात्मोद्धवामीषां भूतानां सुहृदीश्वरः अहं सर्वाणि भूतानि तेषां स्थित्युद्भवाप्ययः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-010",
    "skandha": 11,
    "chapter": 16,
    "sloka": 10,
    "sanskrit": "अहं गतिर्गतिमतां कालः कलयतामहम् गुनाणां चाप्यहं साम्यं गुणिन्यौत्पत्तिको गुणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-011",
    "skandha": 11,
    "chapter": 16,
    "sloka": 11,
    "sanskrit": "गुणिनामप्यहं सूत्रं महतां च महानहम् सूक्ष्माणामप्यहं जीवो दुर्जयानामहं मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-012",
    "skandha": 11,
    "chapter": 16,
    "sloka": 12,
    "sanskrit": "हिरण्यगर्भो वेदानां मन्त्राणां प्रणवस्त्रिवृत् अक्षराणामकारोऽस्मि पदानि च्छन्दुसामहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-013",
    "skandha": 11,
    "chapter": 16,
    "sloka": 13,
    "sanskrit": "इन्द्रोऽहं सर्वदेवानां वसूनामस्मि हव्यवाट् आदित्यानामहं विष्णू रुद्राणां नीललोहितः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-014",
    "skandha": 11,
    "chapter": 16,
    "sloka": 14,
    "sanskrit": "ब्रह्मर्षीणां भृगुरहं राजर्षीणामहं मनुः देवर्षीणां नारदोऽहं हविर्धान्यस्मि धेनुषु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-015",
    "skandha": 11,
    "chapter": 16,
    "sloka": 15,
    "sanskrit": "सिद्धेश्वराणां कपिलः सुपर्णोऽहं पतत्रिणाम् प्रजापतीनां दक्षोऽहं पितॄणामहमर्यमा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-016",
    "skandha": 11,
    "chapter": 16,
    "sloka": 16,
    "sanskrit": "मां विद्ध्युद्धव दैत्यानां प्रह्लादमसुरेश्वरम् सोमं नक्षत्रौषधीनां धनेशं यक्षरक्षसाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-017",
    "skandha": 11,
    "chapter": 16,
    "sloka": 17,
    "sanskrit": "ऐरावतं गजेन्द्राणां यादसां वरुणं प्रभुम् तपतां द्युमतां सूर्यं मनुष्याणां च भूपतिम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-018",
    "skandha": 11,
    "chapter": 16,
    "sloka": 18,
    "sanskrit": "उच्चैःश्रवास्तुरङ्गाणां धातूनामस्मि काञ्चनम् यमः संयमतां चाहम्सर्पाणामस्मि वासुकिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-019",
    "skandha": 11,
    "chapter": 16,
    "sloka": 19,
    "sanskrit": "नागेन्द्राणामनन्तोऽहं मृगेन्द्रः शृङ्गिदंष्ट्रिणाम् आश्रमाणामहं तुर्यो वर्णानां प्रथमोऽनघ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-020",
    "skandha": 11,
    "chapter": 16,
    "sloka": 20,
    "sanskrit": "तीर्थानां स्रोतसां गङ्गा समुद्रः सरसामहम् आयुधानां धनुरहं त्रिपुरघ्नो धनुष्मताम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-021",
    "skandha": 11,
    "chapter": 16,
    "sloka": 21,
    "sanskrit": "धिष्ण्यानामस्म्यहं मेरुर्गहनानां हिमालयः वनस्पतीनामश्वत्थ ओषधीनामहं यवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-022",
    "skandha": 11,
    "chapter": 16,
    "sloka": 22,
    "sanskrit": "पुरोधसां वसिष्ठोऽहं ब्रह्मिष्ठानां बृहस्पतिः स्कन्दोऽहं सर्वसेनान्यामग्रण्यां भगवानजः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-023",
    "skandha": 11,
    "chapter": 16,
    "sloka": 23,
    "sanskrit": "यज्ञानां ब्रह्मयज्ञोऽहं व्रतानामविहिंसनम् वाय्वग्न्यर्काम्बुवागात्मा शुचीनामप्यहं शुचिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-024",
    "skandha": 11,
    "chapter": 16,
    "sloka": 24,
    "sanskrit": "योगानामात्मसंरोधो मन्त्रोऽस्मि विजिगीषताम् आन्वीक्षिकी कौशलानां विकल्पः ख्यातिवादिनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-025",
    "skandha": 11,
    "chapter": 16,
    "sloka": 25,
    "sanskrit": "स्त्रीणां तु शतरूपाहं पुंसां स्वायम्भुवो मनुः नारायणो मुनीनां च कुमारो ब्रह्मचारिणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-026",
    "skandha": 11,
    "chapter": 16,
    "sloka": 26,
    "sanskrit": "धर्माणामस्मि सन्न्यासः क्षेमाणामबहिर्मतिः गुह्यानां सुनृतं मौनं मिथुनानामजस्त्वहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-027",
    "skandha": 11,
    "chapter": 16,
    "sloka": 27,
    "sanskrit": "संवत्सरोऽस्म्यनिमिषामृतूनां मधुमाधवौ मासानां मार्गशीर्षोऽहं नक्षत्राणां तथाभिजित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-028",
    "skandha": 11,
    "chapter": 16,
    "sloka": 28,
    "sanskrit": "अहं युगानां च कृतं धीराणां देवलोऽसितः द्वैपायनोऽस्मि व्यासानां कवीनां काव्य आत्मवान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-029",
    "skandha": 11,
    "chapter": 16,
    "sloka": 29,
    "sanskrit": "वासुदेवो भगवतां त्वं तु भागवतेष्वहम् किम्पुरुषानां हनुमान्विद्याध्राणां सुदर्शनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-030",
    "skandha": 11,
    "chapter": 16,
    "sloka": 30,
    "sanskrit": "रत्नानां पद्मरागोऽस्मि पद्मकोशः सुपेशसाम् कुशोऽस्मि दर्भजातीनां गव्यमाज्यं हविःष्वहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-031",
    "skandha": 11,
    "chapter": 16,
    "sloka": 31,
    "sanskrit": "व्यवसायिनामहं लक्ष्मीः कितवानां छलग्रहः तितिक्षास्मि तितिक्षूणां सत्त्वं सत्त्ववतामहम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-032",
    "skandha": 11,
    "chapter": 16,
    "sloka": 32,
    "sanskrit": "ओजः सहो बलवतां कर्माहं विद्धि सात्वताम् सात्वतां नवमूर्तीनामादिमूर्तिरहं परा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-033",
    "skandha": 11,
    "chapter": 16,
    "sloka": 33,
    "sanskrit": "विश्वावसुः पूर्वचित्तिर्गन्धर्वाप्सरसामहम् भूधराणामहं स्थैर्यं गन्धमात्रमहं भुवः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-034",
    "skandha": 11,
    "chapter": 16,
    "sloka": 34,
    "sanskrit": "अपां रसश्च परमस्तेजिष्ठानां विभावसुः प्रभा सूर्येन्दुताराणां शब्दोऽहं नभसः परः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-035",
    "skandha": 11,
    "chapter": 16,
    "sloka": 35,
    "sanskrit": "ब्रह्मण्यानां बलिरहं वीराणामहमर्जुनः भूतानां स्थितिरुत्पत्तिरहं वै प्रतिसङ्क्रमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-036",
    "skandha": 11,
    "chapter": 16,
    "sloka": 36,
    "sanskrit": "गत्युक्त्युत्सर्गोपादानमानन्दस्पर्शलक्षनम् आस्वादश्रुत्यवघ्राणमहं सर्वेन्द्रियेन्द्रियम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-037",
    "skandha": 11,
    "chapter": 16,
    "sloka": 37,
    "sanskrit": "पृथिवी वायुराकाश आपो ज्योतिरहं महान् विकारः पुरुषोऽव्यक्तं रजः सत्त्वं तमः परम् अहमेतत्प्रसङ्ख्यानं ज्ञानं तत्त्वविनिश्चयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-038",
    "skandha": 11,
    "chapter": 16,
    "sloka": 38,
    "sanskrit": "मयेश्वरेण जीवेन गुणेन गुणिना विना सर्वात्मनापि सर्वेण न भावो विद्यते क्वचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-039",
    "skandha": 11,
    "chapter": 16,
    "sloka": 39,
    "sanskrit": "सङ्ख्यानं परमाणूनां कालेन क्रियते मया न तथा मे विभूतीनां सृजतोऽण्डानि कोटिशः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-040",
    "skandha": 11,
    "chapter": 16,
    "sloka": 40,
    "sanskrit": "तेजः श्रीः कीर्तिरैश्वर्यं ह्रीस्त्यागः सौभगं भगः वीर्यं तितिक्षा विज्ञानं यत्र यत्र स मेऽंशकः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-041",
    "skandha": 11,
    "chapter": 16,
    "sloka": 41,
    "sanskrit": "एतास्ते कीर्तिताः सर्वाः सङ्क्षेपेण विभूतयः मनोविकारा एवैते यथा वाचाभिधीयते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-042",
    "skandha": 11,
    "chapter": 16,
    "sloka": 42,
    "sanskrit": "वाचं यच्छ मनो यच्छ प्राणान्यच्छेद्रियाणि च आत्मानमात्मना यच्छ न भूयः कल्पसेऽध्वने",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-043",
    "skandha": 11,
    "chapter": 16,
    "sloka": 43,
    "sanskrit": "यो वै वाङ्मनसी संयगसंयच्छन्धिया यतिः तस्य व्रतं तपो दानं स्रवत्यामघटाम्बुवत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-16-sloka-044",
    "skandha": 11,
    "chapter": 16,
    "sloka": 44,
    "sanskrit": "तस्माद्वचो मनः प्राणान्नियच्छेन्मत्परायणः मद्भक्तियुक्तया बुद्ध्या ततः परिसमाप्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]