[
  {
    "id": "skandha-11-chapter-20-sloka-001",
    "skandha": 11,
    "chapter": 20,
    "sloka": 1,
    "sanskrit": "विधिश्च प्रतिषेधश्च निगमो हीश्वरस्य ते अवेक्षतेऽरविण्डाक्ष गुणं दोषं च कर्मणाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीउद्धव उवाच ।"
  },
  {
    "id": "skandha-11-chapter-20-sloka-002",
    "skandha": 11,
    "chapter": 20,
    "sloka": 2,
    "sanskrit": "वर्णाश्रमविकल्पं च प्रतिलोमानुलोमजम् द्रव्यदेशवयःकालान्स्वर्गं नरकमेव च",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-003",
    "skandha": 11,
    "chapter": 20,
    "sloka": 3,
    "sanskrit": "गुणदोषभिदादृष्टिमन्तरेण वचस्तव निःश्रेयसं कथं नॄणां निषेधविधिलक्षणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-004",
    "skandha": 11,
    "chapter": 20,
    "sloka": 4,
    "sanskrit": "पितृदेवमनुष्यानां वेदश्चक्षुस्तवेश्वर श्रेयस्त्वनुपलब्धेऽर्थे साध्यसाधनयोरपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-005",
    "skandha": 11,
    "chapter": 20,
    "sloka": 5,
    "sanskrit": "गुणदोषभिदादृष्टिर्निगमात्ते न हि स्वतः निगमेनापवादश्च भिदाया इति ह भ्रमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-006",
    "skandha": 11,
    "chapter": 20,
    "sloka": 6,
    "sanskrit": "योगास्त्रयो मया प्रोक्ता नॄणां श्रेयोविधित्सया ज्ञानं कर्म च भक्तिश्च नोपायोऽन्योऽस्ति कुत्रचित्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-11-chapter-20-sloka-007",
    "skandha": 11,
    "chapter": 20,
    "sloka": 7,
    "sanskrit": "निर्विण्णानां ज्ञानयोगो न्यासिनामिह कर्मसु तेष्वनिर्विण्णचित्तानां कर्मयोगस्तु कामिनाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-008",
    "skandha": 11,
    "chapter": 20,
    "sloka": 8,
    "sanskrit": "यदृच्छया मत्कथादौ जातश्रद्धस्तु यः पुमान् न निर्विण्णो नातिसक्तो भक्तियोगोऽस्य सिद्धिदः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-009",
    "skandha": 11,
    "chapter": 20,
    "sloka": 9,
    "sanskrit": "तावत्कर्माणि कुर्वीत न निर्विद्येत यावता मत्कथाश्रवणादौ वा श्रद्धा यावन्न जायते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-010",
    "skandha": 11,
    "chapter": 20,
    "sloka": 10,
    "sanskrit": "स्वधर्मस्थो यजन्यज्ञैरनाशीःकाम उद्धव न याति स्वर्गनरकौ यद्यन्यन्न समाचरेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-011",
    "skandha": 11,
    "chapter": 20,
    "sloka": 11,
    "sanskrit": "अस्मिंल्लोके वर्तमानः स्वधर्मस्थोऽनघः शुचिः ज्ञानं विशुद्धमाप्नोति मद्भक्तिं वा यदृच्छया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-012",
    "skandha": 11,
    "chapter": 20,
    "sloka": 12,
    "sanskrit": "स्वर्गिणोऽप्येतमिच्छन्ति लोकं निरयिणस्तथा साधकं ज्ञानभक्तिभ्यामुभयं तदसाधकम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-013",
    "skandha": 11,
    "chapter": 20,
    "sloka": 13,
    "sanskrit": "न नरः स्वर्गतिं काङ्क्षेन्नारकीं वा विचक्षणः नेमं लोकं च काङ्क्षेत देहावेशात्प्रमाद्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-014",
    "skandha": 11,
    "chapter": 20,
    "sloka": 14,
    "sanskrit": "एतद्विद्वान्पुरा मृत्योरभवाय घटेत सः अप्रमत्त इदं ज्ञात्वा मर्त्यमप्यर्थसिद्धिदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-015",
    "skandha": 11,
    "chapter": 20,
    "sloka": 15,
    "sanskrit": "छिद्यमानं यमैरेतैः कृतनीडं वनस्पतिम् खगः स्वकेतमुत्सृज्य क्षेमं याति ह्यलम्पटः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-016",
    "skandha": 11,
    "chapter": 20,
    "sloka": 16,
    "sanskrit": "अहोरात्रैश्छिद्यमानं बुद्ध्वायुर्भयवेपथुः मुक्तसङ्गः परं बुद्ध्वा निरीह उपशाम्यति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-017",
    "skandha": 11,
    "chapter": 20,
    "sloka": 17,
    "sanskrit": "नृदेहमाद्यं सुलभं सुदुर्लभं प्लवं सुकल्पं गुरुकर्णधारम् मयानुकूलेन नभस्वतेरितं पुमान्भवाब्धिं न तरेत्स आत्महा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-018",
    "skandha": 11,
    "chapter": 20,
    "sloka": 18,
    "sanskrit": "यदारम्भेषु निर्विण्णो विरक्तः संयतेन्द्रियः अभ्यासेनात्मनो योगी धारयेदचलं मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-019",
    "skandha": 11,
    "chapter": 20,
    "sloka": 19,
    "sanskrit": "धार्यमाणं मनो यर्हि भ्राम्यदश्वनवस्थितम् अतन्द्रितोऽनुरोधेन मार्गेणात्मवशं नयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-020",
    "skandha": 11,
    "chapter": 20,
    "sloka": 20,
    "sanskrit": "मनोगतिं न विसृजेज्जितप्राणो जितेन्द्रियः सत्त्वसम्पन्नया बुद्ध्या मन आत्मवशं नयेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-021",
    "skandha": 11,
    "chapter": 20,
    "sloka": 21,
    "sanskrit": "एष वै परमो योगो मनसः सङ्ग्रहः स्मृतः हृदयज्ञत्वमन्विच्छन्दम्यस्येवार्वतो मुहुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-022",
    "skandha": 11,
    "chapter": 20,
    "sloka": 22,
    "sanskrit": "साङ्ख्येन सर्वभावानां प्रतिलोमानुलोमतः भवाप्ययावनुध्यायेन्मनो यावत्प्रसीदति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-023",
    "skandha": 11,
    "chapter": 20,
    "sloka": 23,
    "sanskrit": "निर्विण्णस्य विरक्तस्य पुरुषस्योक्तवेदिनः मनस्त्यजति दौरात्म्यं चिन्तितस्यानुचिन्तया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-024",
    "skandha": 11,
    "chapter": 20,
    "sloka": 24,
    "sanskrit": "यमादिभिर्योगपथैरान्वीक्षिक्या च विद्यया ममार्चोपासनाभिर्वा नान्यैर्योग्यं स्मरेन्मनः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-025",
    "skandha": 11,
    "chapter": 20,
    "sloka": 25,
    "sanskrit": "यदि कुर्यात्प्रमादेन योगी कर्म विगर्हितम् योगेनैव दहेदंहो नान्यत्तत्र कदाचन",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-026",
    "skandha": 11,
    "chapter": 20,
    "sloka": 26,
    "sanskrit": "स्वे स्वेऽधिकारे या निष्ठा स गुणः परिकीर्तितः कर्मणां जात्यशुद्धानामनेन नियमः कृतः गुणदोषविधानेन सङ्गानां त्याजनेच्छया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-027",
    "skandha": 11,
    "chapter": 20,
    "sloka": 27,
    "sanskrit": "जातश्रद्धो मत्कथासु निर्विण्णः सर्वकर्मसु वेद दुःखात्मकान्कामान्परित्यागेऽप्यनीश्वरः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-028",
    "skandha": 11,
    "chapter": 20,
    "sloka": 28,
    "sanskrit": "ततो भजेत मां प्रीतः श्रद्धालुर्दृढनिश्चयः जुषमाणश्च तान्कामान्दुःखोदर्कांश्च गर्हयन्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-029",
    "skandha": 11,
    "chapter": 20,
    "sloka": 29,
    "sanskrit": "प्रोक्तेन भक्तियोगेन भजतो मासकृन्मुनेः कामा हृदय्या नश्यन्ति सर्वे मयि हृदि स्थिते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-030",
    "skandha": 11,
    "chapter": 20,
    "sloka": 30,
    "sanskrit": "भिद्यते हृदयग्रन्थिश्छिद्यन्ते सर्वसंशयाः क्षीयन्ते चास्य कर्माणि मयि दृष्टेऽखिलात्मनि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-031",
    "skandha": 11,
    "chapter": 20,
    "sloka": 31,
    "sanskrit": "तस्मान्मद्भक्तियुक्तस्य योगिनो वै मदात्मनः न ज्ञानं न च वैराग्यं प्रायः श्रेयो भवेदिह",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-032",
    "skandha": 11,
    "chapter": 20,
    "sloka": 32,
    "sanskrit": "यत्कर्मभिर्यत्तपसा ज्ञानवैराग्यतश्च यत् योगेन दानधर्मेण श्रेयोभिरितरैरपि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-033",
    "skandha": 11,
    "chapter": 20,
    "sloka": 33,
    "sanskrit": "सर्वं मद्भक्तियोगेन मद्भक्तो लभतेऽञ्जसा स्वर्गापवर्गं मद्धाम कथञ्चिद्यदि वाञ्छति",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-034",
    "skandha": 11,
    "chapter": 20,
    "sloka": 34,
    "sanskrit": "न किञ्चित्साधवो धीरा भक्ता ह्येकान्तिनो मम वाञ्छन्त्यपि मया दत्तं कैवल्यमपुनर्भवम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-035",
    "skandha": 11,
    "chapter": 20,
    "sloka": 35,
    "sanskrit": "नैरपेक्ष्यं परं प्राहुर्निःश्रेयसमनल्पकम् तस्मान्निराशिषो भक्तिर्निरपेक्षस्य मे भवेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-036",
    "skandha": 11,
    "chapter": 20,
    "sloka": 36,
    "sanskrit": "न मय्येकान्तभक्तानां गुणदोषोद्भवा गुणाः साधूनां समचित्तानां बुद्धेः परमुपेयुषाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-20-sloka-037",
    "skandha": 11,
    "chapter": 20,
    "sloka": 37,
    "sanskrit": "एवमेतान्मया दिष्टाननुतिष्ठन्ति मे पथः क्षेमं विन्दन्ति मत्स्थानं यद्ब्रह्म परमं विदुः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]