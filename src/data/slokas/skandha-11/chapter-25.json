[
  {
    "id": "skandha-11-chapter-25-sloka-001",
    "skandha": 11,
    "chapter": 25,
    "sloka": 1,
    "sanskrit": "गुणानामसम्मिश्राणां पुमान्येन यथा भवेत् तन्मे पुरुषवर्येदमुपधारय शंसतः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress",
    "speaker": "श्रीभगवानुवाच ।"
  },
  {
    "id": "skandha-11-chapter-25-sloka-002",
    "skandha": 11,
    "chapter": 25,
    "sloka": 2,
    "sanskrit": "शमो दमस्तितिक्षेक्षा तपः सत्यं दया स्मृतिः तुष्टिस्त्यागोऽस्पृहा श्रद्धा ह्रीर्दयादिः स्वनिर्वृतिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-003",
    "skandha": 11,
    "chapter": 25,
    "sloka": 3,
    "sanskrit": "काम ईहा मदस्तृष्णा स्तम्भ आशीर्भिदा सुखम् मदोत्साहो यशःप्रीतिर्हास्यं वीर्यं बलोद्यमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-004",
    "skandha": 11,
    "chapter": 25,
    "sloka": 4,
    "sanskrit": "क्रोधो लोभोऽनृतं हिंसा याच्ञा दम्भः क्लमः कलिः शोकमोहौ विषादार्ती निद्राशा भीरनुद्यमः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-005",
    "skandha": 11,
    "chapter": 25,
    "sloka": 5,
    "sanskrit": "सत्त्वस्य रजसश्चैतास्तमसश्चानुपूर्वशः वृत्तयो वर्णितप्रायाः सन्निपातमथो शृणु",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-006",
    "skandha": 11,
    "chapter": 25,
    "sloka": 6,
    "sanskrit": "सन्निपातस्त्वहमिति ममेत्युद्धव या मतिः व्यवहारः सन्निपातो मनोमात्रेन्द्रियासुभिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-007",
    "skandha": 11,
    "chapter": 25,
    "sloka": 7,
    "sanskrit": "धर्मे चार्थे च कामे च यदासौ परिनिष्ठितः गुणानां सन्निकर्षोऽयं श्रद्धारतिधनावहः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-008",
    "skandha": 11,
    "chapter": 25,
    "sloka": 8,
    "sanskrit": "प्रवृत्तिलक्षणे निष्ठा पुमान्यर्हि गृहाश्रमे स्वधर्मे चानु तिष्ठेत गुणानां समितिर्हि सा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-009",
    "skandha": 11,
    "chapter": 25,
    "sloka": 9,
    "sanskrit": "पुरुषं सत्त्वसंयुक्तमनुमीयाच्छमादिभिः कामादिभी रजोयुक्तं क्रोधाद्यैस्तमसा युतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-010",
    "skandha": 11,
    "chapter": 25,
    "sloka": 10,
    "sanskrit": "यदा भजति मां भक्त्या निरपेक्षः स्वकर्मभिः तं सत्त्वप्रकृतिं विद्यात्पुरुषं स्त्रियमेव वा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-011",
    "skandha": 11,
    "chapter": 25,
    "sloka": 11,
    "sanskrit": "यदा आशिष आशास्य मां भजेत स्वकर्मभिः तं रजःप्रकृतिं विद्याथिंसामाशास्य तामसम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-012",
    "skandha": 11,
    "chapter": 25,
    "sloka": 12,
    "sanskrit": "सत्त्वं रजस्तम इति गुणा जीवस्य नैव मे चित्तजा यैस्तु भूतानां सज्जमानो निबध्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-013",
    "skandha": 11,
    "chapter": 25,
    "sloka": 13,
    "sanskrit": "यदेतरौ जयेत्सत्त्वं भास्वरं विशदं शिवम् तदा सुखेन युज्येत धर्मज्ञानादिभिः पुमान्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-014",
    "skandha": 11,
    "chapter": 25,
    "sloka": 14,
    "sanskrit": "यदा जयेत्तमः सत्त्वं रजः सङ्गं भिदा चलम् तदा दुःखेन युज्येत कर्मणा यशसा श्रिया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-015",
    "skandha": 11,
    "chapter": 25,
    "sloka": 15,
    "sanskrit": "यदा जयेद्रजः सत्त्वं तमो मूढं लयं जडम् युज्येत शोकमोहाभ्यां निद्रया हिंसयाशया",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-016",
    "skandha": 11,
    "chapter": 25,
    "sloka": 16,
    "sanskrit": "यदा चित्तं प्रसीदेत इन्द्रियाणां च निर्वृतिः देहेऽभयं मनोऽसङ्गं तत्सत्त्वं विद्धि मत्पदम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-017",
    "skandha": 11,
    "chapter": 25,
    "sloka": 17,
    "sanskrit": "विकुर्वन्क्रियया चाधीरनिवृत्तिश्च चेतसाम् गात्रास्वास्थ्यं मनो भ्रान्तं रज एतैर्निशामय",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-018",
    "skandha": 11,
    "chapter": 25,
    "sloka": 18,
    "sanskrit": "सीदच्चित्तं विलीयेत चेतसो ग्रहणेऽक्षमम् मनो नष्टं तमो ग्लानिस्तमस्तदुपधारय",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-019",
    "skandha": 11,
    "chapter": 25,
    "sloka": 19,
    "sanskrit": "एधमाने गुणे सत्त्वे देवानां बलमेधते असुराणां च रजसि तमस्युद्धव रक्षसाम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-020",
    "skandha": 11,
    "chapter": 25,
    "sloka": 20,
    "sanskrit": "सत्त्वाज्जागरणं विद्याद्रजसा स्वप्नमादिशेत् प्रस्वापं तमसा जन्तोस्तुरीयं त्रिषु सन्ततम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-021",
    "skandha": 11,
    "chapter": 25,
    "sloka": 21,
    "sanskrit": "उपर्युपरि गच्छन्ति सत्त्वेन ब्राह्मणा जनाः तमसाधोऽध आमुख्याद्रजसान्तरचारिणः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-022",
    "skandha": 11,
    "chapter": 25,
    "sloka": 22,
    "sanskrit": "सत्त्वे प्रलीनाः स्वर्यान्ति नरलोकं रजोलयाः तमोलयास्तु निरयं यान्ति मामेव निर्गुणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-023",
    "skandha": 11,
    "chapter": 25,
    "sloka": 23,
    "sanskrit": "मदर्पणं निष्फलं वा सात्त्विकं निजकर्म तत् राजसं फलसङ्कल्पं हिंसाप्रायादि तामसम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-024",
    "skandha": 11,
    "chapter": 25,
    "sloka": 24,
    "sanskrit": "कैवल्यं सात्त्विकं ज्ञानं रजो वैकल्पिकं च यत् प्राकृतं तामसं ज्ञानं मन्निष्ठं निर्गुणं स्मृतम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-025",
    "skandha": 11,
    "chapter": 25,
    "sloka": 25,
    "sanskrit": "वनं तु सात्त्विको वासो ग्रामो राजस उच्यते तामसं द्यूतसदनं मन्निकेतं तु निर्गुणम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-026",
    "skandha": 11,
    "chapter": 25,
    "sloka": 26,
    "sanskrit": "सात्त्विकः कारकोऽसङ्गी रागान्धो राजसः स्मृतः तामसः स्मृतिविभ्रष्टो निर्गुणो मदपाश्रयः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-027",
    "skandha": 11,
    "chapter": 25,
    "sloka": 27,
    "sanskrit": "सात्त्विक्याध्यात्मिकी श्रद्धा कर्मश्रद्धा तु राजसी तामस्यधर्मे या श्रद्धा मत्सेवायां तु निर्गुणा",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-028",
    "skandha": 11,
    "chapter": 25,
    "sloka": 28,
    "sanskrit": "पथ्यं पूतमनायस्तमाहार्यं सात्त्विकं स्मृतम् राजसं चेन्द्रियप्रेष्ठं तामसं चार्तिदाशुचि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-029",
    "skandha": 11,
    "chapter": 25,
    "sloka": 29,
    "sanskrit": "सात्त्विकं सुखमात्मोत्थं विषयोत्थं तु राजसम् तामसं मोहदैन्योत्थं निर्गुणं मदपाश्रयम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-030",
    "skandha": 11,
    "chapter": 25,
    "sloka": 30,
    "sanskrit": "द्रव्यं देशः फलं कालो ज्ञानं कर्म च कारकः श्रद्धावस्थाकृतिर्निष्ठा त्रैगुण्यः सर्व एव हि",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-031",
    "skandha": 11,
    "chapter": 25,
    "sloka": 31,
    "sanskrit": "सर्वे गुणमया भावाः पुरुषाव्यक्तधिष्ठिताः दृष्टं श्रुतं अनुध्यातं बुद्ध्या वा पुरुषर्षभ",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-032",
    "skandha": 11,
    "chapter": 25,
    "sloka": 32,
    "sanskrit": "एताः संसृतयः पुंसो गुणकर्मनिबन्धनाः येनेमे निर्जिताः सौम्य गुणा जीवेन चित्तजाः भक्तियोगेन मन्निष्ठो मद्भावाय प्रपद्यते",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-033",
    "skandha": 11,
    "chapter": 25,
    "sloka": 33,
    "sanskrit": "तस्माद्देहमिमं लब्ध्वा ज्ञानविज्ञानसम्भवम् गुणसङ्गं विनिर्धूय मां भजन्तु विचक्षणाः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-034",
    "skandha": 11,
    "chapter": 25,
    "sloka": 34,
    "sanskrit": "निःसङ्गो मां भजेद्विद्वानप्रमत्तो जितेन्द्रियः रजस्तमश्चाभिजयेत्सत्त्वसंसेवया मुनिः",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-035",
    "skandha": 11,
    "chapter": 25,
    "sloka": 35,
    "sanskrit": "सत्त्वं चाभिजयेद्युक्तो नैरपेक्ष्येण शान्तधीः सम्पद्यते गुणैर्मुक्तो जीवो जीवं विहाय माम्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  },
  {
    "id": "skandha-11-chapter-25-sloka-036",
    "skandha": 11,
    "chapter": 25,
    "sloka": 36,
    "sanskrit": "जीवो जीवविनिर्मुक्तो गुणैश्चाशयसम्भवैः मयैव ब्रह्मणा पूर्णो न बहिर्नान्तरश्चरेत्",
    "malayalamMeaning": "",
    "source": "Sanskrit Documents / Gitapress"
  }
]